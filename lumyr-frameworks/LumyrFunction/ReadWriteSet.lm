// ============================================================
// lumyr-ReadWriteSet：读写锁版本的线程安全集合 ReadWriteSet<E>
// 与 ConcurrentSet 的区别：
//   - ConcurrentSet 用 rmutex（可重入互斥锁），所有操作串行；
//   - ReadWriteSet 用 rwlock（读写锁），读操作共享读锁可并发，
//     写操作独占写锁。读多写少场景吞吐量更高。
//
// 关键约束（rwlock 不可重入）：
//   1. 写操作（addAll/removeAll/retainAll）直接操作 self.value，
//      不调用 self.add/self.remove（避免重入死锁）。
//   2. forEach 持读锁取键快照后释放，再逐键回调（回调内可安全调用
//      self 方法，因为此时无锁）。
//   3. 集合运算（union/intersection/...）继承父类：通过 self.copy()
//      取原子快照后操作新实例，不持 self 锁。
//
// 用法：
//   import <Function/ReadWriteSet>;
//   rs = ReadWriteSet<int>();
//   rs.add(1).add(2).add(3);
//   print(rs.contains(2));
// ============================================================

import <Function/HashSet>;

public class ReadWriteSet<E> extends HashSet<E> {
    lockId: int64;

    func ReadWriteSet(arr: E[]) {
        super(arr);
        self.lockId = rwlock();
    }

    // ===== 读操作：共享读锁 =====

    @FuncAlias(["length", "count"])
    func size(): int {
        rdlock(self.lockId);
        try { return self.value.len; } finally { unlock(self.lockId); }
    }

    func isEmpty(): bool {
        rdlock(self.lockId);
        try { return self.value.len == 0; } finally { unlock(self.lockId); }
    }

    @FuncAlias(["includes", "contains"])
    func has(elem: E): bool {
        rdlock(self.lockId);
        try { return self.value.has(elem); } finally { unlock(self.lockId); }
    }

    @FuncAlias("toList")
    func toArray() {
        rdlock(self.lockId);
        try { return self.value.keys(); } finally { unlock(self.lockId); }
    }

    @FuncAlias("toDict")
    func toMap() {
        rdlock(self.lockId);
        try { return self.value.copy(); } finally { unlock(self.lockId); }
    }

    @FuncAlias("toStr")
    func toString(): string {
        rdlock(self.lockId);
        try { return self.toJSONString(); } finally { unlock(self.lockId); }
    }

    func equals(other): bool {
        if (type(other) != type(self)) { return false; }
        rdlock(self.lockId);
        try {
            if (self.value.len != other.size()) { return false; }
            ks = self.value.keys();
            i = 0;
            while (i < ks.len) {
                if (!other.has(ks[i])) { return false; }
                i = i + 1;
            }
            return true;
        } finally { unlock(self.lockId); }
    }

    @FuncAlias("hashValue")
    func hashCode(): int {
        rdlock(self.lockId);
        try { return self.value.len; } finally { unlock(self.lockId); }
    }

    @FuncAlias("getClassName")
    func className(): string { return type(self); }

    // 弱一致遍历：持读锁取键快照，释放锁后逐键回调。
    // 释放锁后回调，回调内可安全调用 self 方法（无重入死锁）。
    func forEach(cb: SetCallback<E>) {
        ks = self.toArray();   // 内部持读锁取快照
        i = 0;
        while (i < ks.len) { cb(ks[i]); i = i + 1; }
        return self;
    }

    // clone：返回独立的 ReadWriteSet（锁独立、内容深拷贝）
    @FuncAlias("clone")
    func copy() {
        rdlock(self.lockId);
        try { return ReadWriteSet<E>(self.value.keys()); }
        finally { unlock(self.lockId); }
    }

    // ===== 写操作：独占写锁 =====

    @FuncAlias(["put", "insert", "append"])
    func add(elem: E) {
        wrlock(self.lockId);
        try { self.value[elem] = true; } finally { unlock(self.lockId); }
        return self;
    }

    @FuncAlias(["delete", "discard"])
    func remove(elem: E) {
        wrlock(self.lockId);
        try { self.value.remove(elem); } finally { unlock(self.lockId); }
        return self;
    }

    func clear() {
        wrlock(self.lockId);
        try { self.value.clear(); } finally { unlock(self.lockId); }
        return self;
    }

    // 批量添加：整段持写锁，直接操作 value（不调 self.add，避免重入死锁）
    @FuncAlias(["assign", "update", "merge"])
    func addAll(other) {
        wrlock(self.lockId);
        try {
            if (type(other) == "array") {
                i = 0;
                while (i < other.len) { self.value[other[i]] = true; i = i + 1; }
            } else {
                ks = other.toArray();
                i = 0;
                while (i < ks.len) { self.value[ks[i]] = true; i = i + 1; }
            }
        } finally { unlock(self.lockId); }
        return self;
    }

    // 批量移除
    @FuncAlias(["removeAllElements"])
    func removeAll(other) {
        wrlock(self.lockId);
        try {
            if (type(other) == "array") {
                i = 0;
                while (i < other.len) { self.value.remove(other[i]); i = i + 1; }
            } else {
                ks = other.toArray();
                i = 0;
                while (i < ks.len) { self.value.remove(ks[i]); i = i + 1; }
            }
        } finally { unlock(self.lockId); }
        return self;
    }

    // 保留同时存在于 other 的元素（交集 in-place）
    @FuncAlias(["retain", "retainAllElements"])
    func retainAll(other) {
        wrlock(self.lockId);
        try {
            isArr = (type(other) == "array");
            ks = self.value.keys();
            i = 0;
            while (i < ks.len) {
                drop = false;
                if (isArr) {
                    if (other.indexOf(ks[i]) < 0) { drop = true; }
                } else {
                    if (!other.has(ks[i])) { drop = true; }
                }
                if (drop) { self.value.remove(ks[i]); }
                i = i + 1;
            }
        } finally { unlock(self.lockId); }
        return self;
    }
}
