// ============================================================
// lumyr-Doublearraybuffer：DoubleArrayBuffer 数组缓冲区封装类
// 内部使用常规数组 [] 存储（浮点类型，set 不做截断）
// 避免类型化数组存入类字段后丢失元素类型的 VM bug
// 所有修改操作 in-place，返回 self 支持链式调用
//
// 用法：
//   import <Function/DoubleArrayBuffer>;
//   buf = DoubleArrayBuffer();
//   buf.append(1).append(2).append(3);
//   print(buf.size());        // 3
//   print(buf.sum());         // 6
// ============================================================

import <Function/Buffer>;

public class DoubleArrayBuffer extends AbstractBuffer<double> {
    value: <double>array;

    func DoubleArrayBuffer(arr) {
        self.value = [];
        if (arr != null) { self.value = copy(arr); }
    }

    func indexOf(val): int { return self.value.indexOf(val); }

    // includes——override 重新声明别名确保分派命中本类 RuntimeFunc
    @FuncAlias("includes")
    func contains(val): bool { return self.value.indexOf(val) >= 0; }

    // override 返回同类型实例
    // subList——override 必须重新声明别名，确保返回本类实例
    @FuncAlias("subList")
    func slice(start: int, end: int): DoubleArrayBuffer {
        r = DoubleArrayBuffer();
        r.value = self.value.slice(start, end);
        return r;
    }
    func concat(other): DoubleArrayBuffer {
        r = DoubleArrayBuffer();
        r.value = self.value.concat(other.value);
        return r;
    }

    // copy() 继承自 AbstractBuffer：调用全局 copy(self) → bi_copy 深拷贝路径
    // （lumyr_instance_copy memcpy + 字段递归深拷贝），返回本类实例，无需 override
}
