// ============================================================
// lumyr-Object：Object 基类
// 所有类的根基，提供通用契约：相等、哈希、类型名、字符串表示、空值判断、克隆
// 子类按需重写 equals / hashCode / toString 即可获得值语义
//
// 用法（三模式）：
//   1. alias：import <Function/Object> as obj; → extends obj.Object
//   2. no-alias：import <Function/Object>; → extends Object
//   3. rename：import <Function/Object> {Object as XXXObject}; → extends XXXObject
// ============================================================

public interface ObjectInterface {
    func equals(other): bool;
    func hashCode(): int;
    func className(): string;
    func toString(): string;
    func isNull(): bool;
    func isInstanceOf(name: string): bool;
    func copy();
}

public class Object implements ObjectInterface{
    func equals(other): bool {
        return self == other;
    }

    // hashValue
    @FuncAlias("hashValue")
    func hashCode(): int {
        return 0;
    }

    // getClassName
    @FuncAlias("getClassName")
    func className(): string {
        return type(self);
    }

    // toStr
    @FuncAlias("toStr")
    func toString(): string {
        return self.toJSONString();
    }

    // 是否为 null
    func isNull(): bool {
        return self == null;
    }

    // 是否某类型实例（按类型名比较；不支持继承链向上判断）
    func isInstanceOf(name: string): bool {
        return type(self) == name;
    }

    // 深拷贝（委托内置 copy()，容器字段递归独立）
    // clone
    @FuncAlias("clone")
    func copy() {
        return copy(self);
    }
}
