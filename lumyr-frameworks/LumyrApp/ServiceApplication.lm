// ============================================================
// lumyr-ServiceApplication：通用 TCP 服务应用基座（reactor + 协程模型）
//   ServiceHandler             连接处理器契约（命名接口）
//   ServiceConnectionHandler   单连接处理协程（持有 Coroutine，非 Thread）
//   ServiceApplication         继承 Application：onStart 建 reactor + setReactor；
//                              run spawn accept loop 协程后进入 reactor.run() 事件循环；
//                              stop 调 reactor.stop 打破事件循环；onStop 清理 reactor。
//
// 定位：
//   自定义协议服务（echo、私有 RPC、游戏网关、长连接推送等）的基座。
//   用户把连接处理逻辑写在 ServiceHandler.serve(conn) 里，或继承重写
//   handleConnection(conn)，拿到的是原始连接 socket：
//     conn.recv(maxLen) / conn.recv(maxLen, 0, true) 收（文本 / bytes）
//     conn.send(data) / conn.close()
//
//   WebApplication（<App/WebApplication>）继承本类，仅重写 createHandler
//   换入 HTTP 连接处理器，复用全部 reactor+协程骨架。
//
// 模型要点（Phase 6 换底）：
//   - accept/recv/send/connect 在协程上下文内自动协程化（lm_socket.c 已做）：
//     EAGAIN → co_wait_fd 注册事件 + lm_co_yield 切回 reactor 主循环；
//     事件就绪 → co_resume_handler → lm_co_resume 协程从 yield 后继续。
//   - reactor 单线程跑所有协程：accept loop 协程 + 每连接一个 handler 协程，
//     无线程切换开销，无锁（activeHandlers/activeCount 仅 reactor 主线程访问）。
//   - stop 由外部线程调：super.stop (running=false) + reactor.stop (stop_flag)，
//     下一轮 epoll_wait/kevent 立即返回 0，reactor.run() 退出。
//     无需自连唤醒（reactor.stop 直接打破事件循环）。
//   - run 退出后清理：destroy accept loop 协程 + 所有挂起的 handler 协程
//     （lm_co_destroy 对 DEAD/SUSPENDED 状态安全）。
//
// 多 worker 编程指南（共享状态线程安全规则 / dispatch 选型 / 栈档 /
// connCapacity 与 nofile，当前位于 .trae/specs/concurrency-hardening/，
// 语言系统完工后回迁 docs/）：
// .trae/specs/concurrency-hardening/multi-worker-guide.md
//
// 配置键（可被构造参数覆盖，构造参数优先级高于配置文件）：
//   host         string  默认 "0.0.0.0"
//   port         int     默认 8080
//   backlog      int     默认 128（listen 全连接队列长度；高并发下建议
//                        调大，如 4096/8192，超限的握手被内核丢弃由客户端重试）
//   workers      int     默认 1（单线程）；>1 启用 Phase 7.5 多线程模式——
//                        n 个 ServiceWorker（n-1 子线程 + 主线程）各自独立
//                        reactor + scheduler + SO_REUSEPORT 同端口 listen，
//                        内核按连接 hash 分发；maxConnections 转为 per-worker 限制
//   dispatch     string  默认 "reuseport"（多线程模式内核分发，行为不变）；
//                        "rr" 启用 T5 单 acceptor + 应用层负载感知 RR 分派
//                        （worker 0 单 listener，全满不 accept 走 backlog 反压）
//   acceptBackoffInitMs  int 默认 200：accept 资源耗尽/异常重启指数退避起步毫秒
//   acceptBackoffMaxMs   int 默认 5000：退避封顶毫秒（对标 nginx EMFILE 退避）
//   acceptRestartLimit   int 默认 5：监督窗口内最大异常重启次数，超限停止受理
//   acceptRestartWindowMs int 默认 60000：监督窗口毫秒（对标 OTP supervisor
//                        max_restarts/max_seconds、systemd StartLimitBurst）；
//                        四键均可用 setAcceptBackoffInitMs 等同名 setter 覆盖，
//                        非法值（<1）双语 warn 并回退默认
//   connCapacity int     Task 7 起默认自动对齐：用户未显式设置时
//                        per-worker = min(ulimit -n 软上限 - 256 余量, 65536)，
//                        探测失败回退 1024 并双语告警，RLIM_INFINITY 取 65536；
//                        显式设置（编程式/配置键）优先。reactor 连接池容量，
//                        即可跟踪的最大 fd 数（连接对象池按 fd 索引预分配）；
//                        fd 超出容量时新连接被直接拒绝。多线程为 per-worker。
//
// 两个"连接数"概念的区分：
//   connCapacity    资源容量：reactor 连接池大小，决定能跟踪多少 fd，
//                   随 fd 上限一次性预留（每槽位约百字节，预分配不占额外内存）
//   maxConnections  业务限流：在役连接达到上限后新连接走 onRejectConnection
//                   （TCP 直接关 / HTTP 503），0 = 不限
//
// 系统级调优要点（Phase 7.6，单机 C1M 量级的前提）：
//   fd 上限       每连接占 1 个 fd，进程 fd 上限决定连接数天花板。
//                 macOS: launchctl limit maxfiles / ulimit -n；
//                 Linux: /etc/security/limits.conf + systemd LimitNOFILE。
//                 Task 7 起未显式配置 connCapacity 时按软上限自动对齐
//                 （per-worker = min(软上限-256, 65536)），无需手配。
//   SO_REUSEADDR  ServerSocket 已默认开启（重启可绑 TIME_WAIT 残留端口）。
//   SO_REUSEPORT  多线程模式自动开启（workers > 1 时各 worker 同端口 listen）。
//   内存预算      单连接成本 ≈ 连接对象（约百字节，连接池预分配）
//                 + 协程控制块（约数百字节）+ 协程栈（默认 128 KiB 虚拟地址，
//                 mmap 惰性分配——物理内存只按实际触及页计费；VM 调用帧较深，
//                 IO 型连接协程实测触及约 70 KiB）+ 框架对象（handler/闭包等
//                 约千字节级）。实测口径：4000 并发长连接 echo 峰值 RSS
//                 约 296 MiB（含 VM 基线约 1.5 MiB），折合每连接约 74 KiB。
//                 物理内存粗算：每连接数十 KiB 量级（视业务栈深度），
//                 10 万连接约 7~8 GiB；虚拟地址空间每连接固定 132 KiB 左右
//                 （64 位系统地址空间充裕，不构成瓶颈）。
//
// 用法：
//   import <App/ServiceApplication>;
//   class EchoHandler implements ServiceHandler {
//       func serve(conn) {
//           data = conn.recv(4096);
//           conn.send(data);
//       }
//   }
//   // 直接传 handler，或子类化重写 handleConnection
//   ServiceApplication("0.0.0.0", 18090, EchoHandler()).start();
// ============================================================

import <App/Application>;
import <NetWork/Socket>;
import <NetWork/Reactor>;
import <NetWork/NetError>;
import <Thread/SchedStats>;   // P1-8：handler 执行预算采样（forceYield/longSched）

// 连接处理器契约：在原始连接上实现自定义协议；返回后连接由框架关闭
public interface ServiceHandler {
    func serve(conn);
}

// ============================================================
// AcceptLoopHost：公共 accept 循环宿主契约（命名接口——循环差异注入点）
// 单线程模式由 ServiceApplication 实现，多线程模式由 ServiceWorker 实现：
//   loopRunning        判停（app.running；stop 后 false）
//   onAccepted(conn)   已受理连接的入队与启动（上限拒绝判定/建协程/计数/start）
//   onLoopError        循环异常统一挂钩（分级日志；kind 见 AcceptLoop 注释）
//   countHandlerError  handler 异常记账（owner 本地计数 + error 日志，P0-3）
// ============================================================
public interface AcceptLoopHost {
    func loopRunning(): bool;
    func onAccepted(conn);
    func onLoopError(kind: string, msg: string);
    func countHandlerError(e);
    // accept 监督参数（对标 OTP supervisor max_restarts/max_seconds、
    // systemd StartLimitBurst/StartLimitIntervalSec）：
    //   acceptBackoffInitMs/MaxMs 资源耗尽与异常重启的指数退避起步/封顶；
    //   acceptRestartLimit/WindowMs 窗口内最大重启次数与窗口毫秒数。
    func acceptBackoffInitMs(): int;
    func acceptBackoffMaxMs(): int;
    func acceptRestartLimit(): int;
    func acceptRestartWindowMs(): int;
    // P1-6：accept 限速平滑档——返回需让位的毫秒数（0=不限速）。
    // 在役逼近有效容量 87.5% 时返回短延时，让内核 backlog 暂存新连接、
    // 在途连接排空，避免生硬拒绝（对标 nginx accept_disabled）。
    func acceptThrottleMs(): int;
    // 硬上限排队闸门（acceptQueue 模式）：返回 -1 = 正常受理；
    // 返回 >=0 = 在役已达有效容量，暂不 accept 并让位指定毫秒，
    // 新连接留在内核 listen 全连接队列排队，TCP 流控对客户端自然反压。
    // 与 acceptThrottleMs 的区别：平滑档只在 87.5% 附近短暂让位，本闸门
    // 在满员期间持续挂起 accept，直到有空位（小容量上限下唯一不漏拒绝的档）。
    func acceptGateMs(): int;
    // P1-8：handler 执行预算检查——采样 SchedStats forceYield/longSched，
    // 超限则计数 + warn 日志。AcceptLoop 每轮调用。
    func checkHandlerBudget();
    // 运行期增量回收：已完成连接协程达到批量阈值时 destroy 释放协程栈。
    // 不做的话协程栈只在 run() 退出时 reap，长跑服务的稳态 RSS 会随
    // 累计连接数线性增长（实测 200 连接约多占 30+ MiB）。
    func reapDueHandlers();
}

// ============================================================
// AcceptLoop：公共 accept 循环（P0-4 收敛单/多 worker 两处同构循环）
// 内置 P0-1 错误分类与 P0-2 监督重启，宿主差异经 AcceptLoopHost 注入。
//
// 错误分类（P0-1，对标 nginx/brpc/libhv 共识：accept 出错永不杀循环）：
//   瞬时类（ECONNABORTED 等其余错误）：error 日志后继续受理
//   资源耗尽类（NET_ERR_FD_EXHAUSTED，R1 细分码）：warn + 指数退避后继续
//     ——nginx 对 EMFILE 暂停 accept 防空转（ngx_event_accept.c）；退避
//     200ms 起步 ×2 封顶 5s，受理成功即复位。退避用 coSleep（定时器挂起，
//     不阻塞 reactor 线程——sleep 的 usleep 会阻塞整个事件循环，禁用）
//   致命类（监听套接字失效 BAD_STATE/BAD_FD）：退出循环并经 onLoopError
//     上报告警；reactor 退出清理链仍可达（stop 语义不受影响）
//
// 监督重启（P0-2，对标 OTP transient 语义）：
//   受理路径意外异常（onAccepted 内 bug 等）→ 指数退避后重入循环（与
//   "协程死→拉起"可观测语义等价：accept 协程由 reactor 钉住本线程，
//   循环体重入比重建协程少一次重新 pin 的窗口）；主动 stop 不重启；
//   强度缺省 5 次/60 秒（OTP 默认 1 次/5 秒偏紧，取宽松工程值并文档化），
//   超限判服务失败上报——reactor 与既有连接存活，新连接不再受理。
// ============================================================
public class AcceptLoop {
    static BACKOFF_INIT_MS: int = 200;     // 资源耗尽退避起步（毫秒）
    static BACKOFF_MAX_MS: int = 5000;     // 退避封顶（毫秒）
    static RESTART_LIMIT: int = 5;         // 监督强度：窗口内最大重启次数
    static RESTART_WINDOW_MS: int = 60000; // 监督强度窗口（毫秒）

    host: any;           // AcceptLoopHost
    srv: any;            // listen socket
    backoffMs: int;      // 当前资源耗尽退避（受理成功复位）
    restartN: int;       // 监督窗口内已重启次数
    windowStartMs: int;  // 监督窗口起点（timestamp_ms，0 = 未开窗）

    func AcceptLoop(host, srv) {
        self.host = host;
        self.srv = srv;
        self.backoffMs = host.acceptBackoffInitMs();
        self.restartN = 0;
        self.windowStartMs = 0;
    }

    // 错误对象转文本：string 抛出 / VAL_ERROR（builtin）/ Error 实例统一
    public static func errText(e): string {
        if (type(e) == "string") { return e; }
        return e.getMessage();
    }

    // 单次受理 + 错误分类（P0-1）。返回 false = 退出循环（致命/停机）
    func acceptOnce(): bool {
        // 硬上限排队闸门：满员期间不 accept，连接留 backlog 排队（优先于
        // 87.5% 平滑档——平滑档在小容量上限下因整数取整不触发，闸门保证
        // 任意上限值都不漏拒绝）。coSleep 只挂起 accept 协程，不堵 reactor。
        gate = self.host.acceptGateMs();
        if (gate >= 0) {
            coSleep(gate);
            return true;
        }
        // P1-6：accept 限速平滑档——在役逼近有效容量 87.5% 时短暂让位，
        // 让内核 backlog 暂存新连接、在途连接排空，避免生硬拒绝。
        throttle = self.host.acceptThrottleMs();
        if (throttle > 0) {
            coSleep(throttle);
            return true;
        }
        conn = null;
        try {
            conn = self.srv.accept();
        } catch (e) {
            code = 0;
            if (type(e) != "string") { code = e.getCode(); }
            msg = AcceptLoop.errText(e);
            if (code == NetError.FD_EXHAUSTED) {
                self.host.onLoopError("exhausted",
                    "accept 资源耗尽（fd 耗尽），退避 " + self.backoffMs + "ms 后继续 / accept fd exhausted, backing off: " + msg);
                coSleep(self.backoffMs);
                self.backoffMs = self.backoffMs * 2;
                if (self.backoffMs > self.host.acceptBackoffMaxMs()) {
                    self.backoffMs = self.host.acceptBackoffMaxMs();
                }
                return true;
            }
            if (code == NetError.BAD_STATE || code == NetError.BAD_FD) {
                self.host.onLoopError("fatal",
                    "accept 监听套接字失效，退出受理循环 / listen socket broken, accept loop exiting: " + msg);
                return false;
            }
            self.host.onLoopError("transient",
                "accept 瞬时错误，继续受理 / transient accept error: " + msg);
            return true;
        }
        // 受理成功：退避复位；stop 到达时新连接直接关闭退出
        self.backoffMs = self.host.acceptBackoffInitMs();
        if (self.host.loopRunning() == false) {
            try { conn.close(); } catch (e2) { x = 1; }
            return false;
        }
        self.host.onAccepted(conn);
        return true;
    }

    // 循环体：accept 协程入口调用（含 P0-2 监督重启，规则见类注释）
    func run() {
        while (self.host.loopRunning()) {
            // 运行期增量回收已完成协程（释放协程栈，稳态 RSS 不随累计连接数增长）
            self.host.reapDueHandlers();
            // P1-8：每轮采样 handler 执行预算（forceYield/longSched 超限计数+日志）
            self.host.checkHandlerBudget();
            try {
                if (self.acceptOnce() == false) { return; }
            } catch (e) {
                if (self.host.loopRunning() == false) { return; }   // 主动 stop 不重启
                now = timestamp_ms();
                windowMs = self.host.acceptRestartWindowMs();
                limitN = self.host.acceptRestartLimit();
                if (self.windowStartMs == 0 || now - self.windowStartMs > windowMs) {
                    self.windowStartMs = now;
                    self.restartN = 0;
                }
                self.restartN = self.restartN + 1;
                if (self.restartN > limitN) {
                    self.host.onLoopError("failure",
                        "accept 协程异常重启超限（" + limitN + " 次/" + (windowMs / 1000) + "s），停止受理 / accept supervisor gave up: " + AcceptLoop.errText(e));
                    return;
                }
                delay = self.host.acceptBackoffInitMs();
                i = 1;
                while (i < self.restartN) { delay = delay * 2; i = i + 1; }
                maxBackoff = self.host.acceptBackoffMaxMs();
                if (delay > maxBackoff) { delay = maxBackoff; }
                self.host.onLoopError("supervise",
                    "accept 协程异常退出，" + delay + "ms 后第 " + self.restartN + " 次重启 / accept coroutine died, restarting (attempt " + self.restartN + "): " + AcceptLoop.errText(e));
                coSleep(delay);
            }
        }
    }
}

// ============================================================
// RrAcceptLoop：T5 单 acceptor + 应用层 RR 分派的 accept 循环
// 与 AcceptLoop（reuseport 模式）同级，错误分类/监督重启规则一致，
// 差异只在受理原语：srv.acceptRr(n, maxConn) 在 C 层完成
//   负载感知选 worker（RR 游标 + 在役数/入站队列水位跳过高压 worker）
//   → accept 裸 fd → 投递目标 worker reactor MPSC 入站队列。
// 返回码（见 Socket.lm acceptRr 注释）：
//    0 已投递；1 全 worker 高压（未 accept，连接留 backlog，短让出反压）；
//    2 worker reactor 未全部注册（启动屏障，等待）；
//   -1 fd 耗尽（指数退避）；-2 瞬时错误；-3 监听套接字致命（退出）。
// RR 模式下 gate/throttle 不再需要：全满即不 accept（rc=1），
// 等价硬上限排队语义且对全部 worker 生效；87.5% 平滑档由负载选择天然覆盖。
// ============================================================
public class RrAcceptLoop {
    static BACKOFF_INIT_MS: int = 200;
    static BACKOFF_MAX_MS: int = 5000;
    static RESTART_LIMIT: int = 5;
    static RESTART_WINDOW_MS: int = 60000;

    host: any;       // ServiceWorker（owner=worker 0）
    srv: any;        // 唯一 listen socket
    nworkers: int;
    backoffMs: int;
    restartN: int;
    windowStartMs: int;

    func RrAcceptLoop(host, srv, nworkers: int) {
        self.host = host;
        self.srv = srv;
        self.nworkers = nworkers;
        self.backoffMs = host.acceptBackoffInitMs();
        self.restartN = 0;
        self.windowStartMs = 0;
    }

    // 单次受理。返回 false = 退出循环（致命/停机）
    func acceptOnce(): bool {
        rc = self.srv.acceptRr(self.nworkers, self.host.app.maxConnections);
        if (rc == 0) {
            // 受理成功：退避复位
            self.backoffMs = self.host.acceptBackoffInitMs();
            return true;
        }
        if (rc == 1) {
            // 全部 worker 高压（在役满/队列满）：本轮未 accept，listener 保持
            // ET 未读，连接留内核 backlog；短让出后由在役排空驱动重试。
            coSleep(2);
            return true;
        }
        if (rc == 2) {
            // worker reactor 未全部注册：启动屏障未满足，等待就绪
            coSleep(1);
            return true;
        }
        if (rc == -1) {
            self.host.onLoopError("exhausted",
                "RR accept 资源耗尽（fd 耗尽），退避 " + self.backoffMs + "ms 后继续 / RR accept fd exhausted, backing off");
            coSleep(self.backoffMs);
            self.backoffMs = self.backoffMs * 2;
            if (self.backoffMs > self.host.acceptBackoffMaxMs()) {
                self.backoffMs = self.host.acceptBackoffMaxMs();
            }
            return true;
        }
        if (rc == -3) {
            self.host.onLoopError("fatal",
                "RR accept 监听套接字失效，退出受理循环 / RR listen socket broken, accept loop exiting");
            return false;
        }
        // rc == -2：瞬时错误，继续受理
        self.host.onLoopError("transient",
            "RR accept 瞬时错误，继续受理 / RR transient accept error");
        return true;
    }

    // 循环体：acceptor 协程入口（监督重启规则同 AcceptLoop）
    func run() {
        while (self.host.loopRunning()) {
            self.host.reapDueHandlers();
            self.host.checkHandlerBudget();
            try {
                if (self.acceptOnce() == false) { return; }
            } catch (e) {
                if (self.host.loopRunning() == false) { return; }   // 主动 stop 不重启
                now = timestamp_ms();
                windowMs = self.host.acceptRestartWindowMs();
                limitN = self.host.acceptRestartLimit();
                if (self.windowStartMs == 0 || now - self.windowStartMs > windowMs) {
                    self.windowStartMs = now;
                    self.restartN = 0;
                }
                self.restartN = self.restartN + 1;
                if (self.restartN > limitN) {
                    self.host.onLoopError("failure",
                        "RR accept 协程异常重启超限（" + limitN + " 次/"
                        + (windowMs / 1000) + "s），停止受理 / RR accept supervisor gave up: "
                        + AcceptLoop.errText(e));
                    return;
                }
                delay = self.host.acceptBackoffInitMs();
                i = 1;
                while (i < self.restartN) { delay = delay * 2; i = i + 1; }
                maxBackoff = self.host.acceptBackoffMaxMs();
                if (delay > maxBackoff) { delay = maxBackoff; }
                self.host.onLoopError("supervise",
                    "RR accept 协程异常退出，" + delay + "ms 后第 " + self.restartN + " 次重启 / RR accept coroutine died, restarting (attempt "
                    + self.restartN + "): " + AcceptLoop.errText(e));
                coSleep(delay);
            }
        }
    }
}

// ============================================================
// ServiceConnectionHandler：单连接处理协程
// 构造即 spawn 协程（state=READY，不立即执行）；start() resume 一次跑到第一个
// yield（recv/send 等待 IO 事件）；协程内 try handleConnection → 兜底 close →
// 自报 markFinished。用户逻辑抛错只影响本协程，不拖垮 reactor。
// destroy() 替代 Thread.join：reactor 退出后强制释放挂起的协程栈。
// ============================================================
class ServiceConnectionHandler {
    app: any;
    conn: any;
    co: any;       // Coroutine 实例
    active: bool;

    func ServiceConnectionHandler(app, conn) {
        self.app = app;
        self.conn = conn;
        self.active = true;
        // 协程入口接 handler 自身为参数，避免闭包捕获歧义
        self.co = Coroutine(func(h) {
            c = h.conn;
            try {
                h.app.handleConnection(c);
            } catch (e) {
                // P0-3：handler 异常计数 + error 日志（原为静默吞掉，排障不可见）。
                // 记账落 owner（单线程 = app / 多线程 = worker，bindOwner 后），
                // 均为本线程本地状态，无跨线程竞态。隔离骨架不变：异常只影响本协程。
                h.app.countHandlerError(e);
            }
            try {
                c.close();
            } catch (e2) { x = 1; }
            h.app.markFinished(h);
        }, self);
    }

    // 启动协程：resume 一次跑到第一个 yield 或结束
    func start() {
        self.co.resume();
    }

    // Phase 7.5 多线程模式：重绑协程的 owner（默认 owner 为 app 自身）。
    // 多 worker 模式下 accept loop 把 owner 重绑为所属 ServiceWorker，
    // 使 markFinished 落到 per-worker 状态（worker 线程本地，无跨线程竞争）；
    // handleConnection 等虚分派由 worker 委托回 app（子类重写仍生效）。
    func bindOwner(owner) {
        self.app = owner;
        return self;
    }

    // 销毁协程（替代 Thread.join）：reactor 退出后清理挂起协程
    func destroy() {
        if (self.co != null) {
            self.co.destroy();
            self.co = null;
        }
    }
}

// ============================================================
// ServiceWorker：多线程模式下的单 worker（Phase 7.5 SO_REUSEPORT）
// 每个 worker 线程独立持有整套 per-thread 状态：
//   reactor + scheduler + SO_REUSEPORT 同端口 listen socket + accept 协程
//   + 连接协程队列（activeHandlers/finishedHandlers/activeCount 线程本地）。
// 内核按连接 5 元组 hash 把新连接分发到各 worker 的 listen socket，
// 连接全程在 accept 它的 worker 线程内处理（协程不跨线程迁移）。
//
// handler owner 鸭子类型：连接协程（ServiceConnectionHandler /
// HttpConnectionHandler）bindOwner(worker) 后调 worker 的
//   handleConnection / dispatchWithFilters / markFinished——
//   前两者委托回 app（虚分派保持，子类重写生效），
//   markFinished 落 worker 本地状态（无跨线程竞争）。
//
// 异常传递：子线程 run 内未捕获异常（如 bind 失败）存 error 字段，
// 主线程 join 时重抛（同 Application.startAsync 的 bgError 模式）。
// ============================================================
class ServiceWorker {
    static REAP_BATCH: int = 16;
    app: any;
    idx: int;
    serverSock: any;
    reactorInst: any;
    scheduler: any;
    acceptCo: any;
    recvCo: any;        // T5 RR 模式：本 worker receiver 协程（消费入站队列）
    rrEnabled: bool;    // T5：本 worker 是否跑 RR 分派（决定是否发布在役负载）
    finishedHandlers: array;
    activeHandlers: array;
    activeCount: int;
    acceptTotal: int;      // 累计 accept 连接数（分布统计，主线程 run 后只读）
    errorCount: int;       // handler 异常计数（P0-3；worker 线程本地，无锁）
    oversizeCount: int;    // P1-5：报文尺寸超限计数（worker 线程本地，无锁）
    // P1-8：handler 执行预算（worker 线程本地，无锁）
    lastForceYield: long;
    lastLongSched: long;
    budgetOverrunCount: long;
    longSchedCount: long;
    stopRequested: bool;
    stopIssued: bool;       // reactor.stop 单次发放（外部 stop 与收尾路径可能重入）
    signalHost: bool;       // G1：信号宿主 worker（多线程模式主线程 worker），
                            // 进入事件循环前安装进程信号处理器
    tid: int;
    error: any;

    func ServiceWorker(app, idx: int) {
        self.app = app;
        self.idx = idx;
        self.serverSock = null;
        self.reactorInst = null;
        self.scheduler = null;
        self.acceptCo = null;
        self.recvCo = null;
        self.rrEnabled = false;
        self.finishedHandlers = [];
        self.activeHandlers = [];
        self.activeCount = 0;
        self.acceptTotal = 0;
        self.errorCount = 0;
        self.oversizeCount = 0;
        self.lastForceYield = 0;
        self.lastLongSched = 0;
        self.budgetOverrunCount = 0;
        self.longSchedCount = 0;
        self.stopRequested = false;
        self.stopIssued = false;
        self.signalHost = false;
        self.tid = 0;
        self.error = null;
    }

    // 子线程入口：完整跑 run 生命周期；异常捕获存 error，join 时主线程重抛
    func startAsync() {
        self.tid = thread(func(w) {
            try {
                w.run();
            } catch (e) {
                w.error = e;
            }
            return 1;
        }, self);
        return self;
    }

    // 等待子线程结束（子线程错误在此重抛）
    func join() {
        if (self.tid > 0) {
            tid = self.tid;
            self.tid = 0;
            thread_join(tid);
            if (self.error != null) {
                e = self.error;
                self.error = null;
                throw e;
            }
        }
        return self;
    }

    // worker 主流程（主线程直接调 / 子线程入口调）：
    //   公共：建 reactor + scheduler（TLS 均为线程本地）→ 按分派模式跑
    //   事件循环 → 退出后统一清理 + 拆 scheduler/reactor。
    //   reuseport（默认）：SO_REUSEPORT 同端口 listen + 本 worker AcceptLoop；
    //   rr（T5）：worker 0 建唯一 listener + RrAcceptLoop 投递，
    //             全部 worker 跑 receiver 协程消费本 reactor 入站队列。
    func run() {
        app = self.app;
        self.reactorInst = ReactorInstance(app.connCapacity());
        setReactor(self.reactorInst);
        self.scheduler = scheduler(self.reactorInst.impl);
        setScheduler(self.scheduler);
        // stop 先于 run 到达（reactor 建立前）：立即停，不进事件循环
        if (self.stopRequested) { self.reactorInst.stop(); }
        // G1：信号宿主 worker（主线程 worker）在进入事件循环前安装信号
        // 处理器——此刻本线程 scheduler TLS 已就位，回调协程可投递回本 reactor
        if (self.signalHost) { app.installSignalHandlers(self.reactorInst); }
        if (app.dispatchMode() == "rr") {
            self.serveRr();
        } else {
            self.serveReusePort();
        }
        // reactor 退出后统一清理：挂起 handler 协程 + scheduler/reactor
        self.reapFinished();
        self.destroyActive();
        // onStop 等价：清 scheduler（TLS + drain 钩子）+ destroy + clearReactor
        if (self.scheduler != null) {
            clearScheduler(self.scheduler);
            destroyScheduler(self.scheduler);
            self.scheduler = null;
        }
        clearReactor();
        if (self.reactorInst != null) {
            self.reactorInst.destroy();
            self.reactorInst = null;
        }
    }

    // reuseport 模式服务体：同端口 listen + 公共 AcceptLoop 跑满事件循环，
    // 退出后销毁 accept 协程 + listen socket。
    private func serveReusePort() {
        app = self.app;
        srv = ServerSocket(app.host(), app.port(), app.backlog(), 1);
        app.applyTls(srv);   // G4：reuseport 每 worker 各持一份 SSL_CTX
        self.serverSock = srv;
        // accept loop 协程：公共 AcceptLoop 收敛（P0-4），错误分类/退避/监督内置
        self.acceptCo = Coroutine(func(w) {
            loop = AcceptLoop(w, w.serverSock);
            loop.run();
        }, self);
        // Phase 8.2：accept loop 钉住本线程（listen fd 挂本 reactor，
        // 防 WSQ 窃取窗口——spawn 后首次 yield 前协程可被窃取）
        coSetPinned(self.acceptCo.impl);
        self.acceptCo.resume();
        self.reactorInst.run();
        if (self.acceptCo != null) {
            self.acceptCo.destroy();
            self.acceptCo = null;
        }
        if (self.serverSock != null) {
            self.serverSock.close();
            self.serverSock = null;
        }
    }

    // T5 RR 模式服务体：
    //   全部 worker：按 idx 注册 reactor（acceptor 启动屏障/投递寻址）+ receiver 协程；
    //   worker 0：额外建唯一 listener（无 reuseport）+ RrAcceptLoop 协程。
    private func serveRr() {
        app = self.app;
        self.rrEnabled = true;
        n = app.workerCount();
        self.reactorInst.registerIdx(self.idx);
        if (self.idx == 0) {
            // 全进程唯一 listener：不设 SO_REUSEPORT
            self.serverSock = ServerSocket(app.host(), app.port(), app.backlog(), 0);
            app.applyTls(self.serverSock);   // G4：单 listener 持 SSL_CTX，随入站消息投递给 worker
        }
        // receiver：所有 worker（含 worker 0）都消费自己 reactor 的入站队列
        self.recvCo = Coroutine(func(w) { w.rrRecvLoop(); }, self);
        coSetPinned(self.recvCo.impl);
        self.recvCo.resume();
        // acceptor 仅 worker 0；registryCount==n 的启动屏障在 C 层/循环内兜底
        if (self.idx == 0) {
            self.acceptCo = Coroutine(func(w) {
                loop = RrAcceptLoop(w, w.serverSock, n);
                loop.run();
            }, self);
            coSetPinned(self.acceptCo.impl);
            self.acceptCo.resume();
        }
        self.reactorInst.run();
        // 退出清理：先取消 receiver 等待登记再销毁协程（避免等待者悬空），
        // 残余入站 fd 由 reactor 销毁路径 drain 关闭（无泄漏）。
        if (self.recvCo != null) {
            self.reactorInst.cancelInboundWait();
            self.recvCo.destroy();
            self.recvCo = null;
        }
        if (self.acceptCo != null) {
            self.acceptCo.destroy();
            self.acceptCo = null;
        }
        if (self.serverSock != null) {
            self.serverSock.close();
            self.serverSock = null;
        }
    }

    // T5 RR receiver 循环：阻塞取本 reactor 入站连接（空则内部 yield），
    // 取到后复用 onAccepted 受理路径（与普通 accept 完全一致）。
    func rrRecvLoop() {
        while (self.loopRunning()) {
            conn = self.reactorInst.recvInbound();
            // stop 到达后取到的残余连接直接关闭（owner 线程 close，符合不变量）
            if (self.loopRunning() == false) {
                try { conn.close(); } catch (e) { x = 1; }
                return;
            }
            self.onAccepted(conn);
        }
    }

    // 停止：置标志位 + reactor.stop 打破事件循环（跨线程调用安全：
    // reactor.stop 走 C 层 stop_flag + self-pipe 唤醒）。
    // 单次发放：外部 ServiceApplication.stop 与 runMultiWorker 收尾会对
    // 同一 worker 各调一次，重入时拆机可能已完成（impl 已空/释放），
    // 第二次直接忽略，杜绝重入报错与释放后访问。
    func stop() {
        self.stopRequested = true;
        if (self.stopIssued) {
            return self;
        }
        self.stopIssued = true;
        if (self.reactorInst != null) {
            self.reactorInst.stop();
        }
        return self;
    }

    // ---- handler owner 鸭子类型接口（bindOwner 后连接协程调这里）----
    // 业务分派委托回 app（虚分派保持，子类重写生效）；
    // 状态回收落 worker 本地（worker 线程单线程访问，无锁）。

    // ---- AcceptLoopHost 实现（accept 协程宿主，worker 线程本地状态）----

    // 判停：app 停机或本 worker 被单独 stop 均退出受理循环
    func loopRunning(): bool {
        if (self.stopRequested) { return false; }
        return self.app.running;
    }

    // accept 监督参数：worker 不持配置，统一委托 app（配置单点生效）
    func acceptBackoffInitMs(): int {
        return self.app.acceptBackoffInitMs();
    }

    func acceptBackoffMaxMs(): int {
        return self.app.acceptBackoffMaxMs();
    }

    func acceptRestartLimit(): int {
        return self.app.acceptRestartLimit();
    }

    func acceptRestartWindowMs(): int {
        return self.app.acceptRestartWindowMs();
    }

    // 已受理连接的入队与启动（原内联循环体逻辑，per-worker 限制）
    func onAccepted(conn) {
        a = self.app;
        // 并发上限保护：多线程模式下 maxConnections 为 per-worker 限制
        if (a.maxConnections > 0 && self.activeCount >= a.maxConnections) {
            // RR 下 C 层 reserved 门控已保证几乎不可达；万一因竞态拒收，
            // 立即校准本 worker 的 reserved（active+pending），防计数虚高。
            if (self.rrEnabled && self.reactorInst != null) {
                self.reactorInst.publishLoad(self.activeCount);
            }
            a.onRejectConnection(conn);
            return;
        }
        h = a.createHandler(conn);
        h.bindOwner(self);
        self.activeHandlers.add(h);
        self.activeCount = self.activeCount + 1;
        self.acceptTotal = self.acceptTotal + 1;
        // T5 RR：发布最新在役数，acceptor 据此负载感知跳过本 worker
        if (self.rrEnabled) { self.reactorInst.publishLoad(self.activeCount); }
        h.start();
    }

    // accept 循环异常统一挂钩：warn 级（资源耗尽退避/监督重启）、error 级（瞬时/致命）
    func onLoopError(kind: string, msg: string) {
        if (kind == "transient" || kind == "exhausted" || kind == "supervise") {
            print("[lumyr-app][warn] " + msg);
            return;
        }
        print("[lumyr-app][error] " + msg);
    }

    // handler 异常记账（P0-3）：worker 线程本地计数 + error 日志（无锁）
    func countHandlerError(e) {
        self.errorCount = self.errorCount + 1;
        msg = "handler 异常";
        if (type(e) == "string") { msg = msg + "：" + e; }
        else { msg = msg + "：" + e.getMessage(); }
        print("[lumyr-app][error] " + msg + "（worker " + self.idx + " 累计 " + self.errorCount + "）/ handler error (worker " + self.idx + " total " + self.errorCount + ")");
    }

    // P1-5：报文尺寸超限记账（worker 线程本地计数 + warn 日志，无锁）
    func countOversize(kind: string) {
        self.oversizeCount = self.oversizeCount + 1;
        name = "header";
        if (kind == "body") { name = "body"; }
        print("[lumyr-app][warn] 报文尺寸超限（worker " + self.idx + " " + name
            + "，累计 " + self.oversizeCount + "）/ message size exceeded (worker "
            + self.idx + " " + name + ", total " + self.oversizeCount + ")");
    }

    // P1-6：accept 限速平滑档（worker 版，逻辑同 ServiceApplication）。
    // 有效上限 = app.maxConnections>0 时 min(app.maxConnections, app.connCapacity)，
    // 否则 app.connCapacity；空闲槽不足总量 1/8 时让位（active > limit - limit/8）。
    func acceptThrottleMs(): int {
        cap = self.app.connCapacity();
        mc = self.app.maxConnections;
        limit = cap;
        if (mc > 0 && mc < limit) { limit = mc; }
        threshold = limit - limit / 8;
        if (self.activeCount > threshold) { return 10; }
        return 0;
    }

    // 硬上限排队闸门（worker 版）：activeCount 为 per-worker 在役数，
    // 容量配置统一读 app（acceptQueue/maxConnections/connCapacity）。
    func acceptGateMs(): int {
        if (!self.app.acceptQueueEnabled()) { return -1; }
        cap = self.app.connCapacity();
        mc = self.app.maxConnections;
        limit = cap;
        if (mc > 0 && mc < limit) { limit = mc; }
        if (self.activeCount >= limit) { return 2; }
        return -1;
    }

    // P1-8：handler 执行预算检查（worker 版，逻辑同 ServiceApplication）
    func checkHandlerBudget() {
        curForce = SchedStats.forceYield();
        if (curForce > self.lastForceYield) {
            self.budgetOverrunCount = self.budgetOverrunCount + (curForce - self.lastForceYield);
            print("[lumyr-app][warn] handler 执行预算超限（worker " + self.idx
                + " forceYield 累计 " + self.budgetOverrunCount + "）/ handler budget overrun: worker "
                + self.idx + " forceYield=" + self.budgetOverrunCount);
        }
        self.lastForceYield = curForce;
        curLong = SchedStats.longSched();
        if (curLong > self.lastLongSched) {
            self.longSchedCount = self.longSchedCount + (curLong - self.lastLongSched);
            print("[lumyr-app][warn] 长调度告警（worker " + self.idx + " longSched 累计 "
                + self.longSchedCount + "）/ long schedule alert: worker " + self.idx
                + " longSched=" + self.longSchedCount);
        }
        self.lastLongSched = curLong;
    }

    func handleConnection(conn) {
        return self.app.handleConnection(conn);
    }

    // 仅 WebApplication 的 HttpConnectionHandler 会调（ServiceApplication
    // 自身的 handler 只走 handleConnection/markFinished）
    func dispatchWithFilters(req) {
        return self.app.dispatchWithFilters(req);
    }

    // 连接协程完成回调：标记挂起待回收（worker 线程本地，无锁）
    func markFinished(h) {
        h.active = false;
        self.finishedHandlers.add(h);
        self.activeCount = self.activeCount - 1;
        // T5 RR：在役下降立即发布，全满反压期间 acceptor 可尽快恢复投递
        if (self.rrEnabled && self.reactorInst != null) {
            self.reactorInst.publishLoad(self.activeCount);
        }
    }

    // 回收已完成的连接协程（run 退出时调用，destroy 释放协程栈）
    private func reapFinished() {
        done = self.finishedHandlers;
        self.finishedHandlers = [];
        still = [];
        for h in self.activeHandlers {
            if (h.active) { still.add(h); }
        }
        self.activeHandlers = still;
        for h in done { h.destroy(); }
    }

    // 运行期增量回收（AcceptLoop 每轮调用）：攒够一批再统一 destroy，
    // 避免每个连接结束都重建 activeHandlers 数组。
    func reapDueHandlers() {
        if (self.finishedHandlers.len >= ServiceWorker.REAP_BATCH) {
            self.reapFinished();
        }
    }

    // run 退出时 destroy 所有在役连接协程（挂起在 IO yield 的协程强制释放）
    private func destroyActive() {
        all = self.activeHandlers;
        self.activeHandlers = [];
        self.activeCount = 0;
        for h in all { h.destroy(); }
    }
}

// 通用 TCP 服务应用基类
public class ServiceApplication extends Application {
    static REAP_BATCH: int = 16;  // 运行期增量回收阈值：累计完成 16 个连接协程即批量 destroy
    serverSock: any;
    reactor: any;        // ReactorInstance
    scheduler: any;      // Phase 7.2：per-thread scheduler（绑定 reactor + 就绪队列）
    acceptCo: any;       // accept loop 协程（Coroutine 实例）
    hostVal: string;
    portVal: int;
    backlogVal: int;
    finishedHandlers: array;
    activeHandlers: array;
    target: any;
    maxConnections: int;   // 并发连接上限（0 = 不限）
    activeCount: int;      // 在役连接协程计数
    errorCount: int;       // handler 异常计数（P0-3；reactor 主线程本地，无锁）
    oversizeCount: int;    // P1-5：报文尺寸超限计数（主线程本地，无锁）
    // P1-8：handler 执行预算（全局 forceYield/longSched 采样差值，无锁单线程访问）
    lastForceYield: long;
    lastLongSched: long;
    budgetOverrunCount: long;
    longSchedCount: long;
    workerCountVal: int;   // Phase 7.5：worker 线程数（0 = 未设置，走配置/默认 1）
    workerList: any;       // Phase 7.5：多线程模式下的 ServiceWorker 数组（null = 单线程）
    connCapacityVal: int;  // Phase 7.6：reactor 连接池容量（0 = 未设置，走配置/自动对齐）
    // Task 7：自动对齐结果惰性缓存（onStart 先于 run 预算执行，且多 worker
    // 各调一次 connCapacity——缓存保证只探测/告警一次）
    autoCapVal: int;
    autoCapResolved: bool;
    // 硬上限排队模式（0 = 未设置走配置/默认 false；1 = 开；-1 = 关）。
    // 开启后在役达 maxConnections 不 reject，而是暂停 accept 让连接在 backlog 排队。
    acceptQueueVal: int;
    // T5：新连接分派模式（"" = 未设置，走配置表键 dispatch / 默认 reuseport）。
    //   "reuseport"：每 worker 同端口 listen，内核 hash 分发（默认，行为不变）；
    //   "rr"：worker 0 单 listener accept，按 worker 在役负载 RR 应用层分派。
    dispatchVal: string;
    // accept 监督参数（0 = 未设置，走配置键/内置默认；对标 OTP supervisor/
    // systemd StartLimit）。AcceptLoop/RrAcceptLoop 经 AcceptLoopHost 读取。
    acceptBackoffInitVal: int;
    acceptBackoffMaxVal: int;
    acceptRestartLimitVal: int;
    acceptRestartWindowVal: int;
    // G1：信号优雅退出（信号表 + self-pipe，回调协程派发）
    signalWatched: bool;   // 信号处理器是否已安装（onStop 还原）
    signalHooks: any;      // 回调闭包持有数组（GC 根：C 侧表仅存值拷贝）
    // G4：TLS 证书链与私钥路径（PEM；"" = 未设置，走配置表键 tlsCert/tlsKey，
    // 均空 = 明文 HTTP；非空 = HTTPS，accept 连接自动握手）
    tlsCertVal: string;
    tlsKeyVal: string;

    func ServiceApplication() {
        super();
        self.initServiceFields();
    }

    // 单参构造：int 为端口；string 为配置文件路径（立即加载）；map 为配置表；
    // 其余对象/func 当作连接处理器（ServiceHandler）
    // （构造器重载仅按参数个数选择，无法按参数类型区分，故合并为一个构造器）
    func ServiceApplication(first) {
        super();
        self.initServiceFields();
        t = type(first);
        if (t == "int") { self.portVal = first; }
        else if (t == "string") { self.loadConfig(first); }
        else if (t == "map") { self.loadConfigMap(first); }
        else { self.target = first; }
    }

    // 双参构造：监听地址 + 端口
    func ServiceApplication(host: string, port: int) {
        super();
        self.initServiceFields();
        self.hostVal = host;
        self.portVal = port;
    }

    // 三参构造：监听地址 + 端口 + 连接处理器
    func ServiceApplication(host: string, pos: int, handler) {
        super();
        self.initServiceFields();
        self.hostVal = host;
        self.portVal = pos;
        self.target = handler;
    }

    // 编程式设置连接处理器（配合单参端口构造：ServiceApplication(port).setHandler(h)）
    func setHandler(handler) {
        self.target = handler;
        return self;
    }

    private func initServiceFields() {
        self.serverSock = null;
        self.reactor = null;
        self.scheduler = null;
        self.acceptCo = null;
        self.hostVal = "";
        self.portVal = 0;
        self.backlogVal = 0;
        self.finishedHandlers = [];
        self.activeHandlers = [];
        self.target = null;
        self.maxConnections = 0;
        self.activeCount = 0;
        self.errorCount = 0;
        self.oversizeCount = 0;
        self.lastForceYield = 0;
        self.lastLongSched = 0;
        self.budgetOverrunCount = 0;
        self.longSchedCount = 0;
        self.workerCountVal = 0;
        self.workerList = null;
        self.connCapacityVal = 0;
        self.autoCapVal = 0;
        self.autoCapResolved = false;
        self.acceptQueueVal = 0;
        self.dispatchVal = "";
        self.acceptBackoffInitVal = 0;
        self.acceptBackoffMaxVal = 0;
        self.acceptRestartLimitVal = 0;
        self.acceptRestartWindowVal = 0;
        self.signalWatched = false;
        self.signalHooks = [];
        self.tlsCertVal = "";
        self.tlsKeyVal = "";
    }

    // ---- 生效配置（构造参数优先，其次配置文件，最后内置默认）----

    func host(): string {
        if (self.hostVal != "") { return self.hostVal; }
        return self.configString("host", "0.0.0.0");
    }

    func port(): int {
        if (self.portVal > 0) { return self.portVal; }
        return self.configInt("port", 8080);
    }

    func backlog(): int {
        if (self.backlogVal > 0) { return self.backlogVal; }
        return self.configInt("backlog", 128);
    }

    // ---- G4：TLS 配置（编程式优先，其次配置表 tlsCert/tlsKey，默认明文）----

    func tlsCert(): string {
        if (self.tlsCertVal != "") { return self.tlsCertVal; }
        return self.configString("tlsCert", "");
    }

    func tlsKey(): string {
        if (self.tlsKeyVal != "") { return self.tlsKeyVal; }
        return self.configString("tlsKey", "");
    }

    // 是否启用 TLS（证书与私钥路径都配置才生效；只配一个视为配置错误，
    // 在 listener 创建时由 C 层双语报错，这里不静默降级）
    func tlsEnabled(): bool {
        return self.tlsCert() != "" && self.tlsKey() != "";
    }

    // 编程式启用 HTTPS：PEM 证书链路径 + PEM 私钥路径（最低 TLS1.2）。
    // 必须在 start/startAsync 前调用；reuseport 每 worker、rr 单 listener
    // 的三条建 listener 路径统一在创建后挂载。
    func setTls(certPath: string, keyPath: string) {
        self.tlsCertVal = certPath;
        self.tlsKeyVal = keyPath;
        return self;
    }

    // listener 创建后统一挂载点（reuseport/rr/单线程三处调用，避免漏挂）。
    // 包内方法：ServiceWorker 建 listener 后经 app 引用回调，不对外承诺 API。
    func applyTls(srv) {
        if (self.tlsEnabled()) {
            srv.enableTls(self.tlsCert(), self.tlsKey());
        }
    }

    // 设置并发连接上限：在役连接数达到上限后，新连接交 onRejectConnection
    // 处理（默认直接关闭，HTTP 应用重写为 503 响应）。0 = 不限（默认）。
    func setMaxConnections(max: int) {
        if (max < 0) {
            throw "连接上限不能为负 / max connections must not be negative";
        }
        self.maxConnections = max;
        return self;
    }

    // 硬上限排队模式：开启（默认关闭，保持超限即 reject 的既有语义）后，
    // 在役连接达到 maxConnections 时不再受理新连接（不 reject），连接留在内核
    // listen 全连接队列（backlog）排队，在役连接排空后自动补入；TCP 流控对
    // 排队客户端自然反压。要求 backlog ≥ 预期排队峰值，否则超出部分被内核丢弃。
    // 配置表键：acceptQueue（bool）；编程式设置优先于配置表。
    func setAcceptQueue(q: bool) {
        if (q) { self.acceptQueueVal = 1; }
        else { self.acceptQueueVal = -1; }
        return self;
    }

    // 排队模式是否生效（编程式优先，其次配置表，默认关）
    func acceptQueueEnabled(): bool {
        if (self.acceptQueueVal != 0) { return self.acceptQueueVal == 1; }
        if (self.configMap != null && self.configMap.contains("acceptQueue")) {
            v = self.configMap["acceptQueue"];
            if (type(v) == "bool") { return v; }
        }
        return false;
    }

    // ---- Phase 7.5：多线程模式（SO_REUSEPORT 同端口多 reactor）----
    // worker 线程数：1 = 单线程（默认，既有行为）；>1 时 n-1 个子线程 +
    // 主线程各跑一个 ServiceWorker，各自独立 reactor + scheduler +
    // SO_REUSEPORT 同端口 listen，内核按连接 hash 分发到各 worker。
    // 注意：多线程模式下 maxConnections 为 per-worker 限制。
    func workerCount(): int {
        if (self.workerCountVal > 0) { return self.workerCountVal; }
        return self.configInt("workers", 1);
    }

    // 编程式设置 worker 线程数（须在 start 前调用）
    func setWorkers(n: int) {
        if (n < 1) {
            throw "worker 线程数必须 ≥ 1 / worker count must be at least 1";
        }
        self.workerCountVal = n;
        return self;
    }

    // ---- T5：新连接分派模式（workers > 1 时生效）----
    // "reuseport"（默认）：n 个 worker 各自 SO_REUSEPORT 同端口 listen，
    //   内核 hash 分发，既有行为完全不变；
    // "rr"：worker 0 单 listener 做 acceptor，按各 worker 在役连接数/入站
    //   队列水位负载感知 RR 应用层分派（全满不 accept，连接留 backlog 反压）。
    // workers=1 时无分派差异，rr 配置不生效（走单线程直连路径）。
    // 配置表键 dispatch（string）；编程式设置优先。
    func setDispatch(mode: string) {
        if (mode != "reuseport" && mode != "rr") {
            throw "未知分派模式：" + mode + "（仅支持 reuseport / rr） / unknown dispatch mode: "
                + mode + " (expected reuseport or rr)";
        }
        self.dispatchVal = mode;
        return self;
    }

    // 当前生效分派模式（编程式优先，其次配置表，默认 reuseport）
    func dispatchMode(): string {
        if (self.dispatchVal != "") { return self.dispatchVal; }
        m = self.configString("dispatch", "reuseport");
        if (m != "reuseport" && m != "rr") {
            print("[lumyr-app][warn] 未知分派模式配置：" + m + "，回退 reuseport / unknown dispatch config: "
                + m + ", falling back to reuseport");
            return "reuseport";
        }
        return m;
    }

    // ---- accept 监督参数（对标 OTP supervisor / systemd StartLimit）----
    // 优先级同为 setter > 配置表 > 内置默认；配置值非法（<1）时双语 warn
    // 并回退默认，杜绝退避 0 导致 accept 循环空转、监督限次 0 即放弃受理。

    // 资源耗尽/异常重启指数退避起步毫秒（默认 200，×2 递增）
    func acceptBackoffInitMs(): int {
        if (self.acceptBackoffInitVal > 0) { return self.acceptBackoffInitVal; }
        v = self.configInt("acceptBackoffInitMs", AcceptLoop.BACKOFF_INIT_MS);
        if (v < 1) {
            self.warnInvalidAcceptTuning("acceptBackoffInitMs", v, AcceptLoop.BACKOFF_INIT_MS);
            return AcceptLoop.BACKOFF_INIT_MS;
        }
        return v;
    }

    func setAcceptBackoffInitMs(ms: int) {
        if (ms < 1) {
            throw "accept 退避起步必须 ≥ 1 毫秒 / accept backoff init must be at least 1ms";
        }
        self.acceptBackoffInitVal = ms;
        return self;
    }

    // 退避封顶毫秒（默认 5000）
    func acceptBackoffMaxMs(): int {
        if (self.acceptBackoffMaxVal > 0) { return self.acceptBackoffMaxVal; }
        v = self.configInt("acceptBackoffMaxMs", AcceptLoop.BACKOFF_MAX_MS);
        if (v < 1) {
            self.warnInvalidAcceptTuning("acceptBackoffMaxMs", v, AcceptLoop.BACKOFF_MAX_MS);
            return AcceptLoop.BACKOFF_MAX_MS;
        }
        return v;
    }

    func setAcceptBackoffMaxMs(ms: int) {
        if (ms < 1) {
            throw "accept 退避封顶必须 ≥ 1 毫秒 / accept backoff max must be at least 1ms";
        }
        self.acceptBackoffMaxVal = ms;
        return self;
    }

    // 监督窗口内最大重启次数（默认 5，超限停止受理）
    func acceptRestartLimit(): int {
        if (self.acceptRestartLimitVal > 0) { return self.acceptRestartLimitVal; }
        v = self.configInt("acceptRestartLimit", AcceptLoop.RESTART_LIMIT);
        if (v < 1) {
            self.warnInvalidAcceptTuning("acceptRestartLimit", v, AcceptLoop.RESTART_LIMIT);
            return AcceptLoop.RESTART_LIMIT;
        }
        return v;
    }

    func setAcceptRestartLimit(n: int) {
        if (n < 1) {
            throw "accept 监督重启次数必须 ≥ 1 / accept restart limit must be at least 1";
        }
        self.acceptRestartLimitVal = n;
        return self;
    }

    // 监督窗口毫秒数（默认 60000）
    func acceptRestartWindowMs(): int {
        if (self.acceptRestartWindowVal > 0) { return self.acceptRestartWindowVal; }
        v = self.configInt("acceptRestartWindowMs", AcceptLoop.RESTART_WINDOW_MS);
        if (v < 1) {
            self.warnInvalidAcceptTuning("acceptRestartWindowMs", v, AcceptLoop.RESTART_WINDOW_MS);
            return AcceptLoop.RESTART_WINDOW_MS;
        }
        return v;
    }

    func setAcceptRestartWindowMs(ms: int) {
        if (ms < 1) {
            throw "accept 监督窗口必须 ≥ 1 毫秒 / accept restart window must be at least 1ms";
        }
        self.acceptRestartWindowVal = ms;
        return self;
    }

    // accept 监督参数非法值统一告警（纯文案挂钩，便于双语齐全）
    func warnInvalidAcceptTuning(key: string, v: int, fallback: int) {
        print("[lumyr-app][warn] 配置 " + key + " 非法（" + v + "），回退默认 " + fallback
            + " / invalid " + key + " (" + v + "), falling back to " + fallback);
    }

    // ---- Task 7：connCapacity 自动对齐 fd rlimit ----
    // 常量（公式见
    // .trae/specs/concurrency-hardening/concurrency-model-research.md §10.2）：
    //   65536 自动对齐上限（=历史默认，自动对齐只往下收，不放大预分配）
    //   256   fd 安全余量（stdio/listen/kqueue/self-pipe/日志文件/出站 fd）
    //   1024  探测失败/平台不支持时的保守回退值
    //   64    极低 rlimit 下的最小可用池容量
    // 纯函数：由 fd 软上限推导 per-worker 连接池容量（抽成静态便于单测注入）。
    //   fdLimit >0：min(65536, fdLimit-256)；减余量后不足 64 时
    //              改 min(64, max(1, fdLimit-8)) 保底（reactor 容量 ≤0
    //              会被 C 层重置为 65536，必须显式给出 ≥1 值）
    //   fdLimit == -2：RLIM_INFINITY 无上限 → 65536
    //   fdLimit == -1：探测失败/平台不支持 → 1024（调用方双语告警）
    static func calcAutoConnCapacity(fdLimit: int): int {
        if (fdLimit == -2) { return 65536; }
        if (fdLimit <= 0) { return 1024; }
        budget = fdLimit - 256;
        if (budget < 64) {
            // 极低 rlimit：只留 8 个应急 fd，池容量封顶 64、保底 1
            budget = fdLimit - 8;
            if (budget < 1) { budget = 1; }
            if (budget > 64) { budget = 64; }
        }
        if (budget > 65536) { budget = 65536; }
        return budget;
    }

    // 探测失败双语告警文案（纯函数，便于单测断言双语齐全）
    static func fdLimitWarnMsg(fdLimit: int): string {
        return "无法确定系统 fd 上限（探测返回 " + fdLimit
            + "），连接池容量回退保守默认 1024，建议显式配置 connCapacity 或调高 ulimit -n / "
            + "cannot determine system fd limit (probe returned " + fdLimit
            + "), connection pool capacity falls back to conservative 1024; "
            + "set connCapacity explicitly or raise ulimit -n";
    }

    // ---- Phase 7.6 + Task 7：reactor 连接池容量（connCapacity）----
    // 资源容量语义（区别于 maxConnections 业务限流）：reactor 连接池按 fd
    // 索引预分配，决定可跟踪的最大 fd 数；fd 超出容量时新连接被直接拒绝。
    // 取值优先级：编程式 setConnCapacity > 配置表键 connCapacity（均为用户
    // 显式意图）> Task 7 自动对齐 per-worker = min(fd软上限-256, 65536)；
    // 探测失败回退 1024 并双语告警。多线程模式下为 per-worker 容量。
    func connCapacity(): int {
        // 显式优先①：编程式 setConnCapacity
        if (self.connCapacityVal > 0) { return self.connCapacityVal; }
        // 显式优先②：配置表键（配置文件也是用户显式意图）
        if (self.config("connCapacity") != null) {
            return self.configInt("connCapacity", 65536);
        }
        // 自动对齐（惰性缓存：onStart 先于 run 预算执行；多 worker 共享一次探测）
        if (self.autoCapResolved) { return self.autoCapVal; }
        fdLimit = __private_system__fd_limit();
        cap = ServiceApplication.calcAutoConnCapacity(fdLimit);
        self.autoCapVal = cap;
        self.autoCapResolved = true;
        if (fdLimit == -2) {
            print("[lumyr-app] connCapacity 自动对齐：fd 无上限，per-worker 连接池容量取上限 "
                + cap + " / connCapacity auto-aligned: fd unlimited, per-worker pool cap=" + cap);
        } else if (fdLimit <= 0) {
            print("[lumyr-app][warn] " + ServiceApplication.fdLimitWarnMsg(fdLimit));
        } else {
            // 实际预留 = 软上限 - 取值（常规 256；极低 rlimit 保底路径为 8）
            print("[lumyr-app] connCapacity 自动对齐：fd 软上限 " + fdLimit
                + "，per-worker 连接池容量 " + cap + "（预留 " + (fdLimit - cap)
                + " 个 fd）/ connCapacity auto-aligned: fd soft limit " + fdLimit
                + ", per-worker pool cap " + cap + " (" + (fdLimit - cap)
                + " fds reserved)");
        }
        return cap;
    }

    // 编程式设置 reactor 连接池容量（须在 start 前调用）
    func setConnCapacity(n: int) {
        if (n < 1) {
            throw "连接池容量必须 ≥ 1 / connection pool capacity must be at least 1";
        }
        self.connCapacityVal = n;
        return self;
    }

    // P1-7：fd 预算自检（run 入口调用，reactor 建立前）。
    // 比对连接池容量与系统 fd 软上限（R2 __private_system__fd_limit）：
    // 容量超过 fd 上限时双语 warn——实际可跟踪连接数受限于 fd 上限，
    // 建议调高 ulimit -n 或调小 connCapacity。fdLimit=-1（无上限/不支持）跳过。
    func checkFdBudget() {
        cap = self.connCapacity();
        fdLimit = __private_system__fd_limit();
        if (fdLimit > 0 && cap > fdLimit) {
            print("[lumyr-app][warn] 连接池容量 " + cap + " 超过系统 fd 上限 " + fdLimit
                + "，实际可跟踪连接数受限于 fd 上限，建议调高 ulimit -n 或调小 connCapacity / "
                + "connection pool capacity " + cap + " exceeds system fd limit " + fdLimit);
        }
    }

    // ---- 连接处理（核心扩展点，连接协程内调用）----
    // 默认：挂有 target 处理器时执行——func 直接调用，
    // ServiceHandler 对象调 serve；无 target 为空操作（连接随即关闭）。
    // 子类可重写实现自己的连接逻辑。
    func handleConnection(conn) {
        h = self.target;
        if (h != null) {
            if (type(h) == "func") { return h(conn); }
            return h.serve(conn);
        }
    }

    // 连接处理器工厂：accept loop 协程每接受一个连接调一次。
    // 子类（如 WebApplication）重写以换入协议专属的连接协程。
    func createHandler(conn) {
        return ServiceConnectionHandler(self, conn);
    }

    // 并发超限拒绝钩子（accept loop 内调用）：默认 TCP 层直接关闭；
    // 协议子类（如 WebApplication）重写为明确的协议层拒绝（HTTP 503）。
    func onRejectConnection(conn) {
        conn.close();
        return self;
    }

    // ---- 生命周期钩子 ----

    // ---- G1：信号优雅退出 ----
    // 信号表 + self-pipe：SIGTERM/SIGINT/SIGHUP 处理器仅写管道（async-signal-
    // safe），读端挂信号宿主 reactor 事件循环，触发时回调在宿主线程协程内执行。
    // 默认映射：TERM/INT → 优雅停机（stop：停受理 + 排空在役连接 + join）；
    // HUP 仅通知（重载等语义由子类重写 onSignal 实现）。

    // 信号钩子：收到已监视信号时调用（宿主 reactor 线程协程内）。
    // 返回 true 表示已处理（抑制默认行为）；false 走默认映射。
    func onSignal(name: string): bool {
        return false;
    }

    // 安装信号处理器（幂等）。须在信号宿主 reactor 的 owner 线程、进入事件
    // 循环前调用（单线程模式 = 主线程 reactor；多线程模式 = 主线程 worker）。
    // 闭包由 signalHooks 数组持有（GC 根），C 侧表仅存值拷贝。
    func installSignalHandlers(r) {
        if (self.signalWatched) { return; }
        self.signalWatched = true;
        names = ["TERM", "INT", "HUP"];
        for name in names {
            cb = func(n) { self.onSignalDispatch(n); };
            self.signalHooks.add(cb);
            r.watchSignal(name, cb);
        }
    }

    // 信号派发（宿主 reactor 线程协程内）：先走 onSignal 钩子（异常记 error
    // 日志，不中断停机流程），未处理且为 TERM/INT 时默认优雅停机。
    // stop 跨线程安全（reactor.stop 走 stop_flag + self-pipe），宿主线程内
    // 调用同样成立：置位后事件循环下一轮顶部退出。
    func onSignalDispatch(name: string) {
        handled = false;
        try {
            handled = self.onSignal(name);
        } catch (e) {
            print("[lumyr-app][error] onSignal 钩子异常（" + name + "）/ onSignal hook error (" + name + ")");
        }
        if (handled) { return; }
        if (name == "TERM" || name == "INT") {
            self.stop();
        }
    }

    // onStart：创建 reactor + setReactor（socket API 协程化的全局开关）
    //         + Phase 7.2：创建 scheduler 绑定 reactor，置当前线程 TLS + drain 钩子。
    //         scheduler 使 spawn 后的协程自动入就绪队列，由 reactor 主循环每轮
    //         drain_ready 消费 resume（不再需业务层显式 resume）。
    func onStart() {
        // 多线程模式：reactor/scheduler 由各 worker 线程自建自拆（TLS 线程本地），
        // app 层不持有全局 reactor
        if (self.workerCount() > 1) { return; }
        self.reactor = ReactorInstance(self.connCapacity());
        setReactor(self.reactor);
        // Phase 7.2：创建 scheduler 绑定 reactor，置 TLS + drain 钩子。
        // spawn 后协程自动入就绪队列，reactor 主循环每轮 drain_ready 消费 resume。
        self.scheduler = scheduler(self.reactor.impl);
        setScheduler(self.scheduler);
    }

    // onStop：还原信号处理（G1：须在 reactor 事件循环退出后）+ 清 scheduler
    //（TLS + drain 钩子）+ destroy + clearReactor + reactor.destroy
    func onStop() {
        // G1：信号还原为默认（SIG_DFL）+ 关信号管道——单/多线程模式收尾
        // 均在主线程且宿主 reactor 事件循环已退出（start 生命周期保证）
        if (self.signalWatched) {
            restoreSignals();
            self.signalWatched = false;
            self.signalHooks = [];
        }
        // 多线程模式：worker 各自已拆 reactor/scheduler；workerList 引用保留
        // （run 结束后可读取各 worker 的 acceptTotal 分布统计）
        if (self.workerList != null) { return; }
        if (self.scheduler != null) {
            clearScheduler(self.scheduler);
            destroyScheduler(self.scheduler);
            self.scheduler = null;
        }
        clearReactor();
        if (self.reactor != null) {
            self.reactor.destroy();
            self.reactor = null;
        }
    }

    // ---- 应用主循环（start 生命周期内执行，阻塞至 stop）----
    // 创建 listen socket → spawn accept loop 协程 → 进入 reactor 事件循环
    // → reactor 退出后清理 accept 协程 + 挂起 handler 协程 + listen socket
    func run() {
        // P1-7：fd 预算自检（单/多线程均在 reactor 建立前校验）
        self.checkFdBudget();
        // Phase 7.5：多线程模式分派（workerCount > 1 走 SO_REUSEPORT 多 reactor）
        if (self.workerCount() > 1) {
            self.runMultiWorker(self.workerCount());
            return;
        }
        srv = ServerSocket(self.host(), self.port(), self.backlog());
        self.applyTls(srv);   // G4：单线程模式挂载 TLS
        self.serverSock = srv;
        // accept loop 协程：公共 AcceptLoop 收敛（P0-4），错误分类/退避/监督内置
        self.acceptCo = Coroutine(func(app) {
            loop = AcceptLoop(app, app.serverSock);
            loop.run();
        }, self);
        // Phase 8.2：accept loop 钉住本线程（同 ServiceWorker 处说明）
        coSetPinned(self.acceptCo.impl);
        self.acceptCo.resume();  // 启动协程跑到第一个 yield（accept 等读事件）
        // G1：安装信号处理器（主线程 = 信号宿主；TERM/INT 默认优雅停机）
        self.installSignalHandlers(self.reactor);
        // 进入 reactor 事件循环（阻塞至 stop）
        self.reactor.run();
        // reactor 退出后清理：accept 协程 + 挂起 handler 协程 + listen socket
        if (self.acceptCo != null) {
            self.acceptCo.destroy();
            self.acceptCo = null;
        }
        if (self.serverSock != null) {
            self.serverSock.close();
            self.serverSock = null;
        }
        self.reapFinished();
        self.destroyActive();
    }

    // ---- Phase 7.5：多线程主循环 ----
    // n-1 个子线程 + 主线程各跑一个 ServiceWorker（各自 SO_REUSEPORT 同端口
    // listen）。主线程跑最后一个 worker 并阻塞；主 worker 退出（stop 或异常）
    // 后停掉所有子 worker 并 join（子线程错误随 join 重抛）。
    private func runMultiWorker(n: int) {
        workers = [];
        i = 0;
        while (i < n) {
            workers.add(ServiceWorker(self, i));
            i = i + 1;
        }
        self.workerList = workers;
        // G1：主线程 worker 为信号宿主（回调协程在主线程事件循环跑，
        // stop 可跨线程停全部 worker）
        workers[n - 1].signalHost = true;
        // 先启动子 worker 线程（前 n-1 个）
        i = 0;
        while (i < n - 1) {
            workers[i].startAsync();
            i = i + 1;
        }
        // 主线程跑最后一个 worker（阻塞至 stop）
        err = null;
        try {
            workers[n - 1].run();
        } catch (e) {
            err = e;
        }
        // 主 worker 退出后：停所有子 worker（幂等，已停的 reactor.stop 无害）
        i = 0;
        while (i < n - 1) {
            workers[i].stop();
            i = i + 1;
        }
        // join 收子线程；子线程错误在主流程无错时抛出（不覆盖主错误）
        i = 0;
        while (i < n - 1) {
            try {
                workers[i].join();
            } catch (e2) {
                if (err == null) { err = e2; }
            }
            i = i + 1;
        }
        if (err != null) { throw err; }
    }

    // 停止：置标志位 + reactor.stop 打破事件循环（无需自连唤醒）。
    // 监听 socket 由 run 退出循环后自行关闭（避免跨线程 close 竞态）。
    func stop() {
        super.stop();
        // 多线程模式：停所有 worker 的 reactor（worker.reactor 建立前
        // stop 先到时由 worker.run 内的 stopRequested 检查兜底）
        if (self.workerList != null) {
            for w in self.workerList { w.stop(); }
        }
        if (self.reactor != null) {
            self.reactor.stop();
        }
        return self;
    }

    // ---- 连接协程管理（reactor 主线程内，无锁）----

    // ---- AcceptLoopHost 实现（accept 协程宿主，单线程模式）----

    // 判停：stop 后退出受理循环（super.stop 置 running=false）
    func loopRunning(): bool {
        return self.running;
    }

    // 已受理连接的入队与启动（原内联循环体逻辑）
    func onAccepted(conn) {
        // 并发上限保护：在役连接数已达上限 → 拒绝新连接
        // （不启协程，防止慢客户端/攻击耗尽协程资源）
        if (self.maxConnections > 0 && self.activeCount >= self.maxConnections) {
            self.onRejectConnection(conn);
            return;
        }
        h = self.createHandler(conn);
        self.activeHandlers.add(h);
        self.activeCount = self.activeCount + 1;
        h.start();
    }

    // accept 循环异常统一挂钩：warn 级（资源耗尽退避/监督重启）、error 级（瞬时/致命）
    func onLoopError(kind: string, msg: string) {
        if (kind == "transient" || kind == "exhausted" || kind == "supervise") {
            print("[lumyr-app][warn] " + msg);
            return;
        }
        print("[lumyr-app][error] " + msg);
    }

    // handler 异常记账（P0-3）：主线程本地计数 + error 日志（无锁）
    func countHandlerError(e) {
        self.errorCount = self.errorCount + 1;
        msg = "handler 异常";
        if (type(e) == "string") { msg = msg + "：" + e; }
        else { msg = msg + "：" + e.getMessage(); }
        print("[lumyr-app][error] " + msg + "（累计 " + self.errorCount + "）/ handler error (total " + self.errorCount + ")");
    }

    // P1-5：报文尺寸超限记账（主线程本地计数 + warn 日志，无锁）
    func countOversize(kind: string) {
        self.oversizeCount = self.oversizeCount + 1;
        name = "header";
        if (kind == "body") { name = "body"; }
        print("[lumyr-app][warn] 报文尺寸超限（" + name + "，累计 " + self.oversizeCount
            + "）/ message size exceeded (" + name + ", total " + self.oversizeCount + ")");
    }

    // P1-6：accept 限速平滑档。有效上限 = maxConnections>0 时 min(maxConnections,
    // connCapacity)，否则 connCapacity；对标 nginx accept_disabled：空闲槽不足
    // 总量 1/8 时让位（active > limit - limit/8），与硬拒绝档形成两档。
    // 小容量（如 limit=1）下 limit-limit/8=limit，active 不可能超过，故不误触发。
    func acceptThrottleMs(): int {
        limit = self.connCapacity();
        if (self.maxConnections > 0 && self.maxConnections < limit) {
            limit = self.maxConnections;
        }
        threshold = limit - limit / 8;
        if (self.activeCount > threshold) { return 10; }
        return 0;
    }

    // 硬上限排队闸门（单线程版）：满员期间持续返回 20ms 挂起 accept，
    // 直到 markFinished 释放空位；逻辑与 ServiceWorker 版一致。
    func acceptGateMs(): int {
        if (!self.acceptQueueEnabled()) { return -1; }
        limit = self.connCapacity();
        if (self.maxConnections > 0 && self.maxConnections < limit) {
            limit = self.maxConnections;
        }
        if (self.activeCount >= limit) { return 2; }
        return -1;
    }

    // P1-8：handler 执行预算检查（AcceptLoop 每轮调用）。采样全局 forceYield
    // （reduction 预算耗尽强制让出）与 longSched（>50ms 长调度），差值计数+warn。
    // 全局计数器跨协程共享，反映本进程所有协程（含 handler）的预算超限情况。
    func checkHandlerBudget() {
        curForce = SchedStats.forceYield();
        if (curForce > self.lastForceYield) {
            self.budgetOverrunCount = self.budgetOverrunCount + (curForce - self.lastForceYield);
            print("[lumyr-app][warn] handler 执行预算超限（forceYield 累计 " + self.budgetOverrunCount
                + "）/ handler budget overrun: forceYield=" + self.budgetOverrunCount);
        }
        self.lastForceYield = curForce;
        curLong = SchedStats.longSched();
        if (curLong > self.lastLongSched) {
            self.longSchedCount = self.longSchedCount + (curLong - self.lastLongSched);
            print("[lumyr-app][warn] 长调度告警（longSched 累计 " + self.longSchedCount
                + "）/ long schedule alert: longSched=" + self.longSchedCount);
        }
        self.lastLongSched = curLong;
    }

    // 连接协程完成回调（协程内最后调用）：标记挂起待回收
    func markFinished(h) {
        h.active = false;
        self.finishedHandlers.add(h);
        self.activeCount = self.activeCount - 1;
    }

    // 回收已完成的连接协程（run 退出时调用，destroy 释放协程栈）
    private func reapFinished() {
        done = self.finishedHandlers;
        self.finishedHandlers = [];
        still = [];
        for h in self.activeHandlers {
            if (h.active) { still.add(h); }
        }
        self.activeHandlers = still;
        for h in done { h.destroy(); }
    }

    // 运行期增量回收（AcceptLoop 每轮调用）：单线程版，逻辑同 ServiceWorker。
    func reapDueHandlers() {
        if (self.finishedHandlers.len >= ServiceApplication.REAP_BATCH) {
            self.reapFinished();
        }
    }

    // run 退出时 destroy 所有在役连接协程（挂起在 IO yield 的协程强制释放）
    private func destroyActive() {
        all = self.activeHandlers;
        self.activeHandlers = [];
        self.activeCount = 0;
        for h in all { h.destroy(); }
    }

    @FuncAlias("toStr")
    func toString(): string {
        return "ServiceApplication(" + self.host() + ":" + self.port() + ")";
    }
}
