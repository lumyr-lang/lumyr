// ============================================================
// lumyr-WebApplication：HTTP Web 应用基类
//   RequestHandler         路由处理器契约（命名接口）
//   HttpConnectionHandler  单连接 HTTP 处理协程（持有 Coroutine，非 Thread）
//   WebApplication         继承 ServiceApplication：只负责 HTTP 报文解析与
//                          路由分派；reactor+协程骨架（accept 循环 / 连接协程
//                          管理 / stop 唤醒）全部复用 ServiceApplication
//
// 依赖：<App/ServiceApplication>（服务骨架：生命周期/配置/连接协程管理）
//       <App/Container>（IoC 容器 + 应用引导表）
//       <App/RequestBinder>（控制器适配函数绑定）
//       <NetWork/HttpServer>（ServerRequest/ServerResponse/HttpMethod）
//       <NetWork/NetError>（socket 错误码枚举）
//       <NetWork/Reactor>（Coroutine 协程封装）
//
// 连接处理流程（HttpConnectionHandler 协程内，keep-alive 循环）：
//   ServerRequest.readFrom(conn, connBuf) 二进制安全收读完整报文并解析
//   （recv 协程化 yield；connBuf 为连接级读缓冲，pipelining 残留跨请求保留）
//   → app.handleRequest(req) 分派（默认走路由表）
//   → resp.sendTo(conn) 分段回写（send 协程化 yield）
//   → Connection 语义判定：keep-alive 则循环读下一请求，否则 conn.close()
//
// 错误处理分层：
//   分派链尾异常（路由处理器/业务逻辑 throw）→ onError(req, e)：
//     默认 500；app.setErrorHandler(f) 自定义（实现 ErrorHandler 的对象，
//     或 func(req, e): ServerResponse）。错误响应仍回到外层过滤器的
//     post 阶段，可统一包装错误格式（如 JSON 错误体）
//   过滤器自身抛错 → 不进 onError（基础设施异常），由连接协程兜 500
//   报文解析错误 → 由连接协程兜 500
//
// 生产保护（建议显式设置）：
//   app.setMaxConnections(n)：并发在役连接达上限 → 新连接不再起协程，
//     回 503 Service Unavailable（ServiceApplication 层钩子，HTTP 重写）
//   慢客户端防护（Phase 7.7，reactor 定时器驱动，协程模式生效）：
//     requestTimeout    请求读取阶段每次 recv 无数据等待上限，超时回 408 并关闭
//     keepAliveTimeout  keep-alive 空闲等首字节上限，超时静默关闭
//     （SO_RCVTIMEO 仅阻塞模式有效；协程模式 fd 非阻塞，走 per-socket
//      recvTimeout/sendTimeout 字段 + reactor 一次性定时器）
//
// 配置键（可被构造参数覆盖，构造参数优先级高于配置文件）：
//   host     string  默认 "0.0.0.0"
//   port     int     默认 8080
//   backlog  int     默认 128
//   autoScan bool   默认 true；false 时不执行编译期生成的引导函数，
//                    需手动 app.scan()
//   keepAlive        bool  默认 true（Phase 7.7）：HTTP/1.1 持久连接总开关，
//                          false 时每请求响应后关闭（Connection: close）
//   keepAliveTimeout int   默认 5000 毫秒（Phase 7.7）：keep-alive 空闲
//                          等下一请求首字节上限，超时静默关闭
//   requestTimeout   int   默认 30000 毫秒（Phase 7.7）：单请求读取阶段
//                          每次 recv 无数据等待上限，超时回 408 并关闭
//
// 注解驱动通道（@Controller / @Service）：
//   编译期生成的引导函数在 run 开始时执行（autoScan 未关闭）：
//   服务依依赖拓扑实例化、注册进 IoC 容器（单例），控制器实例化后挂载。
//   也可编程式注册：app.service(inst) / app.service("name", inst)、
//   app.controller(inst)；app.scan() 手动执行引导。
//
// 扩展方式（可叠加）：
//   1. 注册路由：app.get("/hello", handler)（handler 为实现 RequestHandler
//      的对象，或直接传 func(req): ServerResponse）
//   2. 注册过滤器：app.addFilter(f)（f 为实现 WebFilter 的对象，或直接传
//      func(req, chain): ServerResponse）。过滤器按注册序形成洋葱链包住
//      整个请求分派：chain.next(req) 之前可改写 ServerRequest（改 header、
//      setAttribute 传上下文），之后可改写 ServerResponse（加 header、
//      包装 body）；不调 chain.next 即短路（如鉴权失败直接回 401）。
//      404/500 兜底响应同样经过滤链。
//   3. 继承重写：class MyApp extends WebApplication 重写
//      handleRequest(req)（可 super.handleRequest(req) 回退路由表）、
//      onNotFound(req)、onStart()/onStop() 等钩子；重写 dispatchWithFilters
//      可整体接管过滤链（含跳过）
//
// 用法：
//   import <App/WebApplication>;
//   class MyApp extends WebApplication {
//       func onStart() { print("listen on " + self.port() + "\n"); }
//   }
//   app = MyApp(8080);
//   app.get("/hello", HelloHandler());
//   app.start();            // 阻塞；或 app.startAsync() 后台运行
//   // 另一线程 app.stop(); app.join();
// ============================================================

import <App/ServiceApplication>;
import <App/Container>;
import <App/RequestBinder>;
import <NetWork/HttpServer>;
import <NetWork/NetError>;
import <NetWork/Reactor>;

// 路由处理器契约：接收解析好的请求，返回构建好的响应
// （方法名取 serve：handle 是语言指针类型关键字，不能作方法名）
public interface RequestHandler {
    func serve(req: ServerRequest): ServerResponse;
}

// ============================================================
// FilterChain：过滤器链（洋葱模型）
// 持有剩余过滤器与分派终点（app.handleRequest，虚分派——子类重写生效）。
// next(req) 依次推进：还有过滤器 → 构造子链交给下一个过滤器；
// 过滤器耗尽 → 回归应用分派（路由表 / onNotFound）。
// ============================================================
public class FilterChain {
    filters: array;   // 全量过滤器（注册序，共享只读）
    idx: int;         // 当前推进到的过滤器下标
    app: any;         // 分派终点（链尾调 app.handleRequest）

    func FilterChain(filters: array, idx: int, app) {
        self.filters = filters;
        self.idx = idx;
        self.app = app;
    }

    func next(req: ServerRequest): ServerResponse {
        if (self.idx < self.filters.len) {
            f = self.filters[self.idx];
            sub = FilterChain(self.filters, self.idx + 1, self.app);
            // func 形态过滤器直接调用；对象形态走 doFilter 契约
            if (type(f) == "func") { return f(req, sub); }
            return f.doFilter(req, sub);
        }
        // 链尾：带异常处理的分派核心（错误响应回到本洋葱外层过滤器的 post 阶段）
        return self.app.dispatchCore(req);
    }
}

// 过滤器契约：包住整个请求分派
//   前置改写请求：调 chain.next(req) 之前改 req（header / setAttribute）
//   后置改写响应：chain.next(req) 返回后改 resp（加 header / 包装 body）
//   短路：不调 chain.next，直接 return 自己构造的 ServerResponse
public interface WebFilter {
    func doFilter(req: ServerRequest, chain: FilterChain): ServerResponse;
}

// 全局异常处理契约：分派链尾（路由处理器执行）抛出的异常统一落到这里，
// 返回的错误响应仍会回到外层过滤器的 post 阶段（可统一包装错误格式）。
// e 为 throw 的原始值（string 或 Error 实例）。
public interface ErrorHandler {
    func onError(req: ServerRequest, e): ServerResponse;
}

// ============================================================
// HttpConnectionHandler：单连接 HTTP 处理协程（keep-alive 循环）
// 循环：读请求 → 应用分派 → 回写响应，直到协议要求关闭或出错。
//   Connection 语义：HTTP/1.1 默认 keep-alive（Connection: close 关闭）；
//   HTTP/1.0 默认关闭（Connection: keep-alive 保持）；响应回写 Connection 标头。
//   应用配置 keepAlive=false 时恒关闭（同 HTTP/1.0 短连接）。
// 两级 recv 超时（协程模式 reactor 定时器驱动，setOption recvTimeout 应用）：
//   请求读取阶段 requestTimeout（默认 30s）：超时回 408 并关闭（慢客户端防护）；
//   keep-alive 空闲等首字节 keepAliveTimeout（默认 5s）：超时静默关闭
//   （无未决请求，keepalive_timeout 语义）。
// 处理器抛错兜底为 500（并关闭连接），保证单连接异常不拖垮 reactor。
// recv/send 在协程上下文自动协程化（yield 等 IO 事件，reactor resume）。
// ============================================================
class HttpConnectionHandler {
    app: any;
    conn: any;
    co: any;       // Coroutine 实例
    active: bool;
    kaEnabled: bool;   // keepAlive 配置缓存（构造时读取，启动后不变）
    reqMs: int;        // requestTimeout 毫秒
    idleMs: int;       // keepAliveTimeout 毫秒

    func HttpConnectionHandler(app, conn) {
        self.app = app;
        self.conn = conn;
        self.active = true;
        // 配置在构造时从真实 app 缓存：多线程模式 bindOwner(worker) 后
        // self.app 变为 worker（鸭子类型只有分派/回收接口），
        // 缓存避免向 worker 扩散配置访问
        self.kaEnabled = app.keepAliveEnabled();
        self.reqMs = app.requestTimeout();
        self.idleMs = app.keepAliveTimeout();
        self.co = Coroutine(func(h) {
            c = h.conn;
            connBuf = [];   // 连接级读缓冲（pipelining 残留跨请求保留）
            first = true;   // 首请求标记：首请求读取直接用 requestTimeout
            while (true) {
                // keep-alive 空闲等首字节：仅非首请求且缓冲已空时进入。
                // 超时/EOF/读错均静默关闭（无未决请求）
                if (!first && connBuf.len == 0) {
                    c.setOption("recvTimeout", h.idleMs);
                    chunk = null;
                    try {
                        chunk = c.recv(ServerRequest.readChunkSize(), 0, true);
                    } catch (e) {
                        break;
                    }
                    if (chunk.len == 0) { break; }   // 对端关闭
                    i = 0;
                    while (i < chunk.len) { connBuf.add(chunk[i]); i = i + 1; }
                }
                first = false;
                // 请求读取阶段：requestTimeout（每次 recv 无数据等待上限）
                c.setOption("recvTimeout", h.reqMs);
                resp = null;
                req = null;
                failed = false;
                try {
                    req = ServerRequest.readFrom(c, connBuf);
                    resp = h.app.dispatchWithFilters(req);
                } catch (e) {
                    failed = true;   // 任何异常响应后关闭连接（同历史行为）
                    // 错误码分派：kit 层 socket 错误（VAL_ERROR）携带 code，与
                    // NetError 枚举数值对齐，e.getCode() 精确比较（不再字符串匹配）；
                    // string/Error 实例无 socket 码（getCode=0 或不适用），走 500
                    code = 0;
                    if (type(e) != "string") {
                        code = e.getCode();
                    }
                    if (code == NetError.RECV_TIMEOUT) {
                        // 客户端长时间不发送完整报文（请求接收超时）：协议层 408，
                        // 不进业务 onError（非应用异常），协程及时回收
                        resp = ServerResponse(408);
                        resp.text("Request Timeout: incomplete request / 请求接收超时");
                    } else if (code == NetError.SEND_TIMEOUT) {
                        // 响应阶段发送超时：协议层 408，连接关闭
                        resp = ServerResponse(408);
                        resp.text("Request Timeout: send timeout / 发送超时");
                    } else {
                        resp = ServerResponse(500);
                        resp.text("Internal Server Error");
                    }
                }
                // Connection 语义判定（异常响应恒关闭）
                ka = false;
                if (h.kaEnabled && !failed && req != null) {
                    hdr = req.header("Connection").lower();
                    if (req.httpVersion == "1.1") { ka = (hdr != "close"); }
                    else { ka = (hdr == "keep-alive"); }
                }
                if (ka) { resp.setHeader("Connection", "keep-alive"); }
                else { resp.setHeader("Connection", "close"); }
                try {
                    resp.sendTo(c);
                } catch (e2) { break; }
                if (!ka) { break; }
            }
            try {
                c.close();
            } catch (e3) { x = 1; }
            h.app.markFinished(h);
        }, self);
    }

    // 启动协程：resume 一次跑到第一个 yield（recv 等 IO 事件）
    func start() {
        self.co.resume();
    }

    // Phase 7.5 多线程模式：重绑协程的 owner（默认 owner 为 app 自身）。
    // 多 worker 模式下 accept loop 把 owner 重绑为所属 ServiceWorker，
    // dispatchWithFilters 由 worker 委托回 app（虚分派保持），
    // markFinished 落 per-worker 状态（worker 线程本地，无跨线程竞争）。
    func bindOwner(owner) {
        self.app = owner;
        return self;
    }

    // 销毁协程（替代 Thread.join）：reactor 退出后清理挂起协程
    func destroy() {
        if (self.co != null) {
            self.co.destroy();
            self.co = null;
        }
    }
}

// 请求适配器绑定：把编译期生成的顶层适配函数与控制器实例绑定
// （serve 时以 (instance, req) 调用适配函数，用对象绑定替代闭包捕获实例）
public class BoundAdapter {
    instance: any;
    adapterFn: any;

    func BoundAdapter(instance, adapterFn) {
        if (instance == null) {
            throw "适配目标实例不能为空 / adapter target instance must not be null";
        }
        if (type(adapterFn) != "func") {
            throw "适配函数必须是 func / adapter function must be a func";
        }
        self.instance = instance;
        self.adapterFn = adapterFn;
    }

    func serve(req: ServerRequest): ServerResponse {
        // self["adapterFn"](...)：字段持有的函数须用下标取值后动态调用，
        // 点语法 self.adapterFn(...) 会被当作方法名分派而找不到实现
        return self["adapterFn"](self.instance, req);
    }

    // 400 参数错误双语响应
    static func badRequest(msg: string): ServerResponse {
        r = ServerResponse(400);
        r.text(msg);
        return r;
    }

    // 返回值包装：ServerResponse 直用；string→200 text；map/array→200 json；
    // 整型/bool→对应状态码空响应；null→200 空响应；其余原样返回
    // （VM 动态分派返回装箱已按被调方 ret 标注归一，此处用自然早返回形状）
    static func wrapResult(result): ServerResponse {
        t = type(result);
        if (t == "string") {
            r = ServerResponse(200);
            r.text(result);
            return r;
        }
        if (t == "map" || t == "array") {
            r = ServerResponse(200);
            r.json(result);
            return r;
        }
        if (t == "int" || t == "bool" || t == "long" || t == "int64") {
            return ServerResponse((int)result);
        }
        if (t == "none") {
            return ServerResponse(200);
        }
        return result;
    }
}

// HTTP Web 应用基类
public class WebApplication extends ServiceApplication {
    exactRoutes: map;    // 精确路由："METHOD path" → handler（O(1)）
    patternRoutes: array; // 模式路由（注册有序）：:name 参数 / *name 通配
    container: any;      // IoC 服务容器（scan 或编程式注册时创建）
    controllers: array;  // 已挂载控制器实例
    scanned: bool;       // 引导函数是否已执行（幂等保护）
    filters: array;      // 过滤器链（注册序：先注册 = 外层）
    errHandler: any;     // 全局异常处理器（null = 默认 500 兜底）
    kaVal: int;          // Phase 7.7：keepAlive 开关（-1 未设置走配置；0=关 1=开）
    kaTimeoutVal: int;   // Phase 7.7：keepAliveTimeout 毫秒（0 未设置走配置）
    reqTimeoutVal: int;  // Phase 7.7：requestTimeout 毫秒（0 未设置走配置）

    func WebApplication() {
        super();
        self.initBootFields();
    }

    // 单参构造：int 为端口；string 为配置文件路径（立即加载）；map 为配置表
    // （构造器重载仅按参数个数选择，无法按参数类型区分，故合并为一个构造器）
    func WebApplication(first) {
        super(first);
        self.initBootFields();
    }

    // 双参构造：监听地址 + 端口
    func WebApplication(host: string, port: int) {
        super(host, port);
        self.initBootFields();
    }

    // 初始化引导相关字段（容器延迟到 scan / 注册服务时创建）
    private func initBootFields() {
        self.exactRoutes = {};
        self.patternRoutes = [];
        self.container = null;
        self.controllers = [];
        self.scanned = false;
        self.filters = [];
        self.errHandler = null;
        self.kaVal = -1;
        self.kaTimeoutVal = 0;
        self.reqTimeoutVal = 0;
    }

    // ---- 编程式注册（start 前或 onStart 内调用）----

    // 注册服务单例（普通方法不支持同名重载，用默认参数合并两种形态）：
    //   service(inst)          单参：以实例类名为服务名
    //   service(name, inst)    双参：首参为显式服务名
    func service(first, second = null) {
        inst = null;
        serviceName = "";
        if (second == null) {
            // 单参形态
            inst = first;
        } else {
            // 双参形态：首参必须是名字字符串
            if (type(first) != "string") {
                throw "服务名必须是字符串 / service name must be a string";
            }
            serviceName = first;
            inst = second;
        }
        if (inst == null) {
            throw "服务实例不能为空 / service instance must not be null";
        }
        if (serviceName == "") {
            serviceName = type(inst);
            // type 退化为类别名时无法当作唯一名，必须显式提供（无兜底）
            if (serviceName == "class" || serviceName == "struct" ||
                serviceName == "map" || serviceName == "array") {
                throw "无法推断服务名，请显式传入名称 / cannot infer service name, please pass it explicitly";
            }
        }
        if (self.container == null) { self.container = Container(); }
        self.container.register(serviceName, inst);
        return self;
    }

    // 挂载控制器实例（注解驱动的方法路由解析在后续注册阶段完成）
    func controller(inst) {
        if (inst == null) {
            throw "控制器实例不能为空 / controller instance must not be null";
        }
        self.controllers.add(inst);
        return self;
    }

    // 注册过滤器（洋葱模型：先注册 = 外层，pre 先跑、post 后跑）。
    // f 为实现 WebFilter 的对象，或直接传 func(req, chain): ServerResponse。
    // 对象缺 doFilter 方法时运行期动态分派报错（无兜底）。
    func addFilter(f) {
        if (f == null) {
            throw "过滤器不能为空 / filter must not be null";
        }
        self.filters.add(f);
        return self;
    }

    // 过滤链分派入口（连接协程调用）：有过滤器走洋葱链包住分派核心，
    // 无过滤器零开销直通。重写本方法可整体接管过滤链。
    func dispatchWithFilters(req: ServerRequest): ServerResponse {
        if (self.filters.len == 0) { return self.dispatchCore(req); }
        return FilterChain(self.filters, 0, self).next(req);
    }

    // 注册全局异常处理器：分派链尾抛出的异常统一落到这里。
    // f 为实现 ErrorHandler 的对象，或直接传 func(req, e): ServerResponse
    // （e 为 throw 的原始值：string 或 Error 实例）。
    // 错误响应仍回到外层过滤器的 post 阶段；过滤器自身抛错不进这里
    // （基础设施异常由连接协程兜 500）。
    func setErrorHandler(f) {
        if (f == null) {
            throw "异常处理器不能为空 / error handler must not be null";
        }
        self.errHandler = f;
        return self;
    }

    // ---- Phase 7.7：HTTP keep-alive 与连接级超时配置 ----

    // keep-alive 总开关：默认 true（HTTP/1.1 持久连接）。
    // false 时每请求响应后关闭连接（Connection: close），同 HTTP/1.0 短连接行为。
    func keepAliveEnabled(): bool {
        if (self.kaVal >= 0) { return self.kaVal == 1; }
        v = self.config("keepAlive");
        if (v == null) { return true; }
        if (type(v) == "bool") { return v; }
        throw "keepAlive 配置必须是布尔值 / keepAlive config must be a boolean";
    }

    // 编程式开关 keep-alive（须在 start 前调用）
    func setKeepAlive(enabled: bool) {
        self.kaVal = enabled ? 1 : 0;
        return self;
    }

    // keep-alive 空闲超时（毫秒）：响应完成后等下一请求首字节的最长时间，
    // 超时静默关闭（无未决请求，keepalive_timeout 语义）。默认 5000。
    // 取 0 以下的配置无意义（空闲连接会钉死协程耗尽资源），故下界 1ms。
    func keepAliveTimeout(): int {
        if (self.kaTimeoutVal > 0) { return self.kaTimeoutVal; }
        return self.configInt("keepAliveTimeout", 5000);
    }

    // 编程式设置 keep-alive 空闲超时（毫秒，须在 start 前调用）
    func setKeepAliveTimeout(ms: int) {
        if (ms < 1) {
            throw "keep-alive 空闲超时必须 ≥ 1 毫秒 / keep-alive idle timeout must be at least 1ms";
        }
        self.kaTimeoutVal = ms;
        return self;
    }

    // 请求读取超时（毫秒）：单请求读取阶段每次 recv 的无数据等待上限
    // （慢客户端/Slowloris 防护），超时回 408 Request Timeout 并关闭连接。
    // 默认 30000。协程模式由 reactor 定时器实现（setOption recvTimeout）。
    func requestTimeout(): int {
        if (self.reqTimeoutVal > 0) { return self.reqTimeoutVal; }
        return self.configInt("requestTimeout", 30000);
    }

    // 编程式设置请求读取超时（毫秒，须在 start 前调用）
    func setRequestTimeout(ms: int) {
        if (ms < 1) {
            throw "请求读取超时必须 ≥ 1 毫秒 / request timeout must be at least 1ms";
        }
        self.reqTimeoutVal = ms;
        return self;
    }

    // 分派核心：路由分派 + 链尾异常兜底。
    // 处理器/路由匹配阶段抛出的异常统一转交 onError；错误响应作为
    // 正常返回值回到调用方（有过滤器时即外层过滤器的 post 阶段）。
    func dispatchCore(req: ServerRequest): ServerResponse {
        try {
            return self.handleRequest(req);
        } catch (e) {
            return self.onError(req, e);
        }
    }

    // 全局异常处理钩子（可 setErrorHandler 定制；重写本方法亦可）。
    // 默认兜底：500 "Internal Server Error"（与历史行为一致）。
    // lambda 形态经 self["errHandler"] 下标取值后动态调用——点语法会把
    // 字段持有的函数当方法名分派而找不到实现（同 BoundAdapter 教训）
    func onError(req: ServerRequest, e): ServerResponse {
        if (self.errHandler != null) {
            if (type(self.errHandler) == "func") { return self["errHandler"](req, e); }
            return self.errHandler.onError(req, e);
        }
        r = ServerResponse(500);
        r.text("Internal Server Error");
        return r;
    }

    // ---- 应用扫描：执行编译期生成的引导函数 ----

    // scan 是否应自动执行：配置 autoScan 缺省为 true；值必须是布尔值
    func autoScanEnabled(): bool {
        v = self.config("autoScan");
        if (v == null) { return true; }
        if (type(v) == "bool") { return v; }
        throw "autoScan 配置必须是布尔值 / autoScan config must be a boolean";
    }

    // 执行全部已登记引导函数：服务实例化注册进容器，控制器实例化后挂载。
    // 幂等：重复调用直接返回，避免服务/控制器重复注册。
    func scan() {
        if (self.scanned) { return self; }
        self.scanned = true;
        if (self.container == null) { self.container = Container(); }
        count = __lm_boot_count();
        i = 0;
        while (i < count) {
            boot = __lm_boot_at(i);
            boot(self, self.container);
            i = i + 1;
        }
        return self;
    }

    // 主循环：进入 reactor 事件循环前按配置执行引导（autoScan=false 时跳过，
    // 由用户在合适时机手动 scan），随后复用 ServiceApplication 的 reactor+协程骨架
    func run() {
        if (self.autoScanEnabled()) { self.scan(); }
        super.run();
    }

    // ---- 路由注册（start 前完成注册；handler 为 RequestHandler 对象或 func）----
    // 全字面量路径进精确表（O(1)）；含 :name / 末段 *name 进模式表（注册有序）。

    // 两段数组逐元素比较（模式去重判定）
    private func sameSegments(a: array, b: array): bool {
        if (a.len != b.len) { return false; }
        i = 0;
        while (i < a.len) {
            if (a[i] != b[i]) { return false; }
            i = i + 1;
        }
        return true;
    }

    func route(method: string, path: string, handler) {
        m = method.upper();
        isPattern = (path.indexOf(":") >= 0 || path.indexOf("*") >= 0);
        if (!isPattern) {
            self.exactRoutes[m + " " + path] = handler;
            return self;
        }

        segments = path.split("/");
        star = false;
        starName = "";
        lastSeg = segments[segments.len - 1];
        if (lastSeg.startsWith("*")) {
            star = true;
            starName = lastSeg.slice(1, lastSeg.len);
        }

        // 同 method + 同模式重复注册：覆盖处理器，不新增
        idx = 0;
        while (idx < self.patternRoutes.len) {
            old = self.patternRoutes[idx];
            if (old["method"] == m && self.sameSegments(old["segments"], segments)) {
                old["handler"] = handler;
                return self;
            }
            idx = idx + 1;
        }

        p = {};
        p["method"] = m;
        p["segments"] = segments;
        p["star"] = star;
        p["starName"] = starName;
        p["handler"] = handler;
        self.patternRoutes.add(p);
        return self;
    }

    func get(path: string, handler)     { return self.route(HttpMethod.GET, path, handler); }
    func post(path: string, handler)    { return self.route(HttpMethod.POST, path, handler); }
    func put(path: string, handler)     { return self.route(HttpMethod.PUT, path, handler); }
    func delete(path: string, handler)  { return self.route(HttpMethod.DELETE, path, handler); }
    func patch(path: string, handler)   { return self.route(HttpMethod.PATCH, path, handler); }
    func head(path: string, handler)    { return self.route(HttpMethod.HEAD, path, handler); }

    // 模式匹配：命中返回路径参数 map（:name 逐段、*name 收剩余多段），未命中返回 null
    private func matchPattern(p: map, reqSegments: array) {
        segments = p["segments"];
        star = (p["star"] == true);
        if (star) {
            // 末段 *name：固定段必须全部存在，剩余可为 0..n 段
            if (reqSegments.len < segments.len - 1) { return null; }
        } else {
            if (reqSegments.len != segments.len) { return null; }
        }

        params = {};
        limit = star ? segments.len - 1 : segments.len;
        i = 0;
        while (i < limit) {
            seg = segments[i];
            if (seg.startsWith(":")) {
                params[seg.slice(1, seg.len)] = reqSegments[i];
            } else {
                if (seg != reqSegments[i]) { return null; }
            }
            i = i + 1;
        }

        if (star) {
            rest = [];
            j = segments.len - 1;
            while (j < reqSegments.len) {
                rest.add(reqSegments[j]);
                j = j + 1;
            }
            params[p["starName"]] = rest.join("/");
        }
        return params;
    }

    // 处理器统一调用：func → h(req)；对象 → h.serve(req)
    private func invokeHandler(h, req: ServerRequest): ServerResponse {
        if (type(h) == "func") { return h(req); }
        return h.serve(req);
    }

    // ---- 请求分派（核心扩展点，连接协程内调用）----
    // 顺序：精确表 O(1) → 模式表注册序首个匹配 → onNotFound。
    // 子类重写可实现任意分派逻辑（中间件、前缀匹配、重写等），
    // 需要回退默认行为时调 super.handleRequest(req)。
    func handleRequest(req: ServerRequest): ServerResponse {
        key = req.method + " " + req.path;
        if (self.exactRoutes.contains(key)) {
            return self.invokeHandler(self.exactRoutes[key], req);
        }

        reqSegments = req.path.split("/");
        for p in self.patternRoutes {
            if (p["method"] == req.method) {
                pathParams = self.matchPattern(p, reqSegments);
                if (pathParams != null) {
                    req.pathParams = pathParams;
                    return self.invokeHandler(p["handler"], req);
                }
            }
        }
        return self.onNotFound(req);
    }

    // 404 钩子（可重写定制）
    func onNotFound(req: ServerRequest): ServerResponse {
        resp = ServerResponse(404);
        resp.text("Not Found: " + req.method + " " + req.path);
        return resp;
    }

    // 连接处理器工厂重写：换入 HTTP 连接协程（run 主循环继承自 ServiceApplication）
    func createHandler(conn) {
        return HttpConnectionHandler(self, conn);
    }

    // 并发超限拒绝钩子重写：TCP 直接关闭对 HTTP 客户端不透明，
    // 改回明确的 503 Service Unavailable。
    // 注意关闭顺序：连接接收缓冲里还有客户端已发的请求字节时直接
    // close() 会触发 RST（冲掉未送达的 503），故写响应后先限时排空
    // 接收缓冲（50ms 小超时读，超时/EOF 即停），再 close（对端可能
    // 已断开，全程失败忽略）
    func onRejectConnection(conn) {
        try {
            r = ServerResponse(503);
            r.setHeader("Connection", "close");
            r.text("Service Unavailable: too many concurrent connections / 并发连接数已达上限");
            r.sendTo(conn);
            conn.setOption("recvTimeout", 50);
            guard = 0;
            while (guard < 16) {
                d = conn.recv(4096);
                if (d == "") { break; }   // 对端已关闭
                guard = guard + 1;        // 限时排空，防对端恶意持续发数据
            }
        } catch (e) { x = 1; }
        conn.close();
        return self;
    }

    @FuncAlias("toStr")
    func toString(): string {
        return "WebApplication(" + self.host() + ":" + self.port() + ")";
    }
}
