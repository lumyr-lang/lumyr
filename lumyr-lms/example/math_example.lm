// ============================================================
// lumyr Math 类测试
// 运行：./bin/lumyr lumyr-lms/example/math_example.lm
// ============================================================

import <Function/Math>;

func check(cond, msg) {
    if (cond == true) { x = 1; } else { throw msg; }
}

func approx(a, b, eps) {
    diff = a - b;
    if (diff < 0) { diff = -diff; }
    return diff < eps;
}

EPS = 0.000001;

// ========== 常量 ==========
check(Math_PI > 3.14 && Math_PI < 3.15, "PI ≈ 3.14159");
check(Math_E > 2.71 && Math_E < 2.72, "E ≈ 2.71828");
check(Math_LN2 > 0.69 && Math_LN2 < 0.70, "LN2 ≈ 0.693");
check(Math_LN10 > 2.30 && Math_LN10 < 2.31, "LN10 ≈ 2.303");
check(Math_SQRT2 > 1.41 && Math_SQRT2 < 1.42, "SQRT2 ≈ 1.414");

// ========== 三角函数 ==========
check(approx(Math_sin(0.0), 0.0, EPS), "sin(0)=0");
check(approx(Math_sin(Math_PI / 2), 1.0, EPS), "sin(π/2)=1");
check(approx(Math_cos(0.0), 1.0, EPS), "cos(0)=1");
check(approx(Math_cos(Math_PI), -1.0, EPS), "cos(π)=-1");
check(approx(Math_tan(0.0), 0.0, EPS), "tan(0)=0");
check(approx(Math_tan(Math_PI / 4), 1.0, EPS), "tan(π/4)=1");

// ========== 反三角函数 ==========
check(approx(Math_asin(1.0), Math_PI / 2, EPS), "asin(1)=π/2");
check(approx(Math_acos(1.0), 0.0, EPS), "acos(1)=0");
check(approx(Math_atan(1.0), Math_PI / 4, EPS), "atan(1)=π/4");
check(approx(Math_atan2(1.0, 1.0), Math_PI / 4, EPS), "atan2(1,1)=π/4");
check(approx(Math_atan2(0.0, -1.0), Math_PI, EPS), "atan2(0,-1)=π");

// ========== 对数 ==========
check(approx(Math_log(Math_E), 1.0, EPS), "log(e)=1");
check(approx(Math_log(1.0), 0.0, EPS), "log(1)=0");
check(approx(Math_log10(1000.0), 3.0, EPS), "log10(1000)=3");
check(approx(Math_log10(100.0), 2.0, EPS), "log10(100)=2");
check(approx(Math_log2(8.0), 3.0, EPS), "log2(8)=3");
check(approx(Math_log2(1024.0), 10.0, EPS), "log2(1024)=10");

// ========== 指数与幂 ==========
check(approx(Math_exp(0.0), 1.0, EPS), "exp(0)=1");
check(approx(Math_exp(1.0), Math_E, EPS), "exp(1)=e");
check(approx(Math_pow(2.0, 10.0), 1024.0, EPS), "pow(2,10)=1024");
check(approx(Math_pow(3.0, 2.0), 9.0, EPS), "pow(3,2)=9");
check(approx(Math_sqrt(4.0), 2.0, EPS), "sqrt(4)=2");
check(approx(Math_sqrt(2.0), Math_SQRT2, EPS), "sqrt(2)=1.414...");
check(approx(Math_cbrt(27.0), 3.0, EPS), "cbrt(27)=3");
check(approx(Math_cbrt(-8.0), -2.0, EPS), "cbrt(-8)=-2");
check(approx(Math_hypot(3.0, 4.0), 5.0, EPS), "hypot(3,4)=5");

// ========== 取整 ==========
check(Math_floor(3.7) == 3, "floor(3.7)=3");
check(Math_floor(-3.2) == -4, "floor(-3.2)=-4");
check(Math_ceil(3.2) == 4, "ceil(3.2)=4");
check(Math_ceil(-3.7) == -3, "ceil(-3.7)=-3");
check(approx(Math_round(3.5), 4.0, EPS), "round(3.5)=4");
check(approx(Math_round(3.4), 3.0, EPS), "round(3.4)=3");
check(approx(Math_round(-3.5), -4.0, EPS), "round(-3.5)=-4");
check(approx(Math_trunc(3.9), 3.0, EPS), "trunc(3.9)=3");
check(approx(Math_trunc(-3.9), -3.0, EPS), "trunc(-3.9)=-3");

// ========== 绝对值与符号 ==========
check(Math_abs(-5) == 5, "abs(-5)=5");
check(Math_abs(5) == 5, "abs(5)=5");
check(Math_abs(-3.14) == 3.14, "abs(-3.14)=3.14");
check(approx(Math_sign(42.0), 1.0, EPS), "sign(42)=1");
check(approx(Math_sign(-42.0), -1.0, EPS), "sign(-42)=-1");
check(approx(Math_sign(0.0), 0.0, EPS), "sign(0)=0");

// ========== 角度转换 ==========
check(approx(Math_degrees(Math_PI), 180.0, EPS), "degrees(π)=180");
check(approx(Math_degrees(Math_PI / 2), 90.0, EPS), "degrees(π/2)=90");
check(approx(Math_radians(180.0), Math_PI, EPS), "radians(180)=π");
check(approx(Math_radians(90.0), Math_PI / 2, EPS), "radians(90)=π/2");

// ========== 极值 ==========
check(Math_max(3, 7) == 7, "max(3,7)=7");
check(Math_min(3, 7) == 3, "min(3,7)=3");
check(Math_max(-5, -2) == -2, "max(-5,-2)=-2");
check(Math_min(-5, -2) == -5, "min(-5,-2)=-5");

// ========== 随机数 ==========
r = Math_random();
check(r >= 0.0 && r < 1.0, "random in [0,1)");
r2 = Math_random();
check(r2 >= 0.0 && r2 < 1.0, "random 2 in [0,1)");
// 两次调用不太可能完全相等
check(r != r2 || r == r2, "random calls don't crash");

// 全局形式
rg = random();
check(rg >= 0.0 && rg < 1.0, "global random in [0,1)");

// ========== 全局形式（非类调用）==========
check(approx(sin(0.0), 0.0, EPS), "global sin(0)=0");
check(approx(cos(0.0), 1.0, EPS), "global cos(0)=1");
check(approx(log(1.0), 0.0, EPS), "global log(1)=0");
check(approx(exp(1.0), Math_E, EPS), "global exp(1)=e");
check(approx(pow(2.0, 8.0), 256.0, EPS), "global pow(2,8)=256");
check(approx(round(2.5), 3.0, EPS), "global round(2.5)=3");
check(sign(-10.0) == -1.0, "global sign(-10)=-1");
check(approx(degrees(Math_PI), 180.0, EPS), "global degrees(π)=180");

print("lumyr Math ALL PASS");
