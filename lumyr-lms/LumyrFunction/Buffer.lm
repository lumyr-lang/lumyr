// ============================================================
// lumyr-Buffer：BufferInterface<E> 接口 + AbstractBuffer<E> 抽象基类
// 所有缓冲区/集合封装类的统一契约与通用实现
// E = Element（集合元素类型）
//
// 用法：
//   import <Function/Buffer>;
//   public class Array<E> extends AbstractBuffer<E> implements BufferInterface<E> { ... }
// ============================================================

import <Function/Object>;

// 统一缓冲区契约：E = 集合元素类型
public interface BufferInterface<E> {
    func size(): int;
    func isEmpty(): bool;
    func get(idx: int): E;
    func set(idx: int, val: E): BufferInterface<E>;
    func append(val: E): BufferInterface<E>;
    func insert(idx: int, val: E): BufferInterface<E>;
    func remove(idx: int): BufferInterface<E>;
    func clear(): BufferInterface<E>;
    func sort(): BufferInterface<E>;
    func reverse(): BufferInterface<E>;
    func slice(start: int, end: int);
    func concat(other): BufferInterface<E>;
    func sum();
    func avg(): double;
    func min(): E;
    func max(): E;
    func indexOf(val: E): int;
    func contains(val: E): bool;
    func first(): E;
    func last(): E;
    func copy();
    func toArray();
    func toString(): string;
    func className(): string;
    func equals(other): bool;
    func hashCode(): int;
}

// 抽象基类：所有通用方法委托 self.value 上的内置数组方法
// 子类只需声明 value 字段并实现构造函数
public abstract class AbstractBuffer<E> extends Object implements BufferInterface<E> {
    // length, count
    @FuncAlias(["length", "count"])
    func size(): int { return self.value.len; }

    func isEmpty(): bool { return self.value.len == 0; }

    func get(idx: int): E { return self.value.get(idx); }
    func set(idx: int, val: E) { self.value.set(idx, val); return self; }

    // push, add
    @FuncAlias(["push", "add"])
    func append(val: E) { self.value.add(val); return self; }

    // 注：不为 insert 添加 add 别名——add(int,E) 与 add(E) 重载在 lumin
    // 单方法名模型下会与 append 的 add 别名冲突，故仅 append 持有 add 别名
    func insert(idx: int, val: E) { self.value.insert(idx, val); return self; }
    func remove(idx: int) { self.value.remove(idx); return self; }

    // removeAll
    @FuncAlias("removeAll")
    func clear() { self.value.clear(); return self; }

    func sort() { self.value.sort(); return self; }
    func reverse() { self.value.reverse(); return self; }

    // subList
    @FuncAlias("subList")
    func slice(start: int, end: int) { return self.value.slice(start, end); }
    func concat(other) { return self.value.concat(other.value); }

    func sum() { return self.value.sum(); }

    // mean, average
    @FuncAlias(["mean", "average"])
    func avg(): double { return self.value.avg(); }

    func min(): E { return self.value.min(); }
    func max(): E { return self.value.max(); }

    func indexOf(val: E): int { return self.value.indexOf(val); }

    // includes
    @FuncAlias("includes")
    func contains(val: E): bool { return self.value.indexOf(val) >= 0; }

    // getFirst
    @FuncAlias("getFirst")
    func first(): E { return self.value.first(); }

    // getLast
    @FuncAlias("getLast")
    func last(): E { return self.value.last(); }

    // clone
    @FuncAlias("clone")
    func copy() {
        c = copy(self);
        return c;
    }

    // toList
    @FuncAlias("toList")
    func toArray() { return self.value.copy(); }

    // getClassName
    @FuncAlias("getClassName")
    func className(): string { return type(self); }
    func equals(other): bool {
        if (type(other) != type(self)) { return false; }
        return self.toJSONString() == other.toJSONString();
    }

    // hashValue
    @FuncAlias("hashValue")
    func hashCode(): int { return self.value.len; }

    // toStr
    @FuncAlias("toStr")
    func toString(): string { return self.toJSONString(); }
}
