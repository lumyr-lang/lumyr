// ============================================================
// lumyr-Double：Double 浮点数封装类
// 包装 double 值，提供值语义方法：相等、比较、取整、数学运算
//
// 用法：
//   import <Function/Double> as Dbl;
//   d = Dbl.Double(3.14);
//   print(d.toString());      // "3.14"
//   print(d.round().value);   // 3
// ============================================================

import <Function/Number>;

public class Double extends Number {
    value: double;

    func Double(v: double) {
        self.value = v;
    }

    func equals(other): bool {
        if (type(other) != type(self)) { return false; }
        return self.value == other.value;
    }

    // hashValue
    @FuncAlias("hashValue")
    func hashCode(): int {
        return (int)self.value;
    }

    // 比较：-1 <, 0 ==, 1 >
    // compare
    @FuncAlias("compare")
    func compareTo(other): int {
        if (type(other) != type(self)) { return -2; }
        if (self.value < other.value) { return -1; }
        if (self.value > other.value) { return 1; }
        return 0;
    }

    // toStr
    @FuncAlias("toStr")
    func toString(): string {
        v = self.value;
        return "" + v;
    }

    func toInteger(): int {
        return (int)self.value;
    }

    func toDouble(): double {
        return self.value;
    }

    func abs(): Double {
        if (self.value < 0.0) {
            return Double(-self.value);
        }
        return self;
    }

    func round(): int {
        return (int)(self.value + 0.5);
    }

    func floor(): int {
        v = self.value;
        r = (int)v;
        if (v < 0.0 && v != r + 0.0) {
            return r - 1;
        }
        return r;
    }

    func ceil(): int {
        v = self.value;
        r = (int)v;
        if (v > 0.0 && v != r + 0.0) {
            return r + 1;
        }
        return r;
    }

    func negate(): Double {
        return Double(-self.value);
    }

    func isNegative(): bool {
        return self.value < 0.0;
    }

    func isZero(): bool {
        return self.value == 0.0;
    }

    func isPositive(): bool {
        return self.value > 0.0;
    }
}
