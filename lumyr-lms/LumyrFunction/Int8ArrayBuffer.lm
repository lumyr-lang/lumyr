// ============================================================
// lumyr-Int8ArrayBuffer：Int8ArrayBuffer 数组缓冲区封装类
// 内部使用 <int8> 类型化数组存储，元素写入由运行时按元素类型原生截断到 int8 范围 (-128..127)
// 所有修改操作 in-place，返回 self 支持链式调用
//
// 用法：
//   import <Function/Int8ArrayBuffer>;
//   buf = Int8ArrayBuffer();
//   buf.append(1).append(2).append(3);
//   print(buf.size());        // 3
//   print(buf.sum());         // 6
// ============================================================

import <Function/Buffer>;

public class Int8ArrayBuffer extends AbstractBuffer {
    value: <int8>array;

    func Int8ArrayBuffer(arr) {
        self.value = <int8>[];
        if (arr != null) { self.value.addAll(arr); }
    }

    func indexOf(val): int { return self.value.indexOf(val); }
    func contains(val): bool { return self.value.indexOf(val) >= 0; }

    // override 返回同类型实例
    func slice(start: int, end: int): Int8ArrayBuffer {
        r = Int8ArrayBuffer();
        r.value = self.value.slice(start, end);
        return r;
    }
    func concat(other): Int8ArrayBuffer {
        r = Int8ArrayBuffer();
        r.value = self.value.concat(other.value);
        return r;
    }
    func copy(): Int8ArrayBuffer {
        r = Int8ArrayBuffer();
        r.value = self.value.copy();
        return r;
    }
}
