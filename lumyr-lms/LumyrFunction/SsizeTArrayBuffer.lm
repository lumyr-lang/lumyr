// ============================================================
// lumyr-SsizeTArrayBuffer：SsizeTArrayBuffer 数组缓冲区封装类
// 内部使用 <ssize_t> 类型化数组存储，元素写入由运行时按元素类型原生截断到
// ssize_t 范围（有符号，8 字节）
// 所有修改操作 in-place，返回 self 支持链式调用
//
// 用法：
//   import <Function/SsizeTArrayBuffer>;
//   buf = SsizeTArrayBuffer();
//   buf.append(1).append(2).append(3);
//   print(buf.size());        // 3
//   print(buf.sum());         // 6
// ============================================================

import <Function/Buffer>;

public class SsizeTArrayBuffer extends AbstractBuffer<ssize_t> {
    value: <ssize_t>array;

    func SsizeTArrayBuffer(arr) {
        self.value = <ssize_t>[];
        if (arr != null) { self.value.addAll(arr); }
    }

    func indexOf(val): int { return self.value.indexOf(val); }

    // includes——override 重新声明别名确保分派命中本类 RuntimeFunc
    @FuncAlias("includes")
    func contains(val): bool { return self.value.indexOf(val) >= 0; }

    // override 返回同类型实例
    // subList——override 必须重新声明别名，确保返回本类实例
    @FuncAlias("subList")
    func slice(start: int, end: int): SsizeTArrayBuffer {
        r = SsizeTArrayBuffer();
        r.value = self.value.slice(start, end);
        return r;
    }
    func concat(other): SsizeTArrayBuffer {
        r = SsizeTArrayBuffer();
        r.value = self.value.concat(other.value);
        return r;
    }

    // copy() 继承自 AbstractBuffer：调用全局 copy(self) → bi_copy 深拷贝路径
    // （lumyr_instance_copy memcpy + 字段递归深拷贝），返回本类实例，无需 override
}
