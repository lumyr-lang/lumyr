// ============================================================
// lumyr-UCharArrayBuffer：UCharArrayBuffer 数组缓冲区封装类
// 内部使用 <uchar> 类型化数组存储，元素写入由运行时按元素类型原生截断到
// unsigned char 范围 (0..255)
// 所有修改操作 in-place，返回 self 支持链式调用
//
// 用法：
//   import <Function/UCharArrayBuffer>;
//   buf = UCharArrayBuffer();
//   buf.append(1).append(2).append(3);
//   print(buf.size());        // 3
//   print(buf.sum());         // 6
// ============================================================

import <Function/Buffer>;

public class UCharArrayBuffer extends AbstractBuffer<uchar> {
    value: <uchar>array;

    func UCharArrayBuffer(arr) {
        self.value = <uchar>[];
        if (arr != null) { self.value.addAll(arr); }
    }

    func indexOf(val): int { return self.value.indexOf(val); }

    // includes——override 重新声明别名确保分派命中本类 RuntimeFunc
    @FuncAlias("includes")
    func contains(val): bool { return self.value.indexOf(val) >= 0; }

    // override 返回同类型实例
    // subList——override 必须重新声明别名，确保返回本类实例
    @FuncAlias("subList")
    func slice(start: int, end: int): UCharArrayBuffer {
        r = UCharArrayBuffer();
        r.value = self.value.slice(start, end);
        return r;
    }
    func concat(other): UCharArrayBuffer {
        r = UCharArrayBuffer();
        r.value = self.value.concat(other.value);
        return r;
    }

    // clone——override 必须重新声明别名，确保返回本类实例
    @FuncAlias("clone")
    func copy(): UCharArrayBuffer {
        r = UCharArrayBuffer();
        r.value = self.value.copy();
        return r;
    }
}
