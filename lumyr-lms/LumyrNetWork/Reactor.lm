// ============================================================
// lumyr-Reactor：ReactorInterface + ReactorInstance + Coroutine
// 面向对象封装内置 reactor + 协程 builtin：
//   __private_system__reactor_new()/run()/stop()/addTimer()/delTimer()
//   /__private_system__destroy_reactor()
//   /__private_system__set_socket_reactor() / spawn()/resume()/coYield()/current()/isDead()/destroy()
// 注：协程让出用 coYield() 而非 yield（lm 的 yield 是 generator 语句关键字，仅限 gen func）
// 注：reactor 创建/销毁/挂接已按私有机制内置约定更名 __private_system__reactor_new、
//     __private_system__destroy_reactor、__private_system__set_socket_reactor，
//     由本模块 ReactorInstance 构造/destroy/setReactor/clearReactor 公开封装
//
// 分层：
//   ReactorInterface   reactor 契约（run/stop/timer/destroy）
//   ReactorInstance    reactor 实例（构造即创建，run 进入事件循环）
//   Coroutine          协程实例（spawn/resume/yield/isDead/destroy）
//
// 用法：
//   import <NetWork/Reactor>;
//   r = ReactorInstance();
//   setReactor(r);
//   co = Coroutine(func(arg) { print("co: " + arg); yield(); print("co resumed"); }, 42);
//   co.resume();   // 协程跑到 yield
//   co.resume();   // 协程从 yield 继续到结束
//   co.destroy();
//   r.destroy();
//
// reactor + 协程化 socket echo server（需 reactor 内置 accept trampoline，Phase 6）：
//   r = ReactorInstance();
//   setReactor(r);
//   srv = ServerSocket("0.0.0.0", 8080);
//   // reactor.run() 内部 accept + spawn 协程处理（Phase 6 框架层补 accept trampoline）
//   r.run();
// ============================================================

// reactor 契约：事件循环 + 定时器 + 生命周期
public interface ReactorInterface {
    func run();
    func stop();
    func addTimer(ms: int, cb): int;
    func delTimer(id: int);
    func destroy();
}

// reactor 实例：构造即创建，run 进入事件循环
public class ReactorInstance implements ReactorInterface {
    impl: any;   // reactor C 指针（VAL_STRUCT_PTR）
    stopped: bool;

    // 默认 capacity=65536
    func ReactorInstance() {
        self.impl = __private_system__reactor_new(65536);
        self.stopped = false;
    }

    func ReactorInstance(capacity: int) {
        self.impl = __private_system__reactor_new(capacity);
        self.stopped = false;
    }

    // 进入 reactor 主循环；run 返回后 stopped=true
    func run() {
        run(self.impl);
        self.stopped = true;
    }

    func stop() {
        // 幂等：多 worker 停机时外部 stop 与 runMultiWorker 收尾可能重入，
        // destroy 后 impl 已置 null——重入直接忽略（不再解引用空指针）。
        if (self.impl != null) {
            stop(self.impl);
        }
        self.stopped = true;
    }

    // addTimer(ms, cb)：ms 毫秒后触发 cb（lm 函数，无参或接 timerId）
    // 返回 timerId（>0），失败 -1
    func addTimer(ms: int, cb): int {
        return addTimer(self.impl, ms, cb);
    }

    func delTimer(id: int) {
        delTimer(self.impl, id);
    }

    // ===== T5：单 acceptor + 应用层 RR 分派（框架内部机制，业务不直接调）=====
    // registerIdx：worker 线程按 worker idx 显式占槽注册本 reactor。
    // acceptor 的启动屏障是 registryCount == nworkers；idx 必须唯一且 <128。
    func registerIdx(idx: int) {
        __private_system__reactor_register(self.impl, idx);
    }

    // publishLoad：owner worker 发布在役连接数（accept/连接结束时），
    // acceptor 按该负载负载感知跳过高压 worker。
    func publishLoad(load: int) {
        __private_system__reactor_publish_load(self.impl, load);
    }

    // recvInbound：worker receiver 协程取 acceptor 投递的入站连接；
    // 队列为空时框架内部 yield，唤醒后返回对端 socket。
    // 必须在本 reactor owner 线程的协程内调用。
    func recvInbound() {
        return __private_system__reactor_recv_inbound(self.impl);
    }

    // cancelInboundWait：shutdown 销毁 receiver 协程前取消等待登记，
    // 避免 reactor 残留指向已毁协程的等待者。
    func cancelInboundWait() {
        __private_system__reactor_inbound_cancel(self.impl);
    }

    func destroy() {
        if (self.impl != null) {
            __private_system__destroy_reactor(self.impl);
            self.impl = null;
        }
    }
}

// 协程实例：spawn 创建，resume 调度，yield 让出
public class Coroutine {
    impl: any;   // lm_co_t C 指针（VAL_STRUCT_PTR）

    // 带参数构造：spawn(f, arg)
    func Coroutine(f, arg) {
        self.impl = spawn(f, arg);
    }

    // 无参数构造：spawn(f, null)
    func Coroutine(f) {
        self.impl = spawn(f, null);
    }

    // resume：从挂起点继续；协程内 yield 会切回这里
    func resume() {
        resume(self.impl);
    }

    // 是否已结束（DEAD）
    func isDead(): bool {
        return isDead(self.impl);
    }

    func destroy() {
        if (self.impl != null) {
            destroy(self.impl);
            self.impl = null;
        }
    }
}

// 全局函数：设置 socket API 使用的 reactor 实例
// 设置后，协程上下文内调 socket.recv/send/accept/connect 自动协程化（yield 等事件）
// 底层走私有机制内置 __private_system__set_socket_reactor（本函数是公开封装）
public func setReactor(r: ReactorInstance) {
    __private_system__set_socket_reactor(r.impl);
}

// 全局函数：清理全局 reactor 指针（reactor 生命周期收尾时调）
// reactor.destroy 前后必须清理 g_socket_reactor，否则 destroy 后悬空指针
// （后续 socket 操作虽走阻塞路径，但悬空指针是隐患）
public func clearReactor() {
    __private_system__set_socket_reactor(null);
}

// 全局函数：已注册 worker reactor 数（T5 acceptor 启动屏障用）。
public func reactorRegistryCount(): int {
    return __private_system__reactor_registry_count();
}
