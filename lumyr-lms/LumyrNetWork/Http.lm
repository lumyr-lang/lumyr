// ============================================================
// lumyr-Http：RequestInterface / ResponseInterface 接口
//            + HttpRequest<T, R> / HttpResponse<R> 实现类
// 面向对象封装内置 requests：链式构造请求、统一响应访问
//
// 分层：
//   RequestInterface / ResponseInterface  请求/响应统一契约
//   HttpRequest<T, R>  链式构造 + 按方法分派发送（委托内置 requests）
//   HttpResponse<R>    包装结果 map（status/headers/body），提供类型化访问
//
// 泛型 <T, R>：T = 请求体类型，R = 响应体类型，由调用方决定
// （map/array/string/bytes/标量/class 实例均可），字段为类型
// 擦除动态槽，完整保留运行时类型身份；send 返回 HttpResponse<R>
//
// 常用请求标头以 static const 属性提供（HEADER_*），
// 常用 Content-Type 值以 CONTENT_* 提供
//
// 用法（三模式）：
//   1. alias：import <NetWork/Http> as net; → net.HttpRequest(url).get();
//   2. no-alias：import <NetWork/Http>; → HttpRequest(url).get();
//   3. rename：import <NetWork/Http> {HttpRequest as Req}; → Req(url).get();
//
//   resp = HttpRequest("https://api.example.com/items")
//       .setHeader(HttpRequest.HEADER_ACCEPT, HttpRequest.CONTENT_JSON)
//       .setParam("page", "1")
//       .setTimeout(10)
//       .get();
//   if (resp.isOk()) { print(resp.json()); }
//
//   resp2 = HttpRequest("POST", url).setBody({"a": 1}).send();
// ============================================================

// HTTP 状态码枚举（RFC 7231 常用项）：成员访问 HttpStatus.OK 为编译期常量
// 判定用法：resp.isOk() / resp.statusCode() == HttpStatus.NOT_FOUND
public enum HttpStatus {
    CONTINUE = 100,
    SWITCHING_PROTOCOLS = 101,

    OK = 200,
    CREATED = 201,
    ACCEPTED = 202,
    NO_CONTENT = 204,

    MULTIPLE_CHOICES = 300,
    MOVED_PERMANENTLY = 301,
    FOUND = 302,
    NOT_MODIFIED = 304,

    BAD_REQUEST = 400,
    UNAUTHORIZED = 401,
    FORBIDDEN = 403,
    NOT_FOUND = 404,
    METHOD_NOT_ALLOWED = 405,
    REQUEST_TIMEOUT = 408,
    CONFLICT = 409,
    TOO_MANY_REQUESTS = 429,

    INTERNAL_SERVER_ERROR = 500,
    BAD_GATEWAY = 502,
    SERVICE_UNAVAILABLE = 503,
    GATEWAY_TIMEOUT = 504
}

// 请求契约：链式设置 + 发送
public interface RequestInterface {
    func setHeader(name: string, value: string): RequestInterface;
    func setParam(name: string, value: string): RequestInterface;
    func setBody(body): RequestInterface;
    func setTimeout(seconds: int): RequestInterface;
    func send();
}

// 响应契约：状态/标头/正文访问
public interface ResponseInterface {
    func statusCode(): int;
    func header(name: string): string;
    func body();
    func json();
    func text(): string;
    func isOk(): bool;
}

// Http 响应：包装内置结果 map（status/headers/body）
public class HttpResponse<T> implements ResponseInterface {
    status: int;
    headers: map;
    respBody: <T>;

    func HttpResponse(result: map) {
        self.status = result["status"];
        self.headers = result["headers"];
        self.respBody = result["body"];
    }

    // 状态码
    func statusCode(): int {
        return self.status;
    }

    // 单个响应标头（HTTP 标头大小写不敏感：原样未命中时回退小写键；
    // 内置 requests 将响应标头键统一转为小写）
    func header(name: string): string {
        if (self.headers.has(name)) {
            return self.headers[name];
        }
        lname = name.lower();
        if (self.headers.has(lname)) {
            return self.headers[lname];
        }
        return "";
    }

    // 原始正文（类型取决于 Content-Type：map/array/string/bytes）
    func body(): T {
        return self.respBody;
    }

    // JSON 正文（响应已按 Content-Type 自动解析为 map/array）
    func json(): T {
        return self.respBody;
    }

    // 文本正文（bytes 时按 UTF-8 解码）
    func text(): string {
        if (type(self.respBody) == "bytes") {
            return self.respBody.decode();
        }
        if (type(self.respBody) == "string") {
            return self.respBody;
        }
        return self.respBody.toJSONString();
    }

    // 2xx 判定（[HttpStatus.OK, HttpStatus.MULTIPLE_CHOICES) 区间）
    func isOk(): bool {
        return self.status >= HttpStatus.OK && self.status < HttpStatus.MULTIPLE_CHOICES;
    }

    // toStr
    @FuncAlias("toStr")
    func toString(): string {
        return "HttpResponse(" + self.status + ")";
    }
}

// HTTP 标头集合：大小写不敏感名值管理（内部统一小写键存储；
// HTTP 标头名大小写不敏感，内置 requests 响应标头同样按小写规范化）
public class Headers {
    items: map;

    func Headers() {
        self.items = {};
    }

    // 设置（覆盖同名标头）
    func set(name: string, value: string) {
        self.items[name.lower()] = value;
        return self;
    }

    // 追加（同名按 RFC 7230 列表语义逗号合并）
    func add(name: string, value: string) {
        k = name.lower();
        if (self.items.has(k)) {
            self.items[k] = self.items[k] + ", " + value;
        } else {
            self.items[k] = value;
        }
        return self;
    }

    func has(name: string): bool {
        return self.items.has(name.lower());
    }

    func get(name: string): string {
        k = name.lower();
        if (self.items.has(k)) { return self.items[k]; }
        return "";
    }

    func remove(name: string) {
        k = name.lower();
        if (self.items.has(k)) {
            /* map 无 delete 内置：按键集重建（标头数量小，代价可忽略） */
            kept = {};
            for key in self.items.keys() {
                if (key != k) { kept[key] = self.items[key]; }
            }
            self.items = kept;
        }
        return self;
    }

    func size(): int {
        return self.items.len;
    }

    // 转出普通 map（可直接作为 requests config 的 headers 使用）
    func toMap(): map {
        return self.items;
    }
}

// Cookie：名值 + 标准属性（Domain/Path/Max-Age/Secure/HttpOnly/SameSite）
// toHeader() → Cookie 请求头形式（"name=value"）
// toString() → Set-Cookie 完整形式；parse() 解析 Set-Cookie 字符串
public class Cookie {
    name: string;
    value: string;
    domain: string;
    path: string;
    maxAge: int;
    secure: bool;
    httpOnly: bool;
    sameSite: string;

    func Cookie(name: string, value: string) {
        self.name = name;
        self.value = value;
        self.domain = "";
        self.path = "";
        self.maxAge = 0;
        self.secure = false;
        self.httpOnly = false;
        self.sameSite = "";
    }

    func setDomain(d: string) { self.domain = d; return self; }
    func setPath(p: string) { self.path = p; return self; }
    func setMaxAge(seconds: int) { self.maxAge = seconds; return self; }
    func setSecure(on: bool) { self.secure = on; return self; }
    func setHttpOnly(on: bool) { self.httpOnly = on; return self; }
    // SameSite："Strict" / "Lax" / "None"
    func setSameSite(s: string) { self.sameSite = s; return self; }

    // Cookie 请求头形式："name=value"
    func toHeader(): string {
        return self.name + "=" + self.value;
    }

    // Set-Cookie 完整形式
    @FuncAlias("toStr")
    func toString(): string {
        s = self.name + "=" + self.value;
        if (self.domain != "") { s = s + "; Domain=" + self.domain; }
        if (self.path != "") { s = s + "; Path=" + self.path; }
        if (self.maxAge > 0) { s = s + "; Max-Age=" + self.maxAge; }
        if (self.secure == true) { s = s + "; Secure"; }
        if (self.httpOnly == true) { s = s + "; HttpOnly"; }
        if (self.sameSite != "") { s = s + "; SameSite=" + self.sameSite; }
        return s;
    }

    // 解析 Set-Cookie 字符串（首段为名值，其余按属性名小写识别；
    // Expires 日期属性忽略，Max-Age 转 int）
    public static func parse(s: string): Cookie {
        segs = s.split(";");
        kv = segs[0].split("=");
        c = Cookie(kv[0].trim(), kv.slice(1, kv.len).join("=").trim());
        i = 1;
        while (i < segs.len) {
            attr = segs[i].split("=");
            aname = attr[0].trim().lower();
            aval = "";
            if (attr.len > 1) { aval = attr.slice(1, attr.len).join("=").trim(); }
            if (aname == "domain") { c.domain = aval; }
            else if (aname == "path") { c.path = aval; }
            else if (aname == "max-age") {
                ma: int = aval;
                c.maxAge = ma;
            }
            else if (aname == "samesite") { c.sameSite = aval; }
            else if (aname == "secure") { c.secure = true; }
            else if (aname == "httponly") { c.httpOnly = true; }
            i = i + 1;
        }
        return c;
    }
}

// UserAgent：常见 UA 常量 + 自定义构造（主 product/version + 注释段 + 追加 product 段）
public class UserAgent {
    public static const CHROME: string = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36";
    public static const FIREFOX: string = "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:121.0) Gecko/20100101 Firefox/121.0";
    public static const SAFARI: string = "Mozilla/5.0 (Macintosh; Intel Mac OS X 14_0) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Safari/605.1.15";
    public static const EDGE: string = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 Edg/120.0.0.0";
    public static const CURL: string = "curl/8.4.0";
    public static const LUMYR: string = "lumyr/1.0";

    text: string;

    // 以主 product/version 构造："product/version"
    func UserAgent(product: string, version: string) {
        self.text = product + "/" + version;
    }

    // 追加注释段：" (comment)"
    func comment(c: string) {
        self.text = self.text + " (" + c + ")";
        return self;
    }

    // 追加 product 段：" product/version"
    func product(p: string, v: string) {
        self.text = self.text + " " + p + "/" + v;
        return self;
    }

    @FuncAlias("toStr")
    func toString(): string {
        return self.text;
    }
}

// Http 请求：链式构造，send 委托内置 requests 按方法分派
// 泛型 <T, R>：T = 请求体类型（setBody 参数），R = 响应体类型（send 返回 HttpResponse<R>）
public class HttpRequest<T, R> implements RequestInterface {
    // ========== 常用请求标头（static const） ==========
    public static const HEADER_ACCEPT: string = "Accept";
    public static const HEADER_AUTHORIZATION: string = "Authorization";
    public static const HEADER_CACHE_CONTROL: string = "Cache-Control";
    public static const HEADER_CONTENT_TYPE: string = "Content-Type";
    public static const HEADER_COOKIE: string = "Cookie";
    public static const HEADER_HOST: string = "Host";
    public static const HEADER_USER_AGENT: string = "User-Agent";

    // ========== 常用 Content-Type 值（static const） ==========
    public static const CONTENT_JSON: string = "application/json";
    public static const CONTENT_FORM: string = "application/x-www-form-urlencoded";
    public static const CONTENT_TEXT: string = "text/plain";
    public static const CONTENT_HTML: string = "text/html";
    public static const CONTENT_XML: string = "application/xml";
    public static const CONTENT_OCTET: string = "application/octet-stream";

    method: string;
    url: string;
    headers: map;
    params: map;
    reqBody: <T>;
    hasBody: bool;
    timeoutSec: int;
    respType: string;

    func HttpRequest(url: string) {
        self.method = "GET";
        self.url = url;
        self.headers = {};
        self.params = {};
        self.reqBody = null;
        self.hasBody = false;
        self.timeoutSec = 0;
        self.respType = "";
    }

    func HttpRequest(method: string, url: string) {
        self.method = method;
        self.url = url;
        self.headers = {};
        self.params = {};
        self.reqBody = null;
        self.hasBody = false;
        self.timeoutSec = 0;
        self.respType = "";
    }

    // 链式设置请求标头
    func setHeader(name: string, value: string) {
        self.headers[name] = value;
        return self;
    }

    // 链式合并 Headers 集合（大小写不敏感，键已小写规范化）
    func setHeaders(h: Headers) {
        for k in h.toMap().keys() {
            self.headers[k] = h.toMap()[k];
        }
        return self;
    }

    // 链式追加 Cookie（多个按 "; " 连接，Cookie 请求头语义）
    func addCookie(c: Cookie) {
        if (self.headers.has("Cookie")) {
            self.headers["Cookie"] = self.headers["Cookie"] + "; " + c.toHeader();
        } else {
            self.headers["Cookie"] = c.toHeader();
        }
        return self;
    }

    // 链式设置 User-Agent（UserAgent 实例或 UA 字符串均可，传字符串）
    func setUserAgent(ua: string) {
        self.headers["User-Agent"] = ua;
        return self;
    }

    // 链式设置 query 参数
    func setParam(name: string, value: string) {
        self.params[name] = value;
        return self;
    }

    // 链式设置请求体（map/array 自动 JSON；bytes 原始字节；类型由 T 决定）
    func setBody(body: T) {
        self.reqBody = body;
        self.hasBody = true;
        return self;
    }

    // 链式设置超时（秒）
    func setTimeout(seconds: int) {
        self.timeoutSec = seconds;
        return self;
    }

    // 链式设置 multipart 表单（formdata 经 body 通道，requests 按类型识别为 multipart）
    func setFormData(fd: formdata) {
        self.reqBody = fd;
        self.hasBody = true;
        return self;
    }

    // 链式设置响应类型（"json"/"text"/"bytes"，缺省按 Content-Type 自动）
    func setResponseType(rt: string) {
        self.respType = rt;
        return self;
    }

    // 组装 config：仅放入已设置/非空的项
    func buildConfig(): map {
        out = {};
        if (self.params.len > 0) { out["params"] = self.params; }
        if (self.headers.len > 0) { out["headers"] = self.headers; }
        if (self.timeoutSec > 0) { out["timeout"] = self.timeoutSec; }
        if (self.hasBody) { out["body"] = self.reqBody; }
        if (self.respType != "") { out["responseType"] = self.respType; }
        return out;
    }

    // 按 method 分派发送，返回 HttpResponse
    func send() {
        config = self.buildConfig();
        m = self.method;
        r = null;
        if (m == "GET") { r = requests.get(self.url, config); }
        else if (m == "POST") { r = requests.post(self.url, config); }
        else if (m == "PUT") { r = requests.put(self.url, config); }
        else if (m == "DELETE") { r = requests.delete(self.url, config); }
        else if (m == "HEAD") { r = requests.head(self.url, config); }
        else if (m == "PATCH") { r = requests.patch(self.url, config); }
        else { throw "HttpRequest: 不支持的请求方法 / unsupported method: " + m; }
        return HttpResponse<R>(r);
    }

    // ========== 方法快捷 ==========
    func get() {
        self.method = "GET";
        return self.send();
    }

    func post() {
        self.method = "POST";
        return self.send();
    }

    func put() {
        self.method = "PUT";
        return self.send();
    }

    func delete() {
        self.method = "DELETE";
        return self.send();
    }

    func patch() {
        self.method = "PATCH";
        return self.send();
    }

    func head() {
        self.method = "HEAD";
        return self.send();
    }
}
