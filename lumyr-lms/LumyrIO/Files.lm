// ============================================================
// lumyr-Files：文件系统静态工具类（门面 / Facade）
// 统一封装内置 file/folder 对象：文本/行/字节读写、存在性与类型判断、
// 复制/移动/重命名/删除、目录创建/列举/遍历/通配
//
// 全部方法为静态方法，内部即时构造 file()/folder() 对象（无持久句柄）。
//
// 用法：
//   import <IO/Files>;
//   Files.createDir("/tmp/demo");
//   Files.writeText("/tmp/demo/a.txt", "hello");
//   print(Files.readText("/tmp/demo/a.txt"));   // hello
//
// 行号语义（底层一致）：readLine 为 0 基，支持负索引（-1 末行）；
// writeLines 写多行（末尾带换行）；appendText 原样追加不补换行。
// ============================================================

public class Files {

    // ========== 平台 ==========
    // 路径分隔符（按平台条件编译：Windows 为 \，其余为 /）
    #if windows
    static const separator: string = "\\";
    #else
    static const separator: string = "/";
    #endif

    // ========== 读取 ==========
    // 读取全部文本
    static func readText(path: string): string {
        return file(path).readAll();
    }
    // 读取全部行（数组）
    static func readLines(path: string): array {
        return file(path).readLines();
    }
    // 读取指定行（n 为 0 基，支持负数）
    static func readLine(path: string, n: int): string {
        return file(path).readLine(n);
    }
    // 读取为字节对象
    static func readBytes(path: string): bytes {
        return file(path).readBytes();
    }

    // ========== 写入 ==========
    // 整体写入文本（覆盖）
    static func writeText(path: string, text: string): void {
        file(path).writeAll(text);
    }
    // 写入多行（数组，覆盖）
    static func writeLines(path: string, lines: array): void {
        file(path).writeLines(lines);
    }
    // 改写第 n 行
    static func writeLine(path: string, n: int, text: string): void {
        file(path).writeLine(n, text);
    }
    // 在第 n 行前插入一行
    static func insertLine(path: string, n: int, text: string): void {
        file(path).insertLine(n, text);
    }
    // 原样追加文本（不补换行）
    static func appendText(path: string, text: string): void {
        file(path).append(text);
    }
    // 追加一行
    static func appendLine(path: string, text: string): void {
        file(path).appendLine(text);
    }
    // 写入字节对象（覆盖）
    static func writeBytes(path: string, b: bytes): void {
        file(path).writeBytes(b);
    }

    // ========== 信息查询 ==========
    // 路径是否存在（文件或目录）
    static func exists(path: string): bool {
        return file(path).exists;
    }
    // 是否为目录
    static func isDir(path: string): bool {
        return folder(path).exists;
    }
    // 是否为普通文件
    static func isFile(path: string): bool {
        return file(path).exists && !folder(path).exists;
    }
    // 文件大小（字节）
    static func size(path: string): int {
        return file(path).size;
    }
    // 目录总大小（递归全部文件字节数）
    static func dirSize(path: string): int {
        return folder(path).size;
    }
    // 文件名（不含目录）
    static func name(path: string): string {
        return file(path).name;
    }
    // 扩展名（不含 .，无扩展返回空串）
    static func ext(path: string): string {
        return file(path).ext;
    }

    // ========== 复制 / 移动 / 重命名 / 删除 ==========
    // 复制文件或目录（按实际类型分派）
    static func copy(src: string, dest: string): void {
        if (folder(src).exists) { folder(src).copyTo(dest); return; }
        file(src).copyTo(dest);
    }
    // 移动文件或目录
    static func move(src: string, dest: string): void {
        if (folder(src).exists) { folder(src).moveTo(dest); return; }
        file(src).renameTo(dest);
    }
    // 重命名（文件或目录）
    static func rename(path: string, newPath: string): void {
        if (folder(path).exists) { folder(path).renameTo(newPath); return; }
        file(path).renameTo(newPath);
    }
    // 删除文件或目录（目录递归删除；路径不存在时幂等不报错）
    static func delete(path: string): void {
        // 底层 file.delete 对不存在路径会报错（folder.remove 已幂等），
        // 门面统一：先判存在
        if (!file(path).exists) { return; }
        if (folder(path).exists) { folder(path).remove(); return; }
        file(path).delete();
    }
    // 截断文件到指定字节数
    static func truncate(path: string, size: int): void {
        file(path).truncate(size);
    }

    // ========== 目录操作 ==========
    // 创建目录（递归，类似 mkdir -p）
    static func createDir(path: string): void {
        folder(path).create();
    }
    // 列举直接子项（文件与目录名）
    static func list(path: string): array {
        return folder(path).list();
    }
    // 列举直接文件
    static func listFiles(path: string): array {
        return folder(path).files();
    }
    // 列举直接子目录
    static func listDirs(path: string): array {
        return folder(path).dirs();
    }
    // 递归遍历全部文件（完整路径）
    static func walk(path: string): array {
        return folder(path).walk();
    }
    // 通配匹配（如 *.txt）
    static func glob(path: string, pattern: string): array {
        return folder(path).glob(pattern);
    }
}
