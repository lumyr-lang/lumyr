// 场景1 + 场景5 组合测试
print("=== 场景1 + 场景5 组合测试 ===");

// 场景1：多层继承
class Animal {
    name: string;
    func speak(self) {
        print("Animal speaks");
    }
    func get_name(self) {
        return self.name;
    }
}

class Dog extends Animal {
    func speak(self) {
        print("Dog barks");
    }
}

class Puppy extends Dog {
    func speak(self) {
        print("Puppy yips");
    }
}

puppy = Puppy();
puppy.name = "Max";
print("puppy.name =", puppy.get_name());
puppy.speak();

// 场景5：结构体方法
struct Point {
    x: int;
    y: int;
    func distance(self, other) {
        dx = self.x - other.x;
        dy = self.y - other.y;
        return dx * dx + dy * dy;
    }
}

p1 = Point();
p1.x = 0;
p1.y = 0;
p2 = Point();
p2.x = 3;
p2.y = 4;
print("p1.distance(p2) =", p1.distance(p2));

print("=== 场景1 + 场景5 组合测试完成 ===");
