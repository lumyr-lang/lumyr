// class_interface_test.lm - class 实现接口测试
print("=== Class Interface Test ===");

// class 实现单个接口
class Point implements Printable {
    x: int;
    y: int;
    func __init__(self, x, y) {
        self.x = x;
        self.y = y;
    }
    func to_string(self) {
        return "Point(" + self.x + ", " + self.y + ")";
    }
}

// 测试
print("\n--- 1. class 实现单个接口 ---");
p = Point(3, 4);
print("Point to_string:", p.to_string());

print("\n=== All Class Interface Tests Passed ===");
