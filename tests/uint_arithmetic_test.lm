// 测试：uint类型专用算术运算和比较运算指令（零检查零转换零Value开销）
print("=== uint类型专用算术运算和比较运算测试 ===\n");

// 声明uint变量
a = <uint>10;
b = <uint>3;
c = <uint>10;

print("a = ");
print(a);
print(", b = ");
print(b);
print(", c = ");
print(c);
print("\n");

// 算术运算
print("a + b = ");
print(a + b);
print("\n");
print("a - b = ");
print(a - b);
print("\n");
print("a * b = ");
print(a * b);
print("\n");
print("a / b = ");
print(a / b);
print("\n");
print("a % b = ");
print(a % b);
print("\n");

// 比较运算
print("a > b = ");
print(a > b);
print("\n");
print("a < b = ");
print(a < b);
print("\n");
print("a >= c = ");
print(a >= c);
print("\n");
print("a <= c = ");
print(a <= c);
print("\n");
print("a == c = ");
print(a == c);
print("\n");
print("a != b = ");
print(a != b);
print("\n");

// 条件判断中使用比较运算
if(a > b) {
    print("a > b is true\n");
} else {
    print("a > b is false\n");
}

if(a == c) {
    print("a == c is true\n");
} else {
    print("a == c is false\n");
}

print("=== 测试完成 ===\n");
