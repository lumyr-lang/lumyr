// 测试 __structname__ 只读常量属性
print("=== Struct Name Property Test ===");

struct Point {
    x: int;
    y: int;
}

p = Point(10, 20);

// 测试 __mapname__（已有）
print("__mapname__:", p.__mapname__);

// 测试 __structname__（新增）
print("__structname__:", p.__structname__);

// 测试通过函数参数访问
func get_struct_name(<Point>pt) {
    return pt.__structname__;
}
print("via func:", get_struct_name(p));

// 测试嵌套 struct
struct Rect {
    top_left: Point;
    width: int;
    height: int;
}
r = Rect(Point(1, 2), 100, 200);
print("Rect __structname__:", r.__structname__);

// 测试只读属性不能赋值（应该报错）
// p.__structname__ = "NewName";  // 这行应该报错

print("=== Struct Name Property Test Passed ===");
