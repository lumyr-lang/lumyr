// 测试：声明为 int 类型的变量 + int 泛型数组（零检查零转换）
print("=== int 变量 + int 泛型数组测试 ===\n")

// 声明为 int 类型的变量（语法：a = <int>5）
a = <int>5
b = <int>10
c = <int>15

print("a = ", a, "\n")
print("b = ", b, "\n")
print("c = ", c, "\n")

// 使用声明为 int 的变量创建 int 泛型数组（应该走零检查零转换路径）
arr = <int>[a, b, c]
print("arr type = ", type(arr), "\n")
print("arr len = ", len(arr), "\n")
print("arr[0] = ", arr[0], "\n")
print("arr[1] = ", arr[1], "\n")
print("arr[2] = ", arr[2], "\n")

// 混合场景：int 变量 + 常量
arr2 = <int>[a, 100, b, 200]
print("\narr2 type = ", type(arr2), "\n")
print("arr2 len = ", len(arr2), "\n")
print("arr2 = [", arr2[0], ", ", arr2[1], ", ", arr2[2], ", ", arr2[3], "]\n")

// 全常量数组
arr3 = <int>[1, 2, 3, 4, 5]
print("\narr3 type = ", type(arr3), "\n")
print("arr3 len = ", len(arr3), "\n")

print("\n=== 测试完成 ===\n")
