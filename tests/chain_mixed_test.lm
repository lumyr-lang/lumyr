print("C282:" + type(r282) + "=" + r282);

/* E3: 整数除零得 0 */
r283 = (10 / 0);
print("C283:" + type(r283) + "=" + r283);

/* E4: 浮点除零得 0 */
r284 = (3.0 / 0.0);
print("C284:" + type(r284) + "=" + r284);

/* E5: 负数参与链式运算 */
