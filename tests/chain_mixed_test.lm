print("C288:" + type(r288) + "=" + r288);

/* E9: 字符串链式拼接 */
r289 = (("a" + 1) + 2);
print("C289:" + type(r289) + "=" + r289);

/* E10: 字符串重复后拼接 */
r290 = (("ab" * 3) + "cd");
print("C290:" + type(r290) + "=" + r290);

/* E11: 字符串除法前缀截取 */
r291 = ("abcabc" / 3);
print("C291:" + type(r291) + "=" + r291);

/* E12: 字符串减法尾部截取 */
r292 = ("abcabc" - 3);
print("C292:" + type(r292) + "=" + r292);

/* E13: 数字减字符串首部截取 */
r293 = (3 - "abcabc");
print("C293:" + type(r293) + "=" + r293);

/* E14: bool+char 整数化 true+65+1 */
