print("C286:" + type(r286) + "=" + r286);

/* E7: decimal 0.1+0.2 */
r287 = (<decimal>"0.1" + <decimal>"0.2");
print("C287:" + type(r287) + "=" + r287);

/* E8: double 0.1+0.2（%%f 6 位） */
