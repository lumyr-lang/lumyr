// 测试类型化数组的其他操作
print("=== 测试类型化数组的其他操作 ===");

// 测试 int 类型化数组的 add
int_arr = <int>[1, 2, 3];
print("原始数组长度:", len(int_arr));
int_arr.add(4);
print("add 后长度:", len(int_arr));
print("add 后最后一个元素:", int_arr[3]);

// 测试 int 类型化数组的 remove
int_arr.remove(0);
print("remove(0) 后长度:", len(int_arr));
print("remove(0) 后第一个元素:", int_arr[0]);

// 测试 int 类型化数组的 clear
int_arr.clear();
print("clear 后长度:", len(int_arr));

// 测试 double 类型化数组的 add
double_arr = <double>[1.1, 2.2];
double_arr.add(3.3);
print("\ndouble 数组 add 后长度:", len(double_arr));
print("double 数组 add 后最后一个元素:", double_arr[2]);

// 测试类型化数组的 first 和 last
int_arr2 = <int>[10, 20, 30];
print("\nint 数组 first:", int_arr2.first());
print("int 数组 last:", int_arr2.last());

// 测试类型化数组的 indexOf
print("int 数组 indexOf(20):", int_arr2.indexOf(20));
print("int 数组 indexOf(100):", int_arr2.indexOf(100));

print("\n=== 所有测试完成 ===");
