// tests/branch_retype_test.lm
// 回归：条件分支（if/elif/else、while、for、do-while、switch case、catch）
// 的 body 可能不执行，body 内把已 typed 变量用动态值（方法调用等返回 NONE）
// 重定型换栈后，分支未走时变量类型标签指向新栈而值仍在旧栈，分支出口读取
// 即四栈错位（典型表现：if(false){ x = s.len } 后 x 变成 null，甚至段错误）。
// 根因：四栈 VM 单遍编译，AST_ASSIGN 的 typed→NONE 重定型不区分直线代码与
// 条件执行区间；修复：编译期 branch_depth>0 时禁止重定型，强制 unbox 保原栈。

func check(cond, msg) {
    if (cond == false) { throw msg; }
}

s = "ABCDEFG";   // s.len == 7（动态方法调用，结果类型 NONE）

// 1) if 条件为假：body 不执行，INT 变量必须保持原值
x1 = 100;
if (false) {
    x1 = s.len;
}
check(x1 == 100, "1. if(false) + method call: " + x1);

// 2) if 条件为真：赋值正常执行，按 INT unbox 存储
x2 = 100;
if (true) {
    x2 = s.len;
}
check(x2 == 7, "2. if(true) + method call: " + x2);

// 3) if-else：走 else
x3 = 10;
if (false) {
    x3 = 20;
} else {
    x3 = 30;
}
check(x3 == 30, "3. if-else: " + x3);

// 4) else-if 链：命中中间分支
x4 = 10;
if (false) {
    x4 = 20;
} else if (true) {
    x4 = s.len;
} else {
    x4 = 50;
}
check(x4 == 7, "4. else-if chain: " + x4);

// 5) 嵌套 if：内层为假
x5 = 10;
if (true) {
    if (false) {
        x5 = s.len;
    }
    check(x5 == 10, "5. nested if inner: " + x5);
}
check(x5 == 10, "5. nested if outer: " + x5);

// 6) if(false) 中跨类型赋值（INT→字符串）不得段错误、不得丢值
x6 = 100;
if (false) {
    x6 = "hello";
}
check(x6 == 100, "6. if(false) cross-type assign: " + x6);

// 7) while 初始条件即假：body 一次不执行
x7 = 100;
while (false) {
    x7 = s.len;
}
check(x7 == 100, "7. while(false): " + x7);

// 8) for 循环 0 次
x8 = 100;
for (i = 0; i < 0; i = i + 1) {
    x8 = s.len;
}
check(x8 == 100, "8. for zero iterations: " + x8);

// 9) 正常 while 多轮：body 内动态值赋给 INT 变量，每轮累加正确
x9 = 0;
i9 = 0;
while (i9 < 5) {
    x9 = x9 + s.len;
    i9 = i9 + 1;
}
check(x9 == 35, "9. while multi-iteration: " + x9);

// 10) do-while 多轮：body 回边重放时类型稳定
x10 = 0;
do {
    x10 = x10 + 1;
} while (x10 < 3);
check(x10 == 3, "10. do-while: " + x10);

// 11) switch：命中 case，default 不执行
x11 = 100;
v11 = 1;
switch (v11) {
    case 1: {
        x11 = 200;
        break;
    }
    default: {
        x11 = s.len;
    }
}
check(x11 == 200, "11. switch case hit, default skipped: " + x11);

// 12) switch：无 case 命中，走 default
x12 = 100;
v12 = 5;
switch (v12) {
    case 1: {
        x12 = s.len;
        break;
    }
    case 2: {
        x12 = 999;
        break;
    }
    default: {
        x12 = 777;
    }
}
check(x12 == 777, "12. switch default: " + x12);

// 13) try 不抛异常：catch body 不执行
x13 = 100;
try {
    dummy = 1;
} catch (e) {
    x13 = s.len;
}
check(x13 == 100, "13. try no-throw, catch skipped: " + x13);

// 14) try 抛异常：catch 正常执行，按 INT unbox 存储
x14 = 100;
try {
    throw "boom";
} catch (e) {
    x14 = s.len;
}
check(x14 == 7, "14. try throw, catch runs: " + x14);

// 15) PTR(字符串) 变量在未走分支中保持原值
p = "original";
if (false) {
    p = "changed";
}
check(p == "original", "15. PTR var preserved: [" + p + "]");

// 16) 直线代码重定型仍然允许（修复不得影响正常的类型迁移）
q = 100;
q = s.toUpperCase();
check(q == "ABCDEFG", "16. straight-line retype allowed: [" + q + "]");

print("branch_retype_test ALL PASS");
