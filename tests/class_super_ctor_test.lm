// class_super_ctor_test.lm - class super(...) 调用父类构造函数测试
print("=== Class Super Constructor Test ===");

class Animal {
    name: string;
    age: int;
    func __init__(self, name, age) {
        self.name = name;
        self.age = age;
        print("Animal constructor called:", name, age);
    }
    func speak(self) {
        print("Animal speaks");
    }
}

class Dog extends Animal {
    breed: string;
    func __init__(self, name, age, breed) {
        super(name, age);
        self.breed = breed;
        print("Dog constructor called:", name, age, breed);
    }
    func speak(self) {
        print("Dog barks");
    }
}

print("--- 1. super(...) 调用父类构造函数 ---");
d = Dog("Buddy", 2, "Golden");
print("name:", d.name);
print("age:", d.age);
print("breed:", d.breed);
d.speak();

print("\n=== All Class Super Constructor Tests Passed ===");
