public class RetPrefix<K,V> {
    func RetPrefix() {}
    func mk(): <K,V>map {
        return {"p1": 41, "p2": 42};
    }
}

rp19 = RetPrefix<string,int>();
m19 = rp19.mk();
check(type(m19) == "typed_map", "M-GP19: return should be typed_map, got " + type(m19));
