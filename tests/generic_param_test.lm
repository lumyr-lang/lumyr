n = n + 1;

// ===== M-GP12: 空 <K,V>{} 局部变量下标写入 + GC 压力 =====
public class LocalGc<K,V> {
    func LocalGc() {}
    func run(k, v) {
        m = <K,V>{};
        m[k] = v;
        return m[k];
    }
    func runType(): string {
        m = <K,V>{};
        return type(m);
    }
}

lg12 = LocalGc<string,int>();
check(lg12.runType() == "typed_map", "M-GP12: empty local should be typed_map");
check(lg12.run("ek", 777) == 777, "M-GP12: empty local write should be 777");
i = 0;
while (i < 1000) {
    t = LocalGc<string,int>();
    t.run("k" + i, i);
    i = i + 1;
}
check(lg12.runType() == "typed_map", "M-GP12: local should still be typed_map after GC");
n = n + 1;

// ===== M-GP13: <K,V>expr 强转（非字面量）在泛型类方法体内构造 typed_map =====
public class CastLocal<K,V> {
    func CastLocal() {}
    func castType(m): string {
        x = <K,V>m;
        return type(x);
    }
    func castVal(m, k) {
        x = <K,V>m;
        return x[k];
    }
}

cl13 = CastLocal<string,int>();
src13 = {"a": 11, "b": 22};
check(cl13.castType(src13) == "typed_map", "M-GP13: cast local should be typed_map, got " + cl13.castType(src13));
check(cl13.castVal(src13, "a") == 11, "M-GP13: cast local[a] should be 11");
check(cl13.castVal(src13, "b") == 22, "M-GP13: cast local[b] should be 22");
n = n + 1;

// ===== M-GP14: <E>expr 强转（非字面量）在泛型类方法体内构造 typed_array =====
public class CastArr<E> {
    func CastArr() {}
    func castType(a): string {
        x = <E>a;
        return type(x);
    }
    func castVal(a, i) {
        x = <E>a;
        return x[i];
    }
}

ca14 = CastArr<int>();
src14 = [1, 2, 3];
check(ca14.castType(src14) == "typed_array", "M-GP14: cast local should be typed_array, got " + ca14.castType(src14));
check(ca14.castVal(src14, 0) == 1, "M-GP14: cast local[0] should be 1");
check(ca14.castVal(src14, 2) == 3, "M-GP14: cast local[2] should be 3");
n = n + 1;

// ===== M-GP15: 后缀式泛型容器形参 m: map<K,V> 在方法入口按实参转 typed_map =====
public class ParamSuffix<K,V> {
    func ParamSuffix() {}
    func ptype(m: map<K,V>): string {
        return type(m);
    }
    func pval(m: map<K,V>, k) {
        return m[k];
    }
}

ps15 = ParamSuffix<string,int>();
src15 = {"a": 1, "b": 2};
check(ps15.ptype(src15) == "typed_map", "M-GP15: param should be typed_map, got " + ps15.ptype(src15));
check(ps15.pval(src15, "a") == 1, "M-GP15: param[a] should be 1");
check(ps15.pval(src15, "b") == 2, "M-GP15: param[b] should be 2");
n = n + 1;

