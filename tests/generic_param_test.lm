// ===== M-GP20: 路径 6 父类泛型形参改名继承（extends Base<K,V>），
//              子类字段索引按父实参名重映射，generic_bind 按子类形参序转 typed_map =====
public class BaseRename<KA,VA> {
    data: <KA,VA>map;
    func BaseRename() {}
}

public class DerivedRename<K,V> extends BaseRename<K,V> {
    func DerivedRename() {
        self.data = {"rk": 55};
    }
    func rtype(): string {
        return type(self.data);
    }
    func rget(k) {
        return self.data[k];
    }
}

dr20 = DerivedRename<string,int>();
check(type(dr20.data) == "typed_map", "M-GP20: inherited field should be typed_map, got " + type(dr20.data));
check(dr20.rtype() == "typed_map", "M-GP20: inherited field via method should be typed_map");
check(dr20.rget("rk") == 55, "M-GP20: inherited field[rk] should be 55");
n = n + 1;

// ===== M-GP21: ref 后缀式泛型容器形参 ref m: map<K,V> 转换写穿回调用方 =====
public class RefSuffix<K,V> {
    func RefSuffix() {}
    func fill(ref m: map<K,V>) {
        m["added"] = 71;
    }
}

rs21 = RefSuffix<string,int>();
src21 = {"orig": 70};
rs21.fill(src21);
check(type(src21) == "typed_map", "M-GP21: caller var should become typed_map, got " + type(src21));
check(src21["added"] == 71, "M-GP21: mutation via ref should be visible at caller");
check(src21["orig"] == 70, "M-GP21: original entry should be preserved");
n = n + 1;

// ===== M-GP22: ref 前缀式泛型容器形参 ref m: <K,V>map 转换写穿回调用方 =====
public class RefPrefix<K,V> {
    func RefPrefix() {}
    func fill(ref m: <K,V>map) {
        m["added"] = 81;
    }
}

rp22 = RefPrefix<string,int>();
src22 = {"orig": 80};
rp22.fill(src22);
check(type(src22) == "typed_map", "M-GP22: caller var should become typed_map, got " + type(src22));
check(src22["added"] == 81, "M-GP22: mutation via ref should be visible at caller");
check(src22["orig"] == 80, "M-GP22: original entry should be preserved");
n = n + 1;

