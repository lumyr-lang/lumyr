public class RetSuffix<K,V> {
    func RetSuffix() {}
    func mk(): map<K,V> {
        return {"r1": 31, "r2": 32};
    }
}

rs18 = RetSuffix<string,int>();
m18 = rs18.mk();
check(type(m18) == "typed_map", "M-GP18: return should be typed_map, got " + type(m18));
check(m18["r1"] == 31, "M-GP18: return[r1] should be 31");
