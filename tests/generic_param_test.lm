// ===== M-GP17: 前缀式泛型数组形参 a: <E>array 在方法入口按实参转 typed_array =====
public class ArrPrefix<E> {
    func ArrPrefix() {}
    func atype(a: <E>array): string {
        return type(a);
    }
    func aval(a: <E>array, i) {
        return a[i];
    }
}

ap17 = ArrPrefix<int>();
src17 = [7, 8, 9];
check(ap17.atype(src17) == "typed_array", "M-GP17: param should be typed_array, got " + ap17.atype(src17));
