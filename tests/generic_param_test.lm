    func NullSuffix() {}
    func ntype(m: map<K,V>?): string {
        return type(m);
    }
}

ns23 = NullSuffix<string,int>();
check(ns23.ntype({"k": 91}) == "typed_map", "M-GP23: nullable param should be typed_map, got " + ns23.ntype({"k": 91}));
n = n + 1;

