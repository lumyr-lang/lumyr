// ============================================================
// HTTP 真实接口参数类型推断 · 端到端测试
//
// 真实启动 WebApplication（真 socket 监听、真 HTTP 报文解析、真注解路由），
// 经内置 HTTP 客户端（socket 直连）发起真实请求，验证控制器方法接收到的
//   - 路径参数（:name）
//   - query 参数
//   - JSON body（DTO 模型绑定）
// 参数类型推断是否正确，以及非法/超限/缺失参数是否走 400 通道。
//
// 自验证：startAsync 后台启动 → 发请求断言 → stop，exit 0。
// ============================================================

import <App/WebApplication>;
import <NetWork/Http>;

// JSON body 嵌套 DTO
class AddrIn {
    city: string = "";
    zip: int = 0;
}

// JSON body DTO（公开字段，字段初始化器提供默认值）
class UserIn {
    name: string = "";
    age: int = 0;
    score: double = 0.0;
    addr: AddrIn;
}

// 深嵌套实体类 DTO：Company → Dept → Team → Member（四级）
class Member {
    name: string = "";
    age: int = 0;
    salary: long = 0;
}

class Team {
    title: string = "";
    lead: Member;      // 二级嵌套对象
    members: array;    // 数组字段（元素保留 JSON 原结构）
}

class Dept {
    name: string = "";
    team: Team;        // 三级嵌套
    tags: array;       // 数组字段
    meta: map;         // map 字段
}

class CompanyIn {
    company: string = "";
    dept: Dept;        // 四级深嵌套
    extra: any;        // 未标注字段：JSON 原结构保留
    founded: bigint;
    score: double = 0.0;
    active: bool = false;
    bin: bytes;
}

// any 场景专项 DTO：payload 任意 JSON 值、m map 混合值、a array 混合元素
class AnyIn {
    payload: any;    // 未标注：任意 JSON 值原样保留（编译期选 CAST_VOID 直通）
    m: map;          // map 字段：各值类型逐个保留
    a: array;        // array 字段：各元素类型逐个保留
}

// 超限数字 body DTO：各整数/高精度类型字段
class NumIn {
    i: int = 0;
    l: long = 0;
    ll: long long = 0;
    ul: ulong = 0;
    i8: int8 = 0;
    i16: int16 = 0;
    sh: short = 0;
    by: byte = 0;
    u16: ushort = 0;
    ui: uint = 0;
    u64: uint64 = 0;
    sz: size_t = 0;
    sst: ssize_t = 0;
    f: float = 0.0;
    ld: long double = 0.0;
    bd: bitdecimal;
    bo: bool = false;
    ch: char = ' ';
    bi: bigint;
    dec: decimal;
    d: double = 0.0;
}

@Controller("/api")
class ParamController {

    // 路径标量参数：int8（范围 -128..127，超范围须 400）
    @Get("/u/:id")
    func byId(req, id: int8) {
        r = ServerResponse(200);
        r.json({"idType": type(id), "id": id});
        return r;
    }

    // query 多类型参数：string / int / double
    @Get("/s")
    func search(req, name: string, page: int, ratio: double) {
        r = ServerResponse(200);
        r.json({
            "nameType": type(name), "name": name,
            "pageType": type(page), "page": page,
            "ratioType": type(ratio), "ratio": ratio
        });
        return r;
    }

    // JSON body 模型绑定
    @Post("/u")
    func create(req, user: UserIn) {
        city = null;
        zipType = "none";
        ad = user.addr;
        if (ad != null) {
            city = ad.city;
            zipType = type(ad.zip);
        }
        r = ServerResponse(200);
        r.json({
            "nameType": type(user.name), "name": user.name,
            "ageType": type(user.age), "age": user.age,
            "scoreType": type(user.score), "score": user.score,
            "city": city, "zipType": zipType
        });
        return r;
    }

    // ---- 超限数字 query 端点：每类型一个，返回 {t: 推断类型, s: 字符串形态} ----
    @Get("/t/i8")
    func tI8(req, v: int8) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/i")
    func tI(req, v: int) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/l")
    func tL(req, v: long) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/ll")
    func tLL(req, v: long long) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/ul")
    func tUL(req, v: ulong) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/bi")
    func tBI(req, v: bigint) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/d")
    func tD(req, v: double) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/ld")
    func tLD(req, v: long double) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/f")
    func tF(req, v: float) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/dec")
    func tDEC(req, v: decimal) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/bd")
    func tBD(req, v: bitdecimal) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    // ---- 窄整型/无符号/bool/char query 端点（绑定层分派完整性验证）----
    @Get("/t/i16")
    func tI16(req, v: int16) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/u16")
    func tU16(req, v: ushort) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/by")
    func tBY(req, v: byte) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/ui")
    func tUI(req, v: uint) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/u64")
    func tU64(req, v: uint64) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/sz")
    func tSZ(req, v: size_t) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/sst")
    func tSST(req, v: ssize_t) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/bo")
    func tBO(req, v: bool) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    @Get("/t/ch")
    func tCH(req, v: char) { r = ServerResponse(200); r.json({"t": type(v), "s": (string)v}); return r; }

    // 超限数字 body 端点：各类型字段的推断类型 + 字符串形态
    @Post("/t/num")
    func tNum(req, n: NumIn) {
        r = ServerResponse(200);
        r.json({
            "it": type(n.i), "is": (string)n.i,
            "lt": type(n.l), "ls": (string)n.l,
            "llt": type(n.ll), "lls": (string)n.ll,
            "ult": type(n.ul), "uls": (string)n.ul,
            "i8t": type(n.i8), "i8s": (string)n.i8,
            "i16t": type(n.i16), "i16s": (string)n.i16,
            "sht": type(n.sh), "shs": (string)n.sh,
            "byt": type(n.by), "bys": (string)n.by,
            "u16t": type(n.u16), "u16s": (string)n.u16,
            "uit": type(n.ui), "uis": (string)n.ui,
            "u64t": type(n.u64), "u64s": (string)n.u64,
            "szt": type(n.sz), "szs": (string)n.sz,
            "sstt": type(n.sst), "ssts": (string)n.sst,
            "ft": type(n.f), "fs": (string)n.f,
            "ldt": type(n.ld), "lds": (string)n.ld,
            "bdt": type(n.bd), "bds": (string)n.bd,
            "bot": type(n.bo), "bos": (string)n.bo,
            "cht": type(n.ch), "chs": (string)n.ch,
            "bit": type(n.bi), "bis": (string)n.bi,
            "dect": type(n.dec), "decs": (string)n.dec,
            "dt": type(n.d), "ds": (string)n.d
        });
        return r;
    }

    // 深嵌套 DTO body 端点：逐层回显类型 + 值（含容器/未标注字段）
    @Post("/t/dto")
    func tDto(req, c: CompanyIn) {
        out = {};
        out["companyType"] = type(c.company); out["company"] = c.company;
        out["foundedType"] = type(c.founded);
        if (c.founded != null) { out["founded"] = (string)c.founded; }
        out["score"] = c.score;
        out["activeType"] = type(c.active); out["active"] = c.active;
        out["binType"] = type(c.bin);
        if (c.bin != null) { out["bin"] = (string)c.bin; }
        out["extraType"] = type(c.extra);
        d = c.dept;
        out["deptNull"] = (d == null);
        if (d != null) {
            out["deptName"] = d.name;
            t = d.team;
            out["teamNull"] = (t == null);
            if (t != null) {
                out["teamTitle"] = t.title;
                lead = t.lead;
                out["leadNull"] = (lead == null);
                if (lead != null) {
                    out["leadType"] = type(lead);
                    out["leadName"] = lead.name;
                    out["leadAgeType"] = type(lead.age);
                    out["leadAge"] = lead.age;
                    out["leadSalary"] = (string)lead.salary;
                }
                ms = t.members;
                out["membersType"] = (ms == null) ? "null" : type(ms);
                if (ms != null) {
                    out["membersLen"] = ms.len;
                    if (ms.len > 0) {
                        m0 = ms[0];
                        out["m0Type"] = type(m0);
                        if (type(m0) == "map" && m0.contains("name")) {
                            out["m0Name"] = m0["name"];
                        }
                    }
                }
            }
            tags = d.tags;
            out["tagsType"] = (tags == null) ? "null" : type(tags);
            if (tags != null) {
                out["tagsLen"] = tags.len;
                if (tags.len > 0) { out["tag0"] = tags[0]; }
            }
            meta = d.meta;
            out["metaType"] = (meta == null) ? "null" : type(meta);
            if (meta != null && meta.contains("k")) {
                out["metaK"] = meta["k"];
            }
        }
        r = ServerResponse(200);
        r.json(out);
        return r;
    }

    // query 通道容器参数：map/array 走 JSON 串解析（asMap/asArray）
    @Get("/t/coll")
    func tColl(req, m: map, a: array) {
        r = ServerResponse(200);
        r.json({
            "mt": type(m),
            "mk": m.contains("k") ? m["k"] : null,
            "at": type(a),
            "a0": a.len > 0 ? a[0] : null
        });
        return r;
    }

    // any 场景专项端点：回显 payload/m/a 各层类型与值
    @Post("/t/any")
    func tAny(req, c: AnyIn) {
        out = {};
        p = c.payload;
        out["pt"] = type(p);
        if (p != null) {
            pt = type(p);
            if (pt == "array") {
                out["plen"] = p.len;
                if (p.len > 0) { out["p0"] = p[0]; out["p0t"] = type(p[0]); }
                if (p.len > 1) { out["p1"] = p[1]; out["p1t"] = type(p[1]); }
                if (p.len > 2) { out["p2"] = p[2]; out["p2t"] = type(p[2]); }
                if (p.len > 3) { out["p3"] = p[3]; out["p3t"] = type(p[3]); }
            }
            if (pt == "map") {
                if (p.contains("k")) { out["pk"] = p["k"]; out["pkt"] = type(p["k"]); }
                if (p.contains("name")) { out["pname"] = p["name"]; }
                if (p.contains("deep")) {
                    out["pdeept"] = type(p["deep"]);
                    out["pdeep"] = p["deep"];
                }
            }
            if (pt != "array" && pt != "map") { out["pv"] = p; }
        }
        m = c.m;
        out["mt"] = (m == null) ? "null" : type(m);
        if (m != null) {
            if (m.contains("s")) { out["mst"] = type(m["s"]); out["ms"] = m["s"]; }
            if (m.contains("i")) { out["mit"] = type(m["i"]); out["mi"] = m["i"]; }
            if (m.contains("b")) { out["mbt"] = type(m["b"]); out["mb"] = m["b"]; }
            if (m.contains("arr")) { out["marrt"] = type(m["arr"]); }
            if (m.contains("obj")) { out["mobjt"] = type(m["obj"]); }
            if (m.contains("nul")) { out["mnult"] = type(m["nul"]); }
        }
        a = c.a;
        out["at"] = (a == null) ? "null" : type(a);
        if (a != null) {
            out["alen"] = a.len;
            if (a.len > 0) { out["a0t"] = type(a[0]); out["a0"] = a[0]; }
            if (a.len > 1) { out["a1t"] = type(a[1]); out["a1"] = a[1]; }
            if (a.len > 2) { out["a2t"] = type(a[2]); }
            if (a.len > 3) { out["a3t"] = type(a[3]); }
            if (a.len > 4) { out["a4t"] = type(a[4]); }
        }
        r = ServerResponse(200);
        r.json(out);
        return r;
    }

    // query 通道 any：未标注参数按名绑定原始字符串（不校验，缺失为 null）
    @Get("/t/qany")
    func tQAny(req, q) {
        r = ServerResponse(200);
        r.json({"qt": (q == null) ? "null" : type(q), "qv": q});
        return r;
    }

    // 显式 any 标注参数：预期与未标注同语义（原样绑定）
    @Get("/t/qany2")
    func tQAny2(req, q: any) {
        r = ServerResponse(200);
        r.json({"qt": (q == null) ? "null" : type(q), "qv": q});
        return r;
    }
}

func check(cond, msg) {
    if (cond == true) { x = 1; } else { throw msg; }
}

// GET 请求辅助
func getResp(url) {
    return HttpRequest<any, any>(url).send();
}

// POST JSON 请求辅助（map 体自动序列化为 JSON）
func postResp(url, body) {
    hreq = HttpRequest<any, any>("POST", url);
    hreq.setHeader("Content-Type", "application/json");
    hreq.setBody(body);
    return hreq.send();
}

// ---- 启动真实服务 ----
port = 18099;
base = "http://127.0.0.1:" + port;
app = WebApplication("127.0.0.1", port);
app.startAsync();
sleep(300);

// ------------------------------------------------------------
// P1: 路径参数 int8 合法 —— 类型须为 int8、值正确
// ------------------------------------------------------------
r1 = getResp(base + "/api/u/100");
check(r1.statusCode() == 200, "P1 合法路径参数应 200");
b1 = r1.json();
check(b1["idType"] == "int8", "P1 id 应推断为 int8，实际: " + b1["idType"]);
check(b1["id"] == 100, "P1 id 值应为 100");

// ------------------------------------------------------------
// P2: 路径参数 int8 超范围（999 > 127）—— 必须走 400
// ------------------------------------------------------------
r2 = getResp(base + "/api/u/999");
check(r2.statusCode() == 400, "P2 int8 超范围应 400，实际: " + r2.statusCode());

// ------------------------------------------------------------
// P3: 路径参数 int8 非数字 —— 必须走 400
// ------------------------------------------------------------
r3 = getResp(base + "/api/u/abc");
check(r3.statusCode() == 400, "P3 int8 非数字应 400，实际: " + r3.statusCode());

// ------------------------------------------------------------
// P4: query 参数全合法 —— string/int/double 类型与值
// ------------------------------------------------------------
r4 = getResp(base + "/api/s?name=tom&page=3&ratio=1.5");
check(r4.statusCode() == 200, "P4 合法 query 应 200");
b4 = r4.json();
check(b4["nameType"] == "string", "P4 name 应为 string，实际: " + b4["nameType"]);
check(b4["name"] == "tom", "P4 name 值应为 tom");
check(b4["pageType"] == "int", "P4 page 应为 int，实际: " + b4["pageType"]);
check(b4["page"] == 3, "P4 page 值应为 3");
check(b4["ratioType"] == "double", "P4 ratio 应为 double，实际: " + b4["ratioType"]);
check(b4["ratio"] == 1.5, "P4 ratio 值应为 1.5");

// ------------------------------------------------------------
// P5: query 缺失必填参数（少 page）—— 必须走 400
// ------------------------------------------------------------
r5 = getResp(base + "/api/s?name=tom&ratio=1.5");
check(r5.statusCode() == 400, "P5 缺少 query 参数应 400，实际: " + r5.statusCode());

// ------------------------------------------------------------
// P6: query 参数类型不符（page=abc）—— 必须走 400
// ------------------------------------------------------------
r6 = getResp(base + "/api/s?name=tom&page=abc&ratio=1.5");
check(r6.statusCode() == 400, "P6 query 类型不符应 400，实际: " + r6.statusCode());

// ------------------------------------------------------------
// P7: JSON body DTO 合法 —— 字段 string/int/double 类型与值
// ------------------------------------------------------------
r7 = postResp(base + "/api/u", {"name": "tom", "age": 20, "score": 9.5});
check(r7.statusCode() == 200, "P7 合法 body 应 200");
b7 = r7.json();
check(b7["nameType"] == "string", "P7 name 应为 string，实际: " + b7["nameType"]);
check(b7["name"] == "tom", "P7 name 值应为 tom");
check(b7["ageType"] == "int", "P7 age 应为 int，实际: " + b7["ageType"]);
check(b7["age"] == 20, "P7 age 值应为 20");
check(b7["scoreType"] == "double", "P7 score 应为 double，实际: " + b7["scoreType"]);
check(b7["score"] == 9.5, "P7 score 值应为 9.5");

// ------------------------------------------------------------
// P8: JSON body 声明类型为 primitive 的字段（int）——不匹配时
//     primitive 槽无法容纳 null（对象模型限制），落默认值 0，不报错
// ------------------------------------------------------------
r8 = postResp(base + "/api/u", {"name": "tom", "age": "20", "score": 9.5});
check(r8.statusCode() == 200, "P8a 应 200");
check(r8.json()["ageType"] == "int" && r8.json()["age"] == 20,
      "P8a 数字串 \"20\" 应按 int 解析为 20");

r8b = postResp(base + "/api/u", {"name": "tom", "age": "abc", "score": 9.5});
check(r8b.json()["age"] == 0, "P8b 非数字串 → int 槽默认 0");

r8c = postResp(base + "/api/u", {"name": "tom", "age": true, "score": 9.5});
check(r8c.json()["age"] == 0, "P8c 布尔 → int 槽默认 0");

r8d = postResp(base + "/api/u", {"name": "tom", "age": 3.7, "score": 9.5});
check(r8d.json()["age"] == 0, "P8d 浮点 → int 槽默认 0（不收窄截断）");

r8e = postResp(base + "/api/u", {"name": "tom", "score": 9.5});
check(r8e.json()["age"] == 0, "P8e 缺失 → int 槽默认 0");

// ------------------------------------------------------------
// P9: JSON body 引用类型字段（string）显式传 null —— 应直接落 null
// ------------------------------------------------------------
r9 = postResp(base + "/api/u", {"name": null, "age": 20, "score": 9.5});
check(r9.statusCode() == 200, "P9 应 200");
b9 = r9.json();
check(b9["nameType"] == "none",
      "P9 string 字段显式 null 应落 null（none），实际: " + b9["nameType"]);

// ------------------------------------------------------------
// P10: 嵌套 DTO 合法 —— 子对象字段按声明类型递归绑定
// ------------------------------------------------------------
r10 = postResp(base + "/api/u", {
    "name": "tom", "age": 20, "score": 9.5,
    "addr": {"city": "BJ", "zip": 100}
});
check(r10.statusCode() == 200, "P10 应 200");
b10 = r10.json();
check(b10["city"] == "BJ", "P10 嵌套 city 应为 BJ，实际: " + b10["city"]);
check(b10["zipType"] == "int",
      "P10 嵌套 zip 应为 int，实际: " + b10["zipType"]);

// ------------------------------------------------------------
// P11: 嵌套 DTO 显式 null —— 子对象应为 null（city 落 null）
// ------------------------------------------------------------
r11 = postResp(base + "/api/u", {
    "name": "tom", "age": 20, "score": 9.5, "addr": null
});
check(r11.statusCode() == 200, "P11 应 200");
b11 = r11.json();
check(b11["city"] == null,
      "P11 嵌套 addr=null 时 city 应为 null，实际: " + b11["city"]);

// ============================================================
// 超限数字参数（超 50 位 / 各类型边界）· query 与 body 双通道
// big50 = 56 位整数，远超 int64（19 位）
// ============================================================
big50 = "12345678901234567890123456789012345678901234567890123456";
negbig50 = "-" + big50;
llmax = "9223372036854775807";
llmax1 = "9223372036854775808";
imax = "2147483647";
imax1 = "2147483648";

// ---------- query 通道：整型超范围一律 400，绝不静默截断 ----------
q1 = getResp(base + "/api/t/i?v=" + imax);
check(q1.statusCode() == 200 && q1.json()["s"] == imax,
      "Q1 int 边界 " + imax + " 应 200 精确");
check(getResp(base + "/api/t/i?v=" + imax1).statusCode() == 400,
      "Q2 int 收 int32+1 应 400");
check(getResp(base + "/api/t/i?v=" + big50).statusCode() == 400,
      "Q3 int 收 56 位应 400");
check(getResp(base + "/api/t/i?v=" + negbig50).statusCode() == 400,
      "Q4 int 收负 56 位应 400");
check(getResp(base + "/api/t/i8?v=" + big50).statusCode() == 400,
      "Q5 int8 收 56 位应 400");

q6 = getResp(base + "/api/t/l?v=" + llmax);
check(q6.statusCode() == 200 && q6.json()["s"] == llmax,
      "Q6 long 收 llmax 应 200 精确");
check(getResp(base + "/api/t/l?v=" + big50).statusCode() == 400,
      "Q7 long 收 56 位应 400");

q8 = getResp(base + "/api/t/ll?v=" + llmax);
check(q8.statusCode() == 200 && q8.json()["t"] == "long long"
      && q8.json()["s"] == llmax,
      "Q8 long long 收 llmax 应 200 精确，实际: " + q8.json()["t"]);
check(getResp(base + "/api/t/ll?v=" + llmax1).statusCode() == 400,
      "Q9 long long 收 llmax+1 应 400");
check(getResp(base + "/api/t/ll?v=" + big50).statusCode() == 400,
      "Q10 long long 收 56 位应 400");

q11 = getResp(base + "/api/t/ul?v=" + llmax);
check(q11.statusCode() == 200 && q11.json()["s"] == llmax,
      "Q11 ulong 收 llmax 应 200 精确");
check(getResp(base + "/api/t/ul?v=" + big50).statusCode() == 400,
      "Q12 ulong 收 56 位应 400");

// ---------- query 通道：bigint/decimal/bitdecimal 精确保留全部位 ----------
q13 = getResp(base + "/api/t/bi?v=" + big50);
check(q13.statusCode() == 200 && q13.json()["t"] == "bigint"
      && q13.json()["s"] == big50,
      "Q13 bigint 收 56 位应 200 精确，实际: " + q13.json()["s"]);
q14 = getResp(base + "/api/t/bi?v=" + negbig50);
check(q14.statusCode() == 200 && q14.json()["s"] == negbig50,
      "Q14 bigint 收负 56 位应 200 精确");

q15 = getResp(base + "/api/t/dec?v=" + big50);
check(q15.statusCode() == 200 && q15.json()["t"] == "decimal"
      && q15.json()["s"] == big50,
      "Q15 decimal 收 56 位应 200 精确，实际: " + q15.json()["s"]);
q16 = getResp(base + "/api/t/bd?v=" + big50);
check(q16.statusCode() == 200 && q16.json()["t"] == "bitdecimal"
      && q16.json()["s"] == big50,
      "Q16 bitdecimal 收 56 位应 200 精确，实际: " + q16.json()["s"]);

// ---------- query 通道：浮点族允许精度丢失但不报错 ----------
q17 = getResp(base + "/api/t/d?v=" + big50);
check(q17.statusCode() == 200 && q17.json()["t"] == "double",
      "Q17 double 收 56 位应 200（允许精度丢失）");
q18 = getResp(base + "/api/t/ld?v=" + big50);
check(q18.statusCode() == 200 && q18.json()["t"] == "long double",
      "Q18 long double 收 56 位应 200");
q19 = getResp(base + "/api/t/f?v=" + big50);
check(q19.statusCode() == 200 && q19.json()["t"] == "float",
      "Q19 float 收 56 位应 200");

// ---------- query 通道：窄整型边界（绑定层按位宽核对，绝不静默截断）----------
q20 = getResp(base + "/api/t/i16?v=32767");
check(q20.statusCode() == 200 && q20.json()["s"] == "32767",
      "Q20 int16 收 32767 应 200 精确");
check(getResp(base + "/api/t/i16?v=32768").statusCode() == 400,
      "Q20b int16 收 32768 应 400");
check(getResp(base + "/api/t/i16?v=-32769").statusCode() == 400,
      "Q20c int16 收 -32769 应 400");

q21 = getResp(base + "/api/t/u16?v=65535");
check(q21.statusCode() == 200 && q21.json()["s"] == "65535",
      "Q21 ushort 收 65535 应 200 精确");
check(getResp(base + "/api/t/u16?v=65536").statusCode() == 400,
      "Q21b ushort 收 65536 应 400");
check(getResp(base + "/api/t/u16?v=-1").statusCode() == 400,
      "Q21c ushort 收负数应 400");

q22 = getResp(base + "/api/t/by?v=255");
check(q22.statusCode() == 200 && q22.json()["s"] == "255",
      "Q22 byte 收 255 应 200 精确");
check(getResp(base + "/api/t/by?v=256").statusCode() == 400,
      "Q22b byte 收 256 应 400");
check(getResp(base + "/api/t/by?v=-1").statusCode() == 400,
      "Q22c byte 收负数应 400");

// uint 标注在编译期归并 uint64（既有设计：uint 是 uint64 别名），故收
// uint32max+1 合法放行——按 64 位语义精确绑定
q23 = getResp(base + "/api/t/ui?v=4294967295");
check(q23.statusCode() == 200 && q23.json()["s"] == "4294967295",
      "Q23 uint 收 uint32max 应 200 精确");
q23b = getResp(base + "/api/t/ui?v=4294967296");
check(q23b.statusCode() == 200 && q23b.json()["s"] == "4294967296",
      "Q23b uint（=uint64 别名）收 uint32max+1 应 200 精确，实际: "
      + q23b.statusCode() + " s=" + q23b.json()["s"]);
check(getResp(base + "/api/t/ui?v=-1").statusCode() == 400,
      "Q23c uint 收负数应 400");

// uint64 上界超出 int64 表示范围：binder 保守拒绝（宁拒不错），锁定语义
q24 = getResp(base + "/api/t/u64?v=" + llmax);
check(q24.statusCode() == 200 && q24.json()["s"] == llmax,
      "Q24 uint64 收 llmax 应 200 精确");
check(getResp(base + "/api/t/u64?v=18446744073709551615").statusCode() == 400,
      "Q24b uint64 收 uint64max（超 int64 上界）保守拒绝应 400");
check(getResp(base + "/api/t/u64?v=" + big50).statusCode() == 400,
      "Q24c uint64 收 56 位应 400");

q25 = getResp(base + "/api/t/sz?v=" + llmax);
check(q25.statusCode() == 200 && q25.json()["s"] == llmax,
      "Q25 size_t 收 llmax 应 200 精确");
check(getResp(base + "/api/t/sz?v=-1").statusCode() == 400,
      "Q25b size_t 收负数应 400");

q26 = getResp(base + "/api/t/sst?v=-9223372036854775808");
check(q26.statusCode() == 200 && q26.json()["s"] == "-9223372036854775808",
      "Q26 ssize_t 收 llmin 应 200 精确");
check(getResp(base + "/api/t/sst?v=-9223372036854775809").statusCode() == 400,
      "Q26b ssize_t 收 llmin-1 应 400");

// ---------- query 通道：bool / char / 负下界 / 科学计数法 ----------
// (string)bool/char 已统一为语义形态（"true"/"false"/字符），与字段、print 一致
q27 = getResp(base + "/api/t/bo?v=true");
check(q27.statusCode() == 200 && q27.json()["t"] == "bool" && q27.json()["s"] == "true",
      "Q27 bool 收 true 应 200 bool，实际: " + q27.json()["t"] + "/" + q27.json()["s"]);
check(getResp(base + "/api/t/bo?v=1").json()["s"] == "true",
      "Q27b bool 收 1 应 true");
check(getResp(base + "/api/t/bo?v=0").json()["s"] == "false",
      "Q27c bool 收 0 应 false");
check(getResp(base + "/api/t/bo?v=yes").statusCode() == 400,
      "Q27d bool 收 yes 应 400");

// (string)char 输出字符形态
q28 = getResp(base + "/api/t/ch?v=A");
check(q28.statusCode() == 200 && q28.json()["t"] == "char" && q28.json()["s"] == "A",
      "Q28 char 收 A 应 200（字符形态），实际: " + q28.json()["t"] + "/" + q28.json()["s"]);
check(getResp(base + "/api/t/ch?v=AB").statusCode() == 400,
      "Q28b char 收多字符应 400");

check(getResp(base + "/api/t/i8?v=-129").statusCode() == 400,
      "Q29 int8 收 -129（负下界越界）应 400");
check(getResp(base + "/api/t/i?v=-2147483649").statusCode() == 400,
      "Q30 int 收 -2147483649（负下界越界）应 400");

// 科学计数法串不是合法十进制字面量（query 浮点 regex 不含指数）→ 400
check(getResp(base + "/api/t/d?v=1e40").statusCode() == 400,
      "Q31 double 收科学计数法 1e40 应 400");

// ---------- body 通道：JSON 数字按幅值升档后按声明类型绑定 ----------
bi50 = (bigint)big50;
b20 = postResp(base + "/api/t/num", {
    "i": 2147483647, "l": 2147483648, "ll": 9223372036854775807,
    "ul": 4294967295, "bi": bi50, "dec": bi50, "d": bi50
});
check(b20.statusCode() == 200, "B20 合法大值 body 应 200");
j20 = b20.json();
check(j20["it"] == "int" && j20["is"] == imax,
      "B20 i 应为 int=" + imax + "，实际: " + j20["it"] + "=" + j20["is"]);
check(j20["ls"] == "2147483648",
      "B20 l 应精确收 2147483648（JSON 升 long long 后入 long），实际: " + j20["ls"]);
check(j20["llt"] == "long long" && j20["lls"] == llmax,
      "B20 ll 应为 long long=" + llmax + "，实际: " + j20["llt"] + "=" + j20["lls"]);
check(j20["bit"] == "bigint" && j20["bis"] == big50,
      "B20 bi 应为 bigint 精确 56 位，实际: " + j20["bit"] + "=" + j20["bis"]);
check(j20["dect"] == "decimal" && j20["decs"] == big50,
      "B20 dec 应为 decimal 精确 56 位，实际: " + j20["dect"] + "=" + j20["decs"]);
check(j20["dt"] == "double",
      "B20 d 应为 double（bigint 转浮点），实际: " + j20["dt"]);

// ---------- body 通道：字符串形态大值，按声明类型严格校验 ----------
b21 = postResp(base + "/api/t/num", {
    "i": imax1, "l": llmax, "ll": llmax1,
    "ul": big50, "bi": big50, "dec": big50, "d": big50
});
check(b21.statusCode() == 200, "B21 应 200");
j21 = b21.json();
check(j21["is"] == "0",
      "B21 i 收 \"2147483648\" 越 int32 → null 落默认 0，实际: " + j21["is"]);
check(j21["ls"] == llmax,
      "B21 l 收 llmax 字符串应精确，实际: " + j21["ls"]);
check(j21["lls"] == "0",
      "B21 ll 收 llmax+1 字符串 → null 落默认 0，实际: " + j21["lls"]);
check(j21["uls"] == "0",
      "B21 ul 收 56 位字符串 → null 落默认 0，实际: " + j21["uls"]);
check(j21["bis"] == big50,
      "B21 bi 收 56 位字符串应精确，实际: " + j21["bis"]);
check(j21["decs"] == big50,
      "B21 dec 收 56 位字符串应精确，实际: " + j21["decs"]);

// ---------- body 通道：窄整型/无符号/bool/char 合法值按声明类型精确绑定 ----------
b22 = postResp(base + "/api/t/num", {
    "i8": 127, "i16": 32767, "sh": 32767, "by": 255,
    "u16": 65535, "ui": 4294967295, "u64": 9223372036854775807,
    "sz": 9223372036854775807, "sst": -9223372036854775808,
    "f": 1.5, "ld": 2.5, "bd": big50, "bo": true, "ch": "A"
});
check(b22.statusCode() == 200, "B22 应 200");
j22 = b22.json();
check(j22["i8s"] == "127" && j22["i16s"] == "32767" && j22["shs"] == "32767",
      "B22 窄有符号边界值应精确，实际: " + j22["i8s"] + "/" + j22["i16s"] + "/" + j22["shs"]);
check(j22["bys"] == "255" && j22["u16s"] == "65535",
      "B22 byte/ushort 边界值应精确，实际: " + j22["bys"] + "/" + j22["u16s"]);
check(j22["uis"] == "4294967295",
      "B22 uint 收 uint32max 应精确，实际: " + j22["uis"]);
check(j22["u64s"] == llmax && j22["szs"] == llmax,
      "B22 uint64/size_t 收 llmax 应精确，实际: " + j22["u64s"] + "/" + j22["szs"]);
check(j22["ssts"] == "-9223372036854775808",
      "B22 ssize_t 收 llmin 应精确，实际: " + j22["ssts"]);
check(j22["fs"] == "1.5" || j22["fs"] == "1.500000",
      "B22 float 收 1.5 应精确，实际: " + j22["fs"]);
check(j22["lds"] == "2.5" || j22["lds"] == "2.500000",
      "B22 long double 收 2.5 应精确，实际: " + j22["lds"]);
check(j22["bds"] == big50,
      "B22 bitdecimal 收 56 位字符串应精确，实际: " + j22["bds"]);
check(j22["bos"] == "true",
      "B22 bool 收 true 应精确，实际: " + j22["bos"]);
check(j22["chs"] == "A",
      "B22 char 收 A 应精确（字符形态），实际: " + j22["chs"]);

// ---------- body 通道：窄类型越界/不匹配 → null 落默认值（不报错不 400）----------
b23 = postResp(base + "/api/t/num", {
    "i8": 128, "i16": 32768, "sh": -32769, "by": 256,
    "u16": -1, "ui": 4294967296, "u64": big50, "sst": negbig50,
    "f": "abc", "bo": "yes", "ch": "AB"
});
check(b23.statusCode() == 200, "B23 应 200（body 越界不报错，按用户规则落默认值）");
j23 = b23.json();
check(j23["i8s"] == "0" && j23["i16s"] == "0" && j23["shs"] == "0",
      "B23 i8/i16/short 越界应落 0，实际: " + j23["i8s"] + "/" + j23["i16s"] + "/" + j23["shs"]);
check(j23["bys"] == "0" && j23["u16s"] == "0",
      "B23 byte/ushort 越界应落 0，实际: " + j23["bys"] + "/" + j23["u16s"]);
check(j23["uis"] == "4294967296",
      "B23 uint（=uint64 别名）收 uint32max+1 应按 64 位精确放行，实际: " + j23["uis"]);
check(j23["u64s"] == "0" && j23["ssts"] == "0",
      "B23 uint64/ssize_t 收超 int64 串应落 0，实际: " + j23["u64s"] + "/" + j23["ssts"]);
check(j23["ft"] == "float" && j23["bos"] == "false" && j23["chs"] != "AB",
      "B23 float/bool/char 不匹配应落默认，实际: " + j23["fs"] + "/" + j23["bos"] + "/" + j23["chs"]);

// ---------- body 通道：嵌套 DTO 内字段超限同样按声明类型绑定 ----------
b24 = postResp(base + "/api/u", {
    "name": "tom", "age": 20, "score": 9.5,
    "addr": {"city": "BJ", "zip": big50}
});
check(b24.statusCode() == 200, "B24 应 200");
j24 = b24.json();
check(j24["city"] == "BJ",
      "B24 嵌套 city 应正常，实际: " + j24["city"]);
check(j24["zipType"] == "int" && j24["zip"] == 0 || j24["zip"] == null,
      "B24 嵌套 zip 收 56 位应拒绝落 0，实际: " + j24["zip"]);

// ---------- body 通道：极限值专项（各类型真正上界/超界，B25 合法、B26 超界）----------
// 200 位数字：程序生成（"1234567890" × 20），验证高精度族无限精度往返
big200 = "";
gi = 0;
while (gi < 20) { big200 = big200 + "1234567890"; gi = gi + 1; }

// B25 合法极限：
//   u64 收 uint64max 数字串（binder 字符串路径无法精确解析超 int64 上界，保守拒绝）
//   bi/dec 收 200 位（bigint/decimal 无限精度）
//   d 收 1e308（double 上界内）、f 收 3.4e38（float 上界内）
b25 = postResp(base + "/api/t/num", {
    "u64": "18446744073709551615",
    "bi": big200, "dec": big200,
    "d": 1e308, "f": 3.4e38
});
check(b25.statusCode() == 200, "B25 应 200");
j25 = b25.json();
// B25 断言：合法极限值精确绑定
check(j25["u64s"] == "0",
      "B25 u64 收 uint64max 字符串应保守拒绝落 0，实际: " + j25["u64s"]);
check(j25["bis"].len == 200 && j25["decs"].len == 200,
      "B25 bigint/decimal 收 200 位应无限精度往返，实际: "
      + j25["bis"].len + "/" + j25["decs"].len);
check(j25["ds"] == "1e+308",
      "B25 double 收 1e308（上界内）应精确，实际: " + j25["ds"]);
check(j25["fs"] == "3.4e+38",
      "B25 float 收 3.4e38（上界内）应精确，实际: " + j25["fs"]);

// B26 断言：超极限跨 JSON 边界语义
// 客户端序列化 inf（1e400）→ null（JS JSON.stringify 语义，lm_json.c jq_stringify）
// → 服务器收 null → binder 拒 → 字段落默认 0
r_d = postResp(base + "/api/t/num", {"d": 1e400});
check(r_d.statusCode() == 200,
      "B26 d 收 1e400（客户端序列化为 null）应 200 不再 500");
j_d = r_d.json();
check(j_d["ds"] == "0",
      "B26 double 收非有限值应 null 落 0，实际: " + j_d["ds"]);
// 未知字段携带 inf：仅经过解析/序列化层，不应影响请求处理
check(postResp(base + "/api/t/num", {"zzz": 1e400}).statusCode() == 200,
      "B26 未知字段携带非有限值应 200");
// 服务器侧 float 物理槽溢出 inf：(string) 是字符串 "inf"，响应合法
r_f = postResp(base + "/api/t/num", {"f": 1e40});
j_f = r_f.json();
check(r_f.statusCode() == 200 && j_f["ft"] == "float" && j_f["fs"] == "inf",
      "B26 float 收 1e40 服务器侧溢出 inf（允许精度丢失），实际: "
      + r_f.statusCode() + "/" + j_f["fs"]);
// uint64max / 39 位整数 JSON 数字：解析升档 bigint → binder 拒 → 落 0
r_u64 = postResp(base + "/api/t/num", {"u64": 18446744073709551615});
check(r_u64.statusCode() == 200 && r_u64.json()["u64s"] == "0",
      "B26 u64 收 uint64max 数字（升档 bigint）应拒绝落 0，实际: "
      + r_u64.statusCode() + "/" + r_u64.json()["u64s"]);
r_i = postResp(base + "/api/t/num", {"i": 1234567890123456789012345678901234567890});
check(r_i.statusCode() == 200 && r_i.json()["is"] == "0",
      "B26 int 收 39 位数字（升档 bigint）应拒绝落 0，实际: "
      + r_i.statusCode() + "/" + r_i.json()["is"]);

// ============================================================
// 深嵌套实体类 DTO · 容器字段 · 未标注字段（B27-B36）
// ============================================================

// ---------- B27: 四级深嵌套 + 容器 + 未标注字段，全链路精确 ----------
b27 = postResp(base + "/api/t/dto", {
    "company": "ACME", "score": 3.25, "active": true,
    "founded": big200,
    "extra": {"z": [1, 2, {"w": null}]},
    "dept": {
        "name": "RD",
        "team": {
            "title": "Core",
            "lead": {"name": "Lee", "age": 30, "salary": 12345678901234},
            "members": [{"name": "A", "age": 1}]
        },
        "tags": ["x", "y", 1, 2],
        "meta": {"k": {"deep": true}}
    }
});
check(b27.statusCode() == 200, "B27 深嵌套合法 body 应 200，实际: " + b27.statusCode());
j27 = b27.json();
check(j27["companyType"] == "string" && j27["company"] == "ACME",
      "B27 company 应 string=ACME，实际: " + j27["companyType"] + "/" + j27["company"]);
check(j27["deptNull"] == false && j27["deptName"] == "RD",
      "B27 一级 dept 应绑定 name=RD，实际: " + j27["deptNull"] + "/" + j27["deptName"]);
check(j27["teamNull"] == false && j27["teamTitle"] == "Core",
      "B27 二级 team 应绑定 title=Core，实际: " + j27["teamNull"] + "/" + j27["teamTitle"]);
check(j27["leadNull"] == false && j27["leadName"] == "Lee",
      "B27 三级 lead 应绑定 name=Lee，实际: " + j27["leadNull"] + "/" + j27["leadName"]);
check(j27["leadAgeType"] == "int" && j27["leadAge"] == 30,
      "B27 lead.age 应 int=30，实际: " + j27["leadAgeType"] + "/" + j27["leadAge"]);
check(j27["leadSalary"] == "12345678901234",
      "B27 lead.salary 应 long 精确收 14 位，实际: " + j27["leadSalary"]);
check(j27["membersType"] == "array" && j27["membersLen"] == 1,
      "B27 members 数组字段应原样绑定，实际: " + j27["membersType"] + "/" + j27["membersLen"]);
check(j27["m0Type"] == "map" && j27["m0Name"] == "A",
      "B27 数组元素应保留 JSON 原结构（map），实际: " + j27["m0Type"] + "/" + j27["m0Name"]);
check(j27["tagsType"] == "array" && j27["tagsLen"] == 4 && j27["tag0"] == "x",
      "B27 tags 数组字段应原样绑定 4 元素，实际: "
      + j27["tagsType"] + "/" + j27["tagsLen"] + "/" + j27["tag0"]);
check(j27["metaType"] == "map" && j27["metaK"] != null
      && type(j27["metaK"]) == "map" && j27["metaK"]["deep"] == true,
      "B27 meta map 字段应原样绑定（嵌套值保留），实际: " + j27["metaType"]);
check(j27["extraType"] == "map",
      "B27 未标注字段应保留 JSON 原结构，实际: " + j27["extraType"]);
check(j27["foundedType"] == "bigint" && j27["founded"].len == 200,
      "B27 嵌套外 bigint 字段应精确收 200 位，实际: "
      + j27["foundedType"] + "/" + j27["founded"].len);
check(j27["score"] == 3.25 && j27["activeType"] == "bool" && j27["active"] == true,
      "B27 score/active 应精确，实际: " + j27["score"] + "/" + j27["active"]);

// ---------- B28: 嵌套标量字段越界/非法/类型不符 → 落默认值（不报错）----------
b28 = postResp(base + "/api/t/dto", {
    "company": 123,
    "score": "abc", "active": "yes",
    "dept": {
        "name": "RD",
        "team": {
            "title": "T",
            "lead": {"name": "Lee", "age": big50, "salary": "abc"}
        }
    }
});
check(b28.statusCode() == 200, "B28 应 200（嵌套字段越界不报错），实际: " + b28.statusCode());
j28 = b28.json();
check(j28["company"] == "123" && j28["companyType"] == "string",
      "B28 string 字段收数字应尽力转串 \"123\"，实际: "
      + j28["companyType"] + "/" + j28["company"]);
check(j28["score"] == 0 && j28["active"] == false,
      "B28 double/bool 字段收非法串应落默认，实际: " + j28["score"] + "/" + j28["active"]);
check(j28["leadAge"] == 0,
      "B28 嵌套 int 字段收 56 位应拒绝落 0，实际: " + j28["leadAge"]);
check(j28["leadSalary"] == "0",
      "B28 嵌套 long 字段收 \"abc\" 应拒绝落 0，实际: " + j28["leadSalary"]);

// ---------- B29: 嵌套 bigint 字段字符串非法 → null（无初始化器不落默认）----------
b29 = postResp(base + "/api/t/dto", {"company": "ACME", "founded": "xyz"});
check(b29.statusCode() == 200, "B29 应 200，实际: " + b29.statusCode());
j29 = b29.json();
check(j29["foundedType"] == "none",
      "B29 bigint 字段收非法串应 null（none），实际: " + j29["foundedType"]);

// ---------- B30: bytes 字段：JSON 字符串编码转入 / 非字符串拒绝落默认 ----------
b30 = postResp(base + "/api/t/dto", {"company": "ACME", "bin": "hello"});
check(b30.statusCode() == 200, "B30 bin 字符串应 200，实际: " + b30.statusCode());
j30 = b30.json();
check(j30["binType"] == "bytes", "B30 bin 应为 bytes 类型，实际: " + j30["binType"]);
q30 = (char)34;
check(j30["bin"] == "b" + q30 + "hello" + q30,
      "B30 bin 应编码为 b\"hello\" 形态，实际: " + j30["bin"]);
b30b = postResp(base + "/api/t/dto", {"company": "ACME", "bin": 123});
check(b30b.statusCode() == 200, "B30b 应 200，实际: " + b30b.statusCode());
check(b30b.json()["binType"] == "none",
      "B30b bin 收数字应拒绝落默认（none），实际: " + b30b.json()["binType"]);

// ---------- B31: 嵌套字段收非 map 值 → 模型构建器入口校验统一抛错 500 ----------
b31a = postResp(base + "/api/t/dto", {
    "company": "ACME", "dept": {"team": {"lead": 123}}
});
check(b31a.statusCode() == 500, "B31a lead=123 应 500，实际: " + b31a.statusCode());
b31b = postResp(base + "/api/t/dto", {
    "company": "ACME", "dept": {"team": {"lead": [1, 2]}}
});
check(b31b.statusCode() == 500, "B31b lead=数组 应 500，实际: " + b31b.statusCode());
b31c = postResp(base + "/api/t/dto", {
    "company": "ACME", "dept": {"team": {"lead": "str"}}
});
check(b31c.statusCode() == 500, "B31c lead=字符串 应 500，实际: " + b31c.statusCode());

// ---------- B32: 顶层 body 收非对象 → 统一抛错 500 ----------
b32a = postResp(base + "/api/t/dto", [1, 2]);
check(b32a.statusCode() == 500, "B32a body=数组 应 500，实际: " + b32a.statusCode());
b32b = postResp(base + "/api/t/dto", 12345);
check(b32b.statusCode() == 500, "B32b body=数字 应 500，实际: " + b32b.statusCode());

// ---------- B33: 中层嵌套缺失/显式 null → 深层不可达不报错 ----------
b33 = postResp(base + "/api/t/dto", {"company": "ACME", "dept": {"name": "RD"}});
check(b33.statusCode() == 200, "B33 应 200（中层缺失），实际: " + b33.statusCode());
j33 = b33.json();
check(j33["teamNull"] == true && j33["leadNull"] == null
      && j33["membersType"] == null,
      "B33 team 缺失应 teamNull=true 且深层键缺席，实际: "
      + j33["teamNull"] + "/" + j33["leadNull"]);
b33b = postResp(base + "/api/t/dto", {"company": "ACME", "dept": null});
check(b33b.statusCode() == 200, "B33b 应 200（dept=null），实际: " + b33b.statusCode());
j33b = b33b.json();
check(j33b["deptNull"] == true && j33b["deptName"] == null,
      "B33b dept=null 应 deptNull=true，实际: " + j33b["deptNull"]);

// ---------- B34: 嵌套字段显式 null 逐层直通 ----------
b34 = postResp(base + "/api/t/dto", {
    "company": "ACME",
    "dept": {"name": "RD", "team": {"title": "T", "lead": null}}
});
check(b34.statusCode() == 200, "B34 应 200，实际: " + b34.statusCode());
j34 = b34.json();
check(j34["teamNull"] == false && j34["leadNull"] == true,
      "B34 lead=null 应直通 null，实际: " + j34["teamNull"] + "/" + j34["leadNull"]);

// ---------- B35: 嵌套外高精度字段收 JSON 数字（升档）与字符串双形态 ----------
b35 = postResp(base + "/api/t/dto", {"company": "ACME", "founded": big200});
check(b35.statusCode() == 200 && b35.json()["foundedType"] == "bigint"
      && b35.json()["founded"].len == 200,
      "B35 bigint 字段收 200 位字符串应精确，实际: "
      + b35.statusCode() + "/" + b35.json()["foundedType"]);

// ---------- B36: query 通道 map/array 容器参数（JSON 串解析）----------
qch = (char)34;
mj = "{" + qch + "k" + qch + ":5}";
aj = "[1,2,3]";
q36 = getResp(base + "/api/t/coll?m=" + mj + "&a=" + aj);
check(q36.statusCode() == 200, "B36 合法容器 query 应 200，实际: " + q36.statusCode());
j36 = q36.json();
check(j36["mt"] == "map" && j36["mk"] == 5,
      "B36 map 参数应按 JSON 解析，实际: " + j36["mt"] + "/" + j36["mk"]);
check(j36["at"] == "array" && j36["a0"] == 1,
      "B36 array 参数应按 JSON 解析，实际: " + j36["at"] + "/" + j36["a0"]);
check(getResp(base + "/api/t/coll?m=notjson&a=[1]").statusCode() == 400,
      "B36 m 收非 JSON 串应 400");
check(getResp(base + "/api/t/coll?m=[1,2]&a=[1]").statusCode() == 400,
      "B36 m 收数组 JSON（非对象）应 400");
check(getResp(base + "/api/t/coll?m=" + mj + "&a=123").statusCode() == 400,
      "B36 a 收数字串应 400");
check(getResp(base + "/api/t/coll?m=" + mj + "&a=" + qch + "x" + qch).statusCode() == 400,
      "B36 a 收字符串 JSON（非数组）应 400");

// ---------- B37-B47: any 字段全场景矩阵 ----------
// B37: any 收 array（混合元素 int/string/bool/map）→ 原样保留
b37 = postResp(base + "/api/t/any", {"payload": [1, "x", true, {"k": 9}]});
check(b37.statusCode() == 200, "B37 any 收数组应 200，实际: " + b37.statusCode());
j37 = b37.json();
check(j37["pt"] == "array" && j37["plen"] == 4,
      "B37 payload 应保留 array 身份 4 元素，实际: " + j37["pt"] + "/" + j37["plen"]);
check(j37["p0"] == 1 && j37["p0t"] == "int"
      && j37["p1"] == "x" && j37["p1t"] == "string"
      && j37["p2"] == true && j37["p2t"] == "bool",
      "B37 数组元素类型应各自保留，实际: "
      + j37["p0t"] + "/" + j37["p1t"] + "/" + j37["p2t"]);
check(j37["p3t"] == "map" && j37["p3"]["k"] == 9,
      "B37 嵌套 map 元素应保留，实际: " + j37["p3t"]);

// B38: any 收 string（含空格/中文）→ string 原样
b38 = postResp(base + "/api/t/any", {"payload": "hello 世界"});
j38 = b38.json();
check(j38["pt"] == "string" && j38["pv"] == "hello 世界",
      "B38 any 收字符串应原样，实际: " + j38["pt"] + "/" + j38["pv"]);

// B39: any 收 int 双形态：int32 内 → int，超 int32 → long long（JSON 按值域分档，值均精确）
b39a = postResp(base + "/api/t/any", {"payload": 42});
b39b = postResp(base + "/api/t/any", {"payload": 1234567890123});
j39a = b39a.json(); j39b = b39b.json();
check(j39a["pt"] == "int" && j39a["pv"] == 42,
      "B39 any 收 int32 内整数应 int 精确，实际: " + j39a["pt"] + "/" + j39a["pv"]);
check(j39b["pt"] == "long long" && j39b["pv"] == 1234567890123,
      "B39 any 收超 int32 整数应 long long 精确，实际: " + j39b["pt"] + "/" + j39b["pv"]);

// B40: any 收 double → double 精确
b40 = postResp(base + "/api/t/any", {"payload": 3.14159});
j40 = b40.json();
check(j40["pt"] == "double" && j40["pv"] == 3.14159,
      "B40 any 收小数应精确，实际: " + j40["pt"] + "/" + j40["pv"]);

// B41: any 收 bool → true/false 双形态
b41a = postResp(base + "/api/t/any", {"payload": true});
b41b = postResp(base + "/api/t/any", {"payload": false});
check(b41a.json()["pt"] == "bool" && b41a.json()["pv"] == true
      && b41b.json()["pt"] == "bool" && b41b.json()["pv"] == false,
      "B41 any 收 bool 双形态应精确，实际: "
      + b41a.json()["pv"] + "/" + b41b.json()["pv"]);

// B42: any 收显式 null → none 直通
b42 = postResp(base + "/api/t/any", {"payload": null});
j42 = b42.json();
check(j42["pt"] == "none", "B42 any 收显式 null 应 none，实际: " + j42["pt"]);

// B43: any 收深度嵌套混合结构（map→map→array→map + 中文）→ 递归保留
b43 = postResp(base + "/api/t/any",
               {"payload": {"deep": {"x": [1, {"y": 2}], "z": "末"}}});
j43 = b43.json();
check(j43["pt"] == "map" && j43["pdeept"] == "map"
      && j43["pdeep"]["x"][1]["y"] == 2 && j43["pdeep"]["z"] == "末",
      "B43 any 深嵌套应递归保留，实际: " + j43["pt"]);

// B44: any 收类同构 map（Member 形状）→ 保持 map 身份，不自动实例化
b44 = postResp(base + "/api/t/any", {"payload": {"name": "Lee", "age": 30}});
j44 = b44.json();
check(j44["pt"] == "map" && j44["pname"] == "Lee",
      "B44 any 收类同构对象应保持 map（不实例化），实际: " + j44["pt"]);

// B45: any 缺失（body 无 payload 键）→ none 不落默认
b45 = postResp(base + "/api/t/any", {"m": {"s": "x"}});
j45 = b45.json();
check(j45["pt"] == "none", "B45 payload 缺失应 none，实际: " + j45["pt"]);

// B46: map 字段混合值类型 → 各值类型保留（map any 场景）
b46 = postResp(base + "/api/t/any", {
    "m": {"s": "str", "i": 42, "b": true, "arr": [1], "obj": {"k": 1}, "nul": null}
});
j46 = b46.json();
check(j46["mt"] == "map" && j46["mst"] == "string" && j46["ms"] == "str",
      "B46 map 字符串值应保留，实际: " + j46["mst"]);
check(j46["mit"] == "int" && j46["mi"] == 42
      && j46["mbt"] == "bool" && j46["mb"] == true,
      "B46 map int/bool 值应保留，实际: " + j46["mit"] + "/" + j46["mbt"]);
check(j46["marrt"] == "array" && j46["mobjt"] == "map" && j46["mnult"] == "none",
      "B46 map 容器/null 值应保留，实际: "
      + j46["marrt"] + "/" + j46["mobjt"] + "/" + j46["mnult"]);

// B47: array 字段混合元素（int/string/map/array/null）→ 元素类型各自保留（array any 场景）
b47 = postResp(base + "/api/t/any", {"a": [7, "s", {"k": 1}, [2], null]});
j47 = b47.json();
check(j47["at"] == "array" && j47["alen"] == 5
      && j47["a0t"] == "int" && j47["a1t"] == "string"
      && j47["a2t"] == "map" && j47["a3t"] == "array" && j47["a4t"] == "none",
      "B47 array 混合元素类型应各自保留，实际: "
      + j47["a0t"] + "/" + j47["a1t"] + "/" + j47["a2t"]
      + "/" + j47["a3t"] + "/" + j47["a4t"]);

// ---------- B48: query 通道 any（未标注 / 显式 any 标注）----------
j48a = getResp(base + "/api/t/qany?q=hello").json();
check(j48a["qt"] == "string" && j48a["qv"] == "hello",
      "B48 未标注参数应原样字符串，实际: " + j48a["qt"] + "/" + j48a["qv"]);
j48b = getResp(base + "/api/t/qany?q=123").json();
check(j48b["qt"] == "string" && j48b["qv"] == "123",
      "B48 未标注参数收数字串应保持 string（不推断），实际: "
      + j48b["qt"] + "/" + j48b["qv"]);
check(getResp(base + "/api/t/qany").json()["qt"] == "null",
      "B48 未标注参数缺失应 null");
j48c = getResp(base + "/api/t/qany2?q=abc").json();
check(j48c["qt"] == "string" && j48c["qv"] == "abc",
      "B48 显式 any 标注应与未标注同语义，实际: " + j48c["qt"] + "/" + j48c["qv"]);

// ---- 关闭服务 ----
app.stop();
app.join();

print("http_param_type_test ALL PASS");
