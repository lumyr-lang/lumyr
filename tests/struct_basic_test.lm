// struct 基础测试
print("=== Struct Basic Test ===");

struct Point { x: int; y: int; }

p = Point(10, 20);
print("p.x:", p.x);
print("p.y:", p.y);
print("p class:", p.__mapname__);

// struct 作为函数参数
func get_x(pt) {
    return pt.x;
}
print("get_x(p):", get_x(p));

// struct 作为函数返回值
func make_point(x, y) {
    return Point(x, y);
}
p3 = make_point(30, 40);
print("p3.x:", p3.x, "p3.y:", p3.y);

// struct 字段修改
p.x = 100;
p.y = 200;
print("p.x after modify:", p.x);
print("p.y after modify:", p.y);

// 多个 struct 实例
p4 = Point(1, 2);
p5 = Point(3, 4);
print("p4.x:", p4.x, "p4.y:", p4.y);
print("p5.x:", p5.x, "p5.y:", p5.y);

print("=== Struct Basic Test Passed ===");
