// tests/generic_map_test.lm
// 泛型 map 字面量 <K,V>{...} 全类型矩阵（由 fuzz/gen_generic_map_test.py 生成，勿手改）
// K=23 可哈希类型 × V=29 数据类型 = 667 组合

// check：cond 为假则 throw（未捕获错误 → 进程非 0 退出）。
// 注意：动态值的逻辑非 ! 当前语义不一致，统一用 if/else 形式。
func check(cond, msg) {
    if(cond) {} else {
        throw msg;
    }
}

n = 0;

// ===== K = string =====
m_string_int = <string, int>{"k": 7};
check(type(m_string_int) == "map", "string|int: container");
check(m_string_int["k"] == 7, "string|int: value");
check(type(m_string_int["k"]) == "int", "string|int: vtype");
