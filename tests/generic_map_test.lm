check((string)m_ssize_t_bitdecimal[5] == "99", "ssize_t|bitdecimal: value");
check(type(m_ssize_t_bitdecimal[5]) == "bitdecimal", "ssize_t|bitdecimal: vtype");
n = n + 1;

// ===== 附加场景 =====
e0 = <int, string>{};
check(type(e0) == "map", "empty: container");
check(e0[1] == null, "empty: missing key");

e1 = <string, int>{"a": 1, "b": 2};
check(e1["a"] == 1 && e1["b"] == 2, "multi: values");
check(e1.has("a") && e1.len == 2, "multi: has/len");
e1["c"] = 3;
check(e1["c"] == 3 && e1.len == 3, "write: inserted");

e2 = <uint, string>{2: "11", 3: "ssss"};
check(e2[2] == "11" && e2[3] == "ssss", "uint-key: lookup");

print("generic_map_test cases =", n);
print("generic_map_test ALL PASS");
