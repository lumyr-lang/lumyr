// 测试：CC模式 int 类型转化开销检查
print("=== int类型转化开销检查 ===\n");

// 1. 变量声明
a = <int>42;
print("a = ");
print(a);
print("\n");

// 2. 变量赋值
b = a;
print("b = ");
print(b);
print("\n");

// 3. 算术运算
c = a + b;
print("c = a + b = ");
print(c);
print("\n");

// 4. 数组声明
arr = <int>[1, 2, 3];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[1] = ");
print(arr[1]);
print("\n");

// 5. 数组元素赋值
arr[0] = 100;
print("arr[0] after assign = ");
print(arr[0]);
print("\n");

print("=== 检查完成 ===\n");
