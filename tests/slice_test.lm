// tests/slice_test.lm
// 切片：arr[1:3] / arr[2:] / arr[:3] / arr[:] —— 语法糖：调用 builtin slice(arr, start, end)

a = [10, 20, 30, 40, 50];
print(a[1:3]);    // [20, 30]
print(a[2:]);     // [30, 40, 50]
print(a[:2]);     // [10, 20]
print(a[:]);      // [10, 20, 30, 40, 50]

s = "hello world";
print(s[0:5]);    // hello
print(s[6:]);     // world
print(s[:5]);     // hello

// 边界：start > end → 空
print(a[3:1]);    // []
print(a[10:12]);  // [] 越界截断

// 单元素切片仍为数组
print(a[1:2]);    // [20]

// 字符串完整切片
print(s[:]);      // hello world
