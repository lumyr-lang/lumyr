// ref_param_test.lm — 测试 ref 引用传递参数
struct Point { x: int; y: int; }

// 值传递：函数内修改不影响外部
func modify_by_value(<Point> p) {
    p.x = 999;
    print("inside value: p.x =", p.x);
}

// 引用传递：函数内修改影响外部
func modify_by_ref(ref <Point> p) {
    p.x = 888;
    print("inside ref: p.x =", p.x);
}

print("=== Ref Parameter Test ===");

// 值传递测试
print("--- 值传递（默认）---");
p1 = Point(10, 20);
print("before: p1.x =", p1.x);
modify_by_value(p1);
print("after:  p1.x =", p1.x);
if (p1.x == 10) {
    print("PASS: 值传递，函数内修改不影响外部");
} else {
    print("FAIL: 值传递，函数内修改影响了外部");
}

// 引用传递测试
print("\n--- 引用传递（ref）---");
p2 = Point(10, 20);
print("before: p2.x =", p2.x);
modify_by_ref(p2);
print("after:  p2.x =", p2.x);
if (p2.x == 888) {
    print("PASS: 引用传递，函数内修改影响外部");
} else {
    print("FAIL: 引用传递，函数内修改没有影响外部");
}

print("\n=== Done ===");
