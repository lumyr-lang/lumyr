// websocket_stress2_test.lm —— G7 WebSocket 压测二期
//
// P5  二进制并发：W 线程 × R 轮 bytes echo（含 0x00/0xFF），逐字节比对
// P6  大帧并发：127 扩展长度模式（>64KB payload）多线程 echo
// P7  分片并发：多连接同时发 3 片分片消息（fin=0 TEXT + CONT + fin=1 CONT），
//     服务端重组后 echo，验证并发交叉分片不串
// P8  关闭风暴：N 连接建立→发一条→直接断 socket（不走 close 帧），循环两轮，
//     随后正常连接验证服务存活
// P9  协程客户端并发：显式 Reactor + K 协程 × R 轮文本 echo
//
// 运行：./bin/lumyr tests/websocket_stress2_test.lm

import <App/WebApplication>;
import <NetWork/Socket>;
import <NetWork/WebSocket>;
import <NetWork/Reactor>;
import <Thread/Thread>;

func check(cond, msg) {
    if (cond == false) { throw msg; }
}

// ---- 服务端 echo ----
class Stress2Handler implements WebSocketHandler {
    func onOpen(ws: WebSocketConn) { }
    func onMessage(ws: WebSocketConn, data: any) {
        if (type(data) == "string") { ws.sendText(data); }
        else { ws.sendBinary(data); }
    }
    func onClose(ws: WebSocketConn, code: int, reason: string) { }
}

// ---- 握手 ----
func wsConnect(port: int, path: string) {
    cli = ClientSocket("127.0.0.1", port);
    req = "GET " + path + " HTTP/1.1\r\n"
        + "Host: 127.0.0.1\r\n"
        + "Upgrade: websocket\r\n"
        + "Connection: Upgrade\r\n"
        + "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n"
        + "Sec-WebSocket-Version: 13\r\n\r\n";
    cli.sock.send(req);
    head = "";
    while (true) {
        d = cli.sock.recv(4096);
        if (d.len == 0) { break; }
        head = head + d;
        if (head.contains("\r\n\r\n")) { break; }
    }
    check(head.contains("101"), "wsConnect: 握手失败 / handshake failed");
    return cli;
}

// ---- 精确读 n 字节（bytes 模式 + leftover 槽）----
func readN(cli, n: int, leftover: array) {
    acc = leftover[0];
    while (acc.len < n) {
        p = cli.sock.recv(65536, 0, 1);
        if (p.len == 0) { return bytes([]); }
        i = 0;
        while (i < p.len) { acc.add(p[i]); i = i + 1; }
    }
    out = [];
    i = 0;
    while (i < n) { out.add(acc[i]); i = i + 1; }
    rest = [];
    while (i < acc.len) { rest.add(acc[i]); i = i + 1; }
    leftover[0] = rest;
    return bytes(out);
}

// ---- 构造 masked 帧（支持 ≤125 / 126 / 127 长度，fin 可控）----
func buildFrame(payload, op: int, fin: int) {
    mask = [9, 8, 7, 6];
    raw = [];
    raw.add(fin * 128 + op);
    n = payload.len;
    if (n <= 125) {
        raw.add(128 + n);
    } else if (n <= 65535) {
        raw.add(128 + 126);
        raw.add((n / 256) % 256);
        raw.add(n % 256);
    } else {
        raw.add(128 + 127);
        // 8 字节大端长度（payload 远小于 2^32，高 4 字节为 0）
        raw.add(0); raw.add(0); raw.add(0); raw.add(0);
        raw.add((n / 16777216) % 256);
        raw.add((n / 65536) % 256);
        raw.add((n / 256) % 256);
        raw.add(n % 256);
    }
    raw.add(mask[0]); raw.add(mask[1]); raw.add(mask[2]); raw.add(mask[3]);
    i = 0;
    while (i < n) { raw.add(payload[i] ^ mask[i % 4]); i = i + 1; }
    return bytes(raw);
}

// ---- 读一帧，返回 [fin, op, payloadBytes]；失败返回 [-1, -1, []] ----
func readFrame(cli, leftover: array) {
    h = readN(cli, 2, leftover);
    if (h.len < 2) { return [-1, -1, []]; }
    fin = 0;
    if (h[0] >= 128) { fin = 1; }
    op = h[0] & 15;
    plen = h[1] & 127;
    if (plen == 126) {
        ext = readN(cli, 2, leftover);
        if (ext.len < 2) { return [-1, -1, []]; }
        plen = ext[0] * 256 + ext[1];
    } else if (plen == 127) {
        ext = readN(cli, 8, leftover);
        if (ext.len < 8) { return [-1, -1, []]; }
        plen = 0;
        i = 0;
        while (i < 8) { plen = plen * 256 + ext[i]; i = i + 1; }
    }
    if (plen == 0) { return [fin, op, bytes([])]; }
    body = readN(cli, plen, leftover);
    if (body.len < plen) { return [-1, -1, []]; }
    return [fin, op, body];
}

// ---- bytes 逐字节相等 ----
func bytesEq(a, b): bool {
    if (a.len != b.len) { return false; }
    i = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// ---- 构造确定性伪随机 bytes ----
func makeBin(n: int, seed: int) {
    arr = [];
    v = seed;
    i = 0;
    while (i < n) {
        v = (v * 1103515245 + 12345) % 256;
        arr.add(v);
        i = i + 1;
    }
    return bytes(arr);
}

// ============================================================
// P5 二进制多线程并发
// ============================================================
class BinWorker implements Runnable {
    idx: int;
    port: int;
    rounds: int;
    func BinWorker(idx: int, port: int, rounds: int) {
        self.idx = idx;
        self.port = port;
        self.rounds = rounds;
    }
    func run(): int {
        cli = wsConnect(self.port, "/ws");
        leftover = [[]];
        bad = 0;
        r = 0;
        while (r < self.rounds) {
            payload = makeBin(256, self.idx * 31 + r);
            cli.sock.send(buildFrame(payload, 2, 1));   // BINARY fin=1
            f = readFrame(cli, leftover);
            if (f[1] != 2) { bad = bad + 1; }
            else if (!bytesEq(f[2], payload)) { bad = bad + 1; }
            r = r + 1;
        }
        cli.close();
        return bad;
    }
}

func phase5(port: int, workers: int, rounds: int) {
    print("[P5] 二进制并发 / binary concurrent: " + workers + " × " + rounds);
    threads = [];
    i = 0;
    t0 = timestamp_ms();
    while (i < workers) {
        threads.add(Thread("bin-" + i, BinWorker(i, port, rounds)).start());
        i = i + 1;
    }
    bad = 0;
    i = 0;
    while (i < threads.len) { bad = bad + threads[i].join(); i = i + 1; }
    t1 = timestamp_ms();
    print("  消息 " + (workers * rounds) + " 条，bad=" + bad + "，耗时 " + (t1 - t0) + " ms");
    check(bad == 0, "P5: 二进制 echo 不一致 bad=" + bad);
    print("  P5 PASS");
}

// ============================================================
// P6 大帧并发（127 扩展长度，>64KB）
// ============================================================
class BigFrameWorker implements Runnable {
    idx: int;
    port: int;
    rounds: int;
    size: int;
    func BigFrameWorker(idx: int, port: int, rounds: int, size: int) {
        self.idx = idx;
        self.port = port;
        self.rounds = rounds;
        self.size = size;
    }
    func run(): int {
        cli = wsConnect(self.port, "/ws");
        leftover = [[]];
        bad = 0;
        // 大 payload 每轮内容不同（seed 变化），文本帧
        r = 0;
        while (r < self.rounds) {
            payload = makeBin(self.size, self.idx * 7 + r);
            cli.sock.send(buildFrame(payload, 2, 1));
            f = readFrame(cli, leftover);
            if (f[1] != 2) { bad = bad + 1; }
            else if (!bytesEq(f[2], payload)) { bad = bad + 1; }
            r = r + 1;
        }
        cli.close();
        return bad;
    }
}

func phase6(port: int, workers: int, rounds: int, size: int) {
    print("[P6] 大帧并发 / big-frame concurrent: " + workers + " × " + rounds + " × " + size + "B");
    threads = [];
    i = 0;
    t0 = timestamp_ms();
    while (i < workers) {
        threads.add(Thread("big-" + i, BigFrameWorker(i, port, rounds, size)).start());
        i = i + 1;
    }
    bad = 0;
    i = 0;
    while (i < threads.len) { bad = bad + threads[i].join(); i = i + 1; }
    t1 = timestamp_ms();
    totalMB = workers * rounds * size / 1048576;
    print("  消息 " + (workers * rounds) + " 条（共约 " + totalMB + " MB），bad=" + bad + "，耗时 " + (t1 - t0) + " ms");
    check(bad == 0, "P6: 大帧 echo 不一致 bad=" + bad);
    print("  P6 PASS");
}

// ============================================================
// P7 分片并发（3 片重组）
// ============================================================
func phase7(port: int, conns: int, rounds: int) {
    print("[P7] 分片并发 / fragmentation concurrent: " + conns + " × " + rounds);
    clis = [];
    leftovers = [];
    i = 0;
    while (i < conns) {
        clis.add(wsConnect(port, "/ws"));
        leftovers.add([[]]);
        i = i + 1;
    }
    bad = 0;
    t0 = timestamp_ms();
    r = 0;
    while (r < rounds) {
        i = 0;
        while (i < conns) {
            // 一条消息分 3 片：fin=0 TEXT + fin=0 CONT + fin=1 CONT
            m1 = bytes("frag-c" + i + "-r" + r + "-part1-");
            m2 = bytes("part2-");
            m3 = bytes("-part3-end");
            cli = clis[i];
            cli.sock.send(buildFrame(m1, 1, 0));
            cli.sock.send(buildFrame(m2, 0, 0));
            cli.sock.send(buildFrame(m3, 0, 1));
            f = readFrame(cli, leftovers[i]);
            expect = "frag-c" + i + "-r" + r + "-part1-part2--part3-end";
            if (f[1] != 1) { bad = bad + 1; }
            else if (f[2].decode() != expect) { bad = bad + 1; }
            i = i + 1;
        }
        r = r + 1;
    }
    t1 = timestamp_ms();
    print("  消息 " + (conns * rounds) + " 条（每条 3 片），bad=" + bad + "，耗时 " + (t1 - t0) + " ms");
    check(bad == 0, "P7: 分片重组不一致 bad=" + bad);
    i = 0;
    while (i < clis.len()) { clis[i].close(); i = i + 1; }
    sleep(200);
    print("  P7 PASS");
}

// ============================================================
// P8 关闭风暴（异常断开 + 服务存活验证）
// ============================================================
func phase8(port: int, total: int) {
    print("[P8] 关闭风暴 / close storm: " + total + " conns × 2 waves");
    wave = 0;
    t0 = timestamp_ms();
    while (wave < 2) {
        i = 0;
        while (i < total) {
            cli = wsConnect(port, "/ws");
            // 发一条后直接断 socket（不发 close 帧——异常断开路径）
            cli.sock.send(buildFrame(bytes("bye-" + wave + "-" + i), 1, 1));
            cli.close();
            i = i + 1;
        }
        wave = wave + 1;
        print("  第 " + wave + " 波完成 / wave done");
    }
    // 服务存活验证：20 条正常 echo
    ok = 0;
    i = 0;
    while (i < 20) {
        cli = wsConnect(port, "/ws");
        leftover = [[]];
        cli.sock.send(buildFrame(bytes("alive-" + i), 1, 1));
        f = readFrame(cli, leftover);
        if (f[2].decode() == "alive-" + i) { ok = ok + 1; }
        cli.close();
        i = i + 1;
    }
    t1 = timestamp_ms();
    print("  风暴后存活验证 " + ok + "/20，总耗时 " + (t1 - t0) + " ms");
    check(ok == 20, "P8: 关闭风暴后服务异常 ok=" + ok);
    print("  P8 PASS");
}

// ============================================================
// P9 服务端多协程切换（连接协程内 yield）
// 说明：不自己起主线程 Reactor（与 WebApplication worker 线程协程调度冲突）。
// 改为在 handler 内 coYield() 让出，由 worker 线程 scheduler 调度其他连接协程，
// 验证多协程并发切换不破坏 WS 帧状态。
// ============================================================
class ServerCoHandler implements WebSocketHandler {
    func onOpen(ws: WebSocketConn) { }
    func onMessage(ws: WebSocketConn, data: any) {
        // 强制 yield：让其他连接协程运行，验证 scheduler 切换后帧状态完好
        coYield();
        if (type(data) == "string") { ws.sendText(data); }
        else { ws.sendBinary(data); }
    }
    func onClose(ws: WebSocketConn, code: int, reason: string) { }
}

func phase9(port: int, workers: int, rounds: int) {
    print("[P9] 服务端多协程回压 / server coroutine echo: " + workers + " × " + rounds);
    // 换 handler 重启应用代价大，直接用新端口
    coPort = 19415;
    app2 = WebApplication("127.0.0.1", coPort);
    app2.get("/ws", func(req) {
        if (WebSocket.isUpgrade(req)) { return WebSocket.accept(req, ServerCoHandler()); }
        r = ServerResponse(400);
        r.text("WebSocket only");
        return r;
    });
    app2.startAsync();
    sleep(300);

    clis = [];
    leftovers = [];
    i = 0;
    while (i < workers) {
        clis.add(wsConnect(coPort, "/ws"));
        leftovers.add([[]]);
        i = i + 1;
    }
    bad = 0;
    t0 = timestamp_ms();
    r = 0;
    while (r < rounds) {
        i = 0;
        while (i < clis.len()) {
            msg = "srv-co-" + i + "-" + r;
            clis[i].sock.send(buildFrame(bytes(msg), 1, 1));
            f = readFrame(clis[i], leftovers[i]);
            if (f[2].decode() != msg) { bad = bad + 1; }
            i = i + 1;
        }
        r = r + 1;
    }
    t1 = timestamp_ms();
    i = 0;
    while (i < clis.len()) { clis[i].close(); i = i + 1; }
    app2.stop();
    app2.join();
    totalMsg = workers * rounds;
    rate = totalMsg * 1000 / (t1 - t0 + 1);
    print("  消息 " + totalMsg + " 条，bad=" + bad + "，耗时 " + (t1 - t0) + " ms，约 " + rate + " msg/s");
    check(bad == 0, "P9: 服务端协程 echo 不一致 bad=" + bad);
    print("  P9 PASS");
}

// ---- main ----
func main() {
    port = 19413;
    print("=== WebSocket 压测二期 / stress phase 2 ===");

    app = WebApplication("127.0.0.1", port);
    app.get("/ws", func(req) {
        if (WebSocket.isUpgrade(req)) { return WebSocket.accept(req, Stress2Handler()); }
        r = ServerResponse(400);
        r.text("WebSocket only");
        return r;
    });
    app.startAsync();
    sleep(300);

    phase5(port, 4, 300);        // 二进制 4 线程 × 300
    phase6(port, 2, 10, 100000); // 大帧 2 线程 × 10 × 100KB
    phase7(port, 10, 50);        // 分片 10 连接 × 50 轮
    phase8(port, 200);           // 关闭风暴 200 × 2 波
    phase9(port, 4, 300);        // 协程 4 × 300

    app.stop();
    app.join();

    print("=== ALL PASS / 全部通过 ===");
    return true;
}

main();
