// 场景2 + 场景5 组合测试
print("=== 场景2 + 场景5 组合测试 ===");

// 场景2：super 调用
class Base {
    func hello(self) {
        print("Hello from Base");
    }
}

class Derived extends Base {
    func hello(self) {
        super.hello();
        print("Hello from Derived");
    }
}

derived = Derived();
derived.hello();

// 场景5：结构体方法
struct Point {
    x: int;
    y: int;
    func distance(self, other) {
        dx = self.x - other.x;
        dy = self.y - other.y;
        return dx * dx + dy * dy;
    }
}

p1 = Point();
p1.x = 0;
p1.y = 0;
p2 = Point();
p2.x = 3;
p2.y = 4;
print("p1.distance(p2) =", p1.distance(p2));

print("=== 场景2 + 场景5 组合测试完成 ===");
