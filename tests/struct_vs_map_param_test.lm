// struct_vs_map_param_test.lm — 验证 struct 参数值传递，map 参数引用传递
struct Point { x: int; y: int; }

func modify_struct(p) {
    p.x = 999;
    print("inside struct: p.x =", p.x);
}

func modify_map(m) {
    m["key"] = 999;
    print("inside map: m[key] =", m["key"]);
}

print("=== Struct vs Map Parameter Test ===");

// struct 参数：值传递
print("--- struct 参数（值传递）---");
p = Point(10, 20);
print("before: p.x =", p.x);
modify_struct(p);
print("after:  p.x =", p.x);
if (p.x == 10) {
    print("PASS: struct 参数是值传递，函数内修改不影响外部");
} else {
    print("FAIL: struct 参数是引用传递");
}

// map 参数：引用传递
print("\n--- map 参数（引用传递）---");
m = {"key": 10};
print("before: m[key] =", m["key"]);
modify_map(m);
print("after:  m[key] =", m["key"]);
if (m["key"] == 999) {
    print("PASS: map 参数是引用传递，函数内修改影响外部");
} else {
    print("FAIL: map 参数是值传递");
}

print("\n=== Done ===");
