// 测试：uint64 最大值溢出问题修复
print("=== uint64 最大值测试 ===\n");

// 1. 测试 uint64 最大值
a = <uint64>18446744073709551615;
print("a = ");
print(a);
print("\n");

// 2. 测试 int64 最大值
b = <int64>9223372036854775807;
print("b = ");
print(b);
print("\n");

// 3. 测试普通整数
c = <uint64>1000000;
print("c = ");
print(c);
print("\n");

// 4. 测试 uint64 数组
arr = <uint64>[18446744073709551615, 9223372036854775807, 1000000];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[1] = ");
print(arr[1]);
print("\n");
print("arr[2] = ");
print(arr[2]);
print("\n");

print("=== 测试完成 ===\n");
