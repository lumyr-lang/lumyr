// 测试算术运算结果赋值给变量的零转换开销
print("=== int arithmetic test ===\n");

a = <int>10;
b = <int>20;
c = a + b;
print("c = ");
print(c);
print("\n");

d = a * b;
print("d = ");
print(d);
print("\n");

e = b - a;
print("e = ");
print(e);
print("\n");

print("=== double arithmetic test ===\n");

x = <double>1.5;
y = <double>2.5;
z = x + y;
print("z = ");
print(z);
print("\n");

w = x * y;
print("w = ");
print(w);
print("\n");

print("=== done ===\n");
