// 多层继承 + 构造函数链组合测试
print("=== 多层继承 + 构造函数链组合测试 ===");

class Animal {
    name: string;
    func __init__(self, name) {
        self.name = name;
        print("Animal constructor: name =", name);
    }
    func speak(self) {
        print("Animal speaks");
    }
}

class Dog extends Animal {
    breed: string;
    func __init__(self, name, breed) {
        super.__init__(name);
        self.breed = breed;
        print("Dog constructor: breed =", breed);
    }
    func speak(self) {
        print("Dog barks");
    }
}

class Puppy extends Dog {
    age: int;
    func __init__(self, name, breed, age) {
        super.__init__(name, breed);
        self.age = age;
        print("Puppy constructor: age =", age);
    }
    func speak(self) {
        print("Puppy yips");
    }
}

puppy = Puppy("Max", "Labrador", 1);
print("puppy.name =", puppy.name);
print("puppy.breed =", puppy.breed);
print("puppy.age =", puppy.age);
puppy.speak();

print("=== 多层继承 + 构造函数链组合测试完成 ===");
