        while (r < self.rounds) {
            q = "t" + self.idx + "x" + r;
            expect = "q=" + q + ";page=" + r;
            if (!roundClose("GET", "/search?q=" + q + "&page=" + r, "", "", 200, expect)) { bad = bad + 1; }
            r = r + 1;
        }
        return bad;
    }
}

