}

// ============================================================
// W4：JSON POST
// ============================================================
class W4Worker implements Runnable {
    idx: int;
    rounds: int;
    func W4Worker(idx: int, rounds: int) {
        self.idx = idx;
        self.rounds = rounds;
    }
    func run(): int {
        bad = 0;
        r = 0;
        while (r < self.rounds) {
            body = "{\"k\":\"j" + self.idx + "\",\"n\":" + r + "}";
            heads = "Content-Type: application/json" + crlf;
            if (!roundClose("POST", "/json", heads, body, 200, body)) { bad = bad + 1; }
            r = r + 1;
        }
        return bad;
    }
}

// ============================================================
// CY：handler 内 coYield
// ============================================================
class CYWorker implements Runnable {
    idx: int;
    rounds: int;
    func CYWorker(idx: int, rounds: int) {
        self.idx = idx;
        self.rounds = rounds;
    }
    func run(): int {
        bad = 0;
        r = 0;
        while (r < self.rounds) {
            if (!roundClose("GET", "/yield", "", "", 200, "Y ok")) { bad = bad + 1; }
            r = r + 1;
        }
        return bad;
    }
}

// ============================================================
// F1：文件上传 md5
// ============================================================
class F1Worker implements Runnable {
    idx: int;
    rounds: int;
    expectMd5: string;
    func F1Worker(idx: int, rounds: int, expectMd5: string) {
        self.idx = idx;
        self.rounds = rounds;
        self.expectMd5 = expectMd5;
    }
    func run(): int {
        bad = 0;
        r = 0;
        while (r < self.rounds) {
            if (!roundClose("POST", "/upload", "Content-Type: application/octet-stream" + crlf,
                            up2m, 200, self.expectMd5)) { bad = bad + 1; }
            r = r + 1;
        }
        return bad;
    }
}

// ============================================================
// F2：明文大文件下载
// ============================================================
class F2Worker implements Runnable {
    idx: int;
    rounds: int;
    func F2Worker(idx: int, rounds: int) {
        self.idx = idx;
        self.rounds = rounds;
    }
    func run(): int {
        bad = 0;
        r = 0;
        while (r < self.rounds) {
            if (!roundClose("GET", "/download", "", "", 200, big2m)) { bad = bad + 1; }
            r = r + 1;
        }
        return bad;
    }
}

// ============================================================
// F3：chunked 流式下载
// ============================================================
class F3Worker implements Runnable {
    idx: int;
    rounds: int;
    expect: string;
    func F3Worker(idx: int, rounds: int, expect: string) {
        self.idx = idx;
        self.rounds = rounds;
        self.expect = expect;
    }
    func run(): int {
        bad = 0;
        r = 0;
        while (r < self.rounds) {
            sock = newSock();
            sendReq(sock, "GET", "/chunked", "", "", false);
            // chunked 也可能随 close 结束：按头部分流
            resp = readRespClose(sock);
            sock.close();
            head = resp[1].lower();
            body = resp[2];
            if (resp[0] != 200) { bad = bad + 1; r = r + 1; continue; }
            if (head.contains("transfer-encoding: chunked")) {
                lo = [body];
                sock2 = null;
                // close 模式已读完全部字节：直接在 leftover 上 dechunk
                body = dechunkFromLo(lo);
            }
            if (body != self.expect) { bad = bad + 1; }
            r = r + 1;
        }
        return bad;
    }
}

// close 模式全量串上的 dechunk（数据已在 leftover 串内，无需 socket）
func dechunkFromLo(lo): string {
    body = "";
    while (true) {
        acc = lo[0];
        p = acc.indexOf(crlf);
        if (p < 0) { return body; }
        line = acc.slice(0, p);
        lo[0] = acc.slice(p + 2);
        n = 0;
        lb = bytes(line);   // 字节数组取下标才是字符码；(int)string 是数字解析语义
        i = 0;
        while (i < lb.len) {
            cv = lb[i];
            if (cv >= 48 && cv <= 57) { n = n * 16 + (cv - 48); }
            else if (cv >= 97 && cv <= 102) { n = n * 16 + (cv - 87); }
            i = i + 1;
        }
        if (n == 0) { break; }
        acc = lo[0];
        body = body + acc.slice(0, n);
        lo[0] = acc.slice(n + 2);
    }
    return body;
}

// ============================================================
// F4：落盘回读（按线程名分文件）
// ============================================================
class F4Worker implements Runnable {
    idx: int;
    rounds: int;
    payload: string;
    expectMd5: string;
    func F4Worker(idx: int, rounds: int, payload: string, expectMd5: string) {
        self.idx = idx;
        self.rounds = rounds;
        self.payload = payload;
        self.expectMd5 = expectMd5;
    }
    func run(): int {
        bad = 0;
        name = "f4_" + self.idx;
        r = 0;
        while (r < self.rounds) {
            // 上传落盘 / save
            if (!roundClose("POST", "/upload_save?name=" + name,
                            "Content-Type: application/octet-stream" + crlf,
                            self.payload, 200, self.expectMd5)) { bad = bad + 1; r = r + 1; continue; }
            // 回读比对 / read back
            if (!roundClose("GET", "/saved?name=" + name, "", "", 200, self.payload)) { bad = bad + 1; }
            r = r + 1;
        }
        return bad;
    }
}

// ============================================================
// KA1：keep-alive 复用（单连接 100 轮顺序请求）
// ============================================================
class KA1Worker implements Runnable {
    idx: int;
    rounds: int;
    func KA1Worker(idx: int, rounds: int) {
        self.idx = idx;
        self.rounds = rounds;
    }
    func run(): int {
        bad = 0;
        sock = newSock();
        lo = [""];
        r = 0;
        while (r < self.rounds) {
            q = "ka" + self.idx + "-" + r;
            sendReq(sock, "GET", "/search?q=" + q + "&page=" + r, "", "", true);
            resp = readRespKA(sock, lo);
            expect = "q=" + q + ";page=" + r;
            if (resp[0] != 200 || resp[2] != expect) { bad = bad + 1; }
            r = r + 1;
        }
        sock.close();
        return bad;
    }
}

// ============================================================
// KA2：pipelining（连发 8 个再按序读 8 个）
// ============================================================
class KA2Worker implements Runnable {
    idx: int;
    batches: int;
    func KA2Worker(idx: int, batches: int) {
        self.idx = idx;
        self.batches = batches;
    }
    func run(): int {
        bad = 0;
        sock = newSock();
        lo = [""];
        b = 0;
        while (b < self.batches) {
            k = 0;
            while (k < 8) {
                sendReq(sock, "GET", "/search?q=pp" + self.idx + "-" + b + "-" + k + "&page=" + k, "", "", true);
                k = k + 1;
            }
            k = 0;
            while (k < 8) {
                resp = readRespKA(sock, lo);
                expect = "q=pp" + self.idx + "-" + b + "-" + k + ";page=" + k;
                if (resp[0] != 200 || resp[2] != expect) { bad = bad + 1; }
                k = k + 1;
            }
            b = b + 1;
        }
        sock.close();
        return bad;
    }
}

// ============================================================
// E4：慢速 client（小片间隔发送）
// ============================================================
class SlowWorker implements Runnable {
    idx: int;
    rounds: int;
    func SlowWorker(idx: int, rounds: int) {
        self.idx = idx;
        self.rounds = rounds;
    }
    func run(): int {
        bad = 0;
        r = 0;
        while (r < self.rounds) {
            sock = newSock();
            h = "POST /echo HTTP/1.1" + crlf + "Host: s4" + crlf
                + "Content-Type: text/plain" + crlf
                + "Content-Length: " + slow256k.len + crlf
                + "Connection: close" + crlf + crlf;
            sock.send(h);
            pos = 0;
            while (pos < slow256k.len) {
                end = pos + 1024;
                if (end > slow256k.len) { end = slow256k.len; }
                sock.send(slow256k.slice(pos, end));
                sleep(5);
                pos = end;
            }
            resp = readRespClose(sock);
            sock.close();
            if (resp[0] != 200 || resp[2] != slow256k) { bad = bad + 1; }
            r = r + 1;
        }
        return bad;
    }
}

// ============================================================
// L1：混合长跑（持久连接轮换多路由）
// ============================================================
class MixWorker implements Runnable {
    idx: int;
    seconds: int;
    func MixWorker(idx: int, seconds: int) {
        self.idx = idx;
        self.seconds = seconds;
    }
    func run(): int {
        bad = 0;
        sock = newSock();
        lo = [""];
        t0 = timestamp_ms();
        ops = 0;
        while (timestamp_ms() - t0 < self.seconds * 1000) {
            mode = ops % 5;
            ok = false;
            if (mode == 0) {
                sendReq(sock, "GET", "/site/index.html", "", "", true);
                resp = readRespKA(sock, lo);
                ok = resp[0] == 200 && resp[2].contains("LUMIN-S4-PAGE-MARKER");
            } else if (mode == 1) {
                sendReq(sock, "GET", "/search?q=mix" + ops + "&page=" + ops, "", "", true);
                resp = readRespKA(sock, lo);
                ok = resp[0] == 200 && resp[2] == "q=mix" + ops + ";page=" + ops;
            } else if (mode == 2) {
                body = "user=mu" + self.idx + "&pass=mp" + ops;
                sendReq(sock, "POST", "/form", "Content-Type: application/x-www-form-urlencoded" + crlf, body, true);
                resp = readRespKA(sock, lo);
                ok = resp[0] == 200 && resp[2] == "user=mu" + self.idx + ";pass=mp" + ops;
            } else if (mode == 3) {
                body = "{\"mix\":" + ops + "}";
                sendReq(sock, "POST", "/json", "Content-Type: application/json" + crlf, body, true);
                resp = readRespKA(sock, lo);
                ok = resp[0] == 200 && resp[2] == body;
            } else {
                sendReq(sock, "GET", "/yield", "", "", true);
                resp = readRespKA(sock, lo);
                ok = resp[0] == 200 && resp[2] == "Y ok";
            }
            if (!ok) { bad = bad + 1; }
            ops = ops + 1;
        }
        sock.close();
        print("  [L1] 线程 " + self.idx + " ops=" + ops + " bad=" + bad);
        return bad;
    }
}

// ============================================================
// main
// ============================================================
func main() {
    print("=== HTTP 压测四期 / http stress phase 4 ===");

    // 准备静态站点 / prepare static site
    Files.createDir(SITE_DIR);
    writeFile(SITE_DIR + "/index.html", pageHtml);
    writeFile(SITE_DIR + "/style.css", "body{color:#333}");
    sleep(100);   // startAsync 就绪 / wait for listener

    upMd5 = md5(up2m);

    print("[M1] 方法矩阵 / method matrix: 6 线程 × 40 轮 × 6 方法");
    runWorkers("M1", 6, func(i) { return M1Worker(i, 40); });

    print("[W1] 静态网页高并发 / static site: 12 × 80");
    runWorkers("W1", 12, func(i) { return W1Worker(i, 80); });

    print("[W2] query 参数 / query params: 6 × 40");
    runWorkers("W2", 6, func(i) { return W2Worker(i, 40); });

    print("[W3] 表单 POST / urlencoded form: 6 × 40");
    runWorkers("W3", 6, func(i) { return W3Worker(i, 40); });

    print("[W4] JSON POST: 6 × 40");
    runWorkers("W4", 6, func(i) { return W4Worker(i, 40); });

    print("[CY] handler coYield: 12 × 40");
    runWorkers("CY", 12, func(i) { return CYWorker(i, 40); });

    print("[F1] 文件上传 md5 / upload 2MiB: 4 × 3");
    runWorkers("F1", 4, func(i) { return F1Worker(i, 3, upMd5); });

    print("[F2] 明文下载 2MiB / download: 4 × 3");
    runWorkers("F2", 4, func(i) { return F2Worker(i, 3); });

    print("[F3] chunked 流式下载 256KiB / chunked: 4 × 3");
    runWorkers("F3", 4, func(i) { return F3Worker(i, 3, chunk4kExpect); });

    print("[F4] 落盘回读 512KiB / save+read: 2 × 3");
    f4payload = makeText(524288);
    f4md5 = md5(f4payload);
    runWorkers("F4", 2, func(i) { return F4Worker(i, 3, f4payload, f4md5); });

    print("[KA1] keep-alive 复用 / persistent: 6 × 1 连接 × 100");
    runWorkers("KA1", 6, func(i) { return KA1Worker(i, 100); });

    print("[KA2] pipelining: 4 × 15 批 × 8 连发");
    runWorkers("KA2", 4, func(i) { return KA2Worker(i, 15); });

    // ---- 负向边界 / negative boundaries ----
    print("[E1] 大 header → 431");
    sock = newSock();
    // 服务端读到上限即回 431 并关闭，此时 1MiB 头大量字节仍在飞行中/对端接收缓冲，
    // close() 必发 RST（非 FIN）。客户端有两种合规结果：先读到 431，
    // 或 send/recv 直接收 Connection reset（时序竞态），二者均判定通过
    e1ok = false;
    try {
        sendReq(sock, "GET", "/method", "X-Big: " + makeText(1048576) + crlf, "", false);
        resp = readRespClose(sock);
        if (resp[0] == 431) { e1ok = true; }
    } catch (e) {
        // RST / Broken pipe：服务端已完成 431 拦截后强制关连接，符合预期
        e1ok = true;
    }
    try { sock.close(); } catch (e2) { }
    check(e1ok, "E1: 期望 431 或连接被重置，均未发生");
    print("  E1 PASS");

    print("[E2] 大 body → 413（CL=5MiB 超 4MiB 上限）");
    sock = newSock();
    // 只发头部带超大 CL：服务端按 CL 前置拦截，无需真发 5MiB
    sock.send("POST /upload HTTP/1.1" + crlf + "Host: s4" + crlf
              + "Content-Length: 5242880" + crlf + "Connection: close" + crlf + crlf);
    resp = readRespClose(sock);
    sock.close();
    check(resp[0] == 413, "E2: 期望 413，实际 " + resp[0]);
    print("  E2 PASS");

    print("[E3] 静态资源 POST → 405");
    sock = newSock();
    sendReq(sock, "POST", "/site/index.html", "Content-Type: text/plain" + crlf, "x", false);
    resp = readRespClose(sock);
    sock.close();
    check(resp[0] == 405, "E3: 期望 405，实际 " + resp[0]);
    print("  E3 PASS");

    print("[E4] 慢速 client / slow client: 2 × 2 × 256KiB(1KiB/5ms)");
    runWorkers("E4", 2, func(i) { return SlowWorker(i, 2); });

    print("[L1] 混合长跑 / mixed long run: 8 线程 × 12s");
    runWorkers("L1", 8, func(i) { return MixWorker(i, 12); });

    app.stop();
    print("=== ALL PASS / 四期全部通过 ===");
    return true;
}

main();
