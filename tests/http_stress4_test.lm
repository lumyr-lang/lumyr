// W3：表单 POST
// ============================================================
class W3Worker implements Runnable {
    idx: int;
    rounds: int;
    func W3Worker(idx: int, rounds: int) {
        self.idx = idx;
        self.rounds = rounds;
    }
    func run(): int {
        bad = 0;
        r = 0;
        while (r < self.rounds) {
            body = "user=u" + self.idx + "&pass=p" + r;
            expect = "user=u" + self.idx + ";pass=p" + r;
            heads = "Content-Type: application/x-www-form-urlencoded" + crlf;
            if (!roundClose("POST", "/form", heads, body, 200, expect)) { bad = bad + 1; }
            r = r + 1;
        }
        return bad;
