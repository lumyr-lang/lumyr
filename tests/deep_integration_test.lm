// ============================================================
// 深度综合测试：7 个新特性 + 现有功能结合
// ============================================================

print("========== 场景 1：do-while + for-each + 默认参数 ==========");

func process_array(arr, multiplier = 2) {
    i = 0;
    result = 0;
    do {
        result = result + arr[i] * multiplier;
        i = i + 1;
    } while (i < len(arr));
    return result;
}

nums = [1, 2, 3, 4, 5];
print("默认 multiplier=2: " + process_array(nums));
print("指定 multiplier=3: " + process_array(nums, 3));

sum = 0;
for x in nums {
    sum = sum + x;
}
print("for-each 求和: " + sum);

print("========== 场景 2：注解 + const fn + 宏 ==========");

// 注解标记的函数
func old_func(x, y = 10) {
    return x * y + 5;
}

// const fn（编译期计算）
const func old_calc(x, y = 10) {
    return x * y + 5;
}

macro log_info(msg) {
    print("[INFO] " + msg);
}

log_info("开始计算");
print("old_calc(3): " + old_calc(3));
print("old_calc(3, 20): " + old_calc(3, 20));
log_info("计算完成");

print("========== 场景 3：空安全 + 默认参数 + for-each ==========");

users = [
    {"name": "Alice", "age": 30},
    {"name": "Bob", "age": 25},
    null,
    {"name": "Charlie", "age": 35}
];

total_age = 0;
valid_count = 0;
for u in users {
    age = u?.age ?? 0;
    if (age > 0) {
        total_age = total_age + age;
        valid_count = valid_count + 1;
    }
}
print("有效用户数: " + valid_count);
print("总年龄: " + total_age);

print("========== 场景 4：const fn + 宏 + do-while ==========");

const func factorial(n) {
    result = 1;
    i = 1;
    do {
        result = result * i;
        i = i + 1;
    } while (i <= n);
    return result;
}

macro assert_eq(actual, expected, msg) {
    if (actual != expected) {
        print("[FAIL] " + msg);
    } else {
        print("[PASS] " + msg);
    }
}

print("5! = " + factorial(5));
print("6! = " + factorial(6));
if (factorial(5) == 120) {
    print("[PASS] factorial(5)");
} else {
    print("[FAIL] factorial(5): expected 120, got " + factorial(5));
}

print("========== 场景 5：注解 + 空安全 + 默认参数 ==========");

func get_user_name(user, default_name = "Unknown") {
    return user?.name ?? default_name;
}

alice = {"name": "Alice", "email": "alice@example.com"};
nobody = null;

print("Alice: " + get_user_name(alice));
print("Nobody: " + get_user_name(nobody));
print("Nobody (custom): " + get_user_name(nobody, "Guest"));

print("========== 场景 6：宏 + for-each + 空安全 ==========");

products = [
    {"name": "Laptop", "price": 999},
    {"name": "Mouse", "price": 29},
    null,
    {"name": "Keyboard", "price": 79}
];

total_price = 0;
for p in products {
    price = p?.price ?? 0;
    total_price = total_price + price;
}
print("商品总价: " + total_price);

first_product = products[0];
print("第一个商品: " + first_product?.name);

print("========== 场景 7：const fn + 注解 + do-while ==========");

// 优化标记的函数
func fib_normal(n) {
    if (n <= 1) {
        return n;
    }
    a = 0;
    b = 1;
    i = 2;
    do {
        temp = a + b;
        a = b;
        b = temp;
        i = i + 1;
    } while (i <= n);
    return b;
}

// const fn（编译期计算）
const func fib(n) {
    if (n <= 1) {
        return n;
    }
    a = 0;
    b = 1;
    i = 2;
    do {
        temp = a + b;
        a = b;
        b = temp;
        i = i + 1;
    } while (i <= n);
    return b;
}

print("fib(10) = " + fib(10));
print("fib(15) = " + fib(15));

fib_sum = 0;
j = 0;
do {
    fib_sum = fib_sum + fib(j);
    j = j + 1;
} while (j <= 10);
print("fib(0..10) sum = " + fib_sum);

print("========== 场景 8：所有特性大综合 ==========");

// 性能关键标记
func process_data_normal(data, threshold = 50, multiplier = 2) {
    result = 0;
    count = 0;
    i = 0;
    do {
        val = data[i] ?? 0;
        if (val > threshold) {
            result = result + val * multiplier;
            count = count + 1;
        }
        i = i + 1;
    } while (i < len(data));
    return result;
}

// const fn（编译期计算）
const func process_data(data, threshold = 50, multiplier = 2) {
    result = 0;
    count = 0;
    i = 0;
    do {
        val = data[i] ?? 0;
        if (val > threshold) {
            result = result + val * multiplier;
            count = count + 1;
        }
        i = i + 1;
    } while (i < len(data));
    return result;
}

dataset = [10, 60, 30, 80, 45, 90, 20, 70, 55, 100];

print("默认参数处理: " + process_data(dataset));
print("自定义阈值: " + process_data(dataset, 40));
print("自定义阈值和乘数: " + process_data(dataset, 30, 3));

processed = [];
for val in dataset {
    if (val > 50) {
        processed = add(processed, val * 2);
    }
}
print("处理后数组长度: " + len(processed));

nullable_data = [50, null, 70, null, 90];
safe_sum = 0;
for v in nullable_data {
    safe_sum = safe_sum + (v ?? 0);
}
print("空安全求和: " + safe_sum);

print("========== 全部深度综合测试完成 ==========");
