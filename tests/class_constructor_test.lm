// class_constructor_test.lm - class 自定义构造函数测试
print("=== Class Constructor Test ===");

class Animal {
    name: string;
    age: int;
    func __init__(self, name, age) {
        self.name = name;
        self.age = age;
        print("Animal constructor called:", name, age);
    }
    func speak(self) {
        print("Animal speaks");
    }
}

class Dog extends Animal {
    breed: string;
    func __init__(self, name, age, breed) {
        self.name = name;
        self.age = age;
        self.breed = breed;
        print("Dog constructor called:", name, age, breed);
    }
    func speak(self) {
        print("Dog barks");
    }
}

print("--- 1. 自定义构造函数 ---");
a = Animal("Cat", 3);
print("name:", a.name);
print("age:", a.age);
a.speak();

print("\n--- 2. 子类自定义构造函数 ---");
d = Dog("Buddy", 2, "Golden");
print("name:", d.name);
print("age:", d.age);
print("breed:", d.breed);
d.speak();

print("\n=== All Class Constructor Tests Passed ===");
