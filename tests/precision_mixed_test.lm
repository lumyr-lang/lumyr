/* 高精度混合运算测试：bigint + decimal + 二十种数据类型 + 多链路 */

/* ========== 第一部分：高精度基础运算 ========== */

/* 测试 1：bigint + int */
a = <bigint>"12345678901234567890";
b = <int>100;
c = a + b;
print("1. bigint + int:");
print(a);
print(b);
print(c);

/* 测试 2：bigint - int */
a = <bigint>"12345678901234567890";
b = <int>100;
c = a - b;
print("2. bigint - int:");
print(a);
print(b);
print(c);

/* 测试 3：bigint * int */
a = <bigint>"12345678901234567890";
b = <int>100;
c = a * b;
print("3. bigint * int:");
print(a);
print(b);
print(c);

/* 测试 4：bigint / int */
a = <bigint>"12345678901234567890";
b = <int>100;
c = a / b;
print("4. bigint / int:");
print(a);
print(b);
print(c);

/* 测试 5：decimal + double */
a = <decimal>"123.45678901234567890";
b = <double>20.5;
c = a + b;
print("5. decimal + double:");
print(a);
print(b);
print(c);

/* 测试 6：decimal - double */
a = <decimal>"123.45678901234567890";
b = <double>20.5;
c = a - b;
print("6. decimal - double:");
print(a);
print(b);
print(c);

/* 测试 7：decimal * double */
a = <decimal>"123.45678901234567890";
b = <double>20.5;
c = a * b;
print("7. decimal * double:");
print(a);
print(b);
print(c);

/* 测试 8：decimal / double */
a = <decimal>"123.45678901234567890";
b = <double>20.5;
c = a / b;
print("8. decimal / double:");
print(a);
print(b);
print(c);

/* ========== 第二部分：高精度 + 二十种数据类型混合运算 ========== */

/* 测试 9：bigint + int + double */
a = <bigint>"12345678901234567890";
b = <int>100;
c = <double>20.5;
d = a + b + c;
print("9. bigint + int + double:");
print(a);
print(b);
print(c);
print(d);

/* 测试 10：bigint * int - double */
a = <bigint>"12345678901234567890";
b = <int>100;
c = <double>20.5;
d = a * b - c;
print("10. bigint * int - double:");
print(a);
print(b);
print(c);
print(d);

/* 测试 11：decimal + int + double */
a = <decimal>"123.45678901234567890";
b = <int>100;
c = <double>20.5;
d = a + b + c;
print("11. decimal + int + double:");
print(a);
print(b);
print(c);
print(d);

/* 测试 12：decimal * int - double */
a = <decimal>"123.45678901234567890";
b = <int>100;
c = <double>20.5;
d = a * b - c;
print("12. decimal * int - double:");
print(a);
print(b);
print(c);
print(d);

/* ========== 第三部分：高精度 + 字符 + 布尔 + 字节 + 短整型等 ========== */

