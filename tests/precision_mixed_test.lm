/* ========== 第四部分：多链路混合运算 ========== */

/* 测试 21：bigint + int + double + char + bool + byte + short */
a = <bigint>"12345678901234567890";
b = <int>100;
c = <double>20.5;
d = <char>'A';
e = <bool>true;
f = <byte>255;
g = <short>32767;
h = a + b + c + d + e + f + g;
print("21. bigint + int + double + char + bool + byte + short:");
print(a);
print(b);
print(c);
print(d);
print(e);
print(f);
print(g);
print(h);

/* 测试 22：decimal + int + double + char + bool + byte + short */
a = <decimal>"123.45678901234567890";
b = <int>100;
c = <double>20.5;
d = <char>'A';
e = <bool>true;
f = <byte>255;
g = <short>32767;
h = a + b + c + d + e + f + g;
print("22. decimal + int + double + char + bool + byte + short:");
print(a);
print(b);
print(c);
print(d);
print(e);
print(f);
print(g);
print(h);

/* 测试 23：bigint * int + double * char - bool + byte / short */
a = <bigint>"12345678901234567890";
b = <int>100;
c = <double>20.5;
d = <char>'A';
e = <bool>true;
f = <byte>255;
g = <short>32767;
h = a * b + c * d - e + f / g;
print("23. bigint * int + double * char - bool + byte / short:");
print(a);
print(b);
print(c);
print(d);
print(e);
print(f);
print(g);
print(h);

/* 测试 24：decimal * int + double * char - bool + byte / short */
a = <decimal>"123.45678901234567890";
b = <int>100;
c = <double>20.5;
d = <char>'A';
e = <bool>true;
f = <byte>255;
g = <short>32767;
h = a * b + c * d - e + f / g;
print("24. decimal * int + double * char - bool + byte / short:");
print(a);
print(b);
print(c);
print(d);
print(e);
print(f);
print(g);
print(h);

/* ========== 第五部分：高精度 + 长整型 + 无符号整型 ========== */

/* 测试 25：bigint + long */
a = <bigint>"12345678901234567890";
b = <long>1234567890;
c = a + b;
print("25. bigint + long:");
print(a);
print(b);
print(c);

/* 测试 26：bigint + long long */
a = <bigint>"12345678901234567890";
b = <long long>1234567890123456789;
c = a + b;
print("26. bigint + long long:");
print(a);
print(b);
print(c);

/* 测试 27：bigint + uint */
a = <bigint>"12345678901234567890";
b = <uint>4294967295;
c = a + b;
print("27. bigint + uint:");
print(a);
print(b);
print(c);

