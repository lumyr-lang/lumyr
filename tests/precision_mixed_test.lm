/* ========== 第六部分：高精度 + 字符串混合运算 ========== */

/* 测试 31：bigint + string */
a = <bigint>"12345678901234567890";
b = <string>"hello";
c = a + b;
print("31. bigint + string:");
print(a);
print(b);
print(c);

/* 测试 32：decimal + string */
a = <decimal>"123.45678901234567890";
b = <string>"hello";
c = a + b;
print("32. decimal + string:");
print(a);
print(b);
print(c);

/* 测试 33：bigint * string */
a = <bigint>"12345678901234567890";
b = <string>"hello";
c = a * 3;
print("33. bigint * 3:");
print(a);
print(b);
print(c);

/* 测试 34：decimal * string */
a = <decimal>"123.45678901234567890";
b = <string>"hello";
c = a * 3;
