/* ========== 第七部分：超长度高精度运算 ========== */

/* 测试 35：超大 bigint 加法 */
a = <bigint>"9999999999999999999999999999999999999999";
b = <bigint>1;
c = a + b;
print("35. 超大 bigint 加法:");
print(a);
print(b);
print(c);

/* 测试 36：超大 bigint 乘法 */
a = <bigint>"9999999999999999999999999999999999999999";
b = <bigint>"9999999999999999999999999999999999999999";
c = a * b;
print("36. 超大 bigint 乘法:");
print(a);
print(b);
print(c);

/* 测试 37：超大 decimal 加法 */
a = <decimal>"9999999999999999999999999999999999999999.9999999999999999999999999999999999999999";
b = <decimal>0.0000000000000000000000000000000000000001;
c = a + b;
print("37. 超大 decimal 加法:");
print(a);
print(b);
print(c);

/* 测试 38：超大 decimal 乘法 */
a = <decimal>"1234567890123456789012345678901234567890.1234567890123456789012345678901234567890";
b = <decimal>"9876543210987654321098765432109876543210.9876543210987654321098765432109876543210";
c = a * b;
print("38. 超大 decimal 乘法:");
print(a);
print(b);
print(c);

/* ========== 第八部分：全类型多链路混合运算 ========== */

/* 测试 39：所有类型混合运算 */
a = <int>10;
b = <double>20.5;
c = <string>"hello";
d = <char>'A';
e = <bool>true;
f = <byte>255;
g = <short>32767;
h = <long>1234567890;
i = <long long>1234567890123456789;
j = <uint>4294967295;
k = <bigint>"12345678901234567890";
l = <decimal>"123.45678901234567890";
m = a + b + c + d + e + f + g + h + i + j + k + l;
print("39. 所有类型混合运算:");
print(a);
print(b);
print(c);
print(d);
print(e);
print(f);
print(g);
print(h);
print(i);
print(j);
print(k);
print(l);
print(m);

/* 测试 40：所有类型多链路运算 */
a = <int>10;
b = <double>20.5;
c = <string>"hello";
d = <char>'A';
e = <bool>true;
f = <byte>255;
g = <short>32767;
h = <long>1234567890;
i = <long long>1234567890123456789;
j = <uint>4294967295;
k = <bigint>"12345678901234567890";
l = <decimal>"123.45678901234567890";
m = a * b + c * d - e + f / g + h * i - j + k * l;
print("40. 所有类型多链路运算:");
print(a);
print(b);
print(c);
print(d);
print(e);
print(f);
print(g);
print(h);
print(i);
print(j);
print(k);
print(l);
print(m);
