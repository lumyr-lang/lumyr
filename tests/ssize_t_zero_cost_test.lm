// 测试：ssize_t 类型完整零开销路径
print("=== ssize_t 类型测试 ===\n");

// 1. 变量声明
a = <ssize_t>1000000;
print("a = ");
print(a);
print("\n");

b = <ssize_t>-500000;
print("b = ");
print(b);
print("\n");

c = <ssize_t>2147483647;
print("c = ");
print(c);
print("\n");

// 2. 数组声明
arr = <ssize_t>[100000, -200000, 300000, -400000, 500000];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[2] = ");
print(arr[2]);
print("\n");
print("arr[4] = ");
print(arr[4]);
print("\n");

print("=== 测试完成 ===\n");
