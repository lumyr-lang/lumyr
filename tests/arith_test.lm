// 测试各种数据类型的加减乘除运算
// int类型
a = <int>10;
b = <int>3;
print(a + b);
print(a - b);
print(a * b);
print(a / b);

// long long类型
c = <long long>1000000000;
d = <long long>3;
print(c + d);
print(c - d);
print(c * d);
print(c / d);

// int8类型
e = <int8>50;
f = <int8>3;
print(e + f);
print(e - f);
print(e * f);
print(e / f);

// int16类型
g = <int16>1000;
h = <int16>3;
print(g + h);
print(g - h);
print(g * h);
print(g / h);

// int32类型
i = <int32>100000;
j = <int32>3;
print(i + j);
print(i - j);
print(i * j);
print(i / j);

// int64类型
k = <int64>1000000000;
l = <int64>3;
print(k + l);
print(k - l);
print(k * l);
print(k / l);

// long类型
m = <long>100000;
n = <long>3;
print(m + n);
print(m - n);
print(m * n);
print(m / n);

// ssize_t类型
o = <ssize_t>100000;
p = <ssize_t>3;
print(o + p);
print(o - p);
print(o * p);
print(o / p);

// 负数字面量测试
q = <int>-10;
r = <int>3;
print(q + r);
print(q - r);
print(q * r);
print(q / r);
