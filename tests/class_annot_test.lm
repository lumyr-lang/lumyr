// 测试 class 类注解
print("=== Class Annotation Test ===");

@entity
@table("users")
class User {
    name: string;
    age: int;
    func __init__(self, name, age) {
        self.name = name;
        self.age = age;
    }
}

u = User("Alice", 25);
print("name:", u.name);
print("age:", u.age);

print("=== Class Annotation Test Done ===");
