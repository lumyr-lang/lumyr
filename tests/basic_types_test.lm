// 基础数据类型运算测试
// 测试所有数据类型的加减乘除

print("=== 1. int 类型运算 ===");
a = <int>10;
b = <int>20;
print(a);
print(b);

print("=== 2. double 类型运算 ===");
c = <double>3.14;
d = <double>2.71;
print(c);
print(d);

print("=== 3. bool 类型 ===");
e = <bool>true;
f = <bool>false;
print(e);
print(f);

print("=== 4. char 类型 ===");
g = <char>'A';
h = <char>'B';
print(g);
print(h);

print("=== 5. string 类型 ===");
i = <string>"hello";
j = <string>"world";
print(i);
print(j);

print("=== 6. 混合运算测试 ===");
// int + int
x = <int>5;
y = <int>3;
print(x + y);
print(x - y);
print(x * y);
print(x / y);

print("=== 测试完成 ===");
