// class_inherit_test.lm - class 继承测试
print("=== Class Inheritance Test ===");

class Animal {
    name: string;
    age: int;
    func speak(self) {
        print("Animal speaks");
    }
    func get_name(self) {
        return self.name;
    }
}

class Dog extends Animal {
    breed: string;
    func speak(self) {
        print("Dog barks");
    }
}

print("--- 1. Basic inheritance ---");
d = Dog("Buddy", 2, "Golden");
print("name:", d.name);
print("age:", d.age);
print("breed:", d.breed);
d.speak();
print("get_name:", d.get_name());

print("\n=== All Class Inheritance Tests Passed ===");
