// class + 结构体（没有方法）组合测试
print("=== class + 结构体（没有方法）组合测试 ===");

// class（没有方法）
class SimpleClass {
    name: string;
}

obj = SimpleClass();
obj.name = "Test";
print("obj.name =", obj.name);

// 结构体（没有方法）
struct Point {
    x: int;
    y: int;
}

p1 = Point();
p1.x = 0;
p1.y = 0;
p2 = Point();
p2.x = 3;
p2.y = 4;
print("p1.x =", p1.x);
print("p2.y =", p2.y);

print("=== class + 结构体（没有方法）组合测试完成 ===");
