// class_prop_annot_comprehensive_test.lm - class 属性注解全面测试
print("=== Class Property Annotation Comprehensive Test ===");

// 1. 无参数注解
print("\n--- 1. 无参数注解 ---");
class User1 {
    @required
    name: string;
    @readonly
    id: int;
    func __init__(self, name, id) {
        self.name = name;
        self.id = id;
    }
}
u1 = User1("Alice", 1001);
print("name:", u1.name);
print("id:", u1.id);

// 2. 带数字参数注解
print("\n--- 2. 带数字参数注解 ---");
class User2 {
    @range(1, 100)
    age: int;
    func __init__(self, age) {
        self.age = age;
    }
}
u2 = User2(25);
print("age:", u2.age);

// 3. 多个注解
print("\n--- 3. 多个注解 ---");
class User3 {
    @required
    @range(1, 100)
    age: int;
    @readonly
    @unique
    id: int;
    func __init__(self, age, id) {
        self.age = age;
        self.id = id;
    }
}
u3 = User3(30, 1002);
print("age:", u3.age);
print("id:", u3.id);

// 4. 注解和方法混合
print("\n--- 4. 注解和方法混合 ---");
class User4 {
    @required
    name: string;
    func get_name(self) {
        return self.name;
    }
    @range(1, 100)
    age: int;
    func get_age(self) {
        return self.age;
    }
}
u4 = User4("Bob", 35);
print("name:", u4.get_name());
print("age:", u4.get_age());

// 5. 继承类的属性注解
print("\n--- 5. 继承类的属性注解 ---");
class Base {
    @required
    base_prop: string;
    func __init__(self, base_prop) {
        self.base_prop = base_prop;
    }
}
class Derived extends Base {
    @readonly
    derived_prop: int;
    func __init__(self, base_prop, derived_prop) {
        super(base_prop);
        self.derived_prop = derived_prop;
    }
}
d = Derived("base", 200);
print("base_prop:", d.base_prop);
print("derived_prop:", d.derived_prop);

// 6. 接口实现类的属性注解
print("\n--- 6. 接口实现类的属性注解 ---");
interface Printable {
    func to_string(): string;
}
class Point implements Printable {
    @range(-1000, 1000)
    x: int;
    @range(-1000, 1000)
    y: int;
    func __init__(self, x, y) {
        self.x = x;
        self.y = y;
    }
    func to_string(self) {
        return "Point(" + self.x + ", " + self.y + ")";
    }
}
p = Point(10, 20);
print("to_string:", p.to_string());

print("\n=== All Class Property Annotation Tests Passed ===");
