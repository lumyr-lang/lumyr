// 场景1 + 场景2 组合测试
print("=== 场景1 + 场景2 组合测试 ===");

// 场景1：多层继承
class Animal {
    name: string;
    func speak(self) {
        print("Animal speaks");
    }
    func get_name(self) {
        return self.name;
    }
}

class Dog extends Animal {
    func speak(self) {
        print("Dog barks");
    }
}

class Puppy extends Dog {
    func speak(self) {
        print("Puppy yips");
    }
}

puppy = Puppy();
puppy.name = "Max";
print("puppy.name =", puppy.get_name());
puppy.speak();

// 场景2：super 调用
class Base {
    func hello(self) {
        print("Hello from Base");
    }
}

class Derived extends Base {
    func hello(self) {
        super.hello();
        print("Hello from Derived");
    }
}

derived = Derived();
derived.hello();

print("=== 场景1 + 场景2 组合测试完成 ===");
