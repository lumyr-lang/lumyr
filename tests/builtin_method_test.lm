// tests/builtin_method_test.lm
// 内置类型方法分派测试：方法形式 x.m(...) / 属性形式 x.len / 全局形式 m(x, ...)
// 覆盖：字符串 / 数组 / 字典 / 高阶回调 / TypedArray / AI 线性代数 / 加密编码 / 模板字符串

// ===== A. 字符串方法 =====
s = "Hello World";
print("A1", s.len);                     // 11
print("A2", type(s.len));               // int
print("A3", s.upper());                 // HELLO WORLD
print("A4", s.lower());                 // hello world
print("A5", s.contains("World"));       // true
print("A6", s.startswith("Hello"));     // true
print("A7", s.endswith("World"));       // true
print("A8", s.substr(0, 5));            // Hello
print("A9", s.replace("World", "LM"));  // Hello LM
print("A10", "a,b,c".split(",").len);   // 3
print("A11", "  x  ".strip());          // x
print("A12", "ab".repeat(3));           // ababab
print("A13", "abc".charAt(1));         // b
print("A14", ["a", "b"].join("-"));     // a-b

// ===== B. 数组方法（原地修改返回 self vs 返回新数组） =====
a = [3, 1, 2];
print("B1", a.len);                     // 3
a.add(4);
print("B2", a);                         // [3, 1, 2, 4]
a.insert(0, 0);
print("B3", a);                         // [0, 3, 1, 2, 4]
print("B4", a.indexOf(3));             // 1
inner = [9, 9];
a2 = [3, inner, 2];
print("B5", a2.objectIndex(inner), a2.objectIndex(a2)); // 1 -1（引用身份）
print("B6", a.get(2));                  // 1
print("B7", a.set(0, 9));               // [9, 3, 1, 2, 4]
print("B8", a.first(), a.last());       // 9 4
print("B9", a.remove(0));               // [3, 1, 2, 4]
print("B10", a.sort());                 // [1, 2, 3, 4]
print("B11", a.reverse());              // [4, 3, 2, 1]
print("B12", a.slice(1, 3));            // [3, 2]（新数组）
print("B13", a.concat([7]));            // [4, 3, 2, 1, 7]（新数组）
print("B14", [1, [2, 3], [4, [5]]].flat()); // [1, 2, 3, 4, [5]]
b = a.addAll([8, 9]);
print("B15", b);                        // [4, 3, 2, 1, 8, 9]
print("B16", b.sum(), b.avg());         // 27 4.5
print("B17", b.min(), b.max());         // 1 9
c = [1, 2];
c.clear();
print("B18", c.len);                    // 0

// ===== C. 字典方法 =====
m = {"k": 1, "j": 2};
print("C1", m.len);                     // 2
print("C2", m.keys());                  // [k, j]
print("C3", m.values());                // [1, 2]
print("C4", m.has("k"), m.has("zz"));   // true false
print("C5", m.get("k"), m.get("zz"));   // 1 null
m.add("n", 3);
print("C6", m);                         // {"k":1,"j":2,"n":3}
print("C7", m.del("j").len);            // 2

// ===== D. 高阶方法（map/filter/reduce：lambda + 命名函数各一次） =====
arr = [1, 2, 3, 4];
print("D1", arr.map(func(x) { return x * 2; }));              // [2, 4, 6, 8]
func sq(x) { return x * x; }
print("D2", arr.map(sq));                                     // [1, 4, 9, 16]
print("D3", arr.filter(func(x) { return x > 2; }));           // [3, 4]
print("D4", arr.reduce(func(acc, x) { return acc + x; }, 0)); // 10

// ===== E. TypedArray 聚合 / 排序 / AI 基础 =====
t = <int>[5, 2, 8];
print("E1", t, t.sum());                // [5, 2, 8] 15
print("E2", t.min(), t.max());          // 2 8
print("E3", t.avg());                   // 5
print("E4", t.sort());                  // [2, 5, 8]
print("E5", t.argmax(), t.argmin());    // 2 0
print("E6", t.mean(), t.variance(), t.std()); // 5 6 2.44949
td = <double>[1.0, 2.0, 3.0];
print("E7", td.norm());                 // 3.74166
print("E8", td.normalize());            // [0.267261, 0.534522, 0.801784]
print("E9", td.softmax());              // [0.0900306, 0.244728, 0.665241]
print("E10", td.dot(<double>[4.0, 5.0, 6.0])); // 32
print("E11", type(t.sum()));            // int

// ===== F. AI / 线性代数（多维数组） =====
M = [[1, 2], [3, 4]];
print("F1", M.shape());                 // [2, 2]
print("F2", M.reshape(4));              // [1, 2, 3, 4]
print("F3", M.transpose());             // [[1, 3], [2, 4]]
print("F4", M.det());                   // -2
print("F5", M.inv());                   // [[-2, 1], [1.5, -0.5]]
print("F6", M.matmul(M));               // [[7, 10], [15, 22]]
print("F7", M.det() + M.det() * 2);     // -6（链式运算）

// ===== G. 加密 / 编码 / 正则 =====
print("G1", "abc".md5());               // 900150983cd24fb0d6963f7d28e17f72
print("G2", "hi".encodeBase64());       // aGk=
print("G3", "aGk=".decodeBase64());     // hi
print("G4", "a b".encodeURL());         // a%20b
print("G5", "a%20b".decodeURL());       // a b
print("G6", "abc".regexMatch("a.c"));  // true
print("G7", "abc".regexSearch("b."));  // [bc]

// ===== H. 属性形式与全局形式 =====
print("H1", "xyz".len, [1, 2, 3].len, {"a": 1}.len); // 3 3 1
print("H2", len("xyz"), len([1, 2, 3]));             // 3 3
print("H3", type("x"), type(1), type([1]));          // string int array
print("H4", max(3, 9, 2), min(3, 9, 2));             // 9 2
print("H5", sum([1, 2, 3]));                         // 6
print("H6", range(3));                               // [0, 1, 2]

// ===== I. 模板字符串（f-string → format 编译） =====
name = "lm";
x = 42;
print("I1", f"hi {name}!");             // hi lm!
print("I2", f"x={x} x2={x * 2}");       // x=42 x2=84

print("BUILTIN_METHOD_TEST_DONE");
