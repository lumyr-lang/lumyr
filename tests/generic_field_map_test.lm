// 泛型类字段 map 测试（阶段5：字段声明路径泛型擦除修复）
// 验证 HashMap<K,V> 和 HashSet<E> 实例化后内部 <K,V>map 字段
// 从动态 VAL_MAP 转换为 VAL_TYPED_MAP

import <Function/HashMap>;
import <Function/HashSet>;

func check(cond, msg) {
    if(cond) {} else {
        throw msg;
    }
}

n = 0;

// ===== M-GF1: HashMap<string,int>() 实例化后 value 为 map =====
m1 = HashMap<string, int>(null);
check(type(m1.value) == "map", "M-GF1: value should be map, got " + type(m1.value));
n = n + 1;

// ===== M-GF2: put/get 后键值类型正确 =====
m1.put("a", 1);
check(m1.get("a") == 1, "M-GF2: get(a) should be 1");
check(type(m1.get("a")) == "int", "M-GF2: value type should be int, got " + type(m1.get("a")));
ks = m1.keys();
check(type(ks[0]) == "string", "M-GF2: key type should be string, got " + type(ks[0]));
n = n + 1;

// ===== M-GF3: HashSet<int>() 内部 <E,bool>map 的 value 为 bool =====
s3 = HashSet<int>(null);
check(type(s3.value) == "map", "M-GF3: value should be map, got " + type(s3.value));
s3.add(42);
check(s3.contains(42), "M-GF3: should contain 42");
vs = s3.value.values();
check(type(vs[0]) == "bool", "M-GF3: value should be bool, got " + type(vs[0]));
n = n + 1;

// ===== M-GF4: 空 HashMap 实例化后也是 map（0 元素）=====
m4 = HashMap<string, int>(null);
check(type(m4.value) == "map", "M-GF4: empty value should be map");
check(m4.size() == 0, "M-GF4: size should be 0");
n = n + 1;

// ===== M-GF5: HashMap<string,string>() 字符串键值 =====
m5 = HashMap<string, string>(null);
check(type(m5.value) == "map", "M-GF5: value should be map");
m5.put("hello", "world");
check(m5.get("hello") == "world", "M-GF5: get(hello) should be world");
check(type(m5.get("hello")) == "string", "M-GF5: value type should be string");
n = n + 1;

// ===== M-GF6: HashMap<int,string>() 整型键字符串值 =====
m6 = HashMap<int, string>(null);
check(type(m6.value) == "map", "M-GF6: value should be map");
m6.put(100, "hundred");
check(m6.get(100) == "hundred", "M-GF6: get(100) should be hundred");
ks6 = m6.keys();
check(type(ks6[0]) == "int", "M-GF6: key type should be int, got " + type(ks6[0]));
n = n + 1;

// ===== M-GF7: 多个实例各自独立拥有 map =====
m7a = HashMap<string, int>(null);
m7b = HashMap<string, int>(null);
m7a.put("x", 10);
m7b.put("y", 20);
check(type(m7a.value) == "map", "M-GF7a: value should be map");
check(type(m7b.value) == "map", "M-GF7b: value should be map");
check(m7a.get("x") == 10, "M-GF7: m7a.get(x) should be 10");
check(m7b.get("y") == 20, "M-GF7: m7b.get(y) should be 20");
check(m7a.size() == 1, "M-GF7: m7a size should be 1");
check(m7b.size() == 1, "M-GF7: m7b size should be 1");
n = n + 1;

// ===== M-GF8: GC 压力下 map 不被误回收 =====
m8 = HashMap<string, int>(null);
m8.put("gc_key", 999);
i = 0;
while (i < 1000) {
    tmp = HashMap<string, int>(null);
    tmp.put("k" + i, i);
    i = i + 1;
}
check(m8.get("gc_key") == 999, "M-GF8: value should survive GC pressure");
check(type(m8.value) == "map", "M-GF8: value should still be map after GC");
n = n + 1;

// ===== M-GF9: typed map 的 JSON 序列化 + 二进制序列化往返 =====
q = (char)34;

// JSON：单键精确断言（多键顺序由桶序决定，不做全等断言）
mj9 = <string, int>{"a": 1};
check((string)mj9 == "{" + q + "a" + q + ":1}", "M-GF9: json single-key, got " + (string)mj9);
n = n + 1;

// JSON：空 typed map
me9 = <string, int>{};
check((string)me9 == "{}", "M-GF9: json empty, got " + (string)me9);
n = n + 1;

// 二进制往返：值恢复
mr9 = <string, int>{"a": 1, "b": 2};
dr9 = __lmDeserialize(__lmSerialize(mr9), 0)[0];
check(type(dr9) == "map", "M-GF9: roundtrip type should be map, got " + type(dr9));
check(dr9["a"] == 1 && dr9["b"] == 2, "M-GF9: roundtrip values");
n = n + 1;

// 二进制往返：key/value 类型保留（byte 强转在往返后仍生效）
mb9 = <string, byte>{"x": 999};
db9 = __lmDeserialize(__lmSerialize(mb9), 0)[0];
check(db9["x"] == 231, "M-GF9: roundtrip should keep byte coercion, got " + (string)db9["x"]);
n = n + 1;

// 二进制往返：空 typed map
dmt9 = __lmDeserialize(__lmSerialize(me9), 0)[0];
check((string)dmt9 == "{}" && dmt9.size() == 0, "M-GF9: roundtrip empty map");
n = n + 1;

// 二进制往返：整型键 typed map
mi9 = <int, string>{100: "hundred"};
di9 = __lmDeserialize(__lmSerialize(mi9), 0)[0];
check(di9[100] == "hundred", "M-GF9: roundtrip int-key map");
n = n + 1;

// ===== M-GF10: 运行时动态 map 强转为 typed map（infer 快路径 + 回退强转）=====
// 均匀类型：键值类型已与目标一致，走 lumyr_map_to_tmap_infer 直接装箱
b10 = {"a": 11, "b": 22};
c10 = <string, int>b10;
check(type(c10) == "map", "M-GF10: inferred type should be map, got " + type(c10));
check(c10["a"] == 11 && c10["b"] == 22, "M-GF10: inferred values");
n = n + 1;

// 类型不匹配：999 超出 byte 需强转，infer 返回 NULL 后回退逐条转换
b10b = {"x": 999};
c10b = <string, byte>b10b;
check(c10b["x"] == 231, "M-GF10: fallback coerce, got " + (string)c10b["x"]);
n = n + 1;

// 空 map：无类型信息可推断，回退 from_value_map，仍为 0 元素 map
b10c = {};
c10c = <string, int>b10c;
check(type(c10c) == "map", "M-GF10: empty cast type should be map");
check(c10c.size() == 0, "M-GF10: empty cast size should be 0");
n = n + 1;

print("generic_field_map_test: " + n + " tests passed");
