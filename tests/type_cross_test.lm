// ============================================================
// 全量数据类型交叉测试
// 覆盖：声明/打印、同类型算术、变量传播、字面量提升、比较运算
// ============================================================

print("=== 1. 各类型声明与打印 ===");

// 有符号整数
a_int = <int>42;
print(a_int);

a_i8 = <int8>8;
print(a_i8);

a_i16 = <int16>16;
print(a_i16);

a_short = <short>160;
print(a_short);

a_i32 = <int32>32;
print(a_i32);

a_i64 = <int64>64;
print(a_i64);

a_ll = <long long>640;
print(a_ll);

a_long = <long>6400;
print(a_long);

// 无符号整数
a_uint = <uint>420;
print(a_uint);

a_u8 = <uint8>80;
print(a_u8);

a_u16 = <uint16>1600;
print(a_u16);

a_u32 = <uint32>320;
print(a_u32);

a_u64 = <uint64>6400;
print(a_u64);

a_ulong = <ulong>64000;
print(a_ulong);

// 浮点
a_float = <float>3.14;
print(a_float);

a_double = <double>2.71828;
print(a_double);

a_ldouble = <long double>1.41421;
print(a_ldouble);

// 布尔、字符、字节
a_bool = <bool>true;
print(a_bool);

a_char = <char>'A';
print(a_char);

a_byte = <byte>255;
print(a_byte);

print("=== 2. 同类型算术运算 ===");

// int 算术
x1 = <int>100;
x2 = <int>23;
print(x1 + x2);
print(x1 - x2);
print(x1 * x2);
print(x1 / x2);
print(x1 % x2);

// double 算术
d1 = <double>10.5;
d2 = <double>2.5;
print(d1 + d2);
print(d1 - d2);
print(d1 * d2);
print(d1 / d2);

// float 算术
f1 = <float>6.25;
f2 = <float>2.5;
print(f1 + f2);
print(f1 * f2);

// int64 算术
ll1 = <int64>1000000;
ll2 = <int64>234567;
print(ll1 + ll2);
print(ll1 - ll2);

// uint 算术
u1 = <uint>500;
u2 = <uint>123;
print(u1 + u2);
print(u1 - u2);

print("=== 3. 变量类型传播 ===");

// int 传播
src_i = <int>777;
cp1 = src_i;
cp2 = cp1;
print(cp2);

// double 传播
src_d = <double>3.333;
cpd1 = src_d;
cpd2 = cpd1;
print(cpd2);

// 传播后参与运算
prop_i = <int>10;
prop_cp = prop_i;
print(prop_cp + <int>5);

print("=== 4. 字面量提升（专用类型 + 字面量） ===");

// int + 字面量
li = <int>10;
print(li + 5);
print(li - 3);
print(li * 4);
print(li / 2);
print(li % 3);

// 嵌套表达式 + 字面量
ni = <int>3;
nj = <int>4;
print(ni * nj + 5);
print(ni + nj * 2);

// double + 字面量数字
ld = <double>1.5;
print(ld + 2);
print(ld * 3);

print("=== 5. 比较运算 ===");

// int 比较
c1 = <int>10;
c2 = <int>20;
print(c1 < c2);
print(c1 > c2);
print(c1 == c1);
print(c1 != c2);
print(c1 <= c1);
print(c1 >= c2);

// double 比较
cd1 = <double>1.1;
cd2 = <double>2.2;
print(cd1 < cd2);
print(cd1 == cd1);

print("=== 6. 混合类型（Value + 专用类型） ===");

// Value + int → 通用路径
mv = 100;
mi = <int>50;
print(mv + mi);

// int + Value
print(mi + mv);

// Value + double
md = <double>2.5;
print(mv + md);

print("=== 7. 类型提升（int + double → double） ===");

pi = <int>10;
pd = <double>0.5;
print(pi + pd);
print(pd + pi);

// int + float
pf = <float>0.25;
print(pi + pf);

print("=== 全部测试完成 ===");
