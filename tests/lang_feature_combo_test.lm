// lang_feature_combo_test.lm —— 7个新语言特性组合验证（简化版）
// for-each + 默认参数 + do-while + 空安全 + 宏 + 注解 + const func
// 双通道（VM / -c）输出必须逐行一致

// ============ 1. const func 编译期计算 ============
const func square(x) { return x * x; }
const func add(a, b) { return a + b; }
print(square(5));           // 25
print(add(3, 4));           // 7
print(square(add(2, 3)));   // 25

// ============ 2. 默认参数值 ============
func greet(name, greeting="Hello") {
    return greeting + ", " + name + "!";
}
print(greet("Alice"));                  // Hello, Alice!
print(greet("Bob", "Hi"));              // Hi, Bob!

func power(base, exp=2) {
    result = 1;
    for(i = 0; i < exp; i++) {
        result = result * base;
    }
    return result;
}
print(power(3));      // 9
print(power(3, 3));   // 27

// ============ 3. for-each 循环 ============
arr = [10, 20, 30, 40, 50];
sum = 0;
for x in arr {
    sum = sum + x;
}
print(sum);                   // 150

// for-each over map
m = {"a": 1, "b": 2, "c": 3};
count = 0;
for k, v in m {
    count = count + 1;
}
print(count);                 // 3

// ============ 4. do-while 循环 ============
n = 0;
do {
    n = n + 1;
} while (n < 5);
print(n);                     // 5

// do-while at least once
n = 100;
do {
    n = n + 1;
} while (n < 5);
print(n);                     // 101

// ============ 5. 空安全 ============
func get_length(s) {
    if (s == null) { return 0; }
    return len(s);
}
print(get_length(null));      // 0
print(get_length("hello"));   // 5

func safe_get(arr, idx, default_val=0) {
    if (arr == null) { return default_val; }
    if (idx < 0 || idx >= len(arr)) { return default_val; }
    return arr[idx];
}
print(safe_get(null, 0));           // 0
print(safe_get([1,2,3], 5));        // 0
print(safe_get([1,2,3], 1, -1));    // 2
print(safe_get(null, 0, -1));       // -1

// ============ 6. 宏（编译期展开） ============
macro print_square(x) {
    print(x * x);
}
print_square(7);              // 49

macro print_add(a, b) {
    print(a + b);
}
print_add(3, 4);              // 7

// ============ 7. 注解 / 属性 ============
func old_func() {
    return "old";
}
print(old_func());             // old

// ============ 8. 特性组合：const func + 默认参数 + for-each ============
const func triple(x) { return x * 3; }
func scale_array(arr, multiplier=2) {
    s = 0;
    for x in arr {
        s = s + x * multiplier;
    }
    return s;
}
print(scale_array([1, 2, 3]));          // 1*2 + 2*2 + 3*2 = 12
print(scale_array([1, 2, 3], triple(1))); // 1*3 + 2*3 + 3*3 = 18

// ============ 9. 特性组合：do-while + 空安全 + 宏 ============
macro increment_if_even(x, c) {
    if (x % 2 == 0) { c = c + 1; }
}
count = 0;
i = 0;
do {
    increment_if_even(i, count);
    i = i + 1;
} while (i < 10);
print(count);                   // 5 (0,2,4,6,8)

// ============ 10. 特性组合：for-each + 默认参数 + 空安全 + const func ============
const func double_val(x) { return x * 2; }
func sum_even(arr, start=0) {
    if (arr == null) { return start; }
    s = start;
    for x in arr {
        if (x % 2 == 0) { s = s + double_val(x); }
    }
    return s;
}
print(sum_even([1,2,3,4,5]));    // 2*2 + 4*2 = 12
print(sum_even(null, 100));       // 100
print(sum_even([1,3,5], 10));     // 10

print("ALL FEATURE COMBO TESTS DONE");
