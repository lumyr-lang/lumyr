// tests/nested_types_test.lm
// 全数据类型 × 容器相互嵌套测试（由 fuzz/gen_nested_types_test.py 生成，勿手改）

func check(cond, msg) {
    if(cond) {} else { throw msg; }
}

// ===== 0. 自定义类型：struct Pt / type BoxT / class Kls =====
struct Pt {
    x: int;
    y: int;
    func sum() {
        return self.x + self.y;
    }
}

type BoxT {
    name: string,
    v: int
}

class Kls {
    label: string;
    n: int;
    func __init__(label, n) {
        self.label = label;
        self.n = n;
    }
    func getn() {
        return self.n;
    }
}

// ===== A. 全 29 类型作 typed map 的 V：<string,T> =====
mA_int = <string, int>{"k": 7};
check(type(mA_int) == "map", "A.int: container");
check(mA_int["k"] == 7, "A.int: value");
check(type(mA_int["k"]) == "int", "A.int: vtype");
