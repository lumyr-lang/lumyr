// ===== C. typed map 的 V = 容器 / 实例 =====
c_mm = <string, map>{"a": {"x": 5}};
check(type(c_mm) == "map", "C.mm container");
check(c_mm["a"]["x"] == 5, "C.mm value");

c_ma = <string, array>{"a": [1, 2, 3]};
check(c_ma["a"][1] == 2, "C.ma value");
check(type(c_ma["a"]) == "array", "C.ma vtype");

c_ms = <string, Pt>{"p": Pt(3, 4)};
check(type(c_ms["p"]) == "Pt", "C.ms vtype");
check(c_ms["p"].x == 3, "C.ms field");
check(c_ms["p"].sum() == 7, "C.ms method");

c_mt = <string, BoxT>{"b": <BoxT>{name: "bb", v: 9}};
check(type(c_mt["b"]) == "map", "C.mt vtype");
check(c_mt["b"].name == "bb", "C.mt field");
check(c_mt["b"].v == 9, "C.mt field2");

c_mc = <string, Kls>{"k": Kls("kk", 13)};
check(type(c_mc["k"]) == "Kls", "C.mc vtype");
check(c_mc["k"].label == "kk", "C.mc field");
check(c_mc["k"].getn() == 13, "C.mc method");

// ===== D. struct / class 实例作 map 键（引用身份） =====
d_pkey = Pt(1, 2);
d_mk = <Pt, int>{[d_pkey]: 77};
check(d_mk[d_pkey] == 77, "D.struct key");
check(d_mk[Pt(1, 2)] == null, "D.identity not equal");

d_ckey = Kls("c", 1);
d_mkc = <Kls, int>{[d_ckey]: 88};
check(d_mkc[d_ckey] == 88, "D.class key");

// ===== E. 字段嵌套容器 / 实例 =====
class EHolder {
    items: array;
    info: map;
    func __init__() {
        self.items = [10, 20, 30];
        self.info = {"a": 1};
    }
    func total() {
        return self.items[0] + self.items[1] + self.items[2];
    }
}
eh = EHolder();
check(type(eh.items) == "array", "E.class array field");
check(eh.total() == 60, "E.class method");
check(eh.info["a"] == 1, "E.class map field");
eh.items[1] = 200;
check(eh.total() == 240, "E.class in-place modify");
eh.info["a"] = 100;
check(eh.info["a"] == 100, "E.class map in-place");

struct EComposed {
    arr: array;
    mp: map;
    p: Pt;
}
ec = <EComposed>{arr: [1, 2], mp: {"k": "v"}, p: Pt(5, 6)};
check(type(ec.arr) == "array", "E.struct array field");
check(ec.arr[0] == 1, "E.struct arr value");
check(ec.mp["k"] == "v", "E.struct map value");
check(ec.p.sum() == 11, "E.struct nested method");
ec.arr[0] = 11;
check(ec.arr[0] == 11, "E.struct in-place modify");

type EHolderT {
    name: string,
    items: array,
    info: map,
    p: Pt
}
et = <EHolderT>{name: "hb", items: [4, 5, 6], info: {"z": 1}, p: Pt(2, 3)};
check(et.name == "hb", "E.type scalar field");
check(et.items[2] == 6, "E.type array field");
check(et.info["z"] == 1, "E.type map field");
check(et.p.sum() == 5, "E.type nested method");
et.items[0] = 40;
check(et.items[0] == 40, "E.type in-place modify");

// ===== F. 深度混合链 =====
struct FDeep {
    layers: map;
}
fd = <FDeep>{layers: {"L1": [{"k": Kls("deep", 42)}]}};
check(fd.layers["L1"][0]["k"].getn() == 42, "F.chain1 method");
fd.layers["L1"][0]["k"].n = 52;
check(fd.layers["L1"][0]["k"].getn() == 52, "F.chain1 modify");

class FTree {
    children: array;
    node: Pt;
    func __init__() {
        self.children = [Pt(1, 1), Pt(2, 2)];
        self.node = Pt(9, 9);
    }
    func childSum(i) {
        return self.children[i].sum();
    }
}
ft = FTree();
check(ft.childSum(0) == 2, "F.chain2 method");
check(ft.node.sum() == 18, "F.chain2 node method");
ft.children[1] = Pt(10, 10);
check(ft.childSum(1) == 20, "F.chain2 element replace");

fmix = {"a": [Pt(1, 2), {"q": 3}], "b": {"c": [Kls("z", 5)]}};
check(fmix["a"][0].sum() == 3, "F.chain3 struct in array");
check(fmix["a"][1]["q"] == 3, "F.chain3 map in array");
check(fmix["b"]["c"][0].getn() == 5, "F.chain3 class deep");
fmix["b"]["c"][0].n = 6;
check(fmix["b"]["c"][0].getn() == 6, "F.chain3 deep modify");

// ===== G. 数组装容器 / 实例 =====
g_coll = [{"a": 1}, [10, 20], Pt(7, 8), Kls("g", 3)];
check(type(g_coll) == "array", "G.coll container");
check(g_coll[0]["a"] == 1, "G.map element");
check(g_coll[1][0] == 10, "G.array element");
check(g_coll[2].sum() == 15, "G.struct element method");
check(g_coll[3].getn() == 3, "G.class element method");

// 自定义类型泛型数组：<Pt>[1, 2] → [Pt(1), Pt(2)] 形状构造，普通数组
g_shaped = <Pt>[1, 2];
check(type(g_shaped) == "array", "G.shape container");
check(g_shaped.len == 2, "G.shape len");
check(type(g_shaped[0]) == "Pt", "G.shape elem vtype");
check(g_shaped[0].x == 1, "G.shape elem0 x");
check(g_shaped[0].sum() == 1, "G.shape elem0 method");
check(g_shaped[1].x == 2, "G.shape elem1 x");
g_shaped[1] = Pt(20, 20);
check(g_shaped[1].sum() == 40, "G.shape element replace");

// ===== H. 语义：引用共享 / 空容器嵌套 / 多层互嵌 =====
h_shared = {"n": 1};
h_outer1 = {"s": h_shared};
h_outer2 = {"s": h_shared};
h_outer1["s"]["n"] = 99;
check(h_outer2["s"]["n"] == 99, "H.reference sharing");

h_empty = {"a": [], "b": {}};
check(h_empty["a"].len == 0, "H.empty array");
h_empty["a"].add(1);
check(h_empty["a"][0] == 1, "H.empty array grow");
h_empty["b"]["k"] = 2;
check(h_empty["b"]["k"] == 2, "H.empty map grow");

h_m3 = [[[1]]];
check(type(h_m3[0][0]) == "array", "H.nested array type");
check(h_m3[0][0][0] == 1, "H.nested array value");

h_tmm = <string, map>{"a": {"x": 1}};
h_tmm["a"]["x"] = 11;
check(h_tmm["a"]["x"] == 11, "H.typed map V=map modify");
h_tma = <string, array>{"a": [1, 2]};
h_tma["a"][0] = 9;
check(h_tma["a"][0] == 9, "H.typed map V=array modify");

print("nested_types_test ALL PASS");
