// 测试：int32 类型完整零开销路径
print("=== int32 类型测试 ===\n");

// 1. 变量声明
a = <int32>100000;
print("a = ");
print(a);
print("\n");

b = <int32>-50000;
print("b = ");
print(b);
print("\n");

c = <int32>2147483647;
print("c = ");
print(c);
print("\n");

// 2. 数组声明
arr = <int32>[1000, 2000, 3000, 4000, 5000];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[2] = ");
print(arr[2]);
print("\n");
print("arr[4] = ");
print(arr[4]);
print("\n");

print("=== 测试完成 ===\n");
