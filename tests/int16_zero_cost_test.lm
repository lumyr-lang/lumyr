// 测试：int16 类型完整零开销路径
print("=== int16 类型测试 ===\n");

// 1. 变量声明
a = <int16>1000;
print("a = ");
print(a);
print("\n");

b = <int16>-500;
print("b = ");
print(b);
print("\n");

c = <int16>32767;
print("c = ");
print(c);
print("\n");

// 2. 数组声明
arr = <int16>[100, 200, 300, 400, 500];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[2] = ");
print(arr[2]);
print("\n");
print("arr[4] = ");
print(arr[4]);
print("\n");

print("=== 测试完成 ===\n");
