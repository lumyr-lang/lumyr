// long long 算术运算和比较运算测试
func main() {
    // 测试 long long 变量声明和赋值
    a = <long long>100;
    b = <long long>200;

    // 测试算术运算
    print(a + b);  // 300
    print(b - a);  // 100
    print(a * b);  // 20000
    print(b / a);  // 2
    print(b % a);  // 0

    // 测试比较运算
    print(a < b);   // true
    print(a > b);   // false
    print(a <= b);  // true
    print(a >= b);  // false
    print(a == b);  // false
    print(a != b);  // true

    // 测试大数值
    c = <long long>9223372036854775807;  // long long 最大值
    print(c);

    d = <long long>1000000000;
    e = <long long>1000000000;
    print(d * e);  // 1000000000000000000
}
