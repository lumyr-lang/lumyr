// long long 算术运算和比较运算测试 - 使用顶层语句
a = <long long>100;
b = <long long>200;

// 测试算术运算
print(a + b);  // 300
print(b - a);  // 100
print(a * b);  // 20000
print(b / a);  // 2
print(b % a);  // 0

// 测试比较运算
print(a < b);   // true
print(a > b);   // false
print(a <= b);  // true
print(a >= b);  // false
print(a == b);  // false
print(a != b);  // true

// 测试大数值
c = <long long>1000000000;
d = <long long>1000000000;
print(c * d);  // 1000000000000000000
