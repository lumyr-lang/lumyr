// concurrent_sort_test.lm —— T1（P0）：g_cmp_width 线程隔离专项
//
// 背景：TypedArray.sort 按元素宽度（1/2/4/8 字节）选择 qsort 比较器，
// 宽度经 src/ir/vm_builtin.c 的文件级 static 变量 g_cmp_width 传递。
// 修复前该变量为普通进程级 static：多 OS 线程并发排序不同宽度 TypedArray 时，
// 一个线程写 g_cmp_width=4、另一线程同时写 8，比较器读到被踩过的宽度，
// 按错误步长读内存 → 排序结果错误/越界读（TSAN 必报 data race）。
// 同功能的 g_sort_numeric（kit/runtime/src/lm_array.c）早已是 _Thread_local，
// 本测试锁定 g_cmp_width 必须同为线程隔离。
//
// 运行（正常构建）：./bin/lumyr tests/concurrent_sort_test.lm
// 运行（TSAN）：
//   TSAN_OPTIONS="halt_on_error=1:exitcode=77" ./bin/lumyr_tsan tests/concurrent_sort_test.lm
import <Thread/Thread>;

// 排序任务：反复构造指定宽度的 TypedArray → 伪随机填充 → sort → 校验非降序。
// kind: 0=int32(4B) 1=int64(8B) 2=float(4B) 3=double(8B)
// 4B 与 8B 任务并发跑，宽度变量若共享即互相踩踏。
class SortWorker {
    kind: int;
    rounds: int;
    size: int;
    bad: int;

    func SortWorker(k: int, r: int, n: int) {
        self.kind = k;
        self.rounds = r;
        self.size = n;
        self.bad = 0;
    }

    // 确定性 LCG 伪随机（避免随机内置差异；同一种子序列每线程按 kind 错开）
    func nextSeed(seed: int): int {
        return (seed * 1103515245 + 12345) % 2147483648;
    }

    func checkInt(a, n: int): bool {
        k = 1;
        while (k < n) {
            if (a[k - 1] > a[k]) { return false; }
            k = k + 1;
        }
        return true;
    }

    func checkFloat(a, n: int): bool {
        k = 1;
        while (k < n) {
            if (a[k - 1] > a[k]) { return false; }
            k = k + 1;
        }
        return true;
    }

    func run() {
        i = 0;
        seed = 12345 + self.kind * 7919;
        n = self.size;
        while (i < self.rounds) {
            seed = self.nextSeed(seed);
            j = 0;
            if (self.kind == 0) {
                // int32：4 字节宽度
                a = <int32>[0];
                while (j < n) {
                    seed = self.nextSeed(seed);
                    a.add((seed % 1000000) - 500000);
                    j = j + 1;
                }
                a.sort();
                if (self.checkInt(a, n) == false) { self.bad = self.bad + 1; }
            } else if (self.kind == 1) {
                // int64：8 字节宽度
                a = <int64>[0];
                while (j < n) {
                    seed = self.nextSeed(seed);
                    a.add((seed % 1000000) - 500000);
                    j = j + 1;
                }
                a.sort();
                if (self.checkInt(a, n) == false) { self.bad = self.bad + 1; }
            } else if (self.kind == 2) {
                // float：4 字节宽度
                a = <float>[0.0];
                while (j < n) {
                    seed = self.nextSeed(seed);
                    a.add((seed % 1000000) / 10.0 - 50000.0);
                    j = j + 1;
                }
                a.sort();
                if (self.checkFloat(a, n) == false) { self.bad = self.bad + 1; }
            } else {
                // double：8 字节宽度
                a = <double>[0.0];
                while (j < n) {
                    seed = self.nextSeed(seed);
                    a.add((seed % 1000000) / 10.0 - 50000.0);
                    j = j + 1;
                }
                a.sort();
                if (self.checkFloat(a, n) == false) { self.bad = self.bad + 1; }
            }
            i = i + 1;
        }
        return self.bad;
    }
}

ROUNDS = 300;
N = 256;

w0 = SortWorker(0, ROUNDS, N);
w1 = SortWorker(1, ROUNDS, N);
w2 = SortWorker(2, ROUNDS, N);
w3 = SortWorker(3, ROUNDS, N);

t0 = Thread("sort-int32", w0).start();
t1 = Thread("sort-int64", w1).start();
t2 = Thread("sort-float", w2).start();
t3 = Thread("sort-double", w3).start();

r0 = t0.join();
r1 = t1.join();
r2 = t2.join();
r3 = t3.join();

print("bad per worker (int32/int64/float/double):", r0, r1, r2, r3);
total = r0 + r1 + r2 + r3;
if (total == 0) {
    print("concurrent_sort_test ALL PASS (" + 4 * ROUNDS + " sorts across 4 threads)");
} else {
    print("FAIL: " + total + " corrupted sorts / 排序结果损坏");
}
