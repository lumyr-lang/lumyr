// bool 类型零转换开销优化测试
// 测试场景：变量声明和赋值、逻辑运算、比较运算结果、print 输出

// 1. 变量声明和赋值
a = <bool>true;
b = <bool>false;
print(a);  // true
print(b);  // false

// 2. 变量赋值优化（b = a 场景）
c = a;
print(c);  // true

// 3. 比较运算结果赋值
d = 1 < 2;
print(d);  // true

e = 1 > 2;
print(e);  // false

// 4. 逻辑运算
f = a && b;
print(f);  // false

g = a || b;
print(g);  // true

h = !a;
print(h);  // false

// 5. 混合逻辑运算
i = (1 < 2) && (3 > 4);
print(i);  // false

j = (1 < 2) || (3 > 4);
print(j);  // true

// 6. 直接 print 比较运算结果
print(1 < 2);  // true
print(1 > 2);  // false

// 7. 直接 print 逻辑运算结果
print(true && false);  // false
print(true || false);  // true
print(!true);  // false

print("done");
