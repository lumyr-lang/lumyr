// 测试：uint 类型零开销路径
// 验证：uint 变量加载、uint 数组创建、uint 数组元素访问、赋值给 uint 变量、上下文感知

print("=== uint 类型零开销测试 ===\n");

// 测试 1：uint 变量声明和加载
a = <uint32>100;
print("a = \n");
print(a);
print(" (期望 100)\n");

b = <uint32>200;
print("b = \n");
print(b);
print(" (期望 200)\n");

// 测试 2：uint 变量赋值上下文感知
c = a;
print("c = \n");
print(c);
print(" (期望 100)\n");

d = b;
print("d = \n");
print(d);
print(" (期望 200)\n");

// 测试 3：uint 数组创建
arr = <uint32>[10, 20, 30, 40, 50];
print("arr type = \n");
print(type(arr));
print("\n");
print("arr len = \n");
print(len(arr));
print("\n");

// 测试 4：uint 数组元素访问
print("arr[0] = \n");
print(arr[0]);
print(" (期望 10)\n");
print("arr[2] = \n");
print(arr[2]);
print(" (期望 30)\n");
print("arr[4] = \n");
print(arr[4]);
print(" (期望 50)\n");

// 测试 5：uint 数组元素赋值上下文感知
e = arr[0];
print("e = \n");
print(e);
print(" (期望 10)\n");

f = arr[2];
print("f = \n");
print(f);
print(" (期望 30)\n");

// 测试 6：显式 <uint32>arr[idx] 赋值
g = <uint32>arr[1];
print("g = \n");
print(g);
print(" (期望 20)\n");

// 测试 7：uint 变量作为数组元素
arr2 = <uint32>[a, b, c, d];
print("arr2 len = \n");
print(len(arr2));
print("\n");
print("arr2[0] = \n");
print(arr2[0]);
print(" (期望 100)\n");
print("arr2[1] = \n");
print(arr2[1]);
print(" (期望 200)\n");
print("arr2[2] = \n");
print(arr2[2]);
print(" (期望 100)\n");
print("arr2[3] = \n");
print(arr2[3]);
print(" (期望 200)\n");

// 测试 8：链式上下文感知
h = arr[0];
i = h;
j = i;
print("j = \n");
print(j);
print(" (期望 10)\n");

// 测试 9：大数值（uint32 最大值附近）
big = <uint32>4294967295;
print("big = \n");
print(big);
print(" (期望 4294967295)\n");

print("\n=== 测试完成 ===\n");
