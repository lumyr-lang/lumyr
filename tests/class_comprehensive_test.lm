// class_comprehensive_test.lm - class 全面测试
print("=== Class Comprehensive Test ===");

// 1. 基础 class 定义和属性访问
print("\n--- 1. 基础 class 定义和属性访问 ---");
class Point {
    x: int;
    y: int;
    func __init__(self, x, y) {
        self.x = x;
        self.y = y;
    }
    func get_x(self) {
        return self.x;
    }
    func get_y(self) {
        return self.y;
    }
    func set_x(self, x) {
        self.x = x;
    }
    func set_y(self, y) {
        self.y = y;
    }
}

p = Point(3, 4);
print("x:", p.get_x());
print("y:", p.get_y());
p.set_x(10);
p.set_y(20);
print("after set - x:", p.get_x());
print("after set - y:", p.get_y());

// 2. 继承和方法重写
print("\n--- 2. 继承和方法重写 ---");
class Animal {
    name: string;
    age: int;
    func __init__(self, name, age) {
        self.name = name;
        self.age = age;
    }
    func speak(self) {
        print("Animal speaks");
    }
    func get_info(self) {
        print("name:", self.name, "age:", self.age);
    }
}

class Dog extends Animal {
    breed: string;
    func __init__(self, name, age, breed) {
        super(name, age);
        self.breed = breed;
    }
    func speak(self) {
        print("Dog barks");
    }
    func get_breed(self) {
        return self.breed;
    }
}

class Cat extends Animal {
    color: string;
    func __init__(self, name, age, color) {
        super(name, age);
        self.color = color;
    }
    func speak(self) {
        print("Cat meows");
    }
}

dog = Dog("Buddy", 2, "Golden");
dog.get_info();
dog.speak();
print("breed:", dog.get_breed());

cat = Cat("Whiskers", 3, "Orange");
cat.get_info();
cat.speak();

// 3. 多层继承
print("\n--- 3. 多层继承 ---");
class Puppy extends Dog {
    is_trained: bool;
    func __init__(self, name, age, breed, is_trained) {
        super(name, age, breed);
        self.is_trained = is_trained;
    }
    func speak(self) {
        print("Puppy yips");
    }
    func is_trained_func(self) {
        return self.is_trained;
    }
}

puppy = Puppy("Max", 1, "Labrador", false);
puppy.get_info();
puppy.speak();
print("breed:", puppy.get_breed());
print("is_trained:", puppy.is_trained_func());

// 4. super.method() 调用父类方法
print("\n--- 4. super.method() 调用父类方法 ---");
class Base {
    func greet(self) {
        print("Hello from Base");
    }
}

class Derived extends Base {
    func greet(self) {
        super.greet();
        print("Hello from Derived");
    }
}

derived = Derived();
derived.greet();

// 5. __classname__ 属性
print("\n--- 5. __classname__ 属性 ---");
print("Point classname:", p.__classname__);
print("Dog classname:", dog.__classname__);
print("Cat classname:", cat.__classname__);
print("Puppy classname:", puppy.__classname__);

// 6. 没有自定义构造函数的 class
print("\n--- 6. 没有自定义构造函数的 class ---");
class Simple {
    value: int;
    name: string;
    func get_value(self) {
        return self.value;
    }
    func get_name(self) {
        return self.name;
    }
}

simple = Simple(42, "test");
print("value:", simple.get_value());
print("name:", simple.get_name());

// 7. class 作为函数参数
print("\n--- 7. class 作为函数参数 ---");
func print_animal_info(animal) {
    print("Animal name:", animal.name);
    print("Animal age:", animal.age);
    animal.speak();
}

print_animal_info(dog);
print_animal_info(cat);

// 8. class 作为返回值
print("\n--- 8. class 作为返回值 ---");
func create_animal(name, age) {
    return Animal(name, age);
}

new_animal = create_animal("Test", 5);
new_animal.get_info();

// 9. class 属性直接访问
print("\n--- 9. class 属性直接访问 ---");
print("dog.name:", dog.name);
print("dog.age:", dog.age);
print("dog.breed:", dog.breed);

// 10. 修改 class 属性
print("\n--- 10. 修改 class 属性 ---");
dog.name = "New Buddy";
dog.age = 3;
dog.breed = "New Golden";
print("after modify - name:", dog.name);
print("after modify - age:", dog.age);
print("after modify - breed:", dog.breed);

print("\n=== All Class Comprehensive Tests Passed ===");
