// 测试：uint类型化数组元素赋值上下文感知（零转换开销）
print("=== uint类型化数组元素赋值上下文感知测试 ===\n");

// 1. uint类型化数组声明
arr = <uint>[1, 2, 3, 4, 5];
print("1. 初始数组: ");
for(i = 0; i < 5; i = i + 1) {
    print(arr[i]);
    print(" ");
}
print("\n");

// 2. 数组元素赋值（字面量）- 上下文感知，直接压入uint栈
arr[0] = 100;
arr[1] = 200;
print("2. 字面量赋值后: ");
for(i = 0; i < 5; i = i + 1) {
    print(arr[i]);
    print(" ");
}
print("\n");

// 3. 数组元素赋值（uint变量）- 上下文感知，直接从uint变量读取
a = <uint>300;
b = <uint>400;
arr[2] = a;
arr[3] = b;
print("3. uint变量赋值后: ");
for(i = 0; i < 5; i = i + 1) {
    print(arr[i]);
    print(" ");
}
print("\n");

// 4. 验证赋值是否正确
print("4. 验证结果:\n");
if(arr[0] == 100) {
    print("   arr[0] = 100 正确\n");
} else {
    print("   arr[0] = ");
    print(arr[0]);
    print(" 错误，期望 100\n");
}

if(arr[1] == 200) {
    print("   arr[1] = 200 正确\n");
} else {
    print("   arr[1] = ");
    print(arr[1]);
    print(" 错误，期望 200\n");
}

if(arr[2] == 300) {
    print("   arr[2] = 300 正确\n");
} else {
    print("   arr[2] = ");
    print(arr[2]);
    print(" 错误，期望 300\n");
}

if(arr[3] == 400) {
    print("   arr[3] = 400 正确\n");
} else {
    print("   arr[3] = ");
    print(arr[3]);
    print(" 错误，期望 400\n");
}

if(arr[4] == 5) {
    print("   arr[4] = 5 正确（未修改）\n");
} else {
    print("   arr[4] = ");
    print(arr[4]);
    print(" 错误，期望 5\n");
}

print("=== 测试完成 ===\n");
