// class_super_test.lm - class super 调用测试
print("=== Class Super Test ===");

class Animal {
    name: string;
    age: int;
    func speak(self) {
        print("Animal speaks");
    }
    func get_name(self) {
        return self.name;
    }
}

class Dog extends Animal {
    breed: string;
    func speak(self) {
        print("Dog barks");
        super.speak();  // 调用父类方法
    }
    func get_info(self) {
        return super.get_name() + " (" + self.breed + ")";
    }
}

print("--- 1. super.method() 调用 ---");
d = Dog("Buddy", 2, "Golden");
d.speak();  // 应该输出 "Dog barks" 和 "Animal speaks"

print("\n--- 2. super 方法返回值 ---");
print("info:", d.get_info());

print("\n=== All Class Super Tests Passed ===");
