// class_basic_test.lm - class 基本功能测试
print("=== Class Basic Test ===");

// 1. 简单 class 定义
class Animal {
    name: string;
    age: int;
    func speak(self) {
        print("Animal speaks");
    }
}

print("--- 1. Class definition ---");
a = Animal("Dog", 3);
print("name:", a.name);
print("age:", a.age);
a.speak();

print("\n=== All Class Basic Tests Passed ===");
