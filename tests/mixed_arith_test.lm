// 测试混合类型算术运算
print("=== int + float ===\n");
a = <int>10;
b = <float>2.5;
c = a + b;
print("c = ");
print(c);
print("\n");

print("=== int + double ===\n");
d = <int>10;
e = <double>3.14;
f = d + e;
print("f = ");
print(f);
print("\n");

print("=== float + double ===\n");
g = <float>1.5;
h = <double>2.5;
i = g + h;
print("i = ");
print(i);
print("\n");

print("=== uint + float ===\n");
j = <uint>20;
k = <float>1.5;
l = j + k;
print("l = ");
print(l);
print("\n");

print("=== direct print mixed ===\n");
print(a + b);
print("\n");

print("=== done ===\n");
