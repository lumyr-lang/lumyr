// 测试：uint64 类型完整零开销路径
print("=== uint64 类型测试 ===\n");

// 1. 变量声明
a = <uint64>1000000000;
print("a = ");
print(a);
print("\n");

b = <uint64>10000000000;
print("b = ");
print(b);
print("\n");

c = <uint64>18446744073709551615;
print("c = ");
print(c);
print("\n");

// 2. 数组声明
arr = <uint64>[1000000, 2000000, 3000000, 4000000, 5000000];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[2] = ");
print(arr[2]);
print("\n");
print("arr[4] = ");
print(arr[4]);
print("\n");

print("=== 测试完成 ===\n");
