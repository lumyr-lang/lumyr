// 测试：int8 类型完整零开销路径
print("=== int8 类型测试 ===\n");

// 1. 变量声明
a = <int8>10;
print("a = ");
print(a);
print("\n");

b = <int8>-5;
print("b = ");
print(b);
print("\n");

c = <int8>127;
print("c = ");
print(c);
print("\n");

// 2. 数组声明
arr = <int8>[1, 2, 3, 4, 5];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[2] = ");
print(arr[2]);
print("\n");
print("arr[4] = ");
print(arr[4]);
print("\n");

print("=== 测试完成 ===\n");
