// 测试5种数据类型的交叉混合类型运算
a = <int>10;
b = <uint>20;
c = <float>1.5;
d = <double>2.5;
e = <long long>1000000000;

print("=== int + 其他类型 ===");
print(a + b);  // int + uint
print(a + c);  // int + float
print(a + d);  // int + double
print(a + e);  // int + long long

print("=== uint + 其他类型 ===");
print(b + c);  // uint + float
print(b + d);  // uint + double
print(b + e);  // uint + long long

print("=== float + 其他类型 ===");
print(c + d);  // float + double
print(c + e);  // float + long long

print("=== double + long long ===");
print(d + e);  // double + long long

print("=== 减法测试 ===");
print(e - a);  // long long - int
print(c - b);  // float - uint

print("=== 乘法测试 ===");
print(a * c);  // int * float
print(b * e);  // uint * long long

print("=== 除法测试 ===");
print(e / a);  // long long / int
print(d / c);  // double / float
