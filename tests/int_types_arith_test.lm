// int8/int16/int32/int64 算术运算和比较运算测试
a = <int8>10;
b = <int8>3;
print(a + b);
print(a - b);
print(a * b);
print(a / b);
print(a % b);
print(a > b);
print(a < b);
print(a >= b);
print(a <= b);
print(a == b);
print(a != b);

c = <int16>100;
d = <int16>30;
print(c + d);
print(c - d);
print(c * d);

e = <int32>1000;
f = <int32>300;
print(e + f);
print(e - f);
print(e * f);

g = <int64>1000000;
h = <int64>300000;
print(g + h);
print(g - h);
print(g * h);
