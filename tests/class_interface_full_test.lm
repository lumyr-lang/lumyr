// class_interface_full_test.lm - class 实现接口完整测试
print("=== Class Interface Full Test ===");

// 定义接口
interface Printable {
    func to_string(): string;
}

interface Drawable {
    func draw(): void;
}

// class 实现单个接口（正确实现）
class Point implements Printable {
    x: int;
    y: int;
    func __init__(self, x, y) {
        self.x = x;
        self.y = y;
    }
    func to_string(self) {
        return "Point(" + self.x + ", " + self.y + ")";
    }
}

// class 实现多个接口（正确实现）
class Circle implements Printable, Drawable {
    x: int;
    y: int;
    radius: int;
    func __init__(self, x, y, radius) {
        self.x = x;
        self.y = y;
        self.radius = radius;
    }
    func to_string(self) {
        return "Circle((" + self.x + ", " + self.y + "), r=" + self.radius + ")";
    }
    func draw(self) {
        print("Drawing circle at (" + self.x + ", " + self.y + ") with radius " + self.radius);
    }
}

// 测试
print("\n--- 1. class 实现单个接口 ---");
p = Point(3, 4);
print("Point to_string:", p.to_string());

print("\n--- 2. class 实现多个接口 ---");
c = Circle(5, 6, 10);
print("Circle to_string:", c.to_string());
c.draw();

print("\n=== All Class Interface Full Tests Passed ===");
