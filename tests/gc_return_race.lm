// ============================================================
// gc_return_race.lm - Return value protection window stress test
// Tests: thread function returns heap object, between unregister and protect
// Many short-lived threads exit concurrently, main thread allocates heavily to trigger GC,
// Verify returned heap objects are not incorrectly collected (UAF).
// ============================================================

func make_payload(id, iteration) {
    // Create a non-SSO large string to force heap allocation
    s = "payload_" + id + "_" + iteration +
        "_padding_padding_padding_padding_padding_padding_padding_padding";
    // Wrap in an array to increase heap object graph complexity
    holder = [s, id, iteration, s, s, s, s, s];
    return holder;
}

func worker(id, iteration) {
    h = make_payload(id, iteration);
    // Hold reference for a while to ensure object survives long enough in young generation
    gc_collect();
    // Return holder - return value on C stack, window between unregister and protect on thread exit
    return h;
}

// Main loop: batch start threads + allocate garbage to trigger GC
GARBAGE = 5000;
total_ok = 1;
round = 0;

while (round < 20) {
    N = 20;
    tids = [];
    for (t = 0; t < N; t = t + 1) {
        tids.add(thread(worker, round * 1000 + t, t));
    }

    // Main thread allocates garbage heavily to trigger frequent GC
    junk = [];
    for (j = 0; j < GARBAGE; j = j + 1) {
        junk.add("junk_string_" + j + "_padding_padding_padding_padding");
    }
    gc_collect();
    junk = [];
    gc_collect();

    // Join and verify return values
    for (t = 0; t < N; t = t + 1) {
        r = thread_join(tids[t]);
        expected_id = round * 1000 + t;
        // Verify returned array content is not corrupted
        if (len(r) != 8) {
            print("CORRUPTION round=" + round + " t=" + t + " len=" + len(r));
            total_ok = 0;
        } else {
            first = r[0];
            expected_prefix = "payload_" + expected_id + "_" + t + "_padding";
            // Simple check: first element should be a string and non-empty
            if (len(first) < 10) {
                print("CORRUPTION round=" + round + " t=" + t + " first_len=" + len(first));
                total_ok = 0;
            }
        }
    }
    print("round " + round + " done");
    round = round + 1;
}

if (total_ok) {
    print("gc_return_race: PASS");
} else {
    print("gc_return_race: FAIL");
}
