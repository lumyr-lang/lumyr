// 测试：uint8 类型完整零开销路径
print("=== uint8 类型测试 ===\n");

// 1. 变量声明
a = <uint8>100;
print("a = ");
print(a);
print("\n");

b = <uint8>200;
print("b = ");
print(b);
print("\n");

c = <uint8>255;
print("c = ");
print(c);
print("\n");

// 2. 数组声明
arr = <uint8>[10, 20, 30, 40, 50];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[2] = ");
print(arr[2]);
print("\n");
print("arr[4] = ");
print(arr[4]);
print("\n");

print("=== 测试完成 ===\n");
