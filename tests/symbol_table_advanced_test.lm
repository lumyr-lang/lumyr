// 统一符号表高级测试（简化版）
// 测试多层继承、super 调用、构造函数链等场景

print("=== 统一符号表高级测试（简化版） ===");

// 1. 多层继承
print("1. 多层继承:");
class Animal {
    name: string;
    func speak(self) {
        print("   Animal speaks");
    }
    func get_name(self) {
        return self.name;
    }
}

class Dog extends Animal {
    func speak(self) {
        print("   Dog barks");
    }
}

class Puppy extends Dog {
    func speak(self) {
        print("   Puppy yips");
    }
}

puppy = Puppy();
puppy.name = "Max";
print("   puppy.name =", puppy.get_name());
puppy.speak();  // 应该输出 "Puppy yips"

// 2. super 调用
print("2. super 调用:");
class Base {
    func hello(self) {
        print("   Hello from Base");
    }
}

class Derived extends Base {
    func hello(self) {
        super.hello();
        print("   Hello from Derived");
    }
}

derived = Derived();
derived.hello();  // 应该输出 "Hello from Base" 和 "Hello from Derived"

// 3. 构造函数链
print("3. 构造函数链:");
class Vehicle {
    brand: string;
    func __init__(self, brand) {
        self.brand = brand;
        print("   Vehicle constructor: brand =", brand);
    }
}

class Car extends Vehicle {
    model: string;
    func __init__(self, brand, model) {
        super.__init__(brand);
        self.model = model;
        print("   Car constructor: model =", model);
    }
}

car = Car("Toyota", "Camry");
print("   car.brand =", car.brand);
print("   car.model =", car.model);

// 4. 多个类相同方法名
print("4. 多个类相同方法名:");
class Circle {
    func area(self) {
        return 3.14 * 5 * 5;
    }
}

class Rectangle {
    func area(self) {
        return 4 * 6;
    }
}

class Triangle {
    func area(self) {
        return 0.5 * 3 * 4;
    }
}

circle = Circle();
rectangle = Rectangle();
triangle = Triangle();
print("   circle.area() =", circle.area());
print("   rectangle.area() =", rectangle.area());
print("   triangle.area() =", triangle.area());

// 5. 结构体方法
print("5. 结构体方法:");
struct Point {
    x: int;
    y: int;
    func distance(self, other) {
        dx = self.x - other.x;
        dy = self.y - other.y;
        return dx * dx + dy * dy;
    }
}

p1 = Point();
p1.x = 0;
p1.y = 0;
p2 = Point();
p2.x = 3;
p2.y = 4;
print("   p1.distance(p2) =", p1.distance(p2));

print("=== 统一符号表高级测试完成 ===");
