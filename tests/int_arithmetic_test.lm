// 测试：int类型专用算术运算指令（零检查零转换零Value开销）
print("=== int类型专用算术运算测试 ===\n");

// 声明int变量
a = <int>10;
b = <int>3;

print("a = ");
print(a);
print("\n");
print("b = ");
print(b);
print("\n");

// 加法
c = a + b;
print("a + b = ");
print(c);
print("\n");

// 减法
d = a - b;
print("a - b = ");
print(d);
print("\n");

// 乘法
e = a * b;
print("a * b = ");
print(e);
print("\n");

// 除法
f = a / b;
print("a / b = ");
print(f);
print("\n");

// 取模
g = a % b;
print("a % b = ");
print(g);
print("\n");

print("=== 测试完成 ===\n");
