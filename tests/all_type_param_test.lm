// 全面测试所有数据类型的参数声明
print("=== All Type Param Test ===");

// 整数类型
func test_int(<int>x) { print("int:", x); }
func test_int8(<int8>x) { print("int8:", x); }
func test_int16(<int16>x) { print("int16:", x); }
func test_int32(<int32>x) { print("int32:", x); }
func test_int64(<int64>x) { print("int64:", x); }
func test_long(<long>x) { print("long:", x); }
func test_longlong(<long long>x) { print("long long:", x); }

// 无符号整数
func test_uint8(<uint8>x) { print("uint8:", x); }
func test_uint16(<uint16>x) { print("uint16:", x); }
func test_uint32(<uint32>x) { print("uint32:", x); }
func test_uint64(<uint64>x) { print("uint64:", x); }

// 浮点类型
func test_double(<double>x) { print("double:", x); }
func test_float(<float>x) { print("float:", x); }

// 其他类型
func test_string(<string>x) { print("string:", x); }
func test_bool(<bool>x) { print("bool:", x); }
func test_char(<char>x) { print("char:", x); }
func test_byte(<byte>x) { print("byte:", x); }

// 自定义类型
struct Point { x: int; y: int; }
func test_point(<Point>p) { print("Point:", p.x, p.y); }

// 多参数混合类型
func <int> add_mixed(<int>a, <double>b, <string>label) {
    print(label, a, b);
    return a + (int)b;
}

// 测试调用
test_int(42);
test_int8(8);
test_int16(16);
test_int32(32);
test_int64(64);
test_long(100);
test_longlong(200);
test_uint8(255);
test_uint16(65535);
test_uint32(100000);
test_uint64(200000);
test_double(3.14);
test_float(2.71);
test_string("hello");
test_bool(true);
test_char('A');
test_byte(127);

p = Point(10, 20);
test_point(p);

result = add_mixed(10, 3.5, "mixed:");
print("result:", result);

print("=== All Type Param Test Passed ===");
