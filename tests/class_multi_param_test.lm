// class_multi_param_test.lm - class 多参数方法测试
print("=== Class Multi Param Test ===");

class Animal {
    name: string;
    func initialize(self, name, age) {
        self.name = name;
        print("Animal initialize called:", name, age);
    }
    func speak(self) {
        print("Animal speaks");
    }
}

a = Animal("Dog");
print("name:", a.name);
a.speak();

print("\n=== All Class Multi Param Tests Passed ===");
