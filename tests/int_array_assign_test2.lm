// 测试：int类型化数组元素赋值上下文感知（零转换开销）
print("=== int类型化数组元素赋值上下文感知测试 ===\n");

// 1. int类型化数组声明
arr = <int>[1, 2, 3, 4, 5];
print("1. 初始数组: ");
for(i = 0; i < 5; i = i + 1) {
    print(arr[i]);
    print(" ");
}
print("\n");

// 2. 数组元素赋值（字面量）- 上下文感知，直接压入int栈
arr[0] = 100;
arr[1] = 200;
print("2. 字面量赋值后: ");
for(i = 0; i < 5; i = i + 1) {
    print(arr[i]);
    print(" ");
}
print("\n");

// 3. 数组元素赋值（int变量）- 上下文感知，直接从int变量读取
a = <int>300;
b = <int>400;
arr[2] = a;
arr[3] = b;
print("3. int变量赋值后: ");
for(i = 0; i < 5; i = i + 1) {
    print(arr[i]);
    print(" ");
}
print("\n");

print("=== 测试完成 ===\n");
