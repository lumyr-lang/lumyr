// ============================================================
// @Data / @Getter / @Setter 注解测试（Lombok 风格实体类）
// 覆盖：自动生成 getXxx / setXxx（驼峰）、public class 前缀、
//       字段初始化器（name: type = expr）、显式 ctor 与初始化顺序、
//       const 字段只生成 getter、bool 字段 isXxx、手写访问器优先、
//       implements、继承链；
//       字段级 @Getter/@Setter：独立生效、按 bool 参数决定、优先级覆盖 @Data；
//       全类型字段（struct/class/array/typed array/map/typed map）访问器；
//       继承 × 字段注解：父类访问器继承、父子策略独立、三层链、@Data 不随继承传递
// 全部为合法用法（应全部通过、exit 0）
// ============================================================

func check(cond, msg) {
    if (cond == true) { x = 1; } else { throw msg; }
}

// ------------------------------------------------------------
// D1: 用户示例 —— @Data + public class + private 字段初始化器
// ------------------------------------------------------------
@Data
public class CustomClass {
    private name: string = "name";
    private age: int = 0;
}
c = CustomClass();
check(c.getName() == "name", "@Data 字符串字段默认值");
check(c.getAge() == 0, "@Data 整数字段默认值");
c.setName("tom");
c.setAge(18);
check(c.getName() == "tom", "@Data setName 写字符串");
check(c.getAge() == 18, "@Data setAge 写整数");

// ------------------------------------------------------------
// D2: 全标量字段类型 × getter/setter（bool getter 为 isXxx）
// ------------------------------------------------------------
@Data
class Scalars {
    vi: int = 100;
    vd: double = 1.5;
    vs: string = "ab";
    vb: bool = true;
    vc: char = 'Z';
}
sc = Scalars();
check(sc.getVi() == 100, "int getter");
check(sc.getVd() == 1.5, "double getter");
check(sc.getVs() == "ab", "string getter");
check(sc.isVb() == true, "bool getter isXxx");
check(sc.getVc() == 'Z', "char getter");
sc.setVi(-7);
sc.setVd(2.5);
sc.setVs("xy");
sc.setVb(false);
sc.setVc('Q');
check(sc.getVi() == -7, "int setter");
check(sc.getVd() == 2.5, "double setter");
check(sc.getVs() == "xy", "string setter");
check(sc.isVb() == false, "bool setter");
check(sc.getVc() == 'Q', "char setter");

// ------------------------------------------------------------
// D3: 显式 ctor + 字段初始化器 —— 初始化器先于 ctor 体执行
//     v 初始为 1，ctor 再 +10 → 11
// ------------------------------------------------------------
@Data
class Ordered {
    v: int = 1;
    func Ordered() { self.v = self.v + 10; }
}
check(Ordered().getV() == 11, "字段初始化器先于构造函数体执行");

// ------------------------------------------------------------
// D4: const 字段 + @Data —— 只生成 getter（无 setter，final 语义）
// ------------------------------------------------------------
@Data
class Item {
    const id: int;
    name: string = "item";
    func Item(n: int) { self.id = n; }
}
it = Item(42);
check(it.getId() == 42, "const 字段 getter");
check(it.getName() == "item", "普通字段与 const 共存");

// ------------------------------------------------------------
// D5: 手写访问器优先 —— @Data 不覆盖已存在的同名方法
// ------------------------------------------------------------
@Data
class Manual {
    v: int = 5;
    func getV(): int { return 999; }
}
check(Manual().getV() == 999, "手写 getter 优先于 @Data 生成");

// ------------------------------------------------------------
// D6: @Data + implements interface
// ------------------------------------------------------------
interface IGreet { func greet(): string; }
@Data
class Greeter implements IGreet {
    msg: string = "hi";
    func greet(): string { return self.msg; }
}
g = Greeter();
check(g.greet() == "hi", "@Data 类实现接口方法");
check(g.getMsg() == "hi", "@Data 与接口方法共存");

// ------------------------------------------------------------
// D7: 继承链 —— 子类 @Data 合成 ctor 自动调用父类无参 ctor，
//     父、子字段初始化器均执行（@Data 不随继承自动传递，子类显式标注）
// ------------------------------------------------------------
@Data
class DataBase {
    bn: int = 10;
}
@Data
class DataSub extends DataBase {
    sn: int = 20;
}
ds = DataSub();
check(ds.getBn() == 10, "子类实例执行父类初始化器（自动 super）");
check(ds.getSn() == 20, "子类自身初始化器执行");

// ------------------------------------------------------------
// D8: 字段初始化器配合带参显式 ctor（super(args) 显式调用）
// ------------------------------------------------------------
@Data
class DataBase2 {
    bv: int;
    func DataBase2(v: int) { self.bv = v; }
}
@Data
class DataSub2 extends DataBase2 {
    sv: int = 1;
    func DataSub2(v: int) {
        super(v);
        self.sv = self.bv + 1;
    }
}
d2 = DataSub2(40);
check(d2.getBv() == 40, "子类 super(args) 后父类字段生效");
check(d2.getSv() == 41, "子类 ctor 读取父类字段");

// ------------------------------------------------------------
// D9: 字段级 @Getter/@Setter 独立生效（无 @Data）
//     @Getter 只读、@Setter 只写、两者同标可读写、无注解不生成
// ------------------------------------------------------------
class FieldAnn {
    @Getter
    ro: int = 1;
    @Setter
    wo: int = 2;
    @Getter @Setter
    rw: int = 3;
    plain: int = 4;
    func readWo() { return self.wo; }
}
fa = FieldAnn();
check(fa.getRo() == 1, "无 @Data：@Getter 独立生成 getter");
fa.setWo(20);
check(fa.readWo() == 20, "无 @Data：@Setter 独立生成 setter");
check(fa.getRw() == 3, "无 @Data：@Getter@Setter 读");
fa.setRw(30);
check(fa.getRw() == 30, "无 @Data：@Getter@Setter 写");

// ------------------------------------------------------------
// D10: 字段注解覆盖类级 @Data —— @Getter(false)/@Setter(false)
//      被关闭方向不生成；另一方向仍随 @Data；未标注字段完全随 @Data
// ------------------------------------------------------------
@Data
class OverrideAnn {
    @Getter(false)
    noGet: int = 1;
    @Setter(false)
    noSet: int = 2;
    normal: int = 3;
    func readNoGet() { return self.noGet; }
}
ov = OverrideAnn();
ov.setNoGet(10);
check(ov.readNoGet() == 10, "@Getter(false) 关读：setter 仍随 @Data");
check(ov.getNoSet() == 2, "@Setter(false) 关写：getter 仍随 @Data");
check(ov.getNormal() == 3, "未标注字段 getter 随 @Data");
ov.setNormal(30);
check(ov.getNormal() == 30, "未标注字段 setter 随 @Data");

// ------------------------------------------------------------
// D11: 显式 true 参数 / 无参 / 同字段重复标注（后者覆盖）
// ------------------------------------------------------------
class BoolArg {
    @Getter(true)
    a: int = 1;
    @Setter(true)
    b: int = 2;
    @Getter(false) @Getter(true)
    c: int = 3;
    func readB() { return self.b; }
}
ba = BoolArg();
check(ba.getA() == 1, "@Getter(true) 生成");
ba.setB(20);
check(ba.readB() == 20, "@Setter(true) 生成");
check(ba.getC() == 3, "同字段重复 @Getter 后者覆盖（false→true）");

// ------------------------------------------------------------
// D12: 全容器 / 实例类型字段矩阵 —— struct 属性、class 属性、
//      普通 array、typed array、普通 map、typed map 的 get/set
//      （容器/自定义类型访问器走动态 any）
// ------------------------------------------------------------
struct APt { x: int; y: int; func sum() { return self.x + self.y; } }
class AKls {
    n: int;
    func AKls(n) { self.n = n; }
    func getn() { return self.n; }
}
@Data
class Containers {
    arr: array;
    tarr: <int>array;
    mp: map;
    tmp: <string, int>map;
    p: APt;
    k: AKls;
    func Containers() {
        self.arr = [1, 2, 3];
        self.tarr = <int>[10, 20];
        self.mp = {"a": 1};
        self.tmp = <string, int>{"x": 7};
        self.p = APt(3, 4);
        self.k = AKls(5);
    }
}
ct = Containers();
check(type(ct.getArr()) == "array", "array 字段 getter 类型");
check(ct.getArr()[1] == 2, "array 字段 getter 元素");
check(ct.getTarr()[0] == 10, "typed array 字段 getter");
check(ct.getMp()["a"] == 1, "map 字段 getter");
check(ct.getTmp()["x"] == 7, "typed map 字段 getter");
check(type(ct.getP()) == "APt", "struct 属性 getter 类型");
check(ct.getP().sum() == 7, "struct 属性 getter 方法调用");
check(type(ct.getK()) == "AKls", "class 属性 getter 类型");
check(ct.getK().getn() == 5, "class 属性 getter 方法调用");
ct.setArr([9]);
check(ct.getArr().len == 1 && ct.getArr()[0] == 9, "array 字段 setter");
ct.setTarr(<int>[100]);
check(ct.getTarr()[0] == 100, "typed array 字段 setter");
ct.setMp({"b": 2});
check(ct.getMp()["b"] == 2, "map 字段 setter");
ct.setTmp(<string, int>{"y": 8});
check(ct.getTmp()["y"] == 8, "typed map 字段 setter");
ct.setP(APt(6, 7));
check(ct.getP().sum() == 13, "struct 属性 setter");
ct.setK(AKls(9));
check(ct.getK().getn() == 9, "class 属性 setter");

// ------------------------------------------------------------
// D13: 多类顺序 —— 带字段注解的类位于其他类之后，紧随动态读取，
//      覆盖跨类场景（容器/动态值经 BOX_PTR→INDEX_GET 路径）
// ------------------------------------------------------------
class Lead { v: int = 1; }
@Data
class After {
    @Setter(false)
    s: string = "x";
    n: int = 5;
}
at = After();
check(at.getS() == "x", "多类顺序：字段注解类字符串动态读");
check(at.getN() == 5, "多类顺序：普通字段读");

// ============================================================
// 继承 × @Data / @Getter / @Setter
// ============================================================

// ------------------------------------------------------------
// D14: 父类字段注解生成的访问器被子类继承
// ------------------------------------------------------------
class IHP {
    @Getter @Setter
    v: int = 1;
    @Getter @Setter(false)
    ro: int = 2;
}
class IHC extends IHP {
    w: int = 3;
}
ihc = IHC();
check(ihc.getV() == 1, "继承：父类 @Getter 读");
ihc.setV(10);
check(ihc.getV() == 10, "继承：父类 @Setter 写");
check(ihc.getRo() == 2, "继承：父类 @Getter @Setter(false) 字段读");

// ------------------------------------------------------------
// D15: 父类 @Data，子类无 @Data，子类自有字段独立字段注解
// ------------------------------------------------------------
@Data
class IDP {
    a: int = 1;
}
class IDC extends IDP {
    @Getter @Setter
    b: int = 2;
}
idc = IDC();
check(idc.getA() == 1, "继承父类 @Data getter");
idc.setA(11);
check(idc.getA() == 11, "继承父类 @Data setter");
check(idc.getB() == 2, "子类自有字段 @Getter");
idc.setB(22);
check(idc.getB() == 22, "子类自有字段 @Setter");

// ------------------------------------------------------------
// D16: 子类 @Data + 字段注解覆盖，父类 @Data —— 父子策略各自独立
// ------------------------------------------------------------
@Data
class IOP {
    a: int = 1;
}
@Data
class IOC extends IOP {
    @Getter(false)
    noGet: int = 5;
    @Setter(false)
    noSet: int = 6;
    func readNoGet() { return self.noGet; }
}
ioc = IOC();
ioc.setNoGet(50);
check(ioc.readNoGet() == 50, "子类 @Getter(false) 关读，写仍随子类 @Data");
check(ioc.getNoSet() == 6, "子类 @Setter(false) 关写，读仍随子类 @Data");
check(ioc.getA() == 1, "父类 @Data 访问器仍继承可用");

// ------------------------------------------------------------
// D17: 子类手写同名方法覆盖父类生成访问器；父类 const 字段 getter 继承
// ------------------------------------------------------------
@Data
class IMP {
    v: int = 1;
}
@Data
class IMC extends IMP {
    func getV() { return 777; }
}
check(IMC().getV() == 777, "子类手写 getter 覆盖父类 @Data 生成");

@Data
class ICP {
    const id: int;
    func ICP(i) { self.id = i; }
}
@Data
class ICC extends ICP {
    n: int = 9;
    func ICC(i) { super(i); }
}
icc2 = ICC(42);
check(icc2.getId() == 42, "继承父类 const 字段 getter");
check(icc2.getN() == 9, "子类自身字段 getter");

// ------------------------------------------------------------
// D18: 父类关闭方向的访问器随继承保持；三层继承链字段注解一路传递
// ------------------------------------------------------------
@Data
class IFP {
    @Getter(false)
    ng: int = 1;
    @Setter(false)
    ns: int = 2;
}
class IFC extends IFP {
    x: int = 0;
}
ifc = IFC();
check(ifc.getNs() == 2, "父类 @Setter(false) 字段 getter 继承可用");
ifc.setNg(10);   /* ng 关 getter，其 setter 随父类 @Data 生成 */

class IG {
    @Getter @Setter
    gv: int = 1;
}
class IM extends IG {
    mv: int = 2;
}
class IS extends IM {
    sv: int = 3;
}
is7 = IS();
check(is7.getGv() == 1, "三层链：孙类继承祖父字段 @Getter");
is7.setGv(100);
check(is7.getGv() == 100, "三层链：孙类继承祖父字段 @Setter");

// ------------------------------------------------------------
// D19: @Data 不随继承传递 —— 子类无 @Data，自有字段无生成访问器；
//      父类访问器仍继承，自有字段类内可直接访问
// ------------------------------------------------------------
@Data
class IP8 {
    a: int = 1;
}
class IC8 extends IP8 {
    own: int = 2;
    func readOwn() { return self.own; }
}
ic8 = IC8();
check(ic8.getA() == 1, "父类 @Data 访问器继承可用");
check(ic8.readOwn() == 2, "子类自有字段无生成访问器，类内可直接访问");

/* ------------------------------------------------------------
 * 编译中止场景（exit 1，单独验证，不放入本文件以保证全绿）：
 *  - 类有字段初始化器但无 ctor，父类 ctor 含必填参数 → 语法错误中止
 *  - @Data 不随继承传递：未标注的子类不会为自有字段生成访问器
 *  - 继承：父类 @Getter(false)/@Setter(false) 关闭的方向，子类调用仍中止
 * ------------------------------------------------------------
 */

print("annotation_data_test ALL PASS");
