// 测试 class 访问修饰符语法
print("=== Class Access Modifier Test ===");

class User {
    public name: string;
    private password: string;
    protected email: string;

    func __init__(self, name, password, email) {
        self.name = name;
        self.password = password;
        self.email = email;
    }

    func print_info(self) {
        print("name:", self.name);
        print("password:", self.password);
        print("email:", self.email);
    }

    public func get_name(self) {
        return self.name;
    }

    private func get_password(self) {
        return self.password;
    }

    protected func get_email(self) {
        return self.email;
    }
}

u = User("Alice", "123456", "alice@example.com");
u.print_info();

print("public name:", u.name);
print("public get_name:", u.get_name());

// 以下访问应该被禁止（运行时检查后续实现）
// print("private password:", u.password);  // 应该报错
// print("private get_password:", u.get_password());  // 应该报错
// print("protected email:", u.email);  // 应该报错
// print("protected get_email:", u.get_email());  // 应该报错

print("\n=== Class Access Modifier Test Done ===");
