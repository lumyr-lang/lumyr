// class_interface_missing_test.lm - class 未实现接口方法测试
print("=== Class Interface Missing Method Test ===");

// 定义接口
interface Printable {
    func to_string(): string;
}

// class 未实现接口中定义的所有方法
class BadPoint implements Printable {
    x: int;
    y: int;
    func __init__(self, x, y) {
        self.x = x;
        self.y = y;
    }
    // 缺少 to_string 方法
}

p = BadPoint(3, 4);
print("BadPoint x:", p.x);
print("BadPoint y:", p.y);

print("\n=== All Class Interface Missing Method Tests Passed ===");
