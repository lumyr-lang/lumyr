// ============================================================
// 全量基础数据类型交叉运算测试
// 覆盖所有整数/浮点/字符/布尔类型两两交叉
// ============================================================

print("=== 1. 整数类型两两交叉加法 ===");
a = <int>100;
b = <int8>50;
c = a + b;
print(c);

a = <int8>100;
b = <int16>200;
c = a + b;
print(c);

a = <int16>1000;
b = <int32>2000;
c = a + b;
print(c);

a = <int32>10000;
b = <int64>20000;
c = a + b;
print(c);

a = <int64>1000000;
b = <long long>2000000;
c = a + b;
print(c);

print("=== 2. 整数类型两两交叉减法 ===");
a = <int>1000;
b = <int8>100;
c = a - b;
print(c);

a = <int16>500;
b = <int8>50;
c = a - b;
print(c);

a = <int64>1000000;
b = <int32>10000;
c = a - b;
print(c);

print("=== 3. 整数类型两两交叉乘法 ===");
a = <int>10;
b = <int8>5;
c = a * b;
print(c);

a = <int16>100;
b = <int32>200;
c = a * b;
print(c);

a = <int32>1000;
b = <int64>2000;
c = a * b;
print(c);

print("=== 4. 整数类型两两交叉除法 ===");
a = <int>100;
b = <int8>5;
c = a / b;
print(c);

a = <int64>1000000;
b = <int32>100;
c = a / b;
print(c);

print("=== 5. 有符号 + 无符号交叉 ===");
a = <int>100;
b = <uint>50;
c = a + b;
print(c);

a = <int8>100;
b = <uint8>200;
c = a + b;
print(c);

a = <int16>1000;
b = <uint16>2000;
c = a + b;
print(c);

a = <int32>10000;
b = <uint32>20000;
c = a + b;
print(c);

a = <int64>1000000;
b = <uint64>2000000;
c = a + b;
print(c);

print("=== 6. 浮点类型两两交叉 ===");
a = <float>1.5;
b = <double>2.5;
c = a + b;
print(c);

a = <double>10.5;
b = <long double>20.5;
c = a + b;
print(c);

a = <float>3.5;
b = <long double>7.5;
c = a + b;
print(c);

a = <float>10.0;
b = <float>3.0;
c = a / b;
print(c);

print("=== 7. 整数 + 浮点全量交叉 ===");
a = <int>10;
b = <float>1.5;
c = a + b;
print(c);

a = <int>10;
b = <double>2.5;
c = a + b;
print(c);

a = <int8>100;
b = <float>1.5;
c = a + b;
print(c);

a = <int16>1000;
b = <double>2.5;
c = a + b;
print(c);

a = <int32>10000;
b = <float>1.5;
c = a + b;
print(c);

a = <int64>1000000;
b = <double>2.5;
c = a + b;
print(c);

a = <uint>100;
b = <float>1.5;
c = a + b;
print(c);

a = <uint64>1000000;
b = <double>2.5;
c = a + b;
print(c);

print("=== 8. char / byte 与整数交叉 ===");
a = <char>65;
b = <int>1;
c = a + b;
print(c);

a = <byte>200;
b = <int>100;
c = a + b;
print(c);

a = <char>'A';
b = <int>1;
c = a + b;
print(c);

print("=== 9. bool 与其他类型交叉 ===");
a = <bool>true;
b = <int>1;
c = a + b;
print(c);

a = <bool>false;
b = <int>0;
c = a + b;
print(c);

a = <bool>true;
b = <bool>false;
c = a && b;
print(c);

a = <bool>true;
b = <bool>false;
c = a || b;
print(c);

print("=== 10. 各类型比较运算交叉 ===");
a = <int>100;
b = <int8>50;
c = a > b;
print(c);

a = <int16>1000;
b = <int32>2000;
c = a < b;
print(c);

a = <int64>1000000;
b = <int32>10000;
c = a >= b;
print(c);

a = <double>10.5;
b = <float>5.5;
c = a > b;
print(c);

a = <int>100;
b = <double>100.0;
c = a == b;
print(c);

a = <uint>100;
b = <int>100;
c = a == b;
print(c);

print("=== 11. 各类型赋值传播 ===");
a = <int8>100;
b = a;
print(b);

a = <int16>1000;
b = a;
print(b);

a = <int32>10000;
b = a;
print(b);

a = <int64>1000000;
b = a;
print(b);

a = <float>3.14;
b = a;
print(b);

a = <double>3.14159;
b = a;
print(b);

a = <char>'A';
b = a;
print(b);

a = <bool>true;
b = a;
print(b);

print("=== 12. 传播后参与运算 ===");
a = <int8>100;
b = a + 50;
print(b);

c = <int16>200;
d = c + a;
print(d);

e = <int32>1000;
f = e + d;
print(f);

g = <double>1.5;
h = g + a;
print(h);

print("=== 13. 自增自减全类型 ===");
i8 = <int8>100;
i8 = i8 + 1;
print(i8);
i8 = i8 - 1;
print(i8);

i16 = <int16>1000;
i16 = i16 + 1;
print(i16);
i16 = i16 - 1;
print(i16);

i32 = <int32>10000;
i32 = i32 + 1;
print(i32);
i32 = i32 - 1;
print(i32);

i64 = <int64>1000000;
i64 = i64 + 1;
print(i64);
i64 = i64 - 1;
print(i64);

u8 = <uint8>200;
u8 = u8 + 1;
print(u8);

u16 = <uint16>2000;
u16 = u16 + 1;
print(u16);

f = <float>1.5;
f = f + 0.5;
print(f);

d = <double>2.5;
d = d + 0.5;
print(d);

print("=== 14. 复合运算（乘除加减混合） ===");
a = <int>10;
b = <int>20;
c = <int>5;
d = a + b * c;
print(d);

a = <int>100;
b = <int>20;
c = <int>5;
d = (a + b) / c;
print(d);

a = <int>1000;
b = <int>100;
c = <int>10;
d = a - b * c;
print(d);

a = <double>10.5;
b = <double>2.5;
c = a + b * 2;
print(c);

print("=== 15. 类型提升规则验证 ===");
// int + double → double
a = <int>10;
b = <double>2.5;
c = a + b;
print(c);

// int + float → float/double
a = <int>10;
b = <float>1.5;
c = a + b;
print(c);

// int8 + int32 → int32
a = <int8>100;
b = <int32>200;
c = a + b;
print(c);

// int32 + int64 → int64
a = <int32>10000;
b = <int64>20000;
c = a + b;
print(c);

// uint + int → uint
a = <uint>100;
b = <int>-50;
c = a + b;
print(c);

print("=== 16. 边界值测试 ===");
// int8 边界
a = <int8>127;
print(a);
a = <int8>(-128);
print(a);

// uint8 边界
a = <uint8>255;
print(a);
a = <uint8>0;
print(a);

// int16 边界
a = <int16>32767;
print(a);
a = <int16>(-32768);
print(a);

// int32 边界
a = <int32>2147483647;
print(a);

// int64 边界
a = <int64>9223372036854775807;
print(a);

// uint64 边界
a = <uint64>18446744073709551615;
print(a);

// float 精度
a = <float>0.1;
b = <float>0.2;
c = a + b;
print(c);

// double 精度
a = <double>0.1;
b = <double>0.2;
c = a + b;
print(c);

print("=== 17. 字符串类型运算 ===");
a = <string>"hello ";
b = <string>"world";
c = a + b;
print(c);

a = <string>"count: ";
b = <int>42;
c = a + b;
print(c);

a = <string>"pi = ";
b = <double>3.14;
c = a + b;
print(c);

print("=== 18. 三元运算符交叉 ===");
a = <int>100;
b = <int>200;
c = a > b ? a : b;
print(c);

a = <int>100;
b = <int>200;
c = a < b ? "smaller" : "larger";
print(c);

a = <int>100;
b = <double>200.5;
c = a < b ? a : b;
print(c);

print("=== 19. 逻辑运算交叉 ===");
a = <int>100;
b = <int>0;
c = a && b;
print(c);

a = <int>0;
b = <int>200;
c = a || b;
print(c);

a = <bool>true;
b = <int>1;
c = a && b;
print(c);

a = <bool>false;
b = <int>0;
c = a || b;
print(c);

print("=== 20. 全量完成 ===");
print("=== 全部测试完成 ===");
