// 测试：int 类型化数组元素访问的零开销优化
// 验证 OPC_INT_ARRAY_GET 指令是否正常工作

print("=== int 类型化数组元素访问零开销测试 ===\n");

// 测试 1：int 数组元素作为另一个 int 数组的元素
arr = <int>[1, 2, 3, 4, 5];
print("arr type = \n");
print(type(arr));
print("\n");
print("arr len = \n");
print(len(arr));
print("\n");

// 从 arr 读取元素，创建新的 int 数组
arr2 = <int>[arr[0], arr[1], arr[2]];
print("arr2 type = \n");
print(type(arr2));
print("\n");
print("arr2 len = \n");
print(len(arr2));
print("\n");
print("arr2[0] = \n");
print(arr2[0]);
print(" (期望 1)\n");
print("arr2[1] = \n");
print(arr2[1]);
print(" (期望 2)\n");
print("arr2[2] = \n");
print(arr2[2]);
print(" (期望 3)\n");

// 测试 2：int 变量和 int 数组元素混合
a = <int>100;
b = <int>200;
arr3 = <int>[a, arr[0], b, arr[4]];
print("\narr3 len = \n");
print(len(arr3));
print("\n");
print("arr3[0] = \n");
print(arr3[0]);
print(" (期望 100)\n");
print("arr3[1] = \n");
print(arr3[1]);
print(" (期望 1)\n");
print("arr3[2] = \n");
print(arr3[2]);
print(" (期望 200)\n");
print("arr3[3] = \n");
print(arr3[3]);
print(" (期望 5)\n");

print("\n=== 测试完成 ===\n");
