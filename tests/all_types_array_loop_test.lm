// 测试所有数据类型的专用数组循环取值打印场景
print("=== 测试所有数据类型的专用数组循环取值打印 ===\n");

// 1. int 类型
print("--- int 类型 ---\n");
arr_int = <int>[1, 2, 3, 4, 5];
for(i = 0; i < 5; i = i + 1) {
    print("arr_int[");
    print(i);
    print("] = ");
    print(arr_int[i]);
    print("\n");
}

// 2. uint 类型
print("--- uint 类型 ---\n");
arr_uint = <uint>[10, 20, 30, 40, 50];
for(i = 0; i < 5; i = i + 1) {
    print("arr_uint[");
    print(i);
    print("] = ");
    print(arr_uint[i]);
    print("\n");
}

