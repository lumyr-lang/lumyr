// 测试：uint32 类型完整零开销路径（各类型自己表示自己，别混用）
print("=== uint32 类型测试 ===\n");

// 1. 变量声明
a = <uint32>4294967295;
print("a = ");
print(a);
print("\n");

b = <uint32>1000000;
print("b = ");
print(b);
print("\n");

c = <uint32>0;
print("c = ");
print(c);
print("\n");

// 2. 数组声明
arr = <uint32>[4294967295, 1000000, 0, 500, 999];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[1] = ");
print(arr[1]);
print("\n");
print("arr[2] = ");
print(arr[2]);
print("\n");
print("arr[3] = ");
print(arr[3]);
print("\n");
print("arr[4] = ");
print(arr[4]);
print("\n");

print("=== 测试完成 ===\n");
