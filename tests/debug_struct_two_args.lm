// 调试结构体方法有两个参数的测试
print("=== 调试结构体方法有两个参数 ===");

// 简单 class（没有方法）
class SimpleClass {
    name: string;
}

obj = SimpleClass();
obj.name = "Test";
print("obj.name =", obj.name);

// 结构体方法（有两个参数）
struct Point {
    x: int;
    y: int;
    func distance(self, other) {
        print("进入 distance 方法");
        dx = self.x - other.x;
        dy = self.y - other.y;
        print("dx =", dx);
        print("dy =", dy);
        return dx * dx + dy * dy;
    }
}

p1 = Point();
p1.x = 0;
p1.y = 0;
p2 = Point();
p2.x = 3;
p2.y = 4;
print("准备调用 p1.distance(p2)");
result = p1.distance(p2);
print("result =", result);

print("=== 调试完成 ===");
