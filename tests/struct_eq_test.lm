// struct_eq_test.lm — 测试 struct 相等比较
struct Point { x: int; y: int; }

print("=== Struct Equality Test ===");

p1 = Point(10, 20);
p2 = Point(10, 20);
p3 = Point(30, 40);
p4 = p1;

print("p1:", p1.x, p1.y);
print("p2:", p2.x, p2.y);
print("p3:", p3.x, p3.y);

print("--- 相等比较 ---");
print("p1 == p2 (相同字段，不同实例):", p1 == p2);
print("p1 == p3 (不同字段):", p1 == p3);
print("p1 == p4 (同一实例):", p1 == p4);
print("p1 != p2:", p1 != p2);

print("--- 期望 ---");
print("p1 == p2 应该是 1 (按字段比较)");
print("p1 == p3 应该是 0");
print("p1 == p4 应该是 1");

if (p1 == p2) {
    print("PASS: struct 相等比较按字段比较");
} else {
    print("FAIL: struct 相等比较是引用比较");
}

print("=== Done ===");
