// 嵌套 struct 测试
print("=== Nested Struct Test ===");

struct Point { x: int; y: int; }
struct Rect { top_left: Point; bottom_right: Point; }

p1 = Point(10, 20);
p2 = Point(30, 40);
r = Rect(p1, p2);

print("r.top_left.x:", r.top_left.x);
print("r.top_left.y:", r.top_left.y);
print("r.bottom_right.x:", r.bottom_right.x);
print("r.bottom_right.y:", r.bottom_right.y);

r.top_left.x = 100;
r.top_left.y = 200;
print("after modify r.top_left.x:", r.top_left.x);
print("after modify r.top_left.y:", r.top_left.y);

print("=== Nested Struct Test Passed ===");
