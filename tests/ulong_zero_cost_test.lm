// 测试：unsigned long 类型完整零开销路径
print("=== unsigned long 类型测试 ===\n");

// 1. 变量声明
a = <unsigned long>1000000;
print("a = ");
print(a);
print("\n");

b = <unsigned long>5000000;
print("b = ");
print(b);
print("\n");

c = <unsigned long>4294967295;
print("c = ");
print(c);
print("\n");

// 2. 数组声明
arr = <unsigned long>[100000, 200000, 300000, 400000, 500000];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[2] = ");
print(arr[2]);
print("\n");
print("arr[4] = ");
print(arr[4]);
print("\n");

print("=== 测试完成 ===\n");
