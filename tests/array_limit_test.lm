check(a_int[0] == <int>2147483647, "int max: value");
check(type(a_int[0]) == "int", "int max: vtype");
n = n + 1;
check(a_int[1] == <int>-2147483648, "int min: value");
check(type(a_int[1]) == "int", "int min: vtype");
