// ===== 2. typed 数组整型溢出回绕 =====
ov_int8 = <int8>[200];
check(ov_int8[0] == <int8>-56, "overflow int8: 200 -> -56");
n = n + 1;
ov_int8 = <int8>[-200];
check(ov_int8[0] == <int8>56, "overflow int8: -200 -> 56");
n = n + 1;
ov_uint8 = <uint8>[300];
check(ov_uint8[0] == <uint8>44, "overflow uint8: 300 -> 44");
n = n + 1;
ov_int16 = <int16>[40000];
check(ov_int16[0] == <int16>-25536, "overflow int16: 40000 -> -25536");
n = n + 1;
ov_uint16 = <uint16>[70000];
check(ov_uint16[0] == <uint16>4464, "overflow uint16: 70000 -> 4464");
n = n + 1;
ov_int32 = <int32>[3000000000];
check(ov_int32[0] == <int32>-1294967296, "overflow int32: 3000000000 -> -1294967296");
