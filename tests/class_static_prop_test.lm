// 测试 class 静态属性（简化版）
print("=== Class Static Property Test (Simple) ===");

class Config {
    static version = "1.0.0";
    static max_connections = 100;
}

print("version:", Config_version);
print("max_connections:", Config_max_connections);

// 修改静态属性
Config_version = "2.0.0";
Config_max_connections = 200;

print("modified version:", Config_version);
print("modified max_connections:", Config_max_connections);

print("\n=== Class Static Property Test Done ===");
