// 测试接口类型标注
print("=== 接口类型标注测试 ===");

interface Printable {
    func to_string(): string;
}

interface Serializable {
    func to_json(): string;
}

class Dog implements Printable {
    name: string,
    age: int
    func __init__(self, name, age) {
        self.name = name;
        self.age = age;
    }
    func to_string(self) {
        return "Dog(" + self.name + ", " + self.age + ")";
    }
}

class Cat implements Printable, Serializable {
    name: string
    func __init__(self, name) {
        self.name = name;
    }
    func to_string(self) {
        return "Cat(" + self.name + ")";
    }
    func to_json(self) {
        return "{\"name\":\"" + self.name + "\"}";
    }
}

// 接口类型标注：变量被标记为 Printable 接口引用类型
p = <Printable>Dog("Buddy", 3);
print("p.to_string(): ", p.to_string());

// 接口引用可以指向任何实现了该接口的对象
p = <Printable>Cat("Whiskers");
print("p.to_string(): ", p.to_string());

// 测试 implements 运算符
print("p implements Printable: ", p implements Printable);
print("p implements Serializable: ", p implements Serializable);

print("=== 测试完成 ===");
