// class_polymorphism_test.lm - class 多态测试
print("=== Class Polymorphism Test ===");

class Animal {
    name: string;
    func speak(self) {
        print("Animal speaks");
    }
    func get_name(self) {
        return self.name;
    }
}

class Dog extends Animal {
    breed: string;
    func speak(self) {
        print("Dog barks");
    }
}

class Cat extends Animal {
    color: string;
    func speak(self) {
        print("Cat meows");
    }
}

// 多态：父类引用指向子类对象，动态分派
func make_animal_speak(animal) {
    animal.speak();
}

print("--- 1. 多态方法调用 ---");
d = Dog("Buddy", "Golden");
c = Cat("Whiskers", "Gray");

make_animal_speak(d);  // 应该输出 "Dog barks"
make_animal_speak(c);  // 应该输出 "Cat meows"

print("\n--- 2. 数组中的多态 ---");
animals = [d, c];
for(i = 0; i < len(animals); i++) {
    animals[i].speak();
}

print("\n--- 3. 继承的方法 ---");
print("Dog name:", d.get_name());
print("Cat name:", c.get_name());

print("\n=== All Class Polymorphism Tests Passed ===");
