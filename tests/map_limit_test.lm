// tests/map_limit_test.lm
// map 各数据类型极限容量测试（由 fuzz/gen_map_limit_test.py 生成，勿手改）

func check(cond, msg) {
    if(cond) {} else { throw msg; }
}

n = 0;

// ===== V = int =====
m_int_max = <string, int>{"v": 2147483647};
check(type(m_int_max) == "map", "int max: container");
check(m_int_max["v"] == <int>2147483647, "int max: value");
check(type(m_int_max["v"]) == "int", "int max: vtype");
n = n + 1;
m_int_min = <string, int>{"v": -2147483648};
check(type(m_int_min) == "map", "int min: container");
check(m_int_min["v"] == <int>-2147483648, "int min: value");
check(type(m_int_min["v"]) == "int", "int min: vtype");
n = n + 1;

// ===== V = int8 =====
