check(type(m_int8_max["v"]) == "int8", "int8 max: vtype");
n = n + 1;
m_int8_min = <string, int8>{"v": -128};
check(type(m_int8_min) == "map", "int8 min: container");
check(m_int8_min["v"] == <int8>-128, "int8 min: value");
check(type(m_int8_min["v"]) == "int8", "int8 min: vtype");
