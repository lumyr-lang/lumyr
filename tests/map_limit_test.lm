// ===== 整型溢出回绕（max+1 截断到类型范围，不应崩溃） =====
ov_int8 = <string, int8>{"v": 200};
check(ov_int8["v"] == <int8>-56, "overflow int8: 200 -> -56");
n = n + 1;
ov_int8 = <string, int8>{"v": -200};
check(ov_int8["v"] == <int8>56, "overflow int8: -200 -> 56");
n = n + 1;
ov_uint8 = <string, uint8>{"v": 300};
check(ov_uint8["v"] == <uint8>44, "overflow uint8: 300 -> 44");
n = n + 1;
ov_int16 = <string, int16>{"v": 40000};
check(ov_int16["v"] == <int16>-25536, "overflow int16: 40000 -> -25536");
n = n + 1;
ov_uint16 = <string, uint16>{"v": 70000};
check(ov_uint16["v"] == <uint16>4464, "overflow uint16: 70000 -> 4464");
n = n + 1;
ov_int32 = <string, int32>{"v": 3000000000};
check(ov_int32["v"] == <int32>-1294967296, "overflow int32: 3000000000 -> -1294967296");
n = n + 1;

print("map_limit_test cases =", n);
print("map_limit_test ALL PASS");
