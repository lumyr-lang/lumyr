// 测试接口类型转换（使用内置函数 interface_cast）
print("=== 接口类型转换测试 ===");

interface Printable {
    func to_string(): string;
}

interface Serializable {
    func to_json(): string;
}

class Dog implements Printable {
    name: string,
    age: int
    func __init__(self, name, age) {
        self.name = name;
        self.age = age;
    }
    func to_string(self) {
        return "Dog(" + self.name + ", " + self.age + ")";
    }
}

class Cat implements Printable, Serializable {
    name: string
    func __init__(self, name) {
        self.name = name;
    }
    func to_string(self) {
        return "Cat(" + self.name + ")";
    }
    func to_json(self) {
        return "{\"name\":\"" + self.name + "\"}";
    }
}

// 测试1：正常的接口类型转换
d = Dog("Buddy", 3);
p = lumyr_interface_cast(d, "Printable");
print("测试1 - p.to_string(): ", p.to_string());

// 测试2：接口类型转换后可以指向其他实现了该接口的对象
c = Cat("Whiskers");
p = lumyr_interface_cast(c, "Printable");
print("测试2 - p.to_string(): ", p.to_string());

// 测试3：实现了多个接口的对象可以转换为任意一个接口
s = lumyr_interface_cast(c, "Serializable");
print("测试3 - s.to_json(): ", s.to_json());

// 测试4：接口类型转换失败的情况（对象没有实现接口）
print("测试4 - 接口类型转换失败测试:");
try {
    x = lumyr_interface_cast(d, "Serializable");  // Dog 没有实现 Serializable
    print("  不应该走到这里");
} catch(e) {
    print("  捕获到错误: ", e);
}

print("=== 接口类型转换测试完成 ===");
