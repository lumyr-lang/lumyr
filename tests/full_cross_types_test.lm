/* 全量数据类型交叉测试：自动生成 */

/* ========== 变量定义 ========== */
v0 = <int>100;  /* int */
v1 = <short>32767;  /* short */
v2 = <int8>127;  /* int8 */
v3 = <int16>32767;  /* int16 */
v4 = <int32>2147483647;  /* int32 */
v5 = <int64>9223372036854775807;  /* int64 */
