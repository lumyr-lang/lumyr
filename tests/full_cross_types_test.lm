/* ========== 第二组：三类型多链路组合 ========== */
/* 多链路: int → double → string */
r = v0 + v18 + v19;
print("chain: int+double+string:");
print(type(r));

/* 多链路: double → string → int */
r = v18 + v19 + v0;
print("chain: double+string+int:");
print(type(r));

/* 多链路: string → double → int */
r = v19 + v18 + v0;
print("chain: string+double+int:");
print(type(r));

/* 多链路: bigint → double → int */
r = v20 + v18 + v0;
print("chain: bigint+double+int:");
print(type(r));

/* 多链路: bigint → string → int */
r = v20 + v19 + v0;
print("chain: bigint+string+int:");
print(type(r));

/* 多链路: decimal → int → double */
r = v21 + v0 + v18;
print("chain: decimal+int+double:");
print(type(r));

/* 多链路: decimal → double → string */
r = v21 + v18 + v19;
print("chain: decimal+double+string:");
print(type(r));

/* 多链路: bigint → decimal → string */
r = v20 + v21 + v19;
print("chain: bigint+decimal+string:");
print(type(r));

/* 多链路: int → bigint → decimal */
r = v0 + v20 + v21;
print("chain: int+bigint+decimal:");
print(type(r));

/* 多链路: double → bigint → string */
r = v18 + v20 + v19;
print("chain: double+bigint+string:");
print(type(r));

/* 多链路: string → bigint → decimal */
r = v19 + v20 + v21;
print("chain: string+bigint+decimal:");
print(type(r));

/* 多链路: bool → int → double */
r = v16 + v0 + v18;
print("chain: bool+int+double:");
print(type(r));

/* 多链路: char → int → string */
r = v15 + v0 + v19;
print("chain: char+int+string:");
print(type(r));

/* 多链路: byte → short → int */
r = v7 + v1 + v0;
print("chain: byte+short+int:");
print(type(r));

/* 多链路: uint → int → double */
r = v8 + v0 + v18;
print("chain: uint+int+double:");
