// ============================================================
// 变量声明带类型标注语法测试：a: Type = value
// 等价于旧语法 a = <Type>value，覆盖所有数据类型
// ============================================================

func check(cond, msg) {
    if (cond == true) { x = 1; } else { throw msg; }
}

// ============================================================
// PART 1：基础类型（int 族 / float 族 / string / bool / char / byte）
// ============================================================

// 1.1 int
a_int: int = 42;
b_int = <int>42;
check(a_int == 42, "int: a: int = 42");
check(a_int == b_int, "int: 等价于 <int>42");
check(type(a_int) == "int64", "int: type == int64");

// 1.2 int8
a_i8: int8 = 100;
b_i8 = <int8>100;
check(a_i8 == 100, "int8: a: int8 = 100");
check(a_i8 == b_i8, "int8: 等价于 <int8>100");

// 1.3 int16
a_i16: int16 = 1000;
check(a_i16 == 1000, "int16: a: int16 = 1000");

// 1.4 int32
a_i32: int32 = 100000;
check(a_i32 == 100000, "int32: a: int32 = 100000");

// 1.5 int64
a_i64: int64 = 9999999999;
check(a_i64 == 9999999999, "int64: a: int64 = 9999999999");

// 1.6 uint8
a_u8: uint8 = 200;
check(a_u8 == 200, "uint8: a: uint8 = 200");

// 1.7 uint16
a_u16: uint16 = 50000;
check(a_u16 == 50000, "uint16: a: uint16 = 50000");

// 1.8 uint32
a_u32: uint32 = 3000000000;
check(a_u32 == 3000000000, "uint32: a: uint32 = 3000000000");

// 1.9 uint / uint64
a_u64: uint64 = 9999999999;
check(a_u64 == 9999999999, "uint64: a: uint64 = 9999999999");

// 1.10 short / long / long long
a_short: short = 1000;
check(a_short == 1000, "short: a: short = 1000");
a_long: long = 99999;
check(a_long == 99999, "long: a: long = 99999");
a_ll: long long = 9999999999;
check(a_ll == 9999999999, "long long: a: long long = 9999999999");

// 1.11 ushort / ulong
a_ushort: ushort = 60000;
check(a_ushort == 60000, "ushort: a: ushort = 60000");
a_ulong: ulong = 9999999999;
check(a_ulong == 9999999999, "ulong: a: ulong = 9999999999");

// 1.12 size_t / ssize_t
a_size: size_t = 1024;
check(a_size == 1024, "size_t: a: size_t = 1024");
a_ssize: ssize_t = -1024;
check(a_ssize == -1024, "ssize_t: a: ssize_t = -1024");

// 1.13 负数
a_neg: int = -5;
check(a_neg == -5, "int: 负数 a: int = -5");

print("var_decl_type_test PART1 (int 族) PASS");

// ============================================================
// PART 2：浮点族
// ============================================================

// 2.1 double
a_dbl: double = 3.14;
b_dbl = <double>3.14;
check(a_dbl == 3.14, "double: a: double = 3.14");
check(a_dbl == b_dbl, "double: 等价于 <double>3.14");
check(type(a_dbl) == "double", "double: type == double");

// 2.2 float
a_flt: float = 2.5;
check(a_flt == 2.5, "float: a: float = 2.5");

// 2.3 long double
a_ld: long double = 9.999;
check(a_ld == 9.999, "long double: a: long double = 9.999");

print("var_decl_type_test PART2 (float 族) PASS");

// ============================================================
// PART 3：string / bool / char / byte / ascii / uchar
// ============================================================

// 3.1 string
a_str: string = "hello";
b_str = <string>"hello";
check(a_str == "hello", "string: a: string = hello");
check(a_str == b_str, "string: 等价于 <string>hello");
check(type(a_str) == "string", "string: type == string");

// 3.2 bool
a_bool: bool = true;
b_bool = <bool>true;
check(a_bool == true, "bool: a: bool = true");
check(a_bool == b_bool, "bool: 等价于 <bool>true");

// 3.3 char
a_char: char = 'X';
b_char = <char>'X';
check(a_char == 'X', "char: a: char = X");
check(a_char == b_char, "char: 等价于 <char>X");

// 3.4 byte
a_byte: byte = 200;
b_byte = <byte>200;
check(a_byte == 200, "byte: a: byte = 200");
check(a_byte == b_byte, "byte: 等价于 <byte>200");

// 3.5 ascii
a_ascii: ascii = 65;
b_ascii = <ascii>65;
check(a_ascii == 65, "ascii: a: ascii = 65");
check(a_ascii == b_ascii, "ascii: 等价于 <ascii>65");

// 3.6 uchar
a_uchar: uchar = 250;
check(a_uchar == 250, "uchar: a: uchar = 250");

print("var_decl_type_test PART3 (string/bool/char/byte/ascii/uchar) PASS");

// ============================================================
// PART 4：ptr / bigint / decimal / bitdecimal
// ============================================================

// 4.1 ptr
a_ptr: ptr = 0;
b_ptr = <ptr>0;
check(a_ptr == b_ptr, "ptr: a: ptr == <ptr>0 等价");

// 4.2 bigint（bigint 比较语义特殊，只验证赋值不崩溃 + 类型一致）
a_bi: bigint = "12345678901234567890";
b_bi = <bigint>"12345678901234567890";
check(type(a_bi) == type(b_bi), "bigint: 新旧语法类型一致");
check(type(a_bi) == "bigint", "bigint: type == bigint");

// 4.3 decimal
a_dec: decimal = "3.14159265358979";
b_dec = <decimal>"3.14159265358979";
check(type(a_dec) == type(b_dec), "decimal: 新旧语法类型一致");
check(type(a_dec) == "decimal", "decimal: type == decimal");

// 4.4 bitdecimal
a_bdec: bitdecimal = "2.718281828459045";
b_bdec = <bitdecimal>"2.718281828459045";
check(type(a_bdec) == type(b_bdec), "bitdecimal: 新旧语法类型一致");
check(type(a_bdec) == "bitdecimal", "bitdecimal: type == bitdecimal");

print("var_decl_type_test PART4 (ptr/bigint/decimal/bitdecimal) PASS");

// ============================================================
// PART 5：array / map（容器类型）
// ============================================================

// 5.1 array
a_arr: array = [1, 2, 3];
b_arr = <array>[1, 2, 3];
check(type(a_arr) == "array", "array: type(a_arr) == array");
check(len(a_arr) == 3, "array: len = 3");
check(a_arr[0] == 1 && a_arr[1] == 2 && a_arr[2] == 3, "array: elements");
check(a_arr[0] == b_arr[0], "array: 等价 <array>[1,2,3]");

// 5.2 map
a_map: map = {"k1": 1, "k2": 2};
b_map = <map>{"k1": 1, "k2": 2};
check(type(a_map) == "map", "map: type(a_map) == map");
check(a_map["k1"] == 1 && a_map["k2"] == 2, "map: values");
check(a_map["k1"] == b_map["k1"], "map: 等价 <map>{...}");

// 5.3 空容器
a_empty_arr: array = [];
check(type(a_empty_arr) == "array" && len(a_empty_arr) == 0, "array: 空数组声明");
a_empty_map: map = {};
check(type(a_empty_map) == "map" && len(a_empty_map) == 0, "map: 空map声明");

print("var_decl_type_test PART5 (array/map) PASS");

// ============================================================
// PART 6：typed array（通过 a: Type = <T>value 组合）
// ============================================================

// 6.1 typed array 元素类型转换
a_tint: array = <int>[1.9, 2.1, 3.99];
check(type(a_tint) == "array" && len(a_tint) == 3, "typed array: 声明");
check(a_tint[0] == 1 && a_tint[1] == 2 && a_tint[2] == 3, "typed array: float→int 转换");

// 6.2 typed string array
a_tstr: array = <string>["a", "b", "c"];
check(a_tstr[0] == "a" && a_tstr[1] == "b" && a_tstr[2] == "c", "typed array: string");

// 6.3 typed double array
a_tdbl: array = <double>[1, 2, 3];
check(a_tdbl[0] == 1.0 && a_tdbl[1] == 2.0 && a_tdbl[2] == 3.0, "typed array: int→double");

print("var_decl_type_test PART6 (typed array) PASS");

// ============================================================
// PART 7：generic map（<K,V>map 字面量赋值）
// ============================================================

// 7.1 <string, int> map
a_gmsi: map = <string, int>{"x": 10, "y": 20};
check(type(a_gmsi) == "map", "gmap: type == map");
check(a_gmsi["x"] == 10 && a_gmsi["y"] == 20, "gmap<string,int>: values");

// 7.2 <int, string> map
a_gmis: map = <int, string>{1: "one", 2: "two"};
check(a_gmis[1] == "one" && a_gmis[2] == "two", "gmap<int,string>: values");

// 7.3 <string, double> map
a_gmsd: map = <string, double>{"pi": 3.14};
check(a_gmsd["pi"] == 3.14, "gmap<string,double>: value");

// 7.4 <string, bool> map
a_gmsb: map = <string, bool>{"ok": true};
check(a_gmsb["ok"] == true, "gmap<string,bool>: value");

// 7.5 <string, string> map
a_gmss: map = <string, string>{"k": "v"};
check(a_gmss["k"] == "v", "gmap<string,string>: value");

print("var_decl_type_test PART7 (generic map) PASS");

// ============================================================
// PART 8：自定义 struct / class / type
// ============================================================

// 8.1 struct
struct Pt { x: int; y: int; }
a_struct: Pt = Pt(1, 2);
check(type(a_struct) == "Pt", "struct: type == Pt");
check(a_struct.x == 1 && a_struct.y == 2, "struct: fields");

// 8.2 class
class Animal {
    name: string;
    sound: string;
    func Animal(n, s) { self.name = n; self.sound = s; }
    func speak() { return self.name + " says " + self.sound; }
}
a_class: Animal = Animal("dog", "woof");
check(type(a_class) == "Animal", "class: type == Animal");
check(a_class.name == "dog", "class: name field");
check(a_class.speak() == "dog says woof", "class: speak() method");

// 8.3 type（命名构造）
type Color { red: int, grn: int, blu: int }
a_type: Color = <Color>{red: 255, grn: 128, blu: 0};
check(type(a_type) == "map", "type: type == map");
check(a_type.red == 255 && a_type.grn == 128 && a_type.blu == 0, "type: fields");

print("var_decl_type_test PART8 (struct/class/type) PASS");

// ============================================================
// PART 9：混合与边界场景
// ============================================================

// 9.1 类型转换：int 字面量赋给 double 变量
conv_dbl: double = 42;
check(conv_dbl == 42.0, "conversion: int→double");
check(type(conv_dbl) == "double", "conversion: type preserved as double");

// 9.2 类型转换：double 字面量赋给 int 变量（截断）
conv_int: int = 3.99;
check(conv_int == 3, "conversion: double→int truncate");

// 9.3 表达式赋值
expr_val: int = 2 * 3 + 4;
check(expr_val == 10, "expression: a: int = 2*3+4");

// 9.4 字符串拼接结果赋值
str_expr: string = "hello" + " " + "world";
check(str_expr == "hello world", "expression: a: string = str concat");

// 9.5 函数调用结果赋值
func double_it(n) { return n * 2; }
call_val: int = double_it(21);
check(call_val == 42, "call: a: int = double_it(21)");

// 9.6 链式赋值（a: Type = b: Type = value）
chain_a: int = 5;
chain_b: int = chain_a;
check(chain_a == 5 && chain_b == 5, "chain: a: int = 5; b: int = a");

// 9.7 先声明后赋值（同一变量重新赋值）
redecl: int = 10;
redecl = 20;
check(redecl == 20, "reassign: a: int = 10; a = 20");

// 9.8 声明后用于数组索引
idx_val: int = 2;
arr_for_idx = [10, 20, 30, 40];
check(arr_for_idx[idx_val] == 30, "index: 用声明变量作数组下标");

// 9.9 声明后用于 map 键
mk_val: string = "greeting";
m_for_key = {"greeting": "hi"};
check(m_for_key[mk_val] == "hi", "map key: 用声明变量作 map 键");

// 9.10 声明后用于循环
loop_max: int = 3;
loop_sum = 0;
for (i = 0; i < loop_max; i = i + 1) {
    loop_sum = loop_sum + i;
}
check(loop_sum == 3, "loop: 用声明变量作循环上界 (0+1+2=3)");

print("var_decl_type_test PART9 (混合/边界场景) PASS");

// ============================================================
// PART 10：新语法与旧语法完全等价性验证
// ============================================================

// 对每种类型同时用新语法 a: Type = v 和旧语法 b = <Type>v，验证等价
eq_int_new: int = 100;
eq_int_old = <int>100;
check(eq_int_new == eq_int_old, "equiv int: new == old");

eq_dbl_new: double = 2.5;
eq_dbl_old = <double>2.5;
check(eq_dbl_new == eq_dbl_old, "equiv double: new == old");

eq_str_new: string = "test";
eq_str_old = <string>"test";
check(eq_str_new == eq_str_old, "equiv string: new == old");

eq_bool_new: bool = false;
eq_bool_old = <bool>false;
check(eq_bool_new == eq_bool_old, "equiv bool: new == old");

eq_char_new: char = 'Z';
eq_char_old = <char>'Z';
check(eq_char_new == eq_char_old, "equiv char: new == old");

eq_byte_new: byte = 255;
eq_byte_old = <byte>255;
check(eq_byte_new == eq_byte_old, "equiv byte: new == old");

eq_arr_new: array = [1, 2, 3];
eq_arr_old = <array>[1, 2, 3];
check(eq_arr_new[0] == eq_arr_old[0] && eq_arr_new[2] == eq_arr_old[2], "equiv array: new == old");

eq_map_new: map = {"k": 1};
eq_map_old = <map>{"k": 1};
check(eq_map_new["k"] == eq_map_old["k"], "equiv map: new == old");

print("var_decl_type_test PART10 (新旧语法等价性) PASS");

print("var_decl_type_test ALL PASS");
