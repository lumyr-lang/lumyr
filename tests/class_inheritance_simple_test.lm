// 简单的 class 继承测试
print("=== 简单 class 继承测试 ===");

class Animal {
    name: string;
    func speak(self) {
        print("Animal speaks");
    }
    func get_name(self) {
        return self.name;
    }
}

class Dog extends Animal {
    func speak(self) {
        print("Dog barks");
    }
}

dog = Dog();
dog.name = "Buddy";
print("dog.name =", dog.get_name());
dog.speak();  // 应该输出 "Dog barks"

// 测试父类方法调用
print("=== 父类方法调用测试 ===");
animal = Animal();
animal.name = "Generic";
print("animal.name =", animal.get_name());
animal.speak();  // 应该输出 "Animal speaks"

print("=== 简单 class 继承测试完成 ===");
