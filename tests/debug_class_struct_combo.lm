// 调试 class + 结构体方法组合的测试
print("=== 调试 class + 结构体方法组合 ===");

// 简单 class（没有方法）
class SimpleClass {
    name: string;
}

print("1. 开始实例化 class");
obj = SimpleClass();
print("2. class 实例化完成");
obj.name = "Test";
print("3. obj.name =", obj.name);

// 结构体方法
struct Point {
    x: int;
    y: int;
    func debug_self(self) {
        print("5. 进入结构体方法");
        print("6. self.x =", self.x);
        print("7. self.y =", self.y);
        print("8. 离开结构体方法");
    }
}

print("4. 开始实例化结构体");
p1 = Point();
p1.x = 10;
p1.y = 20;
print("4.5. 结构体实例化完成，准备调用方法");
p1.debug_self();
print("9. 结构体方法调用完成");

print("=== 调试完成 ===");
