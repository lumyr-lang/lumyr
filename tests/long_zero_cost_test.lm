// 测试：long 类型完整零开销路径
print("=== long 类型测试 ===\n");

// 1. 变量声明
a = <long>1000000;
print("a = ");
print(a);
print("\n");

b = <long>-500000;
print("b = ");
print(b);
print("\n");

c = <long>2147483647;
print("c = ");
print(c);
print("\n");

// 2. 数组声明
arr = <long>[100000, 200000, 300000, 400000, 500000];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[2] = ");
print(arr[2]);
print("\n");
print("arr[4] = ");
print(arr[4]);
print("\n");

print("=== 测试完成 ===\n");
