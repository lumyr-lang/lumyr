// 测试 implements 运算符
print("=== implements 运算符测试 ===");

interface Printable {
    func to_string(): string;
}

interface Serializable {
    func to_json(): string;
}

class Dog implements Printable {
    name: string,
    age: int
    func __init__(self, name, age) {
        self.name = name;
        self.age = age;
    }
    func to_string(self) {
        return "Dog(" + self.name + ", " + self.age + ")";
    }
}

class Cat implements Printable, Serializable {
    name: string
    func __init__(self, name) {
        self.name = name;
    }
    func to_string(self) {
        return "Cat(" + self.name + ")";
    }
    func to_json(self) {
        return "{\"name\":\"" + self.name + "\"}";
    }
}

class Car {
    brand: string
    func __init__(self, brand) {
        self.brand = brand;
    }
}

d = Dog("Buddy", 3);
c = Cat("Whiskers");
car = Car("Toyota");

// 测试 class 实例的 implements 运算符
print("Dog implements Printable: ", d implements Printable);
print("Dog implements Serializable: ", d implements Serializable);
print("Cat implements Printable: ", c implements Printable);
print("Cat implements Serializable: ", c implements Serializable);
print("Car implements Printable: ", car implements Printable);

// 测试在 if 语句中使用
if(d implements Printable) {
    print("d 是 Printable，可以调用 to_string: ", d.to_string());
}

if(c implements Serializable) {
    print("c 是 Serializable，可以调用 to_json: ", c.to_json());
}

print("=== 测试完成 ===");
