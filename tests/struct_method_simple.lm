// 结构体方法测试 - 无类型参数
print("=== Struct Method Test ===");

struct Point {
    x: int;
    y: int;
    func get_x(self) {
        return self.x;
    }
    func set_x(self, new_x) {
        self.x = new_x;
    }
}

p = Point(3, 4);
print("p.x:", p.x);
print("p.get_x():", p.get_x());

p.set_x(100);
print("after set_x(100), p.x:", p.x);

print("=== Struct Method Test Passed ===");
