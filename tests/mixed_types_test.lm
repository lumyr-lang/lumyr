print("char - char:");
r = ch_a - ch_A;
print(r);
print("char * char:");
r = ch_A * ch_a;
print(r);
print("char / char:");
r = ch_a / ch_A;
print(r);

print("char + int:");
r = ch_A + i_int;
print(r);
