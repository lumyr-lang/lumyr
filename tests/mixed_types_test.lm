print(r);

// ===== 7. 字符串运算（只有 +）=====
print("=== 7. 字符串运算 ===");

print("string + string:");
r = s_hello + s_world;
print(r);

print("string + int:");
r = s_hello + i_int;
print(r);

print("int + string:");
r = i_int + s_hello;
print(r);

print("string + double:");
r = s_hello + f_double;
print(r);

print("double + string:");
r = f_double + s_hello;
print(r);

print("string + bool:");
r = s_hello + b_true;
print(r);

print("string + char:");
r = s_hello + ch_A;
print(r);

// ===== 8. 链式运算（所有运算符）=====
print("=== 8. 链式运算 ===");

print("int + int + int:");
r = i_int + i_short + i_int8;
print(r);

print("int * int + int:");
r = i_int * i_short + i_int8;
print(r);

print("(int + int) * int:");
r = (i_int + i_short) * i_int8;
print(r);

print("int * (int + int):");
r = i_int * (i_short + i_int8);
print(r);

print("int + int * int:");
r = i_int + i_short * i_int8;
print(r);

print("int - int - int:");
r = i_int - i_short - i_int8;
print(r);

print("int / int * int:");
r = i_int / i_short * i_int8;
print(r);

print("double * int + double:");
r = f_double * i_int + f_float;
print(r);

print("double + double * int:");
r = f_double + f_float * i_int;
print(r);

// ===== 9. 类型继承运算 =====
print("=== 9. 类型继承运算 ===");

x1 = <int>10;
x2 = x1;  // 继承 int
x3 = x1 + x2;  // int + int = int

print("x3 类型:");
print(type(x3));
print(x3);

x4 = <double>3.14;
x5 = x1 + x4;  // int + double = double

print("x5 类型:");
print(type(x5));
print(x5);

x6 = <short>5;
x7 = x6 * x1;  // short * int = int

print("x7 类型:");
print(type(x7));
print(x7);

// ===== 10. 默认类型运算 =====
print("=== 10. 默认类型运算 ===");

y1 = 10;     // 默认 int
y2 = 3.14;   // 默认 double
y3 = "hi";   // 默认 string

print("y1 + y2:");
r = y1 + y2;
print(r);
print(type(r));

print("y1 - y2:");
r = y1 - y2;
print(r);

print("y1 * y2:");
r = y1 * y2;
print(r);

print("y1 / y2:");
r = y1 / y2;
print(r);

print("y2 + y1:");
r = y2 + y1;
print(r);

print("y2 - y1:");
r = y2 - y1;
print(r);

print("y3 + y1:");
r = y3 + y1;
print(r);

print("y3 + y2:");
r = y3 + y2;
print(r);

