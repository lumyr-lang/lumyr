// ===== 14. 多类型链式复合运算（5+ 个不同类型连续运算） =====
print("=== 14. 多类型链式复合运算 ===");

// 有符号整数链式加法：int + short + int8 + int16 + int32 + int64
print("int + short + int8 + int16 + int32 + int64:");
r = i_int + i_short + i_int8 + i_int16 + i_int32 + i_int64;
print(r);
print("类型:");
print(type(r));

// 有符号整数链式混合：int - short + int8 * int16 / int32
print("int - short + int8 * int16 / int32:");
r = i_int - i_short + i_int8 * i_int16 / i_int32;
print(r);

// 无符号整数链式加法：uint + ushort + uint8 + uint16 + uint32 + uint64
print("uint + ushort + uint8 + uint16 + uint32 + uint64:");
r = u_uint + u_ushort + u_uint8 + u_uint16 + u_uint32 + u_uint64;
print(r);
print("类型:");
print(type(r));

// 有符号+无符号链式：int + uint + short + ushort + int8 + uint8
print("int + uint + short + ushort + int8 + uint8:");
r = i_int + u_uint + i_short + u_ushort + i_int8 + u_uint8;
print(r);

// 浮点链式加法：float + double + long double
print("float + double + long double:");
r = f_float + f_double + f_longdouble;
print(r);
print("类型:");
print(type(r));

// 整数+浮点链式：int + double + short + float + int64 + long double
print("int + double + short + float + int64 + long double:");
r = i_int + f_double + i_short + f_float + i_int64 + f_longdouble;
print(r);
print("类型:");
print(type(r));

// 全类型链式（整数+浮点+char+bool）：int + double + char + bool + float + short
print("int + double + char + bool + float + short:");
r = i_int + f_double + ch_A + b_true + f_float + i_short;
print(r);

// 扩展整数链式：long + longlong + ulong + uchar + byte + size_t + ssize_t
print("long + longlong + ulong + uchar + byte + size_t + ssize_t:");
r = i_long + i_longlong + u_ulong + u_uchar + u_byte + u_sizet + u_ssizet;
print(r);

// 字符串链式拼接：string + int + double + char + bool + float
print("string + int + double + char + bool + float:");
r = s_hello + i_int + f_double + ch_A + b_true + f_float;
print(r);

// 复杂表达式：(int + short) * (int8 + int16) - (int32 + int64)
print("(int + short) * (int8 + int16) - (int32 + int64):");
r = (i_int + i_short) * (i_int8 + i_int16) - (i_int32 + i_int64);
print(r);

// 复杂表达式：(uint + ushort) * (uint8 + uint16) / (uint32 + uint64)
print("(uint + ushort) * (uint8 + uint16) / (uint32 + uint64):");
r = (u_uint + u_ushort) * (u_uint8 + u_uint16) / (u_uint32 + u_uint64);
print(r);

// 复杂浮点表达式：(float + double) * (int + short) - (float * double)
print("(float + double) * (int + short) - (float * double):");
r = (f_float + f_double) * (i_int + i_short) - (f_float * f_double);
print(r);

// 超长链式：int + short + int8 + uint + ushort + float + double + char + bool + byte
print("int + short + int8 + uint + ushort + float + double + char + bool + byte:");
r = i_int + i_short + i_int8 + u_uint + u_ushort + f_float + f_double + ch_A + b_true + u_byte;
print(r);
print("类型:");
print(type(r));

print("=== 全量混合运算测试完成 ===");
