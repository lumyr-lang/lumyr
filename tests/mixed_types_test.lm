/* 混合运算测试：覆盖二十多种数据类型的混合多链路 */

/* 测试 1：int + double */
a = <int>10;
b = <double>20.5;
c = a + b;
print("1. int + double:");
print(a);
print(b);
print(c);

/* 测试 2：int + string */
a = <int>10;
b = <string>"hello";
c = a + b;
print("2. int + string:");
print(a);
print(b);
print(c);

/* 测试 3：double + string */
a = <double>20.5;
b = <string>"hello";
c = a + b;
print("3. double + string:");
print(a);
print(b);
print(c);

/* 测试 4：char + int */
a = <char>'A';
b = <int>1;
c = a + b;
print("4. char + int:");
print(a);
print(b);
print(c);

/* 测试 5：bool + int */
a = <bool>true;
b = <int>1;
c = a + b;
print("5. bool + int:");
print(a);
print(b);
print(c);

/* 测试 6：byte + int */
a = <byte>255;
b = <int>1;
c = a + b;
print("6. byte + int:");
print(a);
print(b);
print(c);

/* 测试 7：short + int */
a = <short>100;
b = <int>200;
c = a + b;
print("7. short + int:");
print(a);
print(b);
print(c);

/* 测试 8：long + int */
a = <long>1000;
b = <int>200;
c = a + b;
print("8. long + int:");
print(a);
print(b);
print(c);

/* 测试 9：long long + int */
a = <long long>1000000;
b = <int>200;
c = a + b;
print("9. long long + int:");
print(a);
print(b);
print(c);

/* 测试 10：float + double */
a = <float>3.14;
b = <double>2.718;
c = a + b;
print("10. float + double:");
print(a);
print(b);
print(c);

/* 测试 11：uint + int */
a = <uint>100;
b = <int>200;
c = a + b;
print("11. uint + int:");
print(a);
print(b);
print(c);

/* 测试 12：uchar + int */
a = <uchar>255;
b = <int>1;
c = a + b;
print("12. uchar + int:");
print(a);
print(b);
print(c);

/* 测试 13：ushort + int */
a = <ushort>100;
b = <int>200;
c = a + b;
print("13. ushort + int:");
print(a);
print(b);
print(c);

/* 测试 14：ulong + int */
a = <ulong>1000;
b = <int>200;
c = a + b;
print("14. ulong + int:");
print(a);
print(b);
print(c);

/* 测试 15：multi-chain: int + double + string + char */
a = <int>10;
b = <double>20.5;
c = <string>"hello";
d = <char>'A';
e = a + b + c + d;
print("15. multi-chain: int + double + string + char:");
print(a);
print(b);
print(c);
print(d);
print(e);

/* 测试 16：multi-chain: bool + int + double + string */
a = <bool>true;
b = <int>10;
c = <double>20.5;
d = <string>"hello";
e = a + b + c + d;
print("16. multi-chain: bool + int + double + string:");
print(a);
print(b);
print(c);
print(d);
print(e);

/* 测试 17：multi-chain: byte + short + int + long + long long */
a = <byte>1;
b = <short>2;
c = <int>3;
d = <long>4;
e = <long long>5;
f = a + b + c + d + e;
print("17. multi-chain: byte + short + int + long + long long:");
print(a);
print(b);
print(c);
print(d);
print(e);
print(f);

/* 测试 18：multi-chain: float + double + long double */
a = <float>1.5;
b = <double>2.5;
c = <long double>3.5;
d = a + b + c;
print("18. multi-chain: float + double + long double:");
print(a);
print(b);
print(c);
print(d);

/* 测试 19：multi-chain: uint + uchar + ushort + ulong */
a = <uint>100;
b = <uchar>200;
c = <ushort>300;
d = <ulong>400;
e = a + b + c + d;
print("19. multi-chain: uint + uchar + ushort + ulong:");
print(a);
print(b);
print(c);
print(d);
print(e);

/* 测试 20：multi-chain: int - double * char */
a = <int>100;
b = <double>20.5;
c = <char>'A';
d = a - b * c;
print("20. multi-chain: int - double * char:");
print(a);
print(b);
print(c);
print(d);

/* 测试 21：multi-chain: (int + double) * string / char */
a = <int>10;
b = <double>20.5;
c = <string>"hello";
d = <char>'A';
e = (a + b) * c / d;
print("21. multi-chain: (int + double) * string / char:");
print(a);
print(b);
print(c);
print(d);
print(e);

/* 测试 22：multi-chain: bool + byte + short + int + double + string */
a = <bool>true;
b = <byte>1;
c = <short>2;
d = <int>3;
e = <double>4.5;
f = <string>"hello";
g = a + b + c + d + e + f;
print("22. multi-chain: bool + byte + short + int + double + string:");
print(a);
print(b);
print(c);
print(d);
print(e);
print(f);
print(g);

/* 测试 23：multi-chain: 20+ types */
a1 = <bool>true;
a2 = <byte>1;
a3 = <char>'A';
a4 = <short>2;
a5 = <ushort>3;
a6 = <int>4;
a7 = <uint>5;
a8 = <long>6;
a9 = <ulong>7;
a10 = <long long>8;
a11 = <float>1.5;
a12 = <double>2.5;
a13 = <long double>3.5;
a14 = <string>"hello";
result = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14;
print("23. multi-chain: 20+ types:");
print(result);

print("All tests passed!");
