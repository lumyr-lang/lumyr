// 全量数据类型混合运算测试 - 覆盖所有运算符的所有组合
// 运算符：+、-、*、/
// 数据类型：int, short, int8, int16, int32, int64, long, longlong, uint, ushort, uint8, uint16, uint32, uint64, ulong, uchar, byte, size_t, ssize_t, float, double, long_double, bool, char, string

// ===== 准备变量 =====
i_int = <int>100;
i_short = <short>20;
i_int8 = <int8>5;
i_int16 = <int16>50;
i_int32 = <int32>1000;
i_int64 = <int64>1000000;
i_long = <long>2000000;
i_longlong = <long long>3000000;

u_uint = <uint>100;
u_ushort = <ushort>20;
u_uint8 = <uint8>5;
u_uint16 = <uint16>50;
u_uint32 = <uint32>1000;
u_uint64 = <uint64>1000000;
u_ulong = <ulong>2000000;
u_uchar = <uchar>65;
u_byte = <byte>200;
u_sizet = <size_t>5000;
u_ssizet = <ssize_t>-1000;

f_float = <float>3.14;
f_double = <double>2.71828;
f_longdouble = <long double>3.14159265358979;

b_true = <bool>true;
b_false = <bool>false;

ch_A = <char>'A';
ch_a = <char>'a';

s_hello = <string>"hello";
s_world = <string>"world";

// ===== 1. 有符号整数类型之间的 +、-、*、/ =====
print("=== 1. 有符号整数类型混合运算 ===");

// int 与所有有符号类型
print("int + short:");
r = i_int + i_short;
print(r);
print("int - short:");
r = i_int - i_short;
print(r);
print("int * short:");
r = i_int * i_short;
print(r);
print("int / short:");
r = i_int / i_short;
print(r);

print("int + int8:");
r = i_int + i_int8;
print(r);
print("int - int8:");
r = i_int - i_int8;
print(r);
print("int * int8:");
r = i_int * i_int8;
print(r);
print("int / int8:");
r = i_int / i_int8;
print(r);

print("int + int16:");
r = i_int + i_int16;
print(r);
print("int - int16:");
r = i_int - i_int16;
print(r);
print("int * int16:");
r = i_int * i_int16;
print(r);
print("int / int16:");
r = i_int / i_int16;
print(r);

print("int + int32:");
r = i_int + i_int32;
print(r);
print("int - int32:");
r = i_int - i_int32;
print(r);
print("int * int32:");
r = i_int * i_int32;
print(r);
print("int / int32:");
r = i_int / i_int32;
print(r);

print("int + int64:");
r = i_int + i_int64;
print(r);
print("int - int64:");
r = i_int - i_int64;
print(r);
print("int * int64:");
r = i_int * i_int64;
print(r);
print("int / int64:");
r = i_int / i_int64;
print(r);

// short 与其他有符号类型
print("short + int8:");
r = i_short + i_int8;
print(r);
print("short - int8:");
r = i_short - i_int8;
print(r);
print("short * int8:");
r = i_short * i_int8;
print(r);
print("short / int8:");
r = i_short / i_int8;
print(r);

print("int16 + int32:");
r = i_int16 + i_int32;
print(r);
print("int16 - int32:");
r = i_int16 - i_int32;
print(r);
print("int16 * int32:");
r = i_int16 * i_int32;
print(r);
print("int16 / int32:");
r = i_int16 / i_int32;
print(r);

print("int64 + int32:");
r = i_int64 + i_int32;
print(r);
print("int64 - int32:");
r = i_int64 - i_int32;
print(r);
print("int64 * int32:");
r = i_int64 * i_int32;
print(r);
print("int64 / int32:");
r = i_int64 / i_int32;
print(r);

// ===== 2. 无符号整数类型之间的 +、-、*、/ =====
print("=== 2. 无符号整数类型混合运算 ===");

print("uint + ushort:");
r = u_uint + u_ushort;
print(r);
print("uint - ushort:");
r = u_uint - u_ushort;
print(r);
print("uint * ushort:");
r = u_uint * u_ushort;
print(r);
print("uint / ushort:");
r = u_uint / u_ushort;
print(r);

print("uint8 + uint16:");
r = u_uint8 + u_uint16;
print(r);
print("uint8 - uint16:");
r = u_uint8 - u_uint16;
print(r);
print("uint8 * uint16:");
r = u_uint8 * u_uint16;
print(r);
print("uint8 / uint16:");
r = u_uint8 / u_uint16;
print(r);

print("uint32 + uint64:");
r = u_uint32 + u_uint64;
print(r);
print("uint32 - uint64:");
r = u_uint32 - u_uint64;
print(r);
print("uint32 * uint64:");
r = u_uint32 * u_uint64;
print(r);
print("uint32 / uint64:");
r = u_uint32 / u_uint64;
print(r);

print("uint64 - uint:");
r = u_uint64 - u_uint;
print(r);
print("uint64 / uint:");
r = u_uint64 / u_uint;
print(r);

// ===== 3. 有符号 + 无符号混合运算 =====
