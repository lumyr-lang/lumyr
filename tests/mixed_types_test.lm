print("int16 + uint16:");
r = i_int16 + u_uint16;
print(r);
print("int16 - uint16:");
r = i_int16 - u_uint16;
print(r);
print("int16 * uint16:");
r = i_int16 * u_uint16;
print(r);
print("int16 / uint16:");
r = i_int16 / u_uint16;
