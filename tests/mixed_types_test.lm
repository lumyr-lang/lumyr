print("int32 + uint32:");
r = i_int32 + u_uint32;
print(r);
print("int32 - uint32:");
r = i_int32 - u_uint32;
print(r);
print("int32 * uint32:");
r = i_int32 * u_uint32;
print(r);
print("int32 / uint32:");
r = i_int32 / u_uint32;
print(r);

print("int64 + uint64:");
r = i_int64 + u_uint64;
print(r);
print("int64 - uint64:");
r = i_int64 - u_uint64;
print(r);
print("int64 * uint64:");
r = i_int64 * u_uint64;
print(r);
print("int64 / uint64:");
r = i_int64 / u_uint64;
print(r);

print("short + ushort:");
r = i_short + u_ushort;
print(r);
print("short - ushort:");
r = i_short - u_ushort;
print(r);
print("short * ushort:");
r = i_short * u_ushort;
print(r);
print("short / ushort:");
r = i_short / u_ushort;
print(r);

// ===== 4. 浮点类型混合运算 =====
print("=== 4. 浮点类型混合运算 ===");

print("float + double:");
r = f_float + f_double;
print(r);
print(type(r));
