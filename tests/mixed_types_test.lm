// ===== 6. bool 和 char 运算 =====
print("=== 6. bool 和 char 运算 ===");

print("bool + bool:");
r = b_true + b_false;
print(r);
print("bool - bool:");
r = b_true - b_false;
print(r);
print("bool * bool:");
r = b_true * b_false;
print(r);
print("bool / bool:");
r = b_true / b_true;
print(r);

print("char + char:");
r = ch_A + ch_a;
