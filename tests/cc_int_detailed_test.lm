// 测试：CC模式 int 类型零开销优化（详细版）
print("=== CC模式 int 类型测试 ===\n");

// 1. 变量声明和赋值
a = <int>42;
print("a = ");
print(a);
print("\n");

b = <int>100;
print("b = ");
print(b);
print("\n");

// 2. 变量运算
c = <int>(a + b);
print("c = a + b = ");
print(c);
print("\n");

d = <int>(a * b);
print("d = a * b = ");
print(d);
print("\n");

// 3. 数组声明
arr = <int>[1, 2, 3, 4, 5];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[1] = ");
print(arr[1]);
print("\n");
print("arr[2] = ");
print(arr[2]);
print("\n");
print("arr[3] = ");
print(arr[3]);
print("\n");
print("arr[4] = ");
print(arr[4]);
print("\n");

// 4. 数组元素赋值
arr[0] = <int>100;
print("arr[0] after assign = ");
print(arr[0]);
print("\n");

print("=== 测试完成 ===\n");
