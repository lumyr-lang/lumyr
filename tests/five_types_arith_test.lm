// 测试五种已实现算术运算零开销优化的数据类型
// int类型
a = <int>10;
b = <int>3;
print("int:");
print(a + b);
print(a - b);
print(a * b);
print(a / b);

// uint类型
c = <uint>10;
d = <uint>3;
print("uint:");
print(c + d);
print(c - d);
print(c * d);
print(c / d);

// double类型
e = <double>10.5;
f = <double>3.2;
print("double:");
print(e + f);
print(e - f);
print(e * f);
print(e / f);

// float类型
g = <float>10.5;
h = <float>3.2;
print("float:");
print(g + h);
print(g - h);
print(g * h);
print(g / h);

// long long类型
i = <long long>1000000000;
j = <long long>3;
print("long long:");
print(i + j);
print(i - j);
print(i * j);
print(i / j);

// 混合类型运算测试
print("mixed:");
print(a + e);  // int + double
print(c + g);  // uint + float
print(a + i);  // int + long long
