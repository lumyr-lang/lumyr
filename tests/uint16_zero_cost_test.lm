// 测试：uint16 类型完整零开销路径
print("=== uint16 类型测试 ===\n");

// 1. 变量声明
a = <uint16>1000;
print("a = ");
print(a);
print("\n");

b = <uint16>30000;
print("b = ");
print(b);
print("\n");

c = <uint16>65535;
print("c = ");
print(c);
print("\n");

// 2. 数组声明
arr = <uint16>[100, 200, 300, 400, 500];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[2] = ");
print(arr[2]);
print("\n");
print("arr[4] = ");
print(arr[4]);
print("\n");

print("=== 测试完成 ===\n");
