// 测试 C 语言级别 struct 基础功能
// 1. struct 作为函数返回值
// 2. struct 数组
// 3. struct 浅拷贝赋值

print("=== Struct C-Level Features Test ===");

struct Point {
    x: int;
    y: int;
}

// ===== 1. struct 作为函数返回值 =====
print("--- 1. struct as return value ---");

func make_point(<int>x, <int>y) {
    p = Point(x, y);
    return p;
}

p1 = make_point(10, 20);
print("p1.x:", p1.x, "p1.y:", p1.y);  // 期望 10 20

// 返回后修改原局部变量不影响返回值（值语义）
func make_and_modify() {
    p = Point(1, 2);
    result = p;
    p.x = 999;
    return result;
}
p2 = make_and_modify();
print("p2.x:", p2.x);  // 期望 1（如果是值拷贝）或 999（如果是引用）

// ===== 2. struct 数组 =====
print("--- 2. struct array ---");

arr = [Point(1, 2), Point(3, 4), Point(5, 6)];
print("arr[0].x:", arr[0].x);  // 期望 1
print("arr[1].y:", arr[1].y);  // 期望 4
print("arr len:", len(arr));    // 期望 3

// 修改数组元素
arr[0].x = 100;
print("after modify arr[0].x:", arr[0].x);  // 期望 100

// 遍历数组
i = 0;
while (i < len(arr)) {
    print("arr[", i, "]:", arr[i].x, arr[i].y);
    i = i + 1;
}

// ===== 3. struct 浅拷贝赋值 =====
print("--- 3. struct shallow copy ---");

original = Point(10, 20);
copy = original;  // 浅拷贝

print("before modify:");
print("original.x:", original.x, "copy.x:", copy.x);  // 10 10

copy.x = 999;  // 修改拷贝

print("after modify copy.x = 999:");
print("original.x:", original.x, "copy.x:", copy.x);  // 期望 10 999（值拷贝）或 999 999（引用）

// 嵌套 struct 浅拷贝
struct Rect {
    top_left: Point;
    width: int;
}

r1 = Rect(Point(1, 2), 100);
r2 = r1;  // 浅拷贝

r2.top_left.x = 50;
print("nested: r1.top_left.x:", r1.top_left.x, "r2.top_left.x:", r2.top_left.x);  // 浅拷贝期望 1 50

print("=== Struct C-Level Features Test Done ===");
