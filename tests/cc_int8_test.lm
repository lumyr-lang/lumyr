// 测试：CC模式 int8 类型零开销优化
print("=== CC模式 int8 类型测试 ===\n");

// 1. 变量声明
a = <int8>42;
print("a = ");
print(a);
print("\n");

b = <int8>100;
print("b = ");
print(b);
print("\n");

// 2. 数组声明
arr = <int8>[1, 2, 3];
print("arr[0] = ");
print(arr[0]);
print("\n");
print("arr[1] = ");
print(arr[1]);
print("\n");
print("arr[2] = ");
print(arr[2]);
print("\n");

print("=== 测试完成 ===\n");
