// struct_param_test.lm — 测试 struct 作为函数参数的值传递
struct Point { x: int; y: int; }

func modify_point(<Point> p) {
    p.x = 999;
    p.y = 888;
    print("inside: p.x =", p.x, "p.y =", p.y);
}

print("=== Struct as Function Parameter Test ===");

p = Point(10, 20);
print("before: p.x =", p.x, "p.y =", p.y);

modify_point(p);

print("after:  p.x =", p.x, "p.y =", p.y);
print("expected: p.x = 10, p.y = 20 (值传递，函数内修改不影响外部)");

if (p.x == 10 && p.y == 20) {
    print("PASS: struct 参数是值传递");
} else {
    print("FAIL: struct 参数是引用传递");
}

print("=== Done ===");
